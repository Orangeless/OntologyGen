# ======================= NAMED INDIVIDUALS =======================
:TC_1 a :TrafficClass, owl:NamedIndividual ; rdfs:label "TC-1" ; :name "Priority / realtime" ; :planningThresholdPct 70.0 .
:TC_2 a :TrafficClass, owl:NamedIndividual ; rdfs:label "TC-2" ; :name "Interactive" ; :planningThresholdPct 75.0 .
:TC_4 a :TrafficClass, owl:NamedIndividual ; rdfs:label "TC-4" ; :name "Best effort / bulk" ; :planningThresholdPct 80.0 .
:SEG_RES a :CustomerSegment, owl:NamedIndividual ; rdfs:label "SEG-RES" ; :name "Residential" ; :criticality "NORMAL" ; :defaultSharePct 88.0 .
:SEG_SME a :CustomerSegment, owl:NamedIndividual ; rdfs:label "SEG-SME" ; :name "SME" ; :criticality "MEDIUM" ; :defaultSharePct 9.0 .
:SEG_ENT a :CustomerSegment, owl:NamedIndividual ; rdfs:label "SEG-ENT" ; :name "Enterprise/Critical" ; :criticality "HIGH" ; :defaultSharePct 3.0 .
# the 13 named planning rules (legacy fixture create_rules)
:PR_01 a :PlanningRule, owl:NamedIndividual ; rdfs:label "PR-01" ; :domain "Capacity" ; :metric "NNI utilisation" ; :limit 70.0 ; :unit "PCT" ; :compliance :ComplianceLevel_MUST_COMPLY ; :owner "Capacity Planning" .
:PR_02 a :PlanningRule, owl:NamedIndividual ; rdfs:label "PR-02" ; :domain "Capacity" ; :metric "CVC utilisation" ; :limit 70.0 ; :unit "PCT" ; :compliance :ComplianceLevel_MUST_COMPLY ; :owner "Capacity Planning" .
:PR_03 a :PlanningRule, owl:NamedIndividual ; rdfs:label "PR-03" ; :domain "Capacity" ; :metric "Protected NNI fill" ; :limit 80.0 ; :unit "PCT" ; :compliance :ComplianceLevel_MUST_COMPLY ; :owner "Capacity Planning" .
:EP_01 a :PlanningRule, owl:NamedIndividual ; rdfs:label "EP-01" ; :domain "Capacity" ; :metric "Port utilisation" ; :limit 75.0 ; :unit "PCT" ; :compliance :ComplianceLevel_SHOULD_COMPLY ; :owner "Network Engineering" .
:EP_02 a :PlanningRule, owl:NamedIndividual ; rdfs:label "EP-02" ; :domain "Capacity" ; :metric "Line-card NPU budget" ; :limit 80.0 ; :unit "PCT" ; :compliance :ComplianceLevel_EXCEPTION_REQUIRED ; :owner "Network Architecture" .
:RS_01 a :PlanningRule, owl:NamedIndividual ; rdfs:label "RS-01" ; :domain "Resilience" ; :metric "Dual homing across failure domains" ; :limit 1.0 ; :unit "BOOL" ; :compliance :ComplianceLevel_MUST_COMPLY ; :owner "Resilience Engineering" .
:RS_02 a :PlanningRule, owl:NamedIndividual ; rdfs:label "RS-02" ; :domain "Resilience" ; :metric "Diverse chassis bearer pair" ; :limit 1.0 ; :unit "BOOL" ; :compliance :ComplianceLevel_MUST_COMPLY ; :owner "Resilience Engineering" .
:RS_03 a :PlanningRule, owl:NamedIndividual ; rdfs:label "RS-03" ; :domain "Resilience" ; :metric "No shared SRLG across POI transport" ; :limit 1.0 ; :unit "BOOL" ; :compliance :ComplianceLevel_MUST_COMPLY ; :owner "Transport Engineering" .
:PR_05 a :PlanningRule, owl:NamedIndividual ; rdfs:label "PR-05" ; :domain "Resilience" ; :metric "Offered load within single-failure survivable capacity" ; :limit 100.0 ; :unit "PCT" ; :compliance :ComplianceLevel_MUST_COMPLY ; :owner "Transport Engineering" .
:CP_01 a :PlanningRule, owl:NamedIndividual ; rdfs:label "CP-01" ; :domain "Commercial" ; :metric "Whole-of-life cost horizon" ; :limit 36.0 ; :unit "MONTHS" ; :compliance :ComplianceLevel_SHOULD_COMPLY ; :owner "Commercial Planning" .
:GV_01 a :PlanningRule, owl:NamedIndividual ; rdfs:label "GV-01" ; :domain "Governance" ; :metric "NNI Group rate immutable" ; :limit 1.0 ; :unit "BOOL" ; :compliance :ComplianceLevel_PROHIBITED_DESIGN ; :owner "Wholesale Governance" .
:GV_02 a :PlanningRule, owl:NamedIndividual ; rdfs:label "GV-02" ; :domain "Governance" ; :metric "Diverse bearer additions ordered in pairs" ; :limit 2.0 ; :unit "COUNT" ; :compliance :ComplianceLevel_PROHIBITED_DESIGN ; :owner "Wholesale Governance" .
:GV_03 a :PlanningRule, owl:NamedIndividual ; rdfs:label "GV-03" ; :domain "Governance" ; :metric "No over-booking within NNI Group" ; :limit 1.0 ; :unit "BOOL" ; :compliance :ComplianceLevel_PROHIBITED_DESIGN ; :owner "Wholesale Governance" .
