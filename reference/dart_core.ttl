:ComplianceLevel_SHOULD_COMPLY a :ComplianceLevel, owl:NamedIndividual ; rdfs:label "SHOULD_COMPLY" .
:DeviceRole a owl:Class ; rdfs:label "DeviceRole" ; rdfs:comment "Legacy device role (engine.py ROLE_LEVEL); mapped to NetworkRole/NetworkLayer by the contract." ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :DeviceRole_CORE :DeviceRole_REGIONAL :DeviceRole_LOCAL_AGG :DeviceRole_ACCESS ) ] .
