    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :ComplianceLevel_EXCEPTION_REQUIRED :ComplianceLevel_MUST_COMPLY :ComplianceLevel_PROHIBITED_DESIGN :ComplianceLevel_SHOULD_COMPLY ) ] .
