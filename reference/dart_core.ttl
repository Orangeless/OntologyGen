:ActionStatus_ELIMINATED a :ActionStatus, owl:NamedIndividual ; rdfs:label "ELIMINATED" .
:ActionType a owl:Class ; rdfs:label "ActionType" ; rdfs:comment "Planning action types (legacy fixture action generation)." ;
