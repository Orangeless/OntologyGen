:NetworkLayer_RegionalLayer a :NetworkLayer, owl:NamedIndividual ; rdfs:label "RegionalLayer" .
:legacyRole a owl:ObjectProperty ; rdfs:domain :DeviceRole ; rdfs:range :NetworkRole ; rdfs:comment "Explicit legacy-role mapping of the contract (ROLE_LAYERS)." .
:legacyLayer a owl:ObjectProperty ; rdfs:domain :DeviceRole ; rdfs:range :NetworkLayer .
:DeviceRole_ACCESS :legacyRole :NetworkRole_Access ; :legacyLayer :NetworkLayer_AccessLayer .
:DeviceRole_LOCAL_AGG :legacyRole :NetworkRole_LocalAggregation ; :legacyLayer :NetworkLayer_LocalAggregationLayer .
:DeviceRole_REGIONAL :legacyRole :NetworkRole_RegionalAggregation ; :legacyLayer :NetworkLayer_RegionalLayer .
:DeviceRole_CORE :legacyRole :NetworkRole_Core ; :legacyLayer :NetworkLayer_CoreLayer .

