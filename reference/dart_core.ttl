@prefix : <http://www.example.com/dart#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://www.example.com/dart> a owl:Ontology ;
    rdfs:label "DART reference ontology (merged: DART-NPO + WBA wholesale model)" ;
    rdfs:comment "Merged from the newest DART code. Layer 'DART-NPO' = typed ontology contract (43 entity types, 58 relationship types, schemas 1.0-1.2). Layer 'WBA/legacy fixture' = wholesale domain model of the regional planning fixture (NNI Group, Bearer, CVC, AVC, CSA, POI, regions, ...) plus WBA names from ontology.yaml. Known to contain errors; use as a reference for comparison." .

:layer a owl:AnnotationProperty ; rdfs:comment "DART-NPO and/or WBA/legacy fixture: which part of DART defines the concept." .
:npoModule a owl:AnnotationProperty ; rdfs:comment "DART-NPO module, or the wholesale/legacy grouping." .
:wbaOnly a owl:AnnotationProperty ; rdfs:comment "true = concept exists in the WBA documents / ontology.yaml but has no simulator table." .
:simulationOnly a owl:AnnotationProperty ; rdfs:comment "true = simulator concept with no WBA counterpart (ontology.yaml simulation_only)." .
:legacyName a owl:AnnotationProperty ; rdfs:comment "Name of the same concept in the legacy tables / Neo4j." .
:origin a owl:AnnotationProperty ; rdfs:comment "Where a property comes from." .
:simulatorRelationship a owl:AnnotationProperty .
:endpointsInferred a owl:AnnotationProperty ; rdfs:comment "true = domain/range deduced from field names or counts, not stated verbatim in the DART docs." .
:relationSource a owl:AnnotationProperty .

# ======================= CLASSES =======================
:PlanningRegion a owl:Class ;
    rdfs:label "PlanningRegion" ;
    rdfs:comment "A planning region (key of REFERENCE_REGION_SPECS, e.g. Region-West-1). Groups CSAs, NNI Groups, CVCs, a POI and transport conditions." ;
    :npoModule "Wholesale" ;
    :layer "WBA/legacy fixture" ;
    :simulationOnly true .
:POI a owl:Class ;
    rdfs:label "POI" ;
    rdfs:comment "Point of Interconnect: where CSAs and NNI Groups meet the wholesale network. One per region, hosted on aggregation devices." ;
    :npoModule "Wholesale" ;
    rdfs:subClassOf :PlanningResource ;
    :layer "WBA/legacy fixture" ;
    skos:altLabel "POI" ;
    skos:altLabel "Point of Interconnect" ;
    skos:altLabel "Local POI" ;
    skos:altLabel "State Aggregation POI" .
:CSA a owl:Class ;
    rdfs:label "CSA" ;
    rdfs:comment "Connectivity Serving Area: a served area with services, premises and demand growth." ;
    :npoModule "Wholesale" ;
    rdfs:subClassOf :PlanningResource ;
    :layer "WBA/legacy fixture" ;
    skos:altLabel "CSA" ;
    skos:altLabel "Connectivity Serving Area" .
:NNIGroup a owl:Class ;
    rdfs:label "NNIGroup" ;
    rdfs:comment "Group of NNI Bearers/NNIs at a POI sharing a redundancy mode, interface rate and protected capacity." ;
    :npoModule "Wholesale" ;
    rdfs:subClassOf :PlanningResource ;
    :layer "WBA/legacy fixture" ;
    skos:altLabel "NNI Group" ;
    skos:altLabel "NNI" ;
    skos:altLabel "Network-Network Interface" ;
    skos:altLabel "NNI Product Component" .
:NNI a owl:Class ;
    rdfs:label "NNI" ;
    rdfs:comment "A single NNI within an NNI Group, realised on one Bearer." ;
    :npoModule "Wholesale" ;
    :layer "WBA/legacy fixture" .
:Bearer a owl:Class ;
    rdfs:label "Bearer" ;
    rdfs:comment "NNI Bearer: one physical interface of an NNI Group, landed on a line-card/port in a failure domain." ;
    :npoModule "Wholesale" ;
    :layer "WBA/legacy fixture" ;
    skos:altLabel "NNI Bearer" ;
    skos:altLabel "interface rate" ;
    skos:altLabel "Single Chassis" ;
    skos:altLabel "Diverse Chassis" ;
    skos:altLabel "Redundancy Mode" .
:CVC a owl:Class ;
    rdfs:label "CVC" ;
    rdfs:comment "Connectivity Virtual Circuit: carries a CSA's traffic over an NNI Group, with a traffic-class mix." ;
    :npoModule "Wholesale" ;
    rdfs:subClassOf :PlanningResource ;
    :layer "WBA/legacy fixture" ;
    skos:altLabel "CVC" ;
    skos:altLabel "Connectivity Virtual Circuit" ;
    skos:altLabel "CVC TC-1" ;
    skos:altLabel "CVC TC-2" ;
    skos:altLabel "CVC TC-4" ;
    skos:altLabel "Unicast N:1 CVC" .
:AVC a owl:Class ;
    rdfs:label "AVC" ;
    rdfs:comment "Access Virtual Circuit: per-service circuit that uses a CVC." ;
    :npoModule "Wholesale" ;
    :layer "WBA/legacy fixture" ;
    skos:altLabel "AVC" ;
    skos:altLabel "Access Virtual Circuit" ;
    skos:altLabel "Unicast 1:1 AVC" ;
    skos:altLabel "OVC" .
:TrafficClass a owl:Class ;
    rdfs:label "TrafficClass" ;
    rdfs:comment "Traffic class (TC-1, TC-2, TC-4) with a planning utilisation threshold." ;
    :npoModule "Wholesale" ;
    :layer "WBA/legacy fixture" ;
    skos:altLabel "TC-1" ;
    skos:altLabel "TC-2" ;
    skos:altLabel "TC-4" ;
    skos:altLabel "traffic class" ;
    skos:altLabel "bandwidth profile" .
:PlanningLineCard a owl:Class ;
    rdfs:label "PlanningLineCard" ;
    rdfs:comment "Planning line-card on an aggregation device with NPU capacity/budget and committed load." ;
    :npoModule "Network" ;
    rdfs:subClassOf :PlanningResource ;
    :layer "WBA/legacy fixture" ;
    :simulationOnly true .
:PlanningPort a owl:Class ;
    rdfs:label "PlanningPort" ;
    rdfs:comment "Planning port on a line-card; may be FREE/IN_SERVICE and usable or blocked." ;
    :npoModule "Network" ;
    rdfs:subClassOf :PlanningResource ;
    :layer "WBA/legacy fixture" ;
    :simulationOnly true .
:TransportNode a owl:Class ;
    rdfs:label "TransportNode" ;
    rdfs:comment "Backhaul transport node (aggregation, transit or core gateway) representing a device." ;
    :npoModule "Network" ;
    :layer "WBA/legacy fixture" ;
    :simulationOnly true .
:BackhaulRing a owl:Class ;
    rdfs:label "BackhaulRing" ;
    rdfs:comment "Ring of same-layer transport links." ;
    :npoModule "Network" ;
    :layer "WBA/legacy fixture" .
:CustomerSegment a owl:Class ;
    rdfs:label "CustomerSegment" ;
    rdfs:comment "Customer segment (residential, SME, enterprise) with criticality and default share." ;
    :npoModule "Customer" ;
    :layer "WBA/legacy fixture" .
:Premises a owl:Class ;
    rdfs:label "Premises" ;
    rdfs:comment "Customer premises within a CSA." ;
    :npoModule "Customer" ;
    :layer "WBA/legacy fixture" .
:CustomerService a owl:Class ;
    rdfs:label "CustomerService" ;
    rdfs:comment "A service delivered at premises over an AVC." ;
    :npoModule "Customer" ;
    :layer "WBA/legacy fixture" .
:BandwidthTier a owl:Class ;
    rdfs:label "BandwidthTier" ;
    rdfs:comment "Downstream/upstream speed tier of a service." ;
    :npoModule "Customer" ;
    :layer "WBA/legacy fixture" .
:CapacityPool a owl:Class ;
    rdfs:label "CapacityPool" ;
    rdfs:comment "Contractual/protected/used capacity of an NNI Group." ;
    :npoModule "Capacity" ;
    :layer "WBA/legacy fixture" .
:DemandForecast a owl:Class ;
    rdfs:label "DemandForecast" ;
    rdfs:comment "Legacy demand growth forecast for a CSA or CVC under a scenario (the contract's Forecast, kind-qualified)." ;
    :npoModule "Capacity" ;
    rdfs:subClassOf :Forecast ;
    :layer "WBA/legacy fixture" ;
    :legacyName "demand_forecasts" .
:Intent a owl:Class ;
    rdfs:label "Intent" ;
    rdfs:comment "Planning intent with cost/risk/utilisation/resilience weights." ;
    :npoModule "Decision" ;
    :layer "WBA/legacy fixture" .
:CostItem a owl:Class ;
    rdfs:label "CostItem" ;
    rdfs:comment "A cost line of an action (capital, one-off, recurring, lease)." ;
    :npoModule "Decision" ;
    :layer "WBA/legacy fixture" .
:ProductComponent a owl:Class ;
    rdfs:label "ProductComponent" ;
    rdfs:comment "WBA Product Component; counts toward an NNI Group's Bearer Limit. Not modelled in the simulator." ;
    :npoModule "WBA-only" ;
    :layer "WBA/legacy fixture" ;
    skos:altLabel "Product Component" ;
    skos:altLabel "Bearer Limit" ;
    :wbaOnly true .
:ServiceLevel a owl:Class ;
    rdfs:label "ServiceLevel" ;
    rdfs:comment "WBA availability and service levels (Network Availability, frame delay, frame loss). Not modelled." ;
    :npoModule "WBA-only" ;
    :layer "WBA/legacy fixture" ;
    skos:altLabel "Network Availability" ;
    skos:altLabel "Service Level" ;
    skos:altLabel "frame delay" ;
    skos:altLabel "frame loss" ;
    :wbaOnly true .
:NNILink a owl:Class ;
    rdfs:label "NNILink" ;
    rdfs:comment "WBA NNI Link / V-NNI / S-TAG concepts. Not modelled." ;
    :npoModule "WBA-only" ;
    :layer "WBA/legacy fixture" ;
    skos:altLabel "NNI Link" ;
    skos:altLabel "V-NNI" ;
    skos:altLabel "S-TAG" ;
    skos:altLabel "over-book" ;
    :wbaOnly true .
:Network a owl:Class ;
    rdfs:label "Network" ;
    rdfs:comment "The network (or network instance) that owns sites, devices, links and runs; persistent identity namespace." ;
    :npoModule "Physical Network" ;
    :layer "DART-NPO" ;
    skos:altLabel "NetworkInstance" .
:Site a owl:Class ;
    rdfs:label "Site" ;
    rdfs:comment "Physical or logical location that hosts devices (synthetic km coordinates in the simulator)." ;
    :npoModule "Physical Network" ;
    :layer "DART-NPO" .
:Device a owl:Class ;
    rdfs:label "Device" ;
    rdfs:comment "Active network device with an explicit NetworkRole and NetworkLayer; legacy roles CORE/REGIONAL/LOCAL_AGG/ACCESS." ;
    :npoModule "Physical Network" ;
    :layer "DART-NPO" ;
    :layer "WBA/legacy fixture" .
:LineCard a owl:Class ;
    rdfs:label "LineCard" ;
    rdfs:comment "Replaceable module in a device (Module); generic capacity cards are distinguished." ;
    :npoModule "Physical Network" ;
    :layer "DART-NPO" .
:Port a owl:Class ;
    rdfs:label "Port" ;
    rdfs:comment "Physical endpoint (port_role NETWORK) or logical capacity position (CAPACITY_UNIT); never summed as one count." ;
    :npoModule "Physical Network" ;
    :layer "DART-NPO" .
:PhysicalLink a owl:Class ;
    rdfs:label "PhysicalLink" ;
    rdfs:comment "Physical connection with exactly two distinct port endpoints (HAS_ENDPOINT, side A/B)." ;
    :npoModule "Physical Network" ;
    :layer "DART-NPO" ;
    :legacyName "Link" ;
    skos:altLabel "Link" .
:LinkAggregationGroup a owl:Class ;
    rdfs:label "LinkAggregationGroup" ;
    rdfs:comment "Logical bundle of physical links; observed and simulated active capacity kept separate." ;
    :npoModule "Physical Network" ;
    :layer "DART-NPO" ;
    :legacyName "LAG" ;
    skos:altLabel "LAG" .
:SharedRiskGroup a owl:Class ;
    rdfs:label "SharedRiskGroup" ;
    rdfs:comment "Shared-risk link group: resources that can fail together (legacy srlg_id)." ;
    :npoModule "Physical Network" ;
    :layer "DART-NPO" ;
    :layer "WBA/legacy fixture" ;
    :legacyName "SRLG" ;
    :simulationOnly true .
:NetworkRole a owl:Class ;
    rdfs:label "NetworkRole" ;
    rdfs:comment "Controlled vocabulary of device functions (Access, LocalAggregation, RegionalAggregation, Core, Transit, Edge)." ;
    :npoModule "Physical Network" ;
    :layer "DART-NPO" .
:NetworkLayer a owl:Class ;
    rdfs:label "NetworkLayer" ;
    rdfs:comment "Controlled vocabulary of architecture layers (AccessLayer, LocalAggregationLayer, RegionalLayer, CoreLayer)." ;
    :npoModule "Physical Network" ;
    :layer "DART-NPO" .
:DemandGroup a owl:Class ;
    rdfs:label "DemandGroup" ;
    rdfs:comment "Aggregate offered traffic / user equivalents at an access point; not an endpoint-specific Service/Demand." ;
    :npoModule "Service and Demand" ;
    :layer "DART-NPO" .
:Route a owl:Class ;
    rdfs:label "Route" ;
    rdfs:comment "Stable candidate physical path identity (route_semantics=CANDIDATE_PHYSICAL_PATH) with origin and destination." ;
    :npoModule "Service and Demand" ;
    :layer "DART-NPO" .
:RouteHop a owl:Class ;
    rdfs:label "RouteHop" ;
    rdfs:comment "One ordered, oriented hop of a route; uses exactly one PhysicalLink." ;
    :npoModule "Service and Demand" ;
    :layer "DART-NPO" .
:ResourceSnapshot a owl:Class ;
    rdfs:label "ResourceSnapshot" ;
    rdfs:comment "Run-scoped snapshot of mutable inventory/scenario facts about a resource (keeps shared identity immutable)." ;
    :npoModule "State and Observation" ;
    :layer "DART-NPO" .
:ResourceState a owl:Class ;
    rdfs:label "ResourceState" ;
    rdfs:comment "Scoped state assertion or sample of a resource (state code, assertion type, time basis)." ;
    :npoModule "State and Observation" ;
    :layer "DART-NPO" .
:Metric a owl:Class ;
    rdfs:label "Metric" ;
    rdfs:comment "Explicit metric definition: source table/field, unit, direction, measurement basis (27 in the current map)." ;
    :npoModule "State and Observation" ;
    :layer "DART-NPO" .
:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:comment "Scalar observation: timestamp, value or null, unit, direction, basis, PRESENT/MISSING status, coverage." ;
    :npoModule "State and Observation" ;
    :layer "DART-NPO" .
:FailureEvent a owl:Class ;
    rdfs:label "FailureEvent" ;
    rdfs:comment "Failure with cause and half-open start/end affecting a resource." ;
    :npoModule "Time and Events" ;
    :layer "DART-NPO" .
:MaintenanceEvent a owl:Class ;
    rdfs:label "MaintenanceEvent" ;
    rdfs:comment "Maintenance window with half-open start/end affecting a resource." ;
    :npoModule "Time and Events" ;
    :layer "DART-NPO" .
:Scenario a owl:Class ;
    rdfs:label "Scenario" ;
    rdfs:comment "A scenario within a network (operational scenario or planning scenario)." ;
    :npoModule "Scenario and Simulation" ;
    :layer "DART-NPO" ;
    :layer "WBA/legacy fixture" .
:SimulationRun a owl:Class ;
    rdfs:label "SimulationRun" ;
    rdfs:comment "One execution: caller run/scenario/network IDs, seed, simulated times, input-binding hash, version." ;
    :npoModule "Scenario and Simulation" ;
    :layer "DART-NPO" .
:Dataset a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:comment "Input dataset identity and classification." ;
    :npoModule "Evidence and Provenance" ;
    :layer "DART-NPO" .
:Configuration a owl:Class ;
    rdfs:label "Configuration" ;
    rdfs:comment "Configuration with SHA-256." ;
    :npoModule "Evidence and Provenance" ;
    :layer "DART-NPO" .
:SoftwareVersion a owl:Class ;
    rdfs:label "SoftwareVersion" ;
    rdfs:comment "Recorded simulator revision and exact-build limitation." ;
    :npoModule "Evidence and Provenance" ;
    :layer "DART-NPO" .
:EvidenceArtifact a owl:Class ;
    rdfs:label "EvidenceArtifact" ;
    rdfs:comment "Indexed source file with SHA-256; target of DERIVED_FROM." ;
    :npoModule "Evidence and Provenance" ;
    :layer "DART-NPO" .
:PlanningResource a owl:Class ;
    rdfs:label "PlanningResource" ;
    rdfs:comment "Run-scoped planning inventory object (not a new physical asset). Superclass of POI, CSA, NNIGroup, CVC, PlanningLineCard, PlanningPort." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" .
:Forecast a owl:Class ;
    rdfs:label "Forecast" ;
    rdfs:comment "Planning forecast (kind-qualified: demand, capacity breach); direction/issue time may be explicitly unknown." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" .
:PlanningProblem a owl:Class ;
    rdfs:label "PlanningProblem" ;
    rdfs:comment "Planning problem for a scenario (a decision scope)." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" .
:PlanningRule a owl:Class ;
    rdfs:label "PlanningRule" ;
    rdfs:comment "Named planning/engineering/governance rule with a limit, unit and compliance level (PR-01 ... GV-03)." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" ;
    :layer "WBA/legacy fixture" .
:Threshold a owl:Class ;
    rdfs:label "Threshold" ;
    rdfs:comment "Numeric limit attached to a rule (legacy thresholds table), source units retained." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" .
:Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "Evaluation of a rule for a subject/resource in a scenario (observed before/after vs limit; status PASS/VIOLATED/not evaluated)." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" ;
    :layer "WBA/legacy fixture" ;
    :legacyName "PlanningConstraint" .
:CandidateAction a owl:Class ;
    rdfs:label "CandidateAction" ;
    rdfs:comment "Candidate planning action with lead time, cost, feasibility, blocking reasons and scores." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" ;
    :layer "WBA/legacy fixture" ;
    :legacyName "Action" ;
    skos:altLabel "order" ;
    skos:altLabel "NNI Upsize Migration" ;
    skos:altLabel "NNI Diversity Upgrade" ;
    skos:altLabel "Modify" ;
    skos:altLabel "charge" ;
    skos:altLabel "price" ;
    skos:altLabel "lead time" .
:ActionAssessment a owl:Class ;
    rdfs:label "ActionAssessment" ;
    rdfs:comment "Scored assessment of one candidate action." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" ;
    :layer "WBA/legacy fixture" ;
    :legacyName "Assessment" .
:ActionPlan a owl:Class ;
    rdfs:label "ActionPlan" ;
    rdfs:comment "Multi-action plan (set of candidate actions)." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" .
:DecisionEvaluation a owl:Class ;
    rdfs:label "DecisionEvaluation" ;
    rdfs:comment "The existing regional scoring/search stage; optimality_status=NOT_CLAIMED." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" .
:Recommendation a owl:Class ;
    rdfs:label "Recommendation" ;
    rdfs:comment "The selected action or plan for an intent in a scenario, with explanation; unresolved/unevaluated constraints stay explicit." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" ;
    :layer "WBA/legacy fixture" .
:OperationalReplay a owl:Class ;
    rdfs:label "OperationalReplay" ;
    rdfs:comment "Replay of a recommended/candidate action against the operational model." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" .
:ActionApplication a owl:Class ;
    rdfs:label "ActionApplication" ;
    rdfs:comment "An action applied within a replay." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" .
:ReplayFinding a owl:Class ;
    rdfs:label "ReplayFinding" ;
    rdfs:comment "A finding produced by a replay." ;
    :npoModule "Planning" ;
    :layer "DART-NPO" .
:PlanningCheck a owl:Class ;
    rdfs:label "PlanningCheck" ;
    rdfs:comment "Counterfactual/plan check that checks a recommendation." ;
    :npoModule "Evidence and Provenance" ;
    :layer "DART-NPO" .
:EvidenceRecord a owl:Class ;
    rdfs:label "EvidenceRecord" ;
    rdfs:comment "Evidence text for an action (feasibility gate or supporting measurement)." ;
    :npoModule "Evidence and Provenance" ;
    :layer "DART-NPO" .
:ValidationRun a owl:Class ;
    rdfs:label "ValidationRun" ;
    rdfs:comment "Recorded role/model comparison group from an independent validator." ;
    :npoModule "Evidence and Provenance" ;
    :layer "DART-NPO" .
:ValidationCase a owl:Class ;
    rdfs:label "ValidationCase" ;
    rdfs:comment "One validation case (replay cases only receive typed nodes)." ;
    :npoModule "Evidence and Provenance" ;
    :layer "DART-NPO" .

# ======================= ENUMERATIONS =======================
:RedundancyMode a owl:Class ; rdfs:label "RedundancyMode" ; rdfs:comment "NNI Group redundancy mode (nni_groups.mode)." ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :RedundancyMode_DIVERSE_CHASSIS :RedundancyMode_SINGLE :RedundancyMode_SINGLE_CHASSIS ) ] .
:RedundancyMode_DIVERSE_CHASSIS a :RedundancyMode, owl:NamedIndividual ; rdfs:label "DIVERSE_CHASSIS" .
:RedundancyMode_SINGLE a :RedundancyMode, owl:NamedIndividual ; rdfs:label "SINGLE" ; rdfs:comment "Used by Region-Central-1 but not a WBA redundancy mode." .
:RedundancyMode_SINGLE_CHASSIS a :RedundancyMode, owl:NamedIndividual ; rdfs:label "SINGLE_CHASSIS" .
:InterfaceTechnology a owl:Class ; rdfs:label "InterfaceTechnology" ; rdfs:comment "NNI interface technology (nni_groups.technology)." ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :InterfaceTechnology_100GE :InterfaceTechnology_10GE :InterfaceTechnology_1GE ) ] .
:InterfaceTechnology_100GE a :InterfaceTechnology, owl:NamedIndividual ; rdfs:label "100GE" .
:InterfaceTechnology_10GE a :InterfaceTechnology, owl:NamedIndividual ; rdfs:label "10GE" .
:InterfaceTechnology_1GE a :InterfaceTechnology, owl:NamedIndividual ; rdfs:label "1GE" .
:CSAState a owl:Class ; rdfs:label "CSAState" ; rdfs:comment "CSA lifecycle state (csas.state)." ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :CSAState_ANNOUNCED_RFS_90D :CSAState_IN_SERVICE ) ] .
:CSAState_ANNOUNCED_RFS_90D a :CSAState, owl:NamedIndividual ; rdfs:label "ANNOUNCED_RFS_90D" .
:CSAState_IN_SERVICE a :CSAState, owl:NamedIndividual ; rdfs:label "IN_SERVICE" .
:RiskRating a owl:Class ; rdfs:label "RiskRating" ; rdfs:comment "CSA risk rating (csas.risk_rating)." ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :RiskRating_High :RiskRating_Low :RiskRating_Medium ) ] .
:RiskRating_High a :RiskRating, owl:NamedIndividual ; rdfs:label "High" .
:RiskRating_Low a :RiskRating, owl:NamedIndividual ; rdfs:label "Low" .
:RiskRating_Medium a :RiskRating, owl:NamedIndividual ; rdfs:label "Medium" .
:AccessTechnology a owl:Class ; rdfs:label "AccessTechnology" ; rdfs:comment "Access technology of a CSA (csas.tech; a CSA may have several, separated by '|')." ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :AccessTechnology_FIBRE :AccessTechnology_FTTC :AccessTechnology_HFC ) ] .
:AccessTechnology_FIBRE a :AccessTechnology, owl:NamedIndividual ; rdfs:label "FIBRE" .
:AccessTechnology_FTTC a :AccessTechnology, owl:NamedIndividual ; rdfs:label "FTTC" .
:AccessTechnology_HFC a :AccessTechnology, owl:NamedIndividual ; rdfs:label "HFC" .
:TransportRiskMode a owl:Class ; rdfs:label "TransportRiskMode" ; rdfs:comment "Region transport risk (transport_risk_mode)." ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :TransportRiskMode_DIVERSE :TransportRiskMode_NO_DIVERSITY :TransportRiskMode_SHARED_SRLG ) ] .
:TransportRiskMode_DIVERSE a :TransportRiskMode, owl:NamedIndividual ; rdfs:label "DIVERSE" .
:TransportRiskMode_NO_DIVERSITY a :TransportRiskMode, owl:NamedIndividual ; rdfs:label "NO_DIVERSITY" .
:TransportRiskMode_SHARED_SRLG a :TransportRiskMode, owl:NamedIndividual ; rdfs:label "SHARED_SRLG" .
:RegionCondition a owl:Class ; rdfs:label "RegionCondition" ; rdfs:comment "Reference-scenario condition tag of a region (condition)." ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( :RegionCondition_LEGACY_OVERSUBSCRIBED_LINECARD :RegionCondition_NO_DIVERSITY_AVAILABLE :RegionCondition_NO_USABLE_FREE_PORT_NEW_CSA_90D :RegionCondition_SINGLE_CHASSIS_AVAILABILITY_EXPOSURE ) ] .
:RegionCondition_LEGACY_OVERSUBSCRIBED_LINECARD a :RegionCondition, owl:NamedIndividual ; rdfs:label "LEGACY_OVERSUBSCRIBED_LINECARD" .
