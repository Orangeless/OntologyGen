    rdfs:domain ns1:Cl_AvcTc4OrderedProductComponent ;
    rdfs:range ns1:Cl_PirObjective .

ns1:isNotLocatedIn a owl:DatatypeProperty ;
    rdfs:label "is not located in" ;
