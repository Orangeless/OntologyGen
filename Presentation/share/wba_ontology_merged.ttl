    rdfs:domain ns1:ESLAChangeEvent ;
    rdfs:range ns1:EnhancedFaultRectificationService .

ns1:isCausedByModification a owl:ObjectProperty ;
    rdfs:label "isCausedByModification" ;
    rdfs:comment "Links an eSLA Change Event to the Enhanced Fault Rectification Service that is modified to change the selected option causing the event. [extension: nbn Ethernet Price List, Section 2.2(e)(ii), p.10]" ;
    rdfs:domain ns1:ESLAChangeEvent ;
    rdfs:range ns1:EnhancedFaultRectificationService .

ns1:isCompleted a owl:DatatypeProperty ;
    rdfs:label "isCompleted" ;
