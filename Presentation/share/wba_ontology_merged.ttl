ns1:CVC_ObjectRole a ns1:CVC,
        owl:NamedIndividual ;
    rdfs:label "CVC (object role)" ;
    ns1:hasBandwidthProfile "to be selected by RSP" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.2(b), p.7" ;
    rdfs:comment "A CVC that is the object of contractual events. [extension: nbn Ethernet Product Module, Section 2, p.7]",
        "Ethernet-based Layer 2 virtual capacity on the nbn Network used to carry RSP traffic between multiple AVCs in a CSA on an aggregated basis and the NNI at the POI serving that CSA. [extension: nbn Ethernet Product Module, Section 2.1(a), p.7]" .

ns1:CVC_TC2_ProductComponent a owl:Class ;
    rdfs:label "CVC_TC2_ProductComponent" ;
    rdfs:comment "A Connectivity Virtual Circuit Product Component for Traffic Class 2, with a recurring charge per provisioned symmetrical Mbps (CIR). [extension: nbn Ethernet Price List, Section 1.5, p.8]" ;
    rdfs:subClassOf ns1:CVC,
        ns1:ProductComponent .

ns1:Cl_BandwidthProfileSpec a owl:Class ;
    rdfs:label "BandwidthProfileSpec" ;
    rdfs:comment "Reified relationship representing a traffic class specification (traffic class, rate type, rate value, unit) within a bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" .

ns1:Cl_BearerLimit a owl:Class ;
    rdfs:label "BearerLimit" ;
    rdfs:comment "A reified conditional maximum number of NNI Bearers an NNI Group can support, dependent on interface rate and redundancy mode. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.1, page 28]" .

ns1:Cl_CvcClass a owl:Class ;
    rdfs:label "Cl_CvcClass" ;
    rdfs:comment "A classification (0, 1, 2) for CVC TC-4 on nbn Ethernet (Satellite) that determines CIR increments and minimum AVC association rules. [extension: nbn Ethernet Product Module, Section 2.2(e), p.8]" .

ns1:Cl_EarlyDisconnectionModificationCharge a owl:Class ;
    rdfs:label "Early Disconnection or Modification Charge" ;
    rdfs:comment "A monetary charge triggered when an AVC TC-2 Product Component is cancelled, disconnected, or modified within 12 months of order completion. [extension: nbn Ethernet Price List, Section 7, p.18]" ;
    rdfs:subClassOf ns1:MonetaryAmount .

ns1:Cl_ExceedanceEvent a owl:Class ;
    rdfs:label "Exceedance Event" ;
    rdfs:comment "An event where an RSP exceeds the average download and/or upload limitation set out in section 4.5(a) of the nbn Ethernet Fair Use Policy. [extension: nbn Ethernet Price List, Section 6(d)-(e), p.18]" ;
    rdfs:subClassOf ns1:Event .

ns1:Cl_NNIGroupRedundancyMode a owl:Class ;
    rdfs:label "NNI Group Redundancy Mode" ;
    rdfs:comment "The redundancy mode of an NNI Group, either Single Chassis or Diverse Chassis, set through the selection of the first NNI Bearer or pair of NNI Bearers at the time the NNI Group is created. [extension: nbn Ethernet Product Module, section 8.3.1.2, page 40]" ;
    rdfs:subClassOf ns1:ServiceAttributes .

ns1:Cl_NNIGroupRelocation a ns1:Cl_Event,
        owl:Class ;
    rdfs:label "NNI Group Relocation" ;
    rdfs:comment "The process of changing the location of an NNI Group, which requires purchasing a new NNI Group in the intended location and transitioning existing AVCs and CVCs from the previous NNI Group. [extension: nbn Ethernet Product Module, section 8.3.1.1, page 40]" ;
    rdfs:subClassOf ns1:Cl_Event .

ns1:Cl_NetworkActivity a owl:Class ;
    rdfs:label "Network Activity",
        "Network Activity Event" ;
    rdfs:comment "An activity performed by nbn on the network, designated by a Network Activity Designation Date, and subject to performance objectives for update timeliness. [extension: WBA Ethernet Service Levels Schedule, s5.1-5.2, p.14]",
        "An event where nbn designates that Network Activity is required in respect of an nbn Ethernet Ordered Product to attempt to achieve the CIR Objective. [extension: nbn Ethernet Price List, Section 7(b)(i), p.18]" ;
    rdfs:subClassOf ns1:Event .

ns1:Cl_PirAffectedBillingPeriod a owl:Class ;
    rdfs:label "PIR Affected Billing Period" ;
    rdfs:comment "A monthly billing period during which an AVC TC-4 Ordered Product Component is designated for a Network Activity because it cannot achieve its PIR Objective, starting from the Start Date (Prior WBA) or Trouble Ticket acknowledgment (this Agreement), and ending when the Network Activity is completed. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.15]" .

ns1:Cl_SpecificationType a owl:Class ;
    rdfs:label "SpecificationType" ;
    rdfs:comment "The type of capacity specification (CIR or PIR) applied to a traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

ns1:Cl_TrafficDiscardEvent a owl:Class ;
    rdfs:label "TrafficDiscardEvent" ;
    rdfs:comment "A reified event describing the circumstances under which traffic may be discarded for an NNI Group, including the cause and the priority basis for discard. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.7, page 31]" .

ns1:Cl_UsageRange a owl:Class ;
    rdfs:label "Usage Range" ;
    rdfs:comment "A threshold or range of CVC TC-4 usage that defines a charge tier. [extension: nbn Ethernet Price List, Section 6(a), p.17]" .

ns1:ESLAChangeEvent a owl:Class ;
    rdfs:label "ESLAChangeEvent" ;
    rdfs:comment "An event where an Enhanced Fault Rectification Service is disconnected or modified to change the selected Enhanced Fault Rectification Service option, triggering special charge rules under section 2.2. [extension: nbn Ethernet Price List, Section 2.2(e), p.10]" .

ns1:InterferenceMitigation a owl:Class ;
    rdfs:label "InterferenceMitigation" ;
    rdfs:comment "An interference mitigation activity designated by nbn that may be required to address a CIR Objective not being achieved. [extension: nbn Ethernet Product Module, Section 3.4(c), p.13]" ;
    rdfs:subClassOf ns1:Cl_ContractualEvent .

ns1:NNIBearerProfile a owl:Class ;
    rdfs:label "NNIBearerProfile" ;
    rdfs:comment "An enumeration of NNI Bearer profile types (e.g. 1000BaseLX, 10GBaseLR). [extension: nbn Ethernet Price List, Section 1.6, p.8]",
        "Physical interface profile for an NNI Bearer (e.g. 1000BaseLX, 10GBaseLR). [extension: nbn Ethernet Product Module, Section 1.2, p.6]" .

ns1:NNIGroup_Location_Attribute a ns1:Cl_NNIGroupLocation,
        owl:NamedIndividual ;
    rdfs:label "NNI Group Location Attribute" ;
    ns1:hasAttributeDescription "The location of the NNI Group must be specified at time of NNI Group creation"^^xsd:string ;
    ns1:hasLocationName "Location"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.1.1, page 40" .

ns1:AVC_ObjectRole a ns1:AVC,
        owl:NamedIndividual ;
    rdfs:label "AVC (object role)" ;
    rdfs:comment "An AVC that is the object of contractual events. [extension: nbn Ethernet Product Module, Section 3.1, p.10]" .

ns1:AccessNetwork a owl:Class ;
    rdfs:label "AccessNetwork" ;
    rdfs:comment "An access network type that determines AVC type availability. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

ns1:BWProfile_5Mbps a ns1:BandwidthProfile,
        owl:NamedIndividual ;
    rdfs:label "TC-1 5 Mbps Bandwidth Profile" ;
    ns1:hasBandwidthUnit "Mbps"^^xsd:string ;
    ns1:hasBandwidthValue 5.0 ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 24, page 50" .

ns1:BWProfile_TC4_0Mbps a ns1:Cl_BandwidthProfile,
        owl:NamedIndividual ;
    rdfs:label "TC-4 0 Mbps Bandwidth Profile" ;
    ns1:forTrafficClass ns1:TC_4 ;
    ns1:hasBandwidthProfileValue "0 Mbps"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 26, page 52" .

ns1:BandwidthTier a owl:Class ;
    rdfs:label "BandwidthTier" ;
    rdfs:comment "A symmetrical bandwidth tier in Mbps (CIR) for an AVC TC-1 Product Component. [extension: nbn Ethernet Price List, Section 1.4, p.6]" .

ns1:BearerLimit a owl:Class ;
    rdfs:label "BearerLimit" ;
    rdfs:comment "The maximum number of Product Components, in aggregate, supported in an NNI Group. The Bearer Limit includes the total number of Unicast 1:1 AVCs, OVCs, and Unicast N:1 CVCs associated with an NNI Group. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.6, page 30]" .

ns1:BearerLimitCondition a owl:Class ;
    rdfs:label "BearerLimitCondition" ;
    rdfs:comment "A reified condition (bearer count, interface rate, redundancy mode) under which a Bearer Limit applies. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.6.1, page 30]" .

ns1:CSA_Example a ns1:CSA,
        owl:NamedIndividual ;
    rdfs:label "CSA Example" ;
    ns1:hasDescription "Connectivity Serving Area to which a CVC provides connectivity"^^xsd:string ;
    ns1:servedAt ns1:POI_Example ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26" .

ns1:Cl_Bearer a owl:Class ;
    rdfs:label "NNI Bearer" ;
    rdfs:comment "A physical interface of an NNI Group, landed on a line-card/port in a failure domain. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf ns1:Bearer .

ns1:Cl_CVCClass a owl:Class ;
    rdfs:label "CVC Class" ;
    rdfs:comment "The CVC Class attribute chosen by an RSP at the time of ordering a CVC for nbn Ethernet (Satellite), with values CVC Class-0 (Default), CVC Class-1 (Premium), and CVC Class-2 (Premium). [extension: nbn Ethernet Product Module, Table 8, page 38]" ;
    rdfs:subClassOf ns1:Cl_ServiceAttribute .

ns1:Cl_Charge a owl:Class ;
    rdfs:label "Charge",
        "Charge under Section 7" ;
    rdfs:comment "A charge for a Co-ordinated Appointment. [extension: WBA Ethernet Service Levels Schedule, p.13]",
        "A monetary amount calculated as (Pre Disconnection Modification Charges - Post Disconnection Modification Charges) x Shortfall Period, applicable under section 7. [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    rdfs:subClassOf ns1:Cl_EarlyDisconnectionModificationCharge .

ns1:Cl_ChargeFormula a owl:Class ;
    rdfs:label "Charge Formula" ;
    rdfs:comment "A reified representation of the formula: Charge = (Pre Disconnection Modification Charges - Post Disconnection Modification Charges) x Shortfall Period. [extension: nbn Ethernet Price List, Section 7(c), p.19]" .

ns1:Cl_NetworkContext a owl:Class ;
    rdfs:label "NetworkContext" ;
    rdfs:comment "A network element or variant that determines applicable specification type and capacity-sharing behavior. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

ns1:Cl_OrderedProduct a owl:Class ;
    rdfs:label "Cl_OrderedProduct" ;
    rdfs:comment "An nbn Ethernet Ordered Product (FTTB, FTTN, FTTC) that can be affected by interference events. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" ;
    rdfs:subClassOf ns1:AVC .

ns1:Cl_PowerOutage a owl:Class ;
    rdfs:label "Cl_PowerOutage",
        "Power Outage" ;
    rdfs:comment "A power outage event excluded from Network Availability measurement. [extension: WBA Ethernet Service Levels Schedule, p.32-33]",
        "An event in FTTB/FTTN networks where nbn may not be able to supply nbn Ethernet Ordered Products. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" ;
    rdfs:subClassOf ns1:Cl_ContractualEvent,
        ns1:Cl_ExclusionEvent .

ns1:Cl_ServiceManagementActivity a owl:Class ;
    rdfs:label "Service Management Activity" ;
    rdfs:comment "An event (fault report, cancellation, missed visit) related to nbn Ethernet (Satellite) that incurs a one-off charge per activity. [extension: nbn Ethernet Price List, Section (c), p.17]" .

ns1:Cl_ThroughputDimensioning a owl:Class ;
    rdfs:label "Throughput Dimensioning" ;
    rdfs:comment "The contractual obligation for nbn to dimension average busy hour throughput of Shared Network Resources at specified minimums per AVC TC-4. [extension: WBA Ethernet Service Levels Schedule, p.33]" .

ns1:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "An event that occurs at a point in time or over a duration. [extension: nbn Ethernet Price List, Section 6, p.18]" .

ns1:ProductComponentName a owl:Class ;
    rdfs:label "ProductComponentName" ;
    rdfs:comment "A named variant of a Product Component (e.g. 'Wireless Plus', 'Home Fast'). [extension: nbn Ethernet Price List, Section 1.1]" .

ns1:ServiceLevel a owl:Class ;
    rdfs:label "ServiceLevel" ;
    rdfs:comment "WBA availability and service levels (Network Availability, frame delay, frame loss). Not modelled." ;
    skos:altLabel "Network Availability",
        "Service Level",
        "frame delay",
        "frame loss" .

ns1:UNI_V_Instance a ns1:UNI_V,
        owl:NamedIndividual ;
    rdfs:label "UNI-V Instance" ;
    ns1:excludedFromTrafficClassPerformance ns1:PerfExclusion_UNI_V_Fibre ;
    ns1:hasDescription "User Network Interface - V"^^xsd:string ;
    rdfs:comment "An instance of a UNI-V. [extension: nbn Ethernet Product Module, Section 3.3(c), p.13]" .

ns1:AVC_TC1_ProductComponent a owl:Class ;
    rdfs:label "AVC_TC1_ProductComponent" ;
    rdfs:comment "An Access Virtual Circuit with Traffic Class 1, charged per Billing Period based on symmetrical Mbps (CIR) and network type. [extension: nbn Ethernet Price List, Section 1.4, p.6]" ;
    rdfs:subClassOf ns1:AVC,
        ns1:ProductComponent .

ns1:AVC_TC2_ProductComponent a owl:Class ;
    rdfs:label "AVC_TC2_ProductComponent" ;
    rdfs:comment "An Access Virtual Circuit with Traffic Class 2, associated with a CVC TC-2 Product Component. [extension: nbn Ethernet Price List, Section 1.5(c), p.8]" ;
    rdfs:subClassOf ns1:AVC,
        ns1:ProductComponent .

ns1:CVC_BandwidthProfile a owl:Class ;
    rdfs:label "CVC Bandwidth Profile" ;
    rdfs:comment "A bandwidth profile for a CVC, e.g. CVC Max CVC TC-4. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" .

ns1:Cl_Agent a owl:Class ;
    rdfs:label "Cl_Agent" ;
    rdfs:comment "A party that performs actions under the agreement. Superclass for RSP and nbn. [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

ns1:Cl_ConnectivityServingArea a owl:Class ;
    rdfs:label "Cl_ConnectivityServingArea" ;
    rdfs:comment "A geographic area that contains FSAs (fixed-line), WSAs (wireless), or Beams (satellite) and is served by exactly one POI. [extension: nbn Ethernet Product Module, Section 12.1, p.26]" ;
    rdfs:subClassOf ns1:PlanningResource .

ns1:Cl_InterferenceEvent a owl:Class ;
    rdfs:label "Cl_InterferenceEvent" ;
    rdfs:comment "An event caused by a third party's equipment or network that prejudices the integrity or causes deterioration of an nbn Ethernet (FTTB/FTTN/FTTC) Ordered Product. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" ;
    rdfs:subClassOf ns1:Cl_ContractualEvent .

ns1:Cl_ProductFeature a owl:Class ;
    rdfs:label "Cl_ProductFeature" ;
    rdfs:comment "An optional product feature that can be added to an nbn Ethernet product. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" .

ns1:ServiceOption a owl:Class ;
    rdfs:label "ServiceOption" ;
    rdfs:comment "An enumeration of Enhanced Fault Rectification Service options. [extension: nbn Ethernet Price List, Section 2.2, p.9]" .

ns1:BasicOfferCondition a owl:Class ;
    rdfs:label "BasicOfferCondition" ;
    rdfs:comment "A condition that, when satisfied, triggers the Basic Offer charge for a 12/1 Mbps AVC TC-4 on a given day. [extension: nbn Ethernet Price List, Note 4, p.5]" .

ns1:CVC_Example a ns1:CVC,
        owl:NamedIndividual ;
    rdfs:label "CVC Example" ;
    ns1:carries ns1:CSA_Example ;
    ns1:coExistsOnNNI ns1:CVC_CoExistence_Example ;
    ns1:consumes ns1:TC_4 ;
    ns1:deliversAVC ns1:CVC_DeliversAVC_Example ;
    ns1:describedInSection ns1:DocumentSection_5 ;
    ns1:dimensionedWithBandwidth "specific configured amount of bandwidth capacity"^^xsd:string ;
    ns1:hasDescription "Connectivity Virtual Circuit - an Ethernet virtual circuit that provides connectivity from an NNI to a CSA"^^xsd:string ;
    ns1:hasScalability ns1:CVC_Scalability_Example ;
    ns1:hasVariant ns1:CVC_1_1_VLAN_Example,
        ns1:CVC_N_1_VLAN_Example ;
    ns1:isolatedVia ns1:CVC_Isolation_Example ;
    ns1:mapsTo ns1:NNIGroup_Example ;
    ns1:providesConnectivity ns1:CVC_Connectivity_Example ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26" .

ns1:Cl_FrameBurstEvent a owl:Class ;
    rdfs:label "FrameBurstEvent" ;
    rdfs:comment "A reified event describing an AVC peak burst in excess of a maximum number of consecutive Ethernet frames that may cause increased Frame Loss in the downstream. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33]" .

ns1:OrderedProduct a owl:Class ;
    rdfs:label "OrderedProduct" ;
    rdfs:comment "A product ordered by an RSP. [extension: nbn Ethernet Price List, Section 1.4, p.6]" .

ns1:UNI_D a ns1:UNI_Type,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "UNI-D",
        "UNI_D" ;
    rdfs:comment "UNI-D (User Network Interface - Data) entity, a type of AVC. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 8.1.2.2]",
        "User Network Interface - D (dedicated). [extension: nbn Ethernet Product Module, Section 3.3(c), p.13]",
        "User Network Interface Type D. [extension: nbn Ethernet Price List, Section 1.3, p.6]" ;
    rdfs:subClassOf ns1:AVC,
        ns1:UNI .

ns1:Cl_AreaType a owl:Class ;
    rdfs:label "Area Type",
        "Cl_AreaType" ;
    rdfs:comment "A classification of geographic area that determines the charge for certain service management activities. [extension: nbn Ethernet Price List, Section (c), p.17]",
        "An enumeration of area types that may affect service availability (e.g. Isolated Area, Limited Access Area). [extension: nbn Ethernet Product Module, Section 5(f), p.20]" .

ns1:Cl_PerformanceExclusion a owl:Class ;
    rdfs:label "PerformanceExclusion" ;
    rdfs:comment "A reified relationship representing that the performance of traffic class operations does not apply to a service or product under a specific condition. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 33]" .

ns1:Cl_UsageTierCharge a owl:Class ;
    rdfs:label "Usage Tier Charge" ;
    rdfs:comment "A reified relationship linking an Ordered CVC Class, a usage range, and a charge per each associated AVC TC-4. [extension: nbn Ethernet Price List, Section 6(a), p.17]" .

ns1:PlanningResource a owl:Class ;
    rdfs:label "PlanningResource" ;
    rdfs:comment "Run-scoped planning inventory object (not a new physical asset). Superclass of POI, CSA, NNIGroup, CVC, PlanningLineCard, PlanningPort." .

ns1:ProductComponent a owl:Class ;
    rdfs:label "ProductComponent" ;
    rdfs:comment "WBA Product Component; counts toward an NNI Group's Bearer Limit. Not modelled in the simulator." ;
    skos:altLabel "Bearer Limit",
        "Product Component" .

ns1:RedundancyMode_DIVERSE_CHASSIS a ns1:RedundancyMode,
        owl:NamedIndividual ;
    rdfs:label "DIVERSE_CHASSIS" ;
    rdfs:comment "Diverse chassis redundancy mode: each NNI Bearer in the NNI Group will be connected across a pair of chassis. [extension: nbn Ethernet Product Module, Section 1.3(e), p.7]" .

ns1:Cl_AvcTc4OrderedProductComponent a owl:Class ;
    rdfs:label "AVC TC-4 Ordered Product Component" ;
    rdfs:comment "An AVC product component with TC-4 traffic class that has been ordered by an RSP, subject to PIR Objective rebate provisions. Includes nbn Ethernet (FTTB), nbn Ethernet (FTTN) or nbn Ethernet (FTTC) AVC TC-4 Ordered Product Components. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" .

ns1:Cl_NNIGroupInterfaceRate a owl:Class ;
    rdfs:label "NNI Group Interface Rate" ;
    rdfs:comment "The group interface rate that determines the interface rate of each NNI Bearer within the NNI Group. Available rates: 1Gbps, 10Gbps, 100Gbps (100Gbps not available for nbn Ethernet (Satellite)). [extension: nbn Ethernet Product Module, section 8.3.1.2, page 40]" ;
    rdfs:subClassOf ns1:ServiceAttributes .

ns1:Cl_PerformanceObjective a owl:Class ;
    rdfs:label "Performance Objective" ;
    rdfs:comment "A target percentage of activations completed within the relevant Service Level, measured monthly. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

ns1:RedundancyMode_SINGLE_CHASSIS a ns1:RedundancyMode,
        owl:NamedIndividual ;
    rdfs:label "SINGLE_CHASSIS" ;
    rdfs:comment "Single chassis redundancy mode: each NNI Bearer in the NNI Group will be connected to the same chassis; the NNI will operate as a single, unprotected interface. [extension: nbn Ethernet Product Module, Section 1.3(d), p.7]" .

ns1:UNI a owl:Class ;
    rdfs:label "UNI" ;
    rdfs:comment "User Network Interface: the physical or logical interface at a Premises that an AVC connects to. [extension: nbn Ethernet Product Module, Section 3.1(a), p.10]" .

ns1:Unicast_N_1_AVC_Instance a ns1:Unicast_N_1_AVC,
        owl:NamedIndividual ;
    rdfs:label "Unicast N:1 AVC Instance" ;
    ns1:availableOn ns1:Avail_N_1_UNI_V_Fibre ;
    ns1:availableOnlyToSupport ns1:AvailabilityConstraint_UnicastN1 ;
    ns1:describedInSection ns1:DocumentSection_4_1,
        ns1:DocumentSection_4_1_3_2 ;
    ns1:hasBandwidthProfile ns1:BWProfile_Unicast_N_1 ;
    ns1:hasDescription "Unicast N:1 AVC - available only to support the UNI-V and AVC TC-1 bundle"^^xsd:string,
        "Unicast N:1 AVC - required for unicast data applications using the UNI-V"^^xsd:string ;
    ns1:requiredFor ns1:ReqFor_N_1_AVC_UNI_V ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24",
        "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26" .

ns1:ActionType a owl:Class ;
    rdfs:label "ActionType" ;
    rdfs:comment "Planning action types (legacy fixture action generation)." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns1:ActionType_INCREASE_CVC_BW ns1:ActionType_ADD_PORT ns1:ActionType_MOVE_CSA_LOAD ns1:ActionType_REBALANCE_AVCS ns1:ActionType_SPLIT_CAPACITY_POOL ns1:ActionType_CREATE_NEW_NNI ns1:ActionType_CREATE_NEW_CVC ns1:ActionType_UPGRADE_PORT ns1:ActionType_ADD_BACKHAUL ns1:ActionType_ADD_AGGREGATION ns1:ActionType_CREATE_RESILIENCE_PATH ns1:ActionType_CREATE_NEW_BEARER ) ],
        [ a owl:Class ;
            owl:oneOf ( ns1:ActionType_INCREASE_CVC_BW ns1:ActionType_ADD_PORT ns1:ActionType_MOVE_CSA_LOAD ns1:ActionType_REBALANCE_AVCS ns1:ActionType_SPLIT_CAPACITY_POOL ns1:ActionType_CREATE_NEW_NNI ns1:ActionType_CREATE_NEW_CVC ns1:ActionType_UPGRADE_PORT ns1:ActionType_ADD_BACKHAUL ns1:ActionType_ADD_AGGREGATION ns1:ActionType_CREATE_RESILIENCE_PATH ns1:ActionType_CREATE_NEW_BEARER ) ],
        [ a owl:Class ;
            owl:oneOf ( ns1:ActionType_INCREASE_CVC_BW ns1:ActionType_ADD_PORT ns1:ActionType_MOVE_CSA_LOAD ns1:ActionType_REBALANCE_AVCS ns1:ActionType_SPLIT_CAPACITY_POOL ns1:ActionType_CREATE_NEW_NNI ns1:ActionType_CREATE_NEW_CVC ns1:ActionType_UPGRADE_PORT ns1:ActionType_ADD_BACKHAUL ns1:ActionType_ADD_AGGREGATION ns1:ActionType_CREATE_RESILIENCE_PATH ns1:ActionType_CREATE_NEW_BEARER ) ],
        [ a owl:Class ;
            owl:oneOf ( ns1:ActionType_INCREASE_CVC_BW ns1:ActionType_ADD_PORT ns1:ActionType_MOVE_CSA_LOAD ns1:ActionType_REBALANCE_AVCS ns1:ActionType_SPLIT_CAPACITY_POOL ns1:ActionType_CREATE_NEW_NNI ns1:ActionType_CREATE_NEW_CVC ns1:ActionType_UPGRADE_PORT ns1:ActionType_ADD_BACKHAUL ns1:ActionType_ADD_AGGREGATION ns1:ActionType_CREATE_RESILIENCE_PATH ns1:ActionType_CREATE_NEW_BEARER ) ] .

ns1:Cl_MinimumAvcRequirement a owl:Class ;
    rdfs:label "Cl_MinimumAvcRequirement" ;
    rdfs:comment "A reified rule specifying the minimum number of AVCs that must be associated with a CVC TC-4, conditional on CVC Class and bandwidth profile tier. [extension: nbn Ethernet Product Module, Section 2.2(e), p.8]" .

ns1:NNIBearerProductComponent a owl:Class ;
    rdfs:label "NNIBearerProductComponent" ;
    rdfs:comment "A physical interface of an NNI Group, with a profile and a recurring charge per Billing Period. [extension: nbn Ethernet Price List, Section 1.6, p.8]" ;
    rdfs:subClassOf ns1:ProductComponent .

ns1:AVC_AvailableOn a owl:Class ;
    rdfs:label "AVC Available On" ;
    rdfs:comment "Reified relationship representing that an AVC type is available on a specific UNI type qualified by access network. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

ns1:ControlProtocol_DHCPv4 a ns1:ControlProtocol,
        owl:NamedIndividual ;
    rdfs:label "DHCPv4" ;
    ns1:hasDescription "Dynamic Host Configuration Protocol version 4"^^xsd:string .

ns1:ControlProtocol_DHCPv6 a ns1:ControlProtocol,
        owl:NamedIndividual ;
    rdfs:label "DHCPv6" ;
    ns1:hasDescription "Dynamic Host Configuration Protocol version 6"^^xsd:string .

ns1:ControlProtocol_PPPoE a ns1:ControlProtocol,
        owl:NamedIndividual ;
    rdfs:label "PPPoE" ;
    ns1:hasDescription "Point-to-Point Protocol over Ethernet"^^xsd:string .

ns1:RSP_Generic a ns1:RSP,
        owl:NamedIndividual ;
    rdfs:label "RSP" ;
    ns1:hasContentionManagement ns1:CVC_ContentionManagement_Example ;
    ns1:hasDescription "Retail Service Provider"^^xsd:string .

ns1:S_C_VID a owl:Class ;
    rdfs:label "S/C-VID" ;
    rdfs:comment "Distinct Service and Customer VLAN Identifiers used to logically isolate AVCs from each other. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

ns1:CVCClass_2 a ns1:CVCClass,
        ns1:Cl_CVCClass,
        owl:NamedIndividual ;
    rdfs:label "CVC Class 2",
        "CVC Class-2 (Premium)" ;
    ns1:isPremium true ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 8, page 38" ;
    rdfs:comment "CVC Class 2 for CVC TC-4 Product Components of nbn Ethernet (Satellite). [extension: nbn Ethernet Price List, Section 2.3, p.10]" .

ns1:Cl_ActivityCharge a owl:Class ;
    rdfs:label "Activity Charge" ;
    rdfs:comment "A reified relationship linking a service management activity, area type, monetary amount, and optional incidentals. [extension: nbn Ethernet Price List, Section (c), p.17]" .

ns1:POI a owl:Class ;
    rdfs:label "POI" ;
    rdfs:comment "Point of Interconnect: where CSAs and NNI Groups meet the wholesale network. One per region, hosted on aggregation devices." ;
    rdfs:subClassOf ns1:PlanningResource ;
    skos:altLabel "Local POI",
        "POI",
        "Point of Interconnect",
        "State Aggregation POI" .

ns1:TC_2 a ns1:TrafficClass,
        owl:NamedIndividual ;
    rdfs:label "TC-2" ;
    ns1:name "Interactive" ;
    ns1:planningThresholdPct 75.0 .

ns1:V_NNI a owl:Class ;
    rdfs:label "V-NNI" ;
    rdfs:comment "A virtual NNI that supports the association of a single NNI Link and inherits characteristics from the NNI Group from which the NNI Link was created. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.4, page 30]" .

ns1:nbn a ns1:Cl_Agent,
        ns1:Supplier,
        owl:NamedIndividual ;
    rdfs:label "nbn" ;
    ns1:supplies ns1:NNI_Bearer_1000BaseEX,
        ns1:NNI_Bearer_1000BaseLX,
        ns1:NNI_Bearer_100GBaseER4,
        ns1:NNI_Bearer_100GBaseLR4,
        ns1:NNI_Bearer_10GBaseER,
        ns1:NNI_Bearer_10GBaseER_Reduced,
        ns1:NNI_Bearer_10GBaseLR,
        ns1:NNI_Bearer_10GBaseLR_Reduced ;
    rdfs:comment "The wholesale network provider (nbn co). [extension: nbn Ethernet Product Module, Section 1-2, p.7]",
        "nbn co, the supplier of NNI Bearer Product Components. [extension: nbn Ethernet Price List, Section 1.6(c), p.8]" .

ns1:CVCClass_1 a ns1:CVCClass,
        ns1:Cl_CVCClass,
        owl:NamedIndividual ;
    rdfs:label "CVC Class 1",
        "CVC Class-1 (Premium)" ;
    ns1:isPremium true ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 8, page 38" ;
    rdfs:comment "CVC Class 1 for CVC TC-4 Product Components of nbn Ethernet (Satellite). [extension: nbn Ethernet Price List, Section 2.3, p.10]" .

ns1:Cl_AVC_TC4_BandwidthProfile a owl:Class ;
    rdfs:label "AVC TC-4 Bandwidth Profile (Table 28)" ;
    rdfs:comment "A Unicast 1:1 AVC bandwidth profile as set out in Table 28, specifying downstream/upstream AVC_TC-4 capacities, AVC_TC-2 and AVC_TC-1 capacities, UNI interface, availability by access technology, and default-mapped traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:subClassOf ns1:Cl_BandwidthProfile .

ns1:EnhancedFaultRectificationService a owl:Class ;
    rdfs:label "EnhancedFaultRectificationService" ;
    rdfs:comment "An optional product feature that provides enhanced fault rectification for nbn Ethernet (Fibre). [extension: nbn Ethernet Product Module, Section 5, p.20]",
        "An optional service with multiple options (Enhanced-12, Enhanced-8, etc.) that has a recurring charge per Billing Period, dependent on the option and nbn Network type. [extension: nbn Ethernet Price List, Section 2.2, p.9]" ;
    rdfs:subClassOf ns1:Cl_ProductFeature,
        ns1:ProductComponent .

ns1:Premises a owl:Class ;
    rdfs:label "Premises" ;
    rdfs:comment "A location to which nbn Ethernet is supplied and served by a UNI. [extension: nbn Ethernet Product Module, Section 3.1(a), p.10]" .

ns1:RSP_AgentRole a ns1:Cl_Agent,
        owl:NamedIndividual ;
    rdfs:label "RSP (agent role)" ;
    rdfs:comment "RSP acting as agent in contractual events. [extension: nbn Ethernet Product Module, Section 1.3(d), p.7]" .

ns1:ServiceAttributes a owl:Class ;
    rdfs:label "ServiceAttributes" ;
    rdfs:comment "Service attributes of access components. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 8.1.2]" .

ns1:CVCClass_0 a ns1:CVCClass,
        ns1:Cl_CVCClass,
        owl:NamedIndividual ;
    rdfs:label "CVC Class 0",
        "CVC Class-0 (Default)" ;
    ns1:isDefault true ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 8, page 38" ;
    rdfs:comment "CVC Class 0 for CVC TC-4 Product Components of nbn Ethernet (Satellite). [extension: nbn Ethernet Price List, Section 2.3, p.10]" .

ns1:DownstreamPIR a owl:Class ;
    rdfs:label "DownstreamPIR" ;
    rdfs:comment "The downstream Peak Information Rate (Mbps) for an AVC TC-4 Product Component. [extension: nbn Ethernet Price List, Section 1.1]" .

ns1:NNI a owl:Class ;
    rdfs:label "NNI" ;
    rdfs:comment "A single NNI within an NNI Group, realised on one Bearer." .

ns1:NNILink a owl:Class ;
    rdfs:label "NNILink" ;
    rdfs:comment "WBA NNI Link / V-NNI / S-TAG concepts. Not modelled." ;
    skos:altLabel "NNI Link",
        "S-TAG",
        "V-NNI",
        "over-book" .

ns1:UNI_DSL_Instance a ns1:UNI_DSL,
        owl:NamedIndividual ;
    rdfs:label "UNI-DSL Instance" ;
    ns1:hasDescription "User Network Interface - DSL"^^xsd:string ;
    rdfs:comment "An instance of a UNI-DSL. [extension: nbn Ethernet Product Module, Section 4.4, p.17]" .

ns1:BandwidthProfile a owl:Class ;
    rdfs:label "Bandwidth Profile",
        "BandwidthProfile" ;
    rdfs:comment "A bandwidth profile for an AVC TC-2, defined by CIR values. [extension: nbn Ethernet Price List, Section 7(b)(ii)(B)(2), p.18]",
        "A bandwidth profile reserved from an NNI Group that can be assigned to a V-NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.3, page 30]",
        "A bandwidth profile through which an AVC is designed to be scaled in capacity. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

ns1:UpstreamPIR a owl:Class ;
    rdfs:label "UpstreamPIR" ;
    rdfs:comment "The upstream Peak Information Rate (Mbps) for an AVC TC-4 Product Component. [extension: nbn Ethernet Price List, Section 1.1]" .

ns1:AccessLoopCharacterisationAvailability a owl:Class ;
    rdfs:label "AccessLoopCharacterisationAvailability" ;
    rdfs:comment "Reified relationship for the availability of Access Loop Characterisation on an access technology qualified by control protocol. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 25]" .

ns1:AccessLoopCharacterisation_Feature a ns1:AccessLoopCharacterisation,
        owl:NamedIndividual ;
    rdfs:label "Access Loop Characterisation" ;
    ns1:dependsOn ns1:AccessLoopIdentification_Feature ;
    ns1:hasDescription "Access Loop Characterisation - identifying actual data rate Upstream and actual data rate Downstream"^^xsd:string ;
    ns1:identifies ns1:ActualDataRate_Downstream,
        ns1:ActualDataRate_Upstream ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 25" ;
    ns1:specifiedIn ns1:NetworkInterfaceSpecification_AVC_Doc .

ns1:AccessLoopIdentificationAvailability a owl:Class ;
    rdfs:label "AccessLoopIdentificationAvailability" ;
    rdfs:comment "Reified relationship for the availability of Access Loop Identification on an access technology qualified by control protocol. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 25]" .

ns1:AccessTechnology a owl:Class ;
    rdfs:label "AccessTechnology" ;
    rdfs:comment "Access technology of a CSA (csas.tech; a CSA may have several, separated by '|')." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns1:AccessTechnology_FIBRE ns1:AccessTechnology_FTTC ns1:AccessTechnology_HFC ns1:AccessTechnology_FTTB ns1:AccessTechnology_FTTN ns1:AccessTechnology_Wireless ns1:AccessTechnology_Satellite ) ],
        [ a owl:Class ;
            owl:oneOf ( ns1:AccessTechnology_FIBRE ns1:AccessTechnology_FTTC ns1:AccessTechnology_HFC ) ],
        [ a owl:Class ;
            owl:oneOf ( ns1:AccessTechnology_FIBRE ns1:AccessTechnology_FTTC ns1:AccessTechnology_HFC ns1:AccessTechnology_SATELLITE ns1:AccessTechnology_FTTB ns1:AccessTechnology_FTTN ns1:AccessTechnology_Wireless ) ],
        [ a owl:Class ;
            owl:oneOf ( ns1:AccessTechnology_FIBRE ns1:AccessTechnology_FTTC ns1:AccessTechnology_HFC ) ],
        [ a owl:Class ;
            owl:oneOf ( ns1:AccessTechnology_FIBRE ns1:AccessTechnology_FTTC ns1:AccessTechnology_FTTB ns1:AccessTechnology_FTTN ) ],
        [ a owl:Class ;
            owl:oneOf ( ns1:AccessTechnology_FIBRE ns1:AccessTechnology_FTTC ns1:AccessTechnology_HFC ns1:AccessTechnology_FTTB ns1:AccessTechnology_FTTN ns1:AccessTechnology_Wireless ) ] .

ns1:CandidateAction a owl:Class ;
    rdfs:label "CandidateAction" ;
    rdfs:comment "Candidate planning action with lead time, cost, feasibility, blocking reasons and scores." ;
    skos:altLabel "Modify",
        "NNI Diversity Upgrade",
        "NNI Upsize Migration",
        "charge",
        "lead time",
        "order",
        "price" .

ns1:nbnEthernetProduct a owl:Class ;
    rdfs:label "nbnEthernetProduct" ;
    rdfs:comment "A specific nbn Ethernet Ordered Product variant (FTTB, FTTN, FTTC). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 33]",
        "An nbn Ethernet product variant distinguished by access technology (Satellite, Fibre, FTTB, etc.). [extension: nbn Ethernet Product Module, Section 1.1(f), p.6]" .

ns1:AccessLoopIdentification_Feature a ns1:AccessLoopIdentification,
        owl:NamedIndividual ;
    rdfs:label "Access Loop Identification" ;
    ns1:hasDescription "Access Loop Identification - identifying the access loop by inserting identification into upstream Layer 3 control packets"^^xsd:string ;
    ns1:identifies ns1:AccessLoop_Identified ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 25" ;
    ns1:specifiedIn ns1:NetworkInterfaceSpecification_AVC_Doc .

ns1:Cl_AVC_TC4_ProfileAvailability a owl:Class ;
    rdfs:label "AVC TC-4 Profile Availability" ;
    rdfs:comment "A reified state indicating the availability of a Unicast 1:1 AVC bandwidth profile by access technology (F=Fibre, H=HFC, W=Wireless, S=Satellite). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" .

ns1:Cl_NNIGroup a owl:Class ;
    rdfs:label "NNI Group" ;
    rdfs:comment "A group of NNI Bearers at a POI sharing a redundancy mode, interface rate, and protected capacity. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf ns1:NNIGroup .

ns1:Cl_State a owl:Class ;
    rdfs:label "State" ;
    rdfs:comment "A state or condition of a product component. [extension: nbn Ethernet Product Module, page 38]" .

ns1:RSP a owl:Class ;
    rdfs:label "RSP" ;
    rdfs:comment "Retail Service Provider role. [extension: nbn Ethernet Price List, Section 1.4, p.6]",
        "Retail Service Provider that orders and connects to the nbn Network via NNI. [extension: nbn Ethernet Product Module, Section 1, p.6]",
        "Retail Service Provider who may order optional features for AVCs. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" ;
    rdfs:subClassOf ns1:Cl_Agent .

ns1:FlatRateAVCCharge a owl:Class ;
    rdfs:label "FlatRateAVCCharge" ;
    ns1:conditionDescription "No additional recurring CVC TC-4 charges apply in connection with any Flat Rate AVC TC-4 Product Components." ;
    ns1:sourceClause "nbn Ethernet Price List, Note 1, p.5" ;
    rdfs:comment "A specific type of Recurring Charge that applies per Billing Period for AVC TC-4 Product Components and associated CVC TC-4 capacity. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:subClassOf ns1:RecurringCharge .

ns1:Unicast_1_1_AVC_Instance a ns1:Unicast_1_1_AVC,
        owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC Instance" ;
    ns1:availableOn ns1:Avail_1_1_UNI_DSL_FTTB,
        ns1:Avail_1_1_UNI_DSL_FTTN,
        ns1:Avail_1_1_UNI_D_FTTB,
        ns1:Avail_1_1_UNI_D_FTTC,
        ns1:Avail_1_1_UNI_D_FTTN,
        ns1:Avail_1_1_UNI_D_Fibre,
        ns1:Avail_1_1_UNI_D_HFC,
        ns1:Avail_1_1_UNI_D_Satellite,
        ns1:Avail_1_1_UNI_D_Wireless ;
    ns1:describedInSection ns1:DocumentSection_4_1 ;
    ns1:hasDescription "Unicast 1:1 AVC - required for unicast data applications using the UNI-D or UNI-DSL"^^xsd:string ;
    ns1:logicallyIsolatedBy ns1:LogicalIsolation_Example ;
    ns1:mayCauseIncreasedFrameLoss ns1:FrameBurstEvent_TC4 ;
    ns1:requiredFor ns1:ReqFor_1_1_AVC_UNI_D,
        ns1:ReqFor_1_1_AVC_UNI_DSL ;
    ns1:scaledThrough ns1:ScaledThrough_Example ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24" .

ns1:DataTransferRate a owl:Class ;
    rdfs:label "DataTransferRate" ;
    rdfs:comment "A reified data transfer rate value with unit (Mbps) for an AVC traffic class. [extension: nbn Ethernet Product Module, Section 3.3(b), p.13]" .

ns1:Bearer a owl:Class ;
    rdfs:label "Bearer" ;
    rdfs:comment "NNI Bearer: one physical interface of an NNI Group, landed on a line-card/port in a failure domain." ;
    skos:altLabel "Diverse Chassis",
        "NNI Bearer",
        "Redundancy Mode",
        "Single Chassis",
        "interface rate" .

ns1:CSA a owl:Class ;
    rdfs:label "CSA" ;
    rdfs:comment "Connectivity Serving Area: a served area with services, premises and demand growth." ;
    rdfs:subClassOf ns1:PlanningResource ;
    skos:altLabel "CSA",
        "Connectivity Serving Area" .

ns1:TrafficClass a owl:Class ;
    rdfs:label "TrafficClass" ;
    rdfs:comment "Traffic class (TC-1, TC-2, TC-4) with a planning utilisation threshold." ;
    skos:altLabel "TC-1",
        "TC-2",
        "TC-4",
        "bandwidth profile",
        "traffic class" .

ns1:Cl_Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "An event that changes a product state or causes a consequence. [extension: nbn Ethernet Product Module, page 38]" .

ns1:AVC_TC4_ProductComponent a owl:Class ;
    rdfs:label "AVC_TC4_ProductComponent" ;
    rdfs:comment "A specific type of Product Component that is an AVC with Traffic Class 4, which can be ordered and charged separately. [extension: nbn Ethernet Price List, Section 1.1]" ;
