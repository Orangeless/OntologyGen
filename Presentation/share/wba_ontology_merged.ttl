    rdfs:domain ns1:Cl_OrderedProduct ;
    rdfs:range ns1:Cl_InterferenceEvent .

ns1:isAssociatedWith a owl:ObjectProperty ;
    rdfs:label "isAssociatedWith" ;
    rdfs:comment "Links a Satellite Test Service component to the UNI it is associated with. [extension: nbn Ethernet Product Module, Section 7(b), p.20]",
        "Links an NNI Link to the NNI Group it is intended to be associated with. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 13, page 43]" ;
    rdfs:domain ns1:NNILink,
        owl:Thing ;
    rdfs:range ns1:NNIGroup,
        ns1:UNI .

ns1:isAssociatedWithVNNI a owl:ObjectProperty ;
    rdfs:label "isAssociatedWithVNNI" ;
    rdfs:comment "Inverse of associatedWithUpstreamNNILink; links an Upstream NNI Link to the V-NNI it is associated with. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:domain ns1:UpstreamNNILink ;
    rdfs:range ns1:V_NNI .

ns1:isAtDiscretionOf a owl:ObjectProperty ;
    rdfs:label "isAtDiscretionOf" ;
    rdfs:comment "Links a service or action to the party at whose discretion it is supplied or performed. [extension: nbn Ethernet Product Module, Section 7, p.20]" ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:Cl_Agent .

ns1:isAtMDUSite a owl:DatatypeProperty ;
    rdfs:label "isAtMDUSite" ;
    rdfs:comment "Indicates if a Premises is at an MDU Site. [extension: nbn Ethernet Product Module, Section 4.6(b), p.19]" ;
    rdfs:domain ns1:Premises ;
    rdfs:range xsd:boolean .

ns1:isAtOrNearMaxCapacity a owl:DatatypeProperty ;
    rdfs:label "isAtOrNearMaxCapacity" ;
    rdfs:comment "Indicates if a Beam is at or near maximum capacity. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" ;
    rdfs:domain ns1:Cl_Beam ;
    rdfs:range xsd:boolean .

ns1:isAutomaticallyRemovedAfter a owl:DatatypeProperty ;
    rdfs:label "isAutomaticallyRemovedAfter" ;
