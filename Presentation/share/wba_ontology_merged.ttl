        ns1:BandwidthProfile_25_5_10,
        ns1:BandwidthProfile_HomeFast ;
    ns1:hasMinimumThroughputKbps 350 ;
    ns1:isDimensionedOn ns1:SharedNetworkResourceFttbFttn ;
