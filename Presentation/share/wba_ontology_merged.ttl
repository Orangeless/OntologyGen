ns1:Cl_LabourRate a owl:Class ;
    rdfs:label "Labour Rate" ;
    rdfs:comment "$75.00 for each of the total number of labour hours required to perform the relevant activity (rounded up to the next full hour). [extension: nbn Ethernet Price List, Section 8(a), p.19]" ;
    rdfs:subClassOf ns1:MonetaryAmount .

ns1:Cl_MACForwardingMode a owl:Class ;
