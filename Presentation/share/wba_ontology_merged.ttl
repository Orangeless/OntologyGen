ns1:Cl_NetworkAvailabilityPerformanceObjective a owl:Class ;
    rdfs:label "Network Availability Performance Objective" ;
    rdfs:comment "The Performance Objective for Network Availability, based on modelling using a set of assumptions regarding future network performance and may be modified by nbn following analysis of empirical Network Availability performance data gathered over time. [extension: WBA Ethernet Service Levels Schedule, p.33]" ;
    rdfs:subClassOf ns1:Cl_PerformanceObjective .

ns1:Cl_NoFaultFoundNoTruckRoll a owl:Class ;
    rdfs:label "No Fault Found (No Truck Roll Required)" ;
    rdfs:comment "A service management activity where no fault is found and no truck roll is required. [extension: nbn Ethernet Price List, Section (c), p.17]" ;
    rdfs:subClassOf ns1:Cl_ServiceManagementActivity .

ns1:Cl_NoFaultFoundTruckRoll a owl:Class ;
    rdfs:label "No Fault Found (Truck Roll Required)" ;
    rdfs:comment "A service management activity where no fault is found but a truck roll is required. [extension: nbn Ethernet Price List, Section (c), p.17]" ;
    rdfs:subClassOf ns1:Cl_ServiceManagementActivity .

ns1:Cl_OrderAcknowledgement a owl:Class ;
