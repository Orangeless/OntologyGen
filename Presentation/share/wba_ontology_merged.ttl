ns1:hasInterfaceRate a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "hasInterfaceRate" ;
    rdfs:comment "Interface rate in Gbps of a Bearer or NNI Group. [extension: nbn Ethernet Product Module, Section 1.3(a), p.6]",
        "Links NNI Group to its interface rate attribute. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 8.3.1.2]",
        "The interface rate (Gbps) of a Bearer Limit Condition. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.6.1, page 30]" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Bearer ns1:NNIGroup ) ],
        [ a owl:Class ;
            owl:unionOf ( ns1:Bearer ns1:NNIGroup ) ],
        [ a owl:Class ;
            owl:unionOf ( ns1:Bearer ns1:NNIGroup ) ],
        ns1:BearerLimitCondition,
        ns1:NNIGroup ;
    rdfs:range ns1:Cl_NNIGroupInterfaceRate,
        xsd:decimal,
        xsd:double .

ns1:hasInterfaceRateDetermination a owl:ObjectProperty ;
    rdfs:label "hasInterfaceRateDetermination" ;
