    rdfs:domain ns1:NNIGroup ;
    rdfs:range ns1:Bearer .

ns1:hasParentSection a owl:ObjectProperty ;
    rdfs:label "hasParentSection" ;
    rdfs:comment "Links a document section to its parent section. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 8]" ;
    rdfs:domain ns1:DocumentSection ;
    rdfs:range ns1:DocumentSection .

ns1:hasPeakCapacityBenefit a owl:DatatypeProperty ;
