    rdfs:domain owl:Thing ;
    rdfs:range ns1:V-NNIRSP .

ns1:hasValidationDescription a owl:DatatypeProperty ;
    rdfs:label "hasValidationDescription" ;
    rdfs:comment "A textual description of the validation condition. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 33]" ;
    rdfs:domain ns1:Cl_ValidationCondition ;
    rdfs:range xsd:string .

ns1:hasValidityDuration a owl:DatatypeProperty ;
    rdfs:label "hasValidityDuration" ;
    rdfs:comment "The duration of validity for a service or feature. [extension: nbn Ethernet Product Module, Section 5(e), p.20]" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ns1:hasVariableThroughputTolerance a owl:DatatypeProperty ;
    rdfs:label "hasVariableThroughputTolerance" ;
