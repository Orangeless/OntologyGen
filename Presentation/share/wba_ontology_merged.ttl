    ns1:hasRelocationRequirement "In order to change the location of an NNI Group (i.e. re-locate NNI Bearers to a different location), it is necessary to purchase a new NNI Group in the intended location, and transition existing AVCs and CVCs from the previous NNI Group"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.1.1, page 40" ;
    ns1:transitionsAVCsAndCVCs ns1:CVC_Example,
        ns1:Unicast_1_1_AVC_Instance,
        ns1:Unicast_N_1_AVC_Instance .

