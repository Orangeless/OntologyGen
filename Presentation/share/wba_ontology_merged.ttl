    ns1:isLinkedToDownstreamV-NNI false ;
    ns1:isNotUsedByDownstreamV-NNI true ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43" .

ns1:NNILink_Orderable_Attributes a owl:NamedIndividual ;
    rdfs:label "NNI Link Orderable Attributes" ;
    ns1:hasDescription "A summary of attributes that must be specified for each NNI Link order: NNI Group, S-TAG pool, Bandwidth, V-NNI RSP."^^xsd:string ;
