    rdfs:comment "Fibre to the Building access technology. [extension: nbn Ethernet Price List, Section 1.1]",
        "Fibre to the Building access technology. [extension: nbn Ethernet Product Module, Section 1.2, p.6]" .

ns1:AccessTechnology_FIBRE a ns1:AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FIBRE" .

ns1:Cl_Availability a owl:Class ;
    rdfs:label "Availability" ;
    rdfs:comment "A reified state indicating whether a specific bandwidth profile is available on a given access technology and UNI type, often subject to a condition. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52]" .

