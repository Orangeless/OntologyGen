ns1:identifies a owl:ObjectProperty ;
    rdfs:label "identifies" ;
    rdfs:comment "Links a feature to what it identifies (e.g. access loop, actual data rate). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 25]" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

ns1:identifiesAVC a owl:ObjectProperty ;
    rdfs:label "identifiesAVC" ;
    rdfs:comment "Links an AccessLoopID_Identifies node to the AVC ID. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" ;
    rdfs:domain ns1:AccessLoopID_Identifies ;
    rdfs:range ns1:AVC_ID .

ns1:identifiesAVCID a owl:ObjectProperty ;
    rdfs:label "identifiesAVCID" ;
    rdfs:comment "Links Access Loop Identification to its AVC ID identification reification node. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" ;
    rdfs:domain ns1:AccessLoopIdentification ;
    rdfs:range ns1:AccessLoopID_Identifies .

ns1:impactOfAccessTechnology a owl:ObjectProperty ;
    rdfs:label "impactOfAccessTechnology" ;
    rdfs:comment "Links an access technology impact node to the access technology that has the impact. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33]" ;
    rdfs:domain ns1:Cl_AccessTechnologyImpact ;
    rdfs:range owl:Thing .

ns1:inAccordanceWith a owl:ObjectProperty ;
    rdfs:label "inAccordanceWith" ;
    rdfs:comment "Links an action to the document section that governs it. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.4, page 28]" ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:DocumentSection .

ns1:inEventOf a owl:ObjectProperty ;
    rdfs:label "inEventOf" ;
    rdfs:comment "Links a discarding action to the congestion event that triggers it. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.4, page 28]" ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:AVC_CVC_Contention .

ns1:inProtocol a owl:ObjectProperty ;
    rdfs:label "inProtocol" ;
    rdfs:comment "Links an AVCID_ConfiguredIn node to the protocol. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" ;
    rdfs:domain ns1:AVCID_ConfiguredIn ;
    rdfs:range ns1:Protocol .

ns1:inRegion a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Bearer ns1:CSA ns1:CVC ns1:NNIGroup ns1:POI ) ],
        [ a owl:Class ;
            owl:unionOf ( ns1:Bearer ns1:CSA ns1:CVC ns1:NNIGroup ns1:POI ) ],
        [ a owl:Class ;
            owl:unionOf ( ns1:Bearer ns1:CSA ns1:CVC ns1:NNIGroup ns1:POI ) ],
        [ a owl:Class ;
            owl:unionOf ( ns1:Bearer ns1:CSA ns1:CVC ns1:NNIGroup ns1:POI ) ] ;
    rdfs:range ns1:PlanningRegion .

ns1:inRelationToCSA a owl:ObjectProperty ;
    rdfs:label "inRelationToCSA" ;
    rdfs:comment "Links a purchase or access relationship to the relevant CSA. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28]" ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:CSA .

ns1:includedIn a owl:ObjectProperty ;
    rdfs:label "includedIn" ;
    rdfs:comment "Links a UNI Inclusion to the Recurring Charge it is included in. [extension: nbn Ethernet Price List, Section 1.3, p.6]",
        "Links an inclusion condition to the AVC whose data transfer rate is included. [extension: nbn Ethernet Product Module, Section 3.3(b), p.13]" ;
    rdfs:domain ns1:InclusionCondition,
        ns1:UNI_Inclusion ;
    rdfs:range ns1:AVC,
        ns1:RecurringCharge .

ns1:includes a owl:ObjectProperty ;
    rdfs:label "includes" ;
    rdfs:comment "An NNI includes a V-NNI when RSP has configured a V-NNI with an Upstream NNI Link. [extension: nbn Ethernet Product Module, Section 1.1(e), p.6]",
        "Links a Bearer Limit to the product components it includes (Unicast 1:1 AVCs, OVCs, Unicast N:1 CVCs). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.6, page 30]" ;
    rdfs:domain ns1:BearerLimit,
        ns1:NNI ;
    rdfs:range ns1:NNILink,
        owl:Thing .

ns1:includesAccessLoopID a owl:ObjectProperty ;
    rdfs:label "includesAccessLoopID" ;
    rdfs:comment "Links an RSP_OrdersAccessLoopID node to the Access Loop Identification feature. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" ;
    rdfs:domain ns1:RSP_OrdersAccessLoopID ;
    rdfs:range ns1:AccessLoopIdentification .

ns1:includesRateOf a owl:ObjectProperty ;
    rdfs:label "includesRateOf" ;
    rdfs:comment "Links an inclusion condition to the AVC that includes the data transfer rate. [extension: nbn Ethernet Product Module, Section 3.3(b), p.13]" ;
    rdfs:domain ns1:InclusionCondition ;
    rdfs:range ns1:AVC .

ns1:includesTrafficClassSpec a owl:ObjectProperty ;
    rdfs:label "includesTrafficClassSpec" ;
    rdfs:comment "Links a BandwidthProfile to a traffic class specification reification node. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain ns1:BandwidthProfile ;
    rdfs:range ns1:Cl_BandwidthProfileSpec .

ns1:incorporates a owl:ObjectProperty ;
    rdfs:label "incorporates" ;
    rdfs:comment "Links a product feature to a component it incorporates. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" ;
    rdfs:domain ns1:Cl_ProductFeature ;
    rdfs:range ns1:Cl_AnalogueTelephoneAdaptor .

ns1:increasedBy a owl:ObjectProperty ;
    rdfs:label "increased by" ;
    rdfs:comment "Links a rebate to the Weighted Average Price Change that increases its amount. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range ns1:Cl_WeightedAveragePriceChange .

ns1:indicatesPhysicalPort a owl:ObjectProperty ;
    rdfs:label "indicatesPhysicalPort" ;
    rdfs:comment "Links an nbn-supplied NNI Bearer identification to the physical port on the nbn ODF it indicates. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 12, page 42]" ;
    rdfs:domain ns1:nbn-suppliedNNIBearerIdentification ;
    rdfs:range ns1:PhysicalPort .

ns1:informationRateType a owl:DatatypeProperty ;
    rdfs:label "informationRateType" ;
    rdfs:comment "The type of Information Rate (e.g. 'Peak Information Rate (PIR)', 'potential maximum Information Rate'). [extension: nbn Ethernet Price List, Note 2, p.5]" ;
    rdfs:domain ns1:AVC_TC4_ProductComponent ;
    rdfs:range xsd:string .

ns1:inheritsFrom a owl:ObjectProperty ;
    rdfs:label "inheritsFrom" ;
    rdfs:comment "Links a V-NNI to the NNI Group from which it inherits the redundancy mode. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.4, page 30]" ;
    rdfs:domain ns1:V_NNI ;
    rdfs:range ns1:NNIGroup .

ns1:insertedInto a owl:ObjectProperty ;
    rdfs:label "insertedInto" ;
