ns1:TroubleTicketAcknowledgmentEvent a ns1:Cl_TroubleTicket,
        owl:NamedIndividual ;
    rdfs:label "Trouble Ticket Acknowledgment Event" ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, s5.3, p.15" .

ns1:UNIConfigurationAttributes a owl:Class ;
    rdfs:label "UNIConfigurationAttributes" ;
    rdfs:comment "UNI configuration attributes. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 8.1.1.1]" ;
    rdfs:subClassOf ns1:ConfigurationAttributes .

ns1:UNIV_AVCTC1_Bundle a ns1:Cl_ServiceBundle,
        owl:NamedIndividual ;
    rdfs:label "UNI-V and AVC TC-1 Bundle" ;
    ns1:isAcquiredInConjunctionWith ns1:AVCTC4_UNID_Bundle_Instance ;
    ns1:isAvailableFor ns1:nbnEthernet_Fibre ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 6, p.20" ;
    rdfs:comment "The UNI-V and AVC TC-1 bundle which is a feature of nbn Ethernet designed for voice services over nbn Ethernet. [extension: nbn Ethernet Product Module, Section 6, p.20]" .

ns1:UNIV_ContinuedOrderingPeriod a owl:NamedIndividual ;
    rdfs:label "UNI-V Continued Ordering Period" ;
    ns1:expiresOn "2024-05-26T00:00:00"^^xsd:dateTime ;
    rdfs:comment "The Continued Ordering Period for the UNI-V Product Feature, expiring on 26 May 2024. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

ns1:UNIV_ProductFeature a ns1:Cl_ProductFeature,
        owl:NamedIndividual ;
    rdfs:label "UNI-V Product Feature" ;
    ns1:incorporates ns1:AnalogueTelephoneAdaptor_Instance ;
    ns1:isOptionalProductFeatureOf ns1:nbnEthernet_Fibre ;
    rdfs:comment "The UNI-V is an optional Product Feature of nbn Ethernet (Fibre) and incorporates an analogue telephone adaptor for the supply of telephony services to a Premises. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" .

ns1:UNIV_ProductFeature_Instance a ns1:Cl_ProductFeature,
        owl:NamedIndividual ;
    rdfs:label "UNI-V Product Feature" ;
    ns1:isOptionalProductFeatureOf ns1:nbnEthernet_Fibre ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 6(a), p.20" ;
    rdfs:comment "The UNI-V is an optional Product Feature of nbn Ethernet (Fibre) which provides RSP with access to an analogue telephony interface on the NTD (where available) for the purpose of migrating legacy telephone services. [extension: nbn Ethernet Product Module, Section 6(a), p.20]" .

ns1:UNIV_StateTransition_OrderableToTransitionOut a ns1:Cl_StateTransition,
        owl:NamedIndividual ;
    rdfs:label "UNI-V: Orderable to Transition-out Only" ;
    ns1:hasGuard "after 26 May 2024" ;
    ns1:hasTrigger "expiry of Continued Ordering Period on 26 May 2024" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

ns1:UNIV_StateTransition_TransitionOutToWithdrawn a ns1:Cl_StateTransition,
        owl:NamedIndividual ;
    rdfs:label "UNI-V: Transition-out Only to Withdrawn" ;
    ns1:hasGuard "on 31 January 2031, unless disconnected earlier" ;
    ns1:hasTrigger "withdrawal date of 31 January 2031" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

ns1:UNIV_WithdrawalDate a owl:NamedIndividual ;
    rdfs:label "UNI-V Withdrawal Date" ;
    ns1:withdrawnOn "2031-01-31T00:00:00"^^xsd:dateTime ;
    rdfs:comment "The date on which the UNI-V Product Feature will be withdrawn: 31 January 2031. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

ns1:UNI_DSL_Availability_Rule a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "UNI-DSL Availability Rule" ;
    ns1:hasCondition "a Premises is served by the FTTB Network or FTTN Network" ;
    ns1:hasConsequence "the number of UNI-DSLs available depends on: (i) the number of distinct nbn Copper Pairs installed at the Premises which terminate at an accessible xDSL port; and (ii) the allocation and installation by nbn of a single xDSL port to each distinct nbn Copper Pair" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.4(a), p.17" .

ns1:UNI_D_Availability_Rule a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "UNI-D Availability Rule" ;
    ns1:hasCondition "a Premises is served by the Fibre Network, FTTC Network, HFC Network, Wireless Network or Satellite Network" ;
    ns1:hasConsequence "the number of UNI-Ds available depends on: (i) whether the Premises is located in the footprint of those networks; and (ii) the number and type of NTDs or FTTC-NCDs installed at that Premises" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.2(a), p.17" .

ns1:UNI_D_InterfaceType_Relation a owl:NamedIndividual ;
    rdfs:label "UNI-D has electrical interface" ;
    ns1:hasInterfaceType ns1:InterfaceType_Electrical ;
    rdfs:comment "Reified relationship: UNI-D has an electrical interface and will not be made available with an optical interface. [extension: nbn Ethernet Product Module, Section 4.2(b), p.17]" .

ns1:UNI_Inclusion_Instance a ns1:UNI_Inclusion,
        owl:NamedIndividual ;
    rdfs:label "UNI Inclusion per Section 1.3" ;
    ns1:conditionalOn ns1:AccessTechnology_FIBRE,
        ns1:AccessTechnology_FTTB,
        ns1:AccessTechnology_FTTC,
        ns1:AccessTechnology_FTTN,
        ns1:AccessTechnology_HFC,
        ns1:AccessTechnology_Wireless ;
    ns1:hasIncludedAVCTC1 ns1:AVC_TC1_ProdComp_0_15_AllNetworks ;
    ns1:hasUNI ns1:UNI_D,
        ns1:UNI_DSL,
        ns1:UNI_V ;
    ns1:sourceClause "nbn Ethernet Price List, Section 1.3, p.6" .

ns1:UNI_V_Availability_Rule a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "UNI-V Availability Rule" ;
    ns1:hasCondition "a Premises is served by the Fibre Network" ;
    ns1:hasConsequence "the number of UNI-Vs available depends on the number and version of NTDs which nbn has installed at that Premises" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.3(a), p.17" .

ns1:UNI_V_TC1_ProvisioningEvent a ns1:Cl_ProvisioningEvent,
        owl:NamedIndividual ;
    rdfs:label "UNI-V TC-1 Automatic Provisioning Event" ;
    ns1:hasDescription "Upon order of the UNI-V by RSP, the UNI-V is automatically provisioned by nbn with TC-1 capacity"^^xsd:string ;
    ns1:performedBy ns1:nbn_Entity ;
    ns1:provisionsOn ns1:UNI_V_Instance ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52, footnote 38" ;
    ns1:triggeredBy ns1:RSP_Generic .

ns1:Unicast_1_1_AVC_BWProfile_Avail_Note a owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC Bandwidth Profile Availability Note" ;
    ns1:hasDescription "Availability by access technology for each Unicast 1:1 AVC bandwidth profile combination is also set out in sections B.1 and B.2 to Appendix B"^^xsd:string ;
    ns1:setOutIn ns1:DocumentSection_AppendixB ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

ns1:Unicast_1_1_AVC_BandwidthProfile a ns1:Unicast_1_1_AVC,
        owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC Bandwidth Profile" ;
    ns1:describedIn ns1:nbnEthernetProductDescription_Doc ;
    ns1:describedInSection ns1:DocumentSection_4_1_3_1 ;
    ns1:hasBandwidthProfile ns1:Unicast_1_1_AVC_BWProfile_Instance ;
    ns1:hasDescription "A Unicast 1:1 AVC comprises a combination of mandatory (TC-4) and optional (TC-1 and/or TC-2) traffic classes as described in section 3.1 of the nbn Ethernet Product Description"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

ns1:Unicast_1_1_AVC_Comprises_TC1 a owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC comprises TC-1 (optional)" ;
    ns1:comprises ns1:TC_1 ;
    ns1:hasDescription "TC-1 is an optional traffic class in a Unicast 1:1 AVC"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

ns1:Unicast_1_1_AVC_Comprises_TC2 a owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC comprises TC-2 (optional)" ;
    ns1:comprises ns1:TC_2 ;
    ns1:hasDescription "TC-2 is an optional traffic class in a Unicast 1:1 AVC"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

ns1:Unicast_1_1_AVC_Comprises_TC4 a owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC comprises TC-4 (mandatory)" ;
    ns1:comprises ns1:TC_4 ;
    ns1:hasDescription "TC-4 is a mandatory traffic class in a Unicast 1:1 AVC"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

ns1:Unicast_1_1_AVC_ServiceAttributes_Table6 a ns1:UnicastAVC_ServiceAttributes,
        owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC Service Attributes (Table 6)" ;
    ns1:hasServiceAttribute ns1:Interface_Mode_1_1_AVC,
        ns1:TPEP_TCP_Opt_Satellite,
        ns1:TPEP_Web_Opt_Satellite ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 6, page 37" .

ns1:Unicast_1_1_AVC_TC4 a ns1:Unicast_1_1_AVC,
        owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC TC-4" ;
    ns1:hasBandwidthProfile ns1:BWProfile_TC4_0Mbps,
        ns1:BWProfile_TC4_100_40Mbps,
        ns1:BWProfile_TC4_12_1Mbps,
        ns1:BWProfile_TC4_25_100_5_40Mbps,
        ns1:BWProfile_TC4_25_10Mbps,
        ns1:BWProfile_TC4_25_50_5_20Mbps,
        ns1:BWProfile_TC4_25_5Mbps,
        ns1:BWProfile_TC4_25_5_10Mbps,
        ns1:BWProfile_TC4_50_100_20_40Mbps,
        ns1:BWProfile_TC4_50_20Mbps,
        ns1:BWProfile_TC4_FixedWirelessHomeFast,
        ns1:BWProfile_TC4_HomeFast,
        ns1:BWProfile_TC4_WirelessPlus ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52" .

ns1:Unicast_1_1_CVC_Order a ns1:Cl_Unicast11CVC,
        owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 CVC Order" ;
    ns1:mustSpecify ns1:CVC_TC1_CIR_Attribute,
        ns1:CVC_TC2_CIR_Attribute,
        ns1:CVC_TC4_CIR_Attribute,
        ns1:CVC_TC4_PIR_Attribute ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.2.1, page 39" .

ns1:Unicast_1_1_CVC_Order_Attributes a owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 CVC Order Attributes" ;
    ns1:hasDescription "Each unicast 1:1 CVC order must specify each of the service attributes listed in Table 9, in addition to those configuration attributes detailed in Table 8"^^xsd:string ;
    ns1:mustSpecify ns1:CVC_TC1_CIR_Attribute,
        ns1:CVC_TC2_CIR_Attribute,
        ns1:CVC_TC4_CIR_Attribute,
        ns1:CVC_TC4_PIR_Attribute ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.2.1, page 39" .

ns1:Unicast_N_1_AVC_ServiceAttributes_Table7 a ns1:UnicastAVC_ServiceAttributes,
        owl:NamedIndividual ;
    rdfs:label "Unicast N:1 AVC Service Attributes (Table 7)" ;
    ns1:hasServiceAttribute ns1:CVC_ID_N1_AVC ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 7, page 37" .

ns1:Unicast_N_1_CVC_Order a ns1:Cl_UnicastN1CVC,
        owl:NamedIndividual ;
    rdfs:label "Unicast N:1 CVC Order" ;
    ns1:hasDescription "Each unicast N:1 CVC order must specify each of the service attributes listed in Table 10, in addition to those configuration attributes detailed in Table 8"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.2.2, page 40" .

ns1:Unicast_N_1_CVC_Order_Attributes a owl:NamedIndividual ;
    rdfs:label "Unicast N:1 CVC Order Attributes" ;
    ns1:hasDescription "Each unicast N:1 CVC order must specify each of the service attributes listed in Table 10, in addition to those configuration attributes detailed in Table 8"^^xsd:string ;
    ns1:mustSpecify ns1:CVC_TC1_CIR_Attribute,
        ns1:CVC_TC2_CIR_Attribute,
        ns1:CVC_TC4_CIR_Attribute,
        ns1:CVC_TC4_PIR_Attribute ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.2.2, page 40" .

ns1:UtilisationThreshold a ns1:Cl_UtilisationThreshold,
        owl:NamedIndividual ;
    rdfs:label "Utilisation Threshold" ;
    ns1:appliesToSharedNetworkResource ns1:SharedNetworkResourceFibreFttc,
        ns1:SharedNetworkResourceFttbFttn,
        ns1:SharedNetworkResourceHfc,
        ns1:SharedNetworkResourceWireless ;
    ns1:hasContinuousPeriodDuration "PT30M" ;
    ns1:hasMinimumDays 3 ;
    ns1:hasRollingPeriodDuration "P30D" ;
    ns1:hasUtilisationPercentage 90.0 ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, s15, p.34" ;
    ns1:triggers ns1:UtilisationManagementPerformanceObjective .

ns1:VNNI_Association_Note a owl:NamedIndividual ;
    rdfs:label "V-NNI Association with Upstream NNI Link" ;
    ns1:hasDescription "A V-NNI can be associated with one Upstream NNI Link. The Upstream NNI Link attributes (S-TAG pool and bandwidth) will be displayed during the V-NNI ordering process."^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44" .

ns1:VNNI_Identification_Assignment a owl:NamedIndividual ;
    rdfs:label "V-NNI Identification Number Assignment" ;
    ns1:hasDescription "Each successful V-NNI order will be assigned an nbn-designated V-NNI identification number."^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.2, page 44" .

ns1:VNNI_Identification_Example a ns1:V_NNI,
        owl:NamedIndividual ;
    rdfs:label "nbn-designated V-NNI identification number" ;
    ns1:hasIdentificationNumber "nbn-designated V-NNI identification number"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.2, page 44" .

ns1:VNNI_Orderable_Attributes a owl:NamedIndividual ;
    rdfs:label "V-NNI Orderable Attributes" ;
    ns1:hasDescription "A summary of attributes that must be specified for each V-NNI order: NNI Link ID."^^xsd:string ;
    ns1:hasServiceAttribute ns1:NNILinkID_Attribute ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 14, page 44" .

ns1:VNNI_Ordering_Activities a owl:NamedIndividual ;
    rdfs:label "V-NNI Ordering Activities" ;
    ns1:hasDescription "The following activities may be performed by RSP for a V-NNI: Create a new V-NNI by selecting from a list of possible NNI Links; Cancel an existing V-NNI."^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44" .

ns1:VNniActivationPerformanceObjective a ns1:Cl_PerformanceObjective,
        owl:NamedIndividual ;
    rdfs:label "V-NNI Activation Performance Objective" ;
    ns1:appliesToActivation ns1:Cl_VNniActivation ;
    ns1:hasTargetPercentage 95 ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, s3.2, p.13" .

ns1:VNniActivationServiceLevel a ns1:ServiceLevel,
        owl:NamedIndividual ;
    rdfs:label "V-NNI Activation Service Level" ;
    ns1:appliesToActivation ns1:Cl_VNniActivation ;
    ns1:hasDuration 15 ;
    ns1:hasUnit "Business Days" ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, s3.1, p.13" ;
    ns1:startsAt ns1:OrderAcknowledgementEvent .

ns1:V_NNI_Example2 a ns1:V_NNI,
        owl:NamedIndividual ;
    rdfs:label "V-NNI Example 2" ;
    ns1:doesNotSupportUseOf ns1:NNIGroup_100G_Diverse ;
    ns1:hasDescription "A second V-NNI created from a Diverse Chassis NNI Group"^^xsd:string ;
    ns1:hasVisibilityOf ns1:NNILink_OperationalStatus_Example2 ;
    ns1:inheritsFrom ns1:NNIGroup_100G_Diverse ;
    ns1:obtainsFrom ns1:NNILink_Example2 ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.4, page 30" ;
    ns1:supportsAssociationOf ns1:NNILink_Example2 .

ns1:ValidationCondition_NoOtherTraffic a ns1:Cl_ValidationCondition,
        owl:NamedIndividual ;
    rdfs:label "Validation Condition: No Other Traffic" ;
    ns1:hasValidationDescription "Each traffic class must be validated in the presence of no other traffic from other traffic classes within the AVC"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 33" ;
    ns1:validatedInPresenceOf ns1:NoOtherTraffic_Context .

ns1:WirelessPlus a ns1:TrafficClass,
        owl:NamedIndividual ;
    rdfs:label "Wireless Plus" ;
    ns1:hasDescription "A specific TC-4 product that does not have a defined PIR"^^xsd:string ;
    ns1:hasNoDefinedPIR ns1:WirelessPlus_NoPIR ;
    ns1:name "Wireless Plus" ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33" .

ns1:WirelessPlus_Instance a ns1:Cl_WirelessPlus,
        owl:NamedIndividual ;
    rdfs:label "Wireless Plus" ;
    ns1:hasCIR false ;
    ns1:hasPIR false ;
    rdfs:comment "Wireless Plus product for which no PIR or CIR applies. [extension: nbn Ethernet Product Module, Section 3.8(a), p.15]" .

ns1:WirelessSpeedPerformanceRebate a ns1:Cl_FTTBNCConnectionPerformanceRebate,
        owl:NamedIndividual ;
    rdfs:label "Wireless Speed Performance Rebate" ;
    ns1:hasAmount ns1:WirelessSpeedPerformanceRebateCharge ;
    ns1:hasAnnualIncreaseStartDate "2025-07-01T00:00:00+00:00"^^xsd:dateTime ;
    ns1:hasMinimumIncreasePct 0.0 ;
    ns1:increasedBy ns1:WeightedAveragePriceChange ;
    ns1:isPaidBy ns1:NbnAgent ;
    ns1:isPaidTo ns1:RspAgent ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, s16, p.34" ;
    rdfs:comment "A rebate of $21.22 per month per nbn Ethernet (Wireless) AVC TC-4 Product Component supplied using a Wireless Network cell that is Persistently Congested during that month. [extension: WBA Ethernet Service Levels Schedule, s16, p.34]" .

ns1:actionType a owl:ObjectProperty ;
    rdfs:label "action_type" ;
    rdfs:domain ns1:CandidateAction ;
    rdfs:range ns1:ActionType .

ns1:addressesConstraintIds a owl:DatatypeProperty ;
    rdfs:label "addresses_constraint_ids" ;
    rdfs:comment "'|'-separated constraint ids covered, scoped to a resource." ;
    rdfs:domain ns1:CandidateAction ;
    rdfs:range xsd:string .

ns1:addressesRule a owl:ObjectProperty ;
    rdfs:domain ns1:CandidateAction ;
    rdfs:range ns1:PlanningRule .

ns1:affectsEquipmentType a owl:DatatypeProperty ;
    rdfs:label "affects equipment type" ;
    rdfs:comment "The type of network equipment affected by a Power Outage exclusion event. [extension: WBA Ethernet Service Levels Schedule, p.32-33]" ;
    rdfs:range xsd:string .

ns1:affectsProduct a owl:ObjectProperty ;
    rdfs:label "affectsProduct" ;
    rdfs:comment "Links an Interference Event to the Ordered Product it affects. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" ;
    rdfs:domain ns1:Cl_InterferenceEvent ;
    rdfs:range ns1:Cl_OrderedProduct .

ns1:alignedTo a owl:ObjectProperty ;
    rdfs:label "alignedTo" ;
    rdfs:comment "Links a traffic class to the per-hop behavior its attributes are aligned to. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" ;
    rdfs:domain ns1:TrafficClass ;
    rdfs:range ns1:Cl_PerHopBehavior .

ns1:allowsTestingOf a owl:DatatypeProperty ;
    rdfs:label "allowsTestingOf" ;
    rdfs:comment "Describes what the Satellite Test Service allows RSP to test. [extension: nbn Ethernet Product Module, Section 7(a), p.20]" ;
    rdfs:domain ns1:SatelliteTestService ;
    rdfs:range xsd:string .

ns1:amountEquals a owl:ObjectProperty ;
    rdfs:label "amountEquals" ;
    rdfs:comment "Links a Rebate or Credit to the Recurring Charge whose amount it equals. [extension: nbn Ethernet Price List, Section 1.4, p.6]" ;
    rdfs:domain ns1:RebateOrCredit ;
    rdfs:range ns1:RecurringCharge .

ns1:applicableTo a owl:ObjectProperty ;
    rdfs:label "applicableTo" ;
    rdfs:comment "Links a bandwidth profile attribute to the access technology it is applicable to. [extension: nbn Ethernet Product Module, Table 9, page 39]" ;
    rdfs:domain ns1:Cl_BandwidthProfile ;
    rdfs:range ns1:AccessTechnology .

ns1:appliesInContext a owl:ObjectProperty ;
    rdfs:label "appliesInContext" ;
    rdfs:comment "Links a reified relationship to the network context in which it applies. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:Cl_NetworkContext .

ns1:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to",
        "appliesTo" ;
    rdfs:comment "Links a FlatRateAVCCharge to the AVC TC-4 Product Component or CVC TC-4 capacity it applies to. [extension: nbn Ethernet Price List, Section 1.1]",
        "Links a PIR Objective Rebate or PIR Affected Billing Period to the AVC TC-4 Ordered Product Component it applies to. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]",
        "Links a Rebate or Credit to the Product Component it applies to. [extension: nbn Ethernet Price List, Section 1.4, p.6]",
        "Links a service limit to the service it governs. [extension: nbn Ethernet Product Module, Section 7(c), p.20]" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Cl_PirObjectiveRebate ns1:Cl_PirAffectedBillingPeriod ) ],
        ns1:Cl_ServiceLimit,
        ns1:FlatRateAVCCharge,
        ns1:RebateOrCredit ;
    rdfs:range ns1:AVC_TC4_ProductComponent,
        ns1:Cl_AvcTc4OrderedProductComponent,
        ns1:ProductComponent,
        owl:Thing .

ns1:appliesToActivation a owl:ObjectProperty ;
    rdfs:label "applies to activation" ;
    rdfs:comment "Links a Service Level or Performance Objective to the Activation type it applies to. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

ns1:appliesToBandwidth a owl:ObjectProperty ;
    rdfs:label "appliesToBandwidth" ;
    rdfs:comment "Links an OrderedBandwidth or IncludedBandwidth to the CVC TC-2 Product Component it applies to. [extension: nbn Ethernet Price List, Section 1.5(c), p.8]" ;
    rdfs:domain ns1:OrderedBandwidth ;
    rdfs:range ns1:CVC_TC2_ProductComponent .

ns1:appliesToBandwidthTier a owl:DatatypeProperty ;
    rdfs:label "appliesToBandwidthTier" ;
    rdfs:comment "The bandwidth profile tier to which the minimum AVC requirement applies (e.g. 'initial_100', 'initial_25', 'additional_25'). [extension: nbn Ethernet Product Module, Section 2.2(e)(iii), p.8]" ;
    rdfs:domain ns1:Cl_MinimumAvcRequirement ;
    rdfs:range xsd:string .

ns1:appliesToCVC a owl:ObjectProperty ;
    rdfs:label "appliesToCVC" ;
    rdfs:comment "Links an NNI_SpecificToRSP node to the CVC. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" ;
    rdfs:domain ns1:NNI_SpecificToRSP ;
    rdfs:range ns1:CVC .

ns1:appliesToCvcClass a owl:ObjectProperty ;
    rdfs:label "appliesToCvcClass" ;
    rdfs:comment "Links a minimum AVC requirement to the CVC Class it applies to. [extension: nbn Ethernet Product Module, Section 2.2(e)(iii), p.8]" ;
    rdfs:domain ns1:Cl_MinimumAvcRequirement ;
    rdfs:range ns1:Cl_CvcClass .

ns1:appliesToNNI a owl:ObjectProperty ;
    rdfs:label "appliesToNNI" ;
    rdfs:comment "Links an NNI_SpecificToRSP node to the NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" ;
    rdfs:domain ns1:NNI_SpecificToRSP ;
    rdfs:range ns1:NNI .

ns1:appliesToNetwork a owl:ObjectProperty ;
    rdfs:label "applies to network" ;
    rdfs:comment "Links a Throughput Dimensioning or Shared Network Resource definition to the Access Technology it applies to. [extension: WBA Ethernet Service Levels Schedule, p.33]" ;
    rdfs:range ns1:AccessTechnology .

ns1:appliesToNetworkType a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "appliesToNetworkType" ;
    rdfs:comment "Links a Product Feature or Charge to the network type it applies to. [extension: nbn Ethernet Price List, Section 2.4, p.10]",
        "The nbn network type(s) to which a bandwidth profile applies (e.g. 'Fibre, FTTB, FTTN, FTTC, HFC, Wireless and Satellite'). [extension: nbn Ethernet Product Module, Section 3.2, p.10]" ;
    rdfs:domain ns1:Cl_BandwidthProfile,
        ns1:ProductFeatures ;
    rdfs:range ns1:AccessTechnology,
        xsd:string .

ns1:appliesToOrderedProduct a owl:ObjectProperty ;
    rdfs:label "applies to ordered product" ;
    rdfs:comment "Links a section 7 charge to the ordered product it applies to. [extension: nbn Ethernet Price List, Section 7(a), p.18]" ;
    rdfs:domain ns1:Cl_EarlyDisconnectionModificationCharge ;
    rdfs:range ns1:OrderedProduct .

ns1:appliesToPremises a owl:ObjectProperty ;
    rdfs:label "appliesToPremises" ;
    rdfs:comment "Links a CIR Objective to the Premises it applies to. [extension: nbn Ethernet Product Module, Section 3.4(c), p.13]" ;
    rdfs:domain ns1:CIR_Objective ;
    rdfs:range ns1:Premises .

ns1:appliesToSharedNetworkResource a owl:ObjectProperty ;
    rdfs:label "applies to shared network resource" ;
    rdfs:comment "Links a Utilisation Threshold to the Shared Network Resource it applies to. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range ns1:Cl_SharedNetworkResource .

ns1:appliesToTechnology a owl:ObjectProperty ;
    rdfs:label "applies to technology" ;
    rdfs:comment "Links a Downstream Performance Threshold to the Access Technology it applies to. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range ns1:AccessTechnology .

ns1:appliesToTrafficClass a owl:ObjectProperty ;
    rdfs:label "appliesToTrafficClass" ;
    rdfs:comment "Links an availability limit note to the traffic class it applies to. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes]" ;
    rdfs:range ns1:TrafficClass .

ns1:assessedAs a owl:ObjectProperty ;
    rdfs:domain ns1:CandidateAction ;
    rdfs:range ns1:ActionAssessment .

ns1:associatedWith a owl:ObjectProperty ;
    rdfs:label "associatedWith" ;
    rdfs:comment "Links an AVC TC-2 Product Component to the CVC TC-2 Product Component it is associated with. [extension: nbn Ethernet Price List, Section 1.5(c), p.8]" ;
    rdfs:domain ns1:AVC_TC2_ProductComponent ;
    rdfs:range ns1:CVC_TC2_ProductComponent .

ns1:associatedWithUpstreamNNILink a owl:ObjectProperty ;
    rdfs:label "associatedWithUpstreamNNILink" ;
    rdfs:comment "Links a V-NNI to the single Upstream NNI Link it is associated with. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:domain ns1:V_NNI ;
    rdfs:range ns1:UpstreamNNILink .

ns1:associatesWithAVC a owl:ObjectProperty ;
    rdfs:label "associatesWithAVC" ;
    rdfs:comment "Links a unicast N:1 CVC to the unicast N:1 AVCs associated with it at the NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.2, page 28]" ;
    rdfs:domain ns1:CVC_N_1_VLAN ;
    rdfs:range ns1:Unicast_N_1_AVC .

ns1:atDownstreamNetworkBoundary a owl:DatatypeProperty ;
    rdfs:label "atDownstreamNetworkBoundary" ;
    rdfs:comment "Indicates if the CIR Objective is measured at the nbn Downstream Network Boundary. [extension: nbn Ethernet Product Module, Section 3.4(c), p.13]" ;
    rdfs:domain ns1:CIR_Objective ;
    rdfs:range xsd:boolean .

ns1:autoConfiguredBandwidthEqualsNNI a owl:DatatypeProperty ;
    rdfs:label "autoConfiguredBandwidthEqualsNNI" ;
    rdfs:comment "Indicates that the bandwidth capacity is automatically configured to equal the bandwidth of the associated NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 27]" ;
    rdfs:domain ns1:CVC_BandwidthProfileAutoConfig ;
    rdfs:range xsd:boolean .

ns1:autoConfiguredBandwidthValue a owl:DatatypeProperty ;
    rdfs:label "autoConfiguredBandwidthValue" ;
    rdfs:comment "The auto-configured bandwidth value for a CVC bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 27]" ;
    rdfs:domain ns1:CVC_BandwidthProfileAutoConfig ;
    rdfs:range xsd:string .

ns1:availableByAccessTechnology a owl:ObjectProperty ;
    rdfs:label "availableByAccessTechnology" ;
    rdfs:comment "Links a Cl_AVC_TC4_ProfileAvailability node to the access technology (F=Fibre, H=HFC, W=Wireless, S=Satellite) on which the profile is available. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain ns1:Cl_AVC_TC4_ProfileAvailability ;
    rdfs:range ns1:AccessTechnology .

ns1:availableForConfiguration a owl:ObjectProperty ;
    rdfs:label "availableForConfiguration" ;
    rdfs:comment "Links a Satellite CVC table to the configuration type (e.g., 1:1) for which it is available. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 35, page 79]" ;
    rdfs:domain ns1:Cl_SatelliteCvcTable ;
    rdfs:range ns1:Cl_ConfigurationType .

ns1:availableGbps a owl:DatatypeProperty ;
    rdfs:label "available_gbps" ;
    rdfs:comment "= protected - current load" ;
    rdfs:domain ns1:NNIGroup ;
    rdfs:range xsd:double .

ns1:availableOn a owl:ObjectProperty ;
    rdfs:label "availableOn" ;
    rdfs:comment "Links an AVC type to its availability reification node. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:domain ns1:AVC ;
    rdfs:range ns1:AVC_AvailableOn .

ns1:availableOnAccessTechnology a owl:ObjectProperty ;
    rdfs:label "availableOnAccessTechnology" ;
    rdfs:comment "Links an availability reification node to the access technology. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 25]" ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:AccessTechnology .

ns1:availableOnUNI a owl:ObjectProperty ;
    rdfs:label "availableOnUNI" ;
    rdfs:comment "Links an AVCFeatureAvailability node to the UNI type (UNI-D, UNI-V, UNI-DSL) on which the traffic class or bandwidth profile is available. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50]" ;
    rdfs:domain ns1:AVCFeatureAvailability ;
    rdfs:range ns1:AVC .

ns1:availableOnlyToSupport a owl:ObjectProperty ;
    rdfs:label "availableOnlyToSupport" ;
    rdfs:comment "Links a Unicast N:1 AVC to its availability constraint reification node. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain ns1:Unicast_N_1_AVC ;
    rdfs:range ns1:Cl_AvailabilityConstraint .

ns1:avcType a owl:ObjectProperty ;
    rdfs:label "avcType" ;
    rdfs:comment "Links an AVC_AvailableOn node to the AVC type. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:domain ns1:AVC_AvailableOn ;
    rdfs:range ns1:AVC .

ns1:avcs a owl:DatatypeProperty ;
    rdfs:label "avcs" ;
    rdfs:domain ns1:CVC ;
    rdfs:range xsd:integer .

ns1:averageUtilisationThresholdMbps a owl:DatatypeProperty ;
    rdfs:label "averageUtilisationThresholdMbps" ;
    rdfs:comment "The average utilisation threshold in Mbps for a usage condition. [extension: nbn Ethernet Price List, Note 4, p.5]" ;
    rdfs:domain ns1:UsageCondition ;
    rdfs:range xsd:decimal .

ns1:avoidsMismatch a owl:ObjectProperty ;
    rdfs:label "avoidsMismatch" ;
    rdfs:comment "Links an S/C-VID allocation to the potential S/C-VID mismatch between RSP and nbn that it avoids. [extension: nbn Ethernet Product Module, page 38]" ;
