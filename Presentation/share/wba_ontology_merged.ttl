    rdfs:comment "An event where an RSP uses CVC TC-4 capacity in excess of either the average download limitation or the average upload limitation set out in section 4.5(a) of the nbn Ethernet Fair Use Policy. [extension: nbn Ethernet Price List, Section 6(a), p.17]" .

ns1:Cl_ExemptionCondition a owl:Class ;
