    rdfs:comment "The Enhanced (90 Day) - 12 (24/7) variant of the Enhanced Fault Rectification Service, which is automatically removed after 90 days unless reordered. [extension: nbn Ethernet Product Module, Section 5(e), p.20]" ;
    rdfs:subClassOf ns1:EnhancedFaultRectificationService .

ns1:EstablishANewNNILink a owl:Class ;
    rdfs:label "Establish a new NNI Link" ;
    rdfs:comment "An event that creates a new NNI Link by specifying the range of S-TAGs, bandwidth and the V-NNI RSP. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" ;
    rdfs:subClassOf ns1:Cl_Event .

ns1:EstablishObject a owl:Class ;
    rdfs:label "Establish Object" ;
    rdfs:comment "A reified node capturing the composite object of an Establish a new NNI Link event: the range of S-TAGs, bandwidth and the V-NNI RSP. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" .

ns1:EstablishObject_Example a ns1:EstablishObject,
        owl:NamedIndividual ;
    rdfs:label "Establish Object: S-TAGs, bandwidth, V-NNI RSP" ;
    ns1:hasBandwidth ns1:Bandwidth_Example ;
    ns1:hasS-TAGPool ns1:S-TAGPool_Example ;
    ns1:hasV-NNIRSP ns1:V-NNIRSP_Example ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43" .

ns1:Event_InterferenceEvent_FTTB a ns1:Cl_InterferenceEvent,
        owl:NamedIndividual ;
    rdfs:label "Interference Event - FTTB" ;
    ns1:affectsProduct ns1:OrderedProduct_FTTB_Instance ;
    ns1:causedBy ns1:ThirdPartyEquipmentOrNetwork_Generic ;
    ns1:eventType "Interference Event caused by the equipment or network of a third party prejudicing the integrity or causing deterioration of an nbn Ethernet (FTTB) Ordered Product" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.6(a), p.15" .

ns1:ExcessUsageEvent_Instance a ns1:Cl_ExcessUsageEvent,
        owl:NamedIndividual ;
    rdfs:label "Excess CVC TC-4 Usage Event" ;
    rdfs:comment "Event triggered when RSP uses CVC TC-4 capacity in excess of either the average download limitation or the average upload limitation set out in section 4.5(a) of the nbn Ethernet Fair Use Policy. [extension: nbn Ethernet Price List, Section 6(a), p.17]" .

ns1:ExemptionCondition_AVCTC2 a ns1:BasicOfferCondition,
        owl:NamedIndividual ;
    rdfs:label "Exemption Condition: Enhanced Fault Rectification with AVC TC-2" ;
    ns1:appliesTo ns1:EnhancedFaultRectification_Enhanced4_24_7 ;
    ns1:conditionDescription "Section 2.2(b) will not apply in respect of any Enhanced Fault Rectification Service which is supplied as part of an Ordered Product that also includes an AVC TC-2 Product Component at the time that the eSLA Change Event occurs." .

ns1:ExemptionCondition_ServiceTransferOrder a ns1:Cl_ExemptionCondition,
        owl:NamedIndividual ;
    rdfs:label "Exemption: Service Transfer Order with Qualifying CIR Objective" ;
    ns1:appliesTo ns1:ServiceTransferOrder_Instance ;
    ns1:conditionDescription "The Other Gaining RSP has ordered an AVC TC-2 Product Component with a bandwidth profile with a CIR Objective that is the same as, or higher than, the CIR Objective applicable to the Losing RSP's AVC TC-2 Product Component." ;
    ns1:sourceClause "nbn Ethernet Price List, Section 7(d)(ii), p.19" ;
    rdfs:comment "The Charge under section 7 will not apply if the nbn Ethernet Ordered Product is disconnected following acceptance by nbn of a Service Transfer Order and the Other Gaining RSP has ordered an AVC TC-2 Product Component with a bandwidth profile with a CIR Objective that is the same as, or higher than, the CIR Objective applicable to the Losing RSP's AVC TC-2 Product Component. [extension: nbn Ethernet Price List, Section 7(d)(ii), p.19]" .

ns1:ExemptionCondition_UnsuccessfulNetworkActivity a ns1:Cl_ExemptionCondition,
        owl:NamedIndividual ;
    rdfs:label "Exemption: Unsuccessful Network Activity" ;
    ns1:appliesTo ns1:NetworkActivity_Instance ;
    ns1:hasNetworkActivityOutcome true ;
    ns1:hasNotificationStatus true ;
    ns1:sourceClause "nbn Ethernet Price List, Section 7(d)(i), p.19" ;
    rdfs:comment "The Charge under section 7 will not apply if nbn has undertaken Network Activity activities in respect of the relevant nbn Ethernet Ordered Product and has notified RSP that Network Activity to achieve the CIR Objective was unsuccessful. [extension: nbn Ethernet Price List, Section 7(d)(i), p.19]" .

ns1:FTTCNCD_Instance a ns1:Cl_FTTCNCD,
        owl:NamedIndividual ;
    rdfs:label "FTTC-NCD Instance" ;
    rdfs:comment "An FTTC Network Connection Device at a premises served by the FTTC Network. [extension: nbn Ethernet Product Module, Section 4.6(a)(i), p.19]" .

ns1:FacilitiesAccessRights_Example a ns1:FacilitiesAccessRights,
        owl:NamedIndividual ;
    rdfs:label "Facilities Access Rights" ;
    ns1:hasDescription "The necessary facilities access rights to connect the NNI Bearer to RSP's backhaul transmission cables or RSP Active Equipment."^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 12, page 42" .

ns1:FailureResponse_DiverseChassis_RedirectToProtect a ns1:Cl_FailureResponse,
        owl:NamedIndividual ;
    rdfs:label "Failure Response: Diverse Chassis Redirect to Protect" ;
    ns1:hasFailureDescription "Traffic is re-directed to the NNI Bearers on the protect chassis"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2.2, page 28" .

