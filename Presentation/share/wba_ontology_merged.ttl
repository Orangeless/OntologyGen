    rdfs:label "S-TAG Pool Example" ;
    ns1:hasEnd 4000 ;
    ns1:hasStart 1 ;
    ns1:isCurrentlyAssigned false ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 13, page 43" .

ns1:TimeInterval a owl:Class ;
    rdfs:label "Time Interval" ;
    rdfs:comment "A temporal interval with a start and end time. [extension: nbn Ethernet Price List, Section 6(f), p.18]" .

ns1:UNI_Inclusion a owl:Class ;
    rdfs:label "UNI_Inclusion" ;
    rdfs:comment "A reified relationship representing that a UNI type is included in the recurring charge for the AVC TC-4 and UNI bundle, conditional on network type. [extension: nbn Ethernet Price List, Section 1.3, p.6]" .

ns1:UNI_V a ns1:UNI_Type,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "UNI-V",
        "UNI_V" ;
    rdfs:comment "UNI-V (User Network Interface - V) entity, a type of UNI used with Unicast N:1 AVC. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]",
        "User Network Interface - V (virtual). [extension: nbn Ethernet Product Module, Section 3.3(c), p.13]",
        "User Network Interface Type V. [extension: nbn Ethernet Price List, Section 1.3, p.6]" ;
