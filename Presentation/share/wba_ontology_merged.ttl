    rdfs:domain ns1:V_NNI ;
    rdfs:range owl:Thing .

ns1:hasWeightedAveragePriceChangePct a owl:DatatypeProperty ;
    rdfs:label "has weighted average price change pct" ;
    rdfs:comment "The Weighted Average Price Change percentage. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:decimal .

ns1:hosts a owl:ObjectProperty ;
    rdfs:label "hosts" ;
