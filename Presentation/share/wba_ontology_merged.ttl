    rdfs:comment "Equipment or network of a third party that may cause an Interference Event. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" .

ns1:Cl_TroubleTicket a owl:Class ;
    rdfs:label "Trouble Ticket" ;
    rdfs:comment "A trouble ticket acknowledged by nbn that gives rise to a designated Network Activity under this Agreement, marking the start of a PIR Affected Billing Period. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.15]" .

ns1:Cl_Unicast11CVC a owl:Class ;
    rdfs:label "Unicast 1:1 CVC" ;
    rdfs:comment "A subclass of CVC for the Unicast 1:1 CVC order type. Each unicast 1:1 CVC order must specify each of the service attributes listed in Table 9. [extension: nbn Ethernet Product Module, section 8.2.1, page 39]" ;
    rdfs:subClassOf ns1:CVC .

ns1:Cl_UtilisationThreshold a owl:Class ;
    rdfs:label "Utilisation Threshold" ;
    rdfs:comment "The condition (90% utilisation, 30 continuous minutes, at least 3 separate days within any rolling 30-day period) that triggers nbn's utilisation management obligation. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

ns1:Cl_VNniActivation a owl:Class ;
    rdfs:label "V-NNI Activation" ;
    rdfs:comment "Activation of a V-NNI. [extension: WBA Ethernet Service Levels Schedule, p.13]" ;
    rdfs:subClassOf ns1:Cl_Activation .

ns1:Cl_WBAOperationsManual a owl:Class ;
    rdfs:label "WBA Operations Manual" ;
    rdfs:comment "The WBA Operations Manual document in accordance with which S/C-VID values are returned to RSP. [extension: nbn Ethernet Product Module, page 38]" .

ns1:Cl_WeightedAveragePriceChange a owl:Class ;
    rdfs:label "Weighted Average Price Change" ;
    rdfs:comment "The weighted average price change used to increase the FTTB/N/C Connection Performance Rebate amounts from 1 July 2025. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

ns1:Cl_WirelessServingArea a owl:Class ;
    rdfs:label "Cl_WirelessServingArea" ;
    rdfs:comment "A Wireless Serving Area (or WSA) that contains Premises and is located within a CSA. [extension: nbn Ethernet Product Module, Section 12.1(b), p.26]" ;
    rdfs:subClassOf ns1:PlanningResource .

ns1:Cl_nbnCopperPair a owl:Class ;
    rdfs:label "nbn Copper Pair" ;
    rdfs:comment "An nbn Copper Pair used to supply an nbn Ethernet (FTTB), nbn Ethernet (FTTN), or nbn Ethernet (FTTC) TC-4 Ordered Product. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

ns1:Condition a owl:Class ;
    rdfs:label "Condition" ;
    rdfs:comment "A reified condition that must be met before an event can occur. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" .

ns1:ConfigurationAttributes a owl:Class ;
