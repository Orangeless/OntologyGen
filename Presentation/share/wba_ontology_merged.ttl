    ns1:hasSpecificationType ns1:SpecType_CIR ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9" .

ns1:TC_1_Description a owl:NamedIndividual ;
    rdfs:label "TC-1 Description" ;
    ns1:hasDescription "The TC-1 traffic class is targeted towards real-time, interactive multimedia applications, with low bit-rate, low Frame Delay, Frame Delay Variation, Frame Loss."^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9" .

ns1:TC_2_Description a owl:NamedIndividual ;
    rdfs:label "TC-2 Description" ;
    ns1:hasDescription "The TC-2 traffic class is targeted towards real-time, interactive multimedia applications."^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9" .

ns1:TC_4_Description a owl:NamedIndividual ;
    rdfs:label "TC-4 Description" ;
    ns1:hasDescription "Traffic class 4 is designed for applications that can benefit from a peak capacity and can tolerate variable throughput"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33" .

ns1:TPEP_Web_Enables_TCP a owl:NamedIndividual ;
    rdfs:label "TPEP Web Optimisation enables TPEP TCP Optimisation" ;
    ns1:enables ns1:TPEP_TCP_Opt_Satellite ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, footnote 23, page 37" .

ns1:Table28_ReadSubjectTo_Note a owl:NamedIndividual ;
    rdfs:label "Table 28 Read Subject To" ;
    ns1:hasDescription "To be read subject to section 2.2.2 of this nbn Ethernet Product Technical Specification and section 13 of the nbn Ethernet Product Description." ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes" .

ns1:TelecommunicationsOutlet_Instance a ns1:Cl_TelecommunicationsOutlet,
        owl:NamedIndividual ;
    rdfs:label "First Telecommunications Outlet Instance" ;
    rdfs:comment "The first Telecommunications Outlet at a non-MDU premises. [extension: nbn Ethernet Product Module, Section 4.6(b)(ii), p.19]" .

ns1:ThroughputCharacteristic_Variable a owl:NamedIndividual ;
    rdfs:label "Variable Throughput Tolerance" ;
    ns1:hasDescription "Applications that can tolerate variable throughput"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33" .

ns1:ThroughputDimensioning_2Mbps_Fibre a ns1:Cl_ThroughputDimensioning,
        owl:NamedIndividual ;
    rdfs:label "Throughput Dimensioning 2Mbps - Fibre" ;
    ns1:hasBandwidthProfile ns1:BandwidthProfile_1000_400,
        ns1:BandwidthProfile_250_100,
        ns1:BandwidthProfile_500_200,
        ns1:BandwidthProfile_HomeSuperfast,
        ns1:BandwidthProfile_HomeUltrafast ;
    ns1:hasMinimumThroughputMbps 2 ;
    ns1:isDimensionedOn ns1:SharedNetworkResourceFibreFttc ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, p.33" .

ns1:ThroughputDimensioning_2Mbps_Hfc a ns1:Cl_ThroughputDimensioning,
