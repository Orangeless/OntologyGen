ns1:hasOrderingMode a owl:ObjectProperty ;
    rdfs:label "hasOrderingMode" ;
    rdfs:comment "Links an NNI Group to the mode in which NNI Bearers may be ordered (single interfaces or pairs). [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain ns1:Cl_NNIGroup ;
    rdfs:range owl:Thing .

ns1:hasOrderingProcedure a owl:ObjectProperty ;
