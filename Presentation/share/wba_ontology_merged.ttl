ns1:AVCConfigurationAttributes a owl:Class ;
    rdfs:label "AVCConfigurationAttributes" ;
    rdfs:comment "AVC configuration attributes. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 8.1.1.2]" ;
    rdfs:subClassOf ns1:ConfigurationAttributes .

ns1:AVCTC1_0_15_UNIV_Instance a ns1:AVC_TC_1,
        owl:NamedIndividual ;
    rdfs:label "AVC TC-1 0.15 Mbps mapped to UNI-V" ;
    ns1:hasDataTransferRate ns1:DataTransferRate_AVCTC1_0_15 ;
    ns1:isConfiguredInTrafficClass ns1:TC_1 ;
    ns1:isMappedTo ns1:UNI_V_Instance ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 6(b), p.20" ;
    rdfs:comment "A 0.15 Mbps AVC TC-1 which is mapped to the UNI-V (where available) in the case of nbn Ethernet (Fibre). [extension: nbn Ethernet Product Module, Section 6(b), p.20]" .

ns1:AVCTC1_AdditionalInstance a ns1:AVC_TC_1,
        owl:NamedIndividual ;
    rdfs:label "AVC TC-1 Additional Instance (UNI-V)" ;
    ns1:isConfiguredInTrafficClass ns1:TC_1 ;
    ns1:mappedToUNI ns1:UNI_V_Instance ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.3(c), p.13" ;
    rdfs:comment "An additional AVC TC-1 instance mapped to UNI-V. [extension: nbn Ethernet Product Module, Section 3.3(c), p.13]" .

ns1:AVCTC1_FTTC_Instance a ns1:AVC_TC_1,
        owl:NamedIndividual ;
