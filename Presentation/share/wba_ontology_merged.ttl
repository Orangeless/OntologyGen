        "NNI Group",
        "NNI Product Component",
        "Network-Network Interface" .

ns1:AccessTechnology_HFC a ns1:AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "HFC" .

ns1:AVCFeatureAvailability a owl:Class ;
    rdfs:label "AVC Feature Availability" ;
    rdfs:comment "Reified relationship representing the availability of a traffic class or bandwidth profile on a specific UNI type for a given access technology. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50]" .

ns1:DocumentSection a owl:Class ;
    rdfs:label "DocumentSection" ;
    rdfs:comment "A section or subsection of the Wholesale Broadband Agreement document. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, page 4]" .

ns1:AccessTechnology_FTTB a ns1:AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTB",
        "FTTB Access Technology" ;
    ns1:hasDescription "Fibre to the Building access technology"^^xsd:string ;
