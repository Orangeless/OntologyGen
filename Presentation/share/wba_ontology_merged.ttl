        "Early Disconnection or Modification Charge under Section 7" ;
    ns1:appliesToOrderedProduct ns1:OrderedProduct_DisconnectedViaSTO,
        ns1:OrderedProduct_WithAVCTC2 ;
    ns1:currency "AUD" ;
    ns1:hasChargeFormula ns1:ChargeFormula_Section7,
        ns1:ChargeFormula_Section7_Cancellation,
        ns1:ChargeFormula_Section7_DisconnectionModification,
        ns1:ChargeFormula_Section7_Modification ;
    ns1:hasChargeRule ns1:EarlyDisconnectionModificationCharge_Rule ;
    ns1:hasDurationInMonths 12 ;
    ns1:hasExemptionCondition ns1:ExemptionCondition_ServiceTransferOrder,
        ns1:ExemptionCondition_UnsuccessfulNetworkActivity ;
    ns1:hasTriggerEvent ns1:TriggerEvent_Cancellation,
        ns1:TriggerEvent_Disconnection,
        ns1:TriggerEvent_Modification ;
    ns1:sourceClause "nbn Ethernet Price List, Section 7, p.19" ;
    rdfs:comment "Charge triggered when an AVC TC-2 Product Component is cancelled, disconnected, or modified within 12 months of order completion, calculated as (Pre - Post) x Shortfall Period. [extension: nbn Ethernet Price List, Section 7, p.19]",
        "Charge triggered when an AVC TC-2 Product Component is cancelled, disconnected, or modified within 12 months of order completion. [extension: nbn Ethernet Price List, Section 7, p.18]" .

