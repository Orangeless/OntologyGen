    ns1:hasBandwidthProfile ns1:BandwidthProfile_12_1,
        ns1:BandwidthProfile_25_10,
        ns1:BandwidthProfile_25_5,
        ns1:BandwidthProfile_50_100_20_40,
        ns1:BandwidthProfile_50_20,
        ns1:BandwidthProfile_HomeFast ;
