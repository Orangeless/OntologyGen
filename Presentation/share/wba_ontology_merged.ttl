    rdfs:domain ns1:ProductFeatures ;
    rdfs:range ns1:UpstreamPIR .

ns1:hasUsageRange a owl:ObjectProperty ;
    rdfs:label "has usage range" ;
    rdfs:comment "Links a usage tier charge to the usage range. [extension: nbn Ethernet Price List, Section 6(a), p.17]" ;
    rdfs:domain ns1:Cl_UsageTierCharge ;
    rdfs:range ns1:Cl_UsageRange .

ns1:hasUtilisationPercentage a owl:DatatypeProperty ;
    rdfs:label "has utilisation percentage" ;
