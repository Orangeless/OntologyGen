ns1:Note_CVCClass_AdditionalCharges a owl:NamedIndividual ;
    rdfs:label "Note: CVC Class charges are in addition to sections 1.2 and 6" ;
    rdfs:comment "Any Charges applicable under section 2.3 are in addition to any Charges that apply under sections 1.2 and 6. [extension: nbn Ethernet Price List, Section 2.3, Note, p.10]" .

ns1:Note_NoCIR a owl:NamedIndividual ;
    rdfs:label "No CIR Note" ;
    ns1:hasDescription "For traffic classes which do not support a CIR (e.g. AVC TC-4), no CIR is provided."^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9" .

ns1:Note_PIR_AutoAlign a owl:NamedIndividual ;
    rdfs:label "PIR Auto-Alignment Note" ;
    ns1:hasDescription "For traffic classes where RSP is required only to specify the CIR (i.e. for which the PIR is not specified), the PIR will be automatically set by nbn to align with the specified CIR according to the relevant traffic class."^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9" .

ns1:Note_WirelessPlus_NoPIR a owl:NamedIndividual ;
    rdfs:label "Wireless Plus Note" ;
    ns1:appliesInContext ns1:NetContext_WirelessPlus ;
    ns1:hasDescription "No defined PIR applies in respect of Wireless Plus. However, the other characteristics of TC-4 do apply to Wireless Plus."^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9" .

ns1:OneAVC_Per_UNI_D_DSL a owl:NamedIndividual ;
    rdfs:label "One AVC per UNI-D or UNI-DSL" ;
    ns1:hasDescription "One AVC inclusive of multiple traffic classes may be supported per UNI-D or UNI-DSL"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24, footnote 9" .

ns1:OrderType_Disconnect a ns1:Cl_OrderType,
        owl:NamedIndividual ;
    rdfs:label "Disconnect Order" ;
    rdfs:comment "A Disconnect Order type. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

ns1:OrderType_Standard a ns1:Cl_OrderType,
        owl:NamedIndividual ;
    rdfs:label "Standard Order" ;
    rdfs:comment "A standard order type. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

ns1:OrderType_TransitionOutModify a ns1:Cl_OrderType,
        owl:NamedIndividual ;
    rdfs:label "Transition-out Modify Order" ;
    rdfs:comment "A Transition-out Modify Order type. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

ns1:OrderedProduct_FTTB_FTTN a ns1:OrderedProduct,
        owl:NamedIndividual ;
    rdfs:label "Ordered Product supplied by means of FTTB Network or FTTN Network" ;
    ns1:hasNetworkActivity ns1:NetworkActivity_Instance ;
    rdfs:comment "An nbn Ethernet Ordered Product supplied (or to be supplied) by means of the FTTB Network or FTTN Network, to which section 7 applies. [extension: nbn Ethernet Price List, Section 7(a), p.18]" .

ns1:OrderedProduct_Instance a ns1:OrderedProduct,
        owl:NamedIndividual ;
    rdfs:label "Ordered Product (any symmetrical AVC TC-1 >= 0.15Mbps)" ;
    ns1:providesRebateOrCredit ns1:RebateOrCredit_Instance ;
    ns1:sourceClause "nbn Ethernet Price List, Section 1.4, Note, p.6" .

ns1:PassiveNTD_Instance a ns1:Cl_PassiveNTD,
        owl:NamedIndividual ;
    rdfs:label "Passive NTD Instance" ;
    rdfs:comment "A Passive Network Termination Device at a non-MDU premises. [extension: nbn Ethernet Product Module, Section 4.6(b)(ii), p.19]" .

ns1:PerHop_DSCP_EF a ns1:Cl_PerHopBehavior,
        owl:NamedIndividual ;
    rdfs:label "DSCP EF" ;
    ns1:hasDescription "DSCP Expedited Forwarding per-hop behaviour described in RFC4594"^^xsd:string .

ns1:PerformanceIncident a owl:Class ;
    rdfs:label "PerformanceIncident" ;
    rdfs:comment "A performance incident as defined in the WBA agreement. [extension: nbn Ethernet Product Module, Section 3.4(c), p.13]" .

ns1:PowerOutageFttbFttnNode a ns1:Cl_PowerOutage,
        owl:NamedIndividual ;
    rdfs:label "Power Outage affecting FTTB/FTTN Node" ;
    ns1:affectsEquipmentType "nbn Node, active equipment forming part of FTTB Network or FTTN Network" ;
    ns1:isExcludedFrom ns1:NetworkAvailability ;
    ns1:isNotLocatedIn "Type 1 Facility, Type 2 Facility" ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, p.32-33" ;
    rdfs:comment "Power Outage affecting an nbn Node or any other active equipment that forms part of the FTTB Network or the FTTN Network and is not located within a Type 1 Facility or a Type 2 Facility." .

ns1:PowerOutageFttcDpu a ns1:Cl_PowerOutage,
        owl:NamedIndividual ;
    rdfs:label "Power Outage affecting FTTC DPU" ;
    ns1:affectsEquipmentType "nbn DPU, FTTC-NCD, active equipment forming part of FTTC Network" ;
    ns1:isExcludedFrom ns1:NetworkAvailability ;
    ns1:isNotLocatedIn "Type 1 Facility, Type 2 Facility" ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, p.32-33" ;
    rdfs:comment "Power Outage affecting an nbn DPU, FTTC-NCD or any other active equipment that forms part of the FTTC Network and is not located within a Type 1 Facility or a Type 2 Facility." .

ns1:PowerOutageHfcOpticalNode a ns1:Cl_PowerOutage,
        owl:NamedIndividual ;
    rdfs:label "Power Outage affecting HFC Optical Node" ;
    ns1:affectsEquipmentType "HFC Optical Node, active equipment forming part of HFC Network" ;
    ns1:isExcludedFrom ns1:NetworkAvailability ;
    ns1:isNotLocatedIn "Type 1 Facility, Type 2 Facility" ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, p.32-33" ;
    rdfs:comment "Power Outage affecting an HFC Optical Node or any other active equipment that forms part of the HFC Network and is not located within a Type 1 Facility or a Type 2 Facility." .

ns1:PowerOutageMduSite a ns1:Cl_PowerOutage,
        owl:NamedIndividual ;
    rdfs:label "Power Outage at MDU Site" ;
    ns1:isExcludedFrom ns1:NetworkAvailability ;
    ns1:occursAtSiteType "MDU Site" ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, p.32-33" ;
    rdfs:comment "Any Power Outage at an MDU Site or affecting any nbn Equipment located at that MDU Site." .

ns1:PowerOutage_FTTB_Instance a ns1:Cl_PowerOutage,
        owl:NamedIndividual ;
    rdfs:label "Power Outage - FTTB Network" ;
    ns1:eventType "Power Outage in the FTTB Network" ;
    ns1:occursInNetwork ns1:AccessTechnology_FTTB ;
    ns1:preventsSupplyOf ns1:SupplyRestriction_FTTB_Instance ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 12.3(a), p.26" ;
    rdfs:comment "A Power Outage event in the FTTB Network that may prevent nbn from supplying nbn Ethernet (FTTB) Ordered Products. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" .

ns1:PowerOutage_FTTN_Instance a ns1:Cl_PowerOutage,
        owl:NamedIndividual ;
    rdfs:label "Power Outage - FTTN Network" ;
    ns1:eventType "Power Outage in the FTTN Network" ;
    ns1:occursInNetwork ns1:AccessTechnology_FTTN ;
    ns1:preventsSupplyOf ns1:SupplyRestriction_FTTN_Instance ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 12.3(a), p.26" ;
    rdfs:comment "A Power Outage event in the FTTN Network that may prevent nbn from supplying nbn Ethernet (FTTN) Ordered Products. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" .

ns1:ProRataRule_CVC_TC2 a ns1:ProRataRule,
        owl:NamedIndividual ;
    rdfs:label "Pro-Rata Rule for CVC TC-2 Bandwidth" ;
    ns1:conditionDescription "Changes in capacity across a Billing Period are accounted for on a pro-rata daily basis." .

ns1:ProductFeatureState_Orderable a ns1:Cl_ProductFeatureState,
        owl:NamedIndividual ;
    rdfs:label "Orderable" ;
    rdfs:comment "State in which the UNI-V Product Feature is orderable. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

ns1:ProductFeatureState_TransitionOutOnly a ns1:Cl_ProductFeatureState,
        owl:NamedIndividual ;
    rdfs:label "Transition-out Only" ;
    rdfs:comment "State in which the UNI-V Product Feature can only be ordered via Transition-out Modify Order or Disconnect Order. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

ns1:ProductFeatureState_Withdrawn a ns1:Cl_ProductFeatureState,
        owl:NamedIndividual ;
    rdfs:label "Withdrawn" ;
    rdfs:comment "State in which the UNI-V Product Feature is withdrawn. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

ns1:ProductModule_nbnEthernet a ns1:ProductModule,
        owl:NamedIndividual ;
    rdfs:label "nbn Ethernet Product Module" ;
    ns1:hasDocumentVersion "5"^^xsd:string ;
    ns1:hasProductModuleName "nbn® Ethernet Product Module"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, page 4" .

ns1:PublicInterestPremises_Instance a ns1:Cl_PublicInterestPremises,
        owl:NamedIndividual ;
    rdfs:label "Public Interest Premises Instance" ;
    ns1:waivedByNbn true ;
    rdfs:comment "A Public Interest Premises for which nbn may waive RSP's obligations under section 39 of the nbn Ethernet Product Terms. [extension: nbn Ethernet Product Module, Section 3.7 Note, p.15]" .

ns1:RSP_Chooses_CVCClass a owl:NamedIndividual ;
    rdfs:label "RSP Chooses CVC Class" ;
    ns1:choosesCVCClass ns1:CVCClass_Attribute ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 8, page 38" .

ns1:RSP_Contention_Control_Example a owl:NamedIndividual ;
    rdfs:label "RSP Controls AVC:CVC Contention" ;
    ns1:controlsContention ns1:AVC_CVC_Contention_Example ;
    ns1:hasDescription "Subject to section 2.1(d) of the nbn Ethernet Product Description, RSP should control AVC:CVC contention for the purpose of managing service utilisation"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.4, page 28" ;
    ns1:subjectToClause ns1:DocumentSection_2_1_d .

ns1:RSP_Encouraged_Use_nbn_SCVID a owl:NamedIndividual ;
    rdfs:label "RSP Encouraged to Use nbn S/C-VID Allocations" ;
    ns1:encouragedToUse ns1:SCVID_Allocated_Value ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 38" .

ns1:RSP_FacilitiesAccessRights_Requirement a owl:NamedIndividual ;
    rdfs:label "RSP Facilities Access Rights Requirement" ;
    ns1:hasDescription "RSP must separately acquire the necessary facilities access rights to connect the NNI Bearer to RSP's backhaul transmission cables or RSP Active Equipment."^^xsd:string ;
    ns1:requiresFacilitiesAccessRights ns1:FacilitiesAccessRights_Example ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 12, page 42" .

ns1:RSP_Instance a ns1:RSP,
        owl:NamedIndividual ;
    rdfs:label "Retail Service Provider" ;
    ns1:hasExceedance ns1:ExceedanceEvent_BothLimitations,
        ns1:ExceedanceEvent_MultipleOccasions ;
    ns1:sourceClause "nbn Ethernet Price List, Section 1.4, Note, p.6" ;
    rdfs:comment "RSP that may exceed download and upload limitations triggering charges under section 6. [extension: nbn Ethernet Price List, Section 6(d)-(e), p.18]" .

ns1:RSP_MultipleCVCs_Note a owl:NamedIndividual ;
    rdfs:label "RSP Multiple CVCs within CSA Note" ;
    ns1:hasDescription "It is possible that RSP may have multiple CVCs within a CSA delivered using a number of NNI"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26" .

ns1:RSP_Nominates_SCVID a owl:NamedIndividual ;
    rdfs:label "RSP Nominates S/C-VID" ;
    ns1:isOptional true ;
    ns1:nominatesSCVID ns1:SCVID_Nominated_Value ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 38" .

ns1:RSP_Orders_ALI a ns1:RSP_OrdersAccessLoopID,
        owl:NamedIndividual ;
    rdfs:label "RSP Orders Access Loop Identification" ;
    ns1:hasDescription "RSP may optionally order a unicast AVC to have Access Loop Identification, and where applicable, Line Characteristic information inserted into DHCPv4, DHCPv6 and PPPoE upstream Layer 3 control packets in alignment with TR-101"^^xsd:string ;
    ns1:includesAccessLoopID ns1:AccessLoopID_Example ;
    ns1:ordersForAVC ns1:Unicast_1_1_AVC_Instance ;
    ns1:rspOrders ns1:RSP_Generic ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24" .

ns1:RSP_Products_Using_AVC_TC4 a owl:NamedIndividual ;
    rdfs:label "RSP Products Using AVC TC-4" ;
    ns1:hasDescription "RSP Products that use AVC TC-4s as an input"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33" .

ns1:RSP_Purchase_CVC_Example a owl:NamedIndividual ;
    rdfs:label "RSP May Purchase CVC in Relation to CSA" ;
    ns1:hasDescription "Subject to section 2.1(d) of the nbn Ethernet Product Description, the number of CVCs that RSP may purchase in relation to a given CSA is limited only by the NNI resources that RSP has purchased for that CSA"^^xsd:string ;
    ns1:inRelationToCSA ns1:CSA_Example ;
    ns1:limitedByNNIResources ns1:NNIGroup_Example ;
    ns1:mayPurchase ns1:CVC_1_1_VLAN_Scalability_Example ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28" ;
    ns1:subjectToClause ns1:DocumentSection_2_1_d .

ns1:RSP_RequiresAccess_Example a owl:NamedIndividual ;
    rdfs:label "RSP Requires Access to More Than 4,000 AVCs" ;
    ns1:hasDescription "Where RSP requires access to more than 4,000 AVCs in a given CSA, it is necessary to utilise more than one CVC"^^xsd:string ;
    ns1:inRelationToCSA ns1:CSA_Example ;
    ns1:requiresAccessTo ns1:Unicast_1_1_AVC_Addressed_Example ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28" ;
    ns1:utilisesMoreThanOneCVC ns1:CVC_1_1_VLAN_Scalability_Example .

ns1:RedundancyMode_DIVERSE_CHASSIS_Desc a owl:NamedIndividual ;
    rdfs:label "Diverse Chassis Mode Description" ;
    ns1:hasDescription "Diverse Chassis redundancy mode, where NNI Bearers are connected across a pair of chassis"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2, page 28" .

ns1:RedundancyMode_SINGLE_CHASSIS_Desc a owl:NamedIndividual ;
    rdfs:label "Single Chassis Mode Description" ;
    ns1:hasDescription "Single Chassis redundancy mode, where all NNI Bearers are connected to the same chassis"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2, page 28" .

ns1:Rule_AVCTC1_HFC_CM820B_Limit a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "AVC TC-1 HFC CM820B Limit Rule" ;
    ns1:hasCondition "AVC TC-1 bandwidth profile above 2 Mbps is ordered on nbn Ethernet (HFC) using the CM820B variant of the HFC-NTD" ;
    ns1:hasConsequence "the AVC TC-1 bandwidth profile above 2 Mbps is not available" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.3(a) Note, p.13" .

ns1:Rule_AVCTC1_UNIV_RequiresUNIV a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "AVC TC-1 mapped to UNI-V requires UNI-V Rule" ;
    ns1:hasCondition "RSP elects to order a 0.15 Mbps AVC TC-1 which is mapped to the UNI-V" ;
    ns1:hasConsequence "RSP must acquire a UNI-V in conjunction with that AVC TC-1" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 6(b), p.20" .

ns1:Rule_AVCTC1_UNIV_SeparateAVC a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "AVC TC-1 mapped to UNI-V supplied through separate AVC Rule" ;
    ns1:hasCondition "the AVC TC-1 is mapped to the UNI-V" ;
    ns1:hasConsequence "the 0.15 Mbps AVC TC-1 will be supplied through a separate AVC and not included in the overall AVC TC-4 Data Transfer Rate" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 6(c), p.20" .

ns1:Rule_AVCTC4_Requires_UNID a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "AVC TC-4 Requires UNI-D Rule" ;
    ns1:hasCondition "an AVC TC-4 Product Component of nbn Ethernet (Fibre), nbn Ethernet (FTTC), nbn Ethernet (HFC), nbn Ethernet (Wireless) or nbn Ethernet (Satellite) is supplied" ;
    ns1:hasConsequence "RSP also acquires a UNI-D in conjunction with that AVC TC-4 for each Premises at which nbn Ethernet will be supplied" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.2(c), p.17" .

ns1:Rule_AVCTC4_Requires_UNIDSL a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "AVC TC-4 Requires UNI-DSL Rule" ;
    ns1:hasCondition "an AVC TC-4 Product Component of nbn Ethernet (FTTB) or nbn Ethernet (FTTN) is supplied" ;
    ns1:hasConsequence "RSP also acquires a UNI-DSL in conjunction with that AVC TC-4 for each Premises at which nbn Ethernet will be supplied" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.4(b), p.17" .

ns1:Rule_AssociateLikeNNI a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Associate Like NNI Rule" ;
    ns1:hasCondition "RSP associates CVCs and AVC/UNIs with a V-NNI" ;
    ns1:hasConsequence "RSP must do so in the same way as an NNI" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 1.4(c), p.7" .

ns1:Rule_BeamCapacityDecline a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Beam Capacity Decline Rule" ;
    ns1:hasCondition "an AVC order or AVC modification would require additional Beam capacity to be supplied during any period in which a Beam is at or near maximum capacity" ;
    ns1:hasConsequence "nbn may decline that AVC order or AVC modification" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.7(c), p.15" .

ns1:Rule_BeamDeprioritisation a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Beam Deprioritisation Rule" ;
    ns1:hasCondition "an AVC contributes disproportionately to Beam capacity utilisation" ;
    ns1:hasConsequence "nbn may deprioritise data transfers or reduce the maximum data transfer rate of that AVC" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.7(d), p.15" .

ns1:Rule_CIRLineRateInsufficient a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CIR Line Rate Insufficient Rule" ;
    ns1:hasCondition "the Line Rate of an nbn Ethernet Ordered Product is not capable of supporting the provision of all AVC TC-1 and AVC TC-2 bandwidth profiles ordered by RSP in respect of that Ordered Product (including as set out in sections 3.2.2 and 3.3.2 of the nbn Ethernet Product Technical Specification)" ;
    ns1:hasConsequence "for both AVC TC-1 and AVC TC-2: (a) the Information Rate experienced by RSP, Downstream Service Provider and End Users may each be significantly less than the downstream CIR and upstream CIR of the bandwidth profile ordered by RSP; and (b) the Frame Delay, Frame Delay Variation and Frame Loss of the relevant Ordered Product may each be significantly worse than the Traffic Class performance specified in section 7.1 of the nbn Ethernet Product Technical Specification" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.5, p.15" .

ns1:Rule_CSAServedByOnePOI a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CSA Served by One POI Rule" ;
    ns1:hasCondition "a CSA exists in the nbn Network" ;
    ns1:hasConsequence "that CSA is served by exactly one POI" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 12.1(d)(i), p.26" ;
    rdfs:comment "Each CSA is served by one POI. [extension: nbn Ethernet Product Module, Section 12.1(d)(i), p.26]" .

ns1:Rule_CVCNotCrossTech_NonSat a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC Non-Satellite Not Cross-Available Rule" ;
    ns1:hasCondition "a CVC is supplied in respect of nbn Ethernet supplied by means of any access technology other than the Satellite Network" ;
    ns1:hasConsequence "it will not be made available in respect of nbn Ethernet (Satellite)" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.1(d)(ii), p.7" .

ns1:Rule_CVCNotCrossTech_Sat a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC Satellite Not Cross-Available Rule" ;
    ns1:hasCondition "a CVC is supplied in respect of nbn Ethernet (Satellite)" ;
    ns1:hasConsequence "it will not be made available in respect of nbn Ethernet supplied by means of any other access technology" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.1(d)(i), p.7" .

ns1:Rule_CVCSizeDiscretion a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC Size at RSP Discretion Rule" ;
    ns1:hasCondition "RSP orders a CVC for a CSA where nbn supplies nbn Ethernet to RSP" ;
    ns1:hasConsequence "the size of the CVC that RSP requires is at the discretion of RSP (subject to section 2 and the nbn Ethernet Fair Use Policy)" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2, p.7" .

ns1:Rule_CVCTC1_Available a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC TC-1 Availability Rule" ;
    ns1:hasCondition "RSP orders a CVC TC-1" ;
    ns1:hasConsequence "CVC TC-1 is available in respect of nbn Ethernet (Fibre), nbn Ethernet (FTTB), nbn Ethernet (FTTN), nbn Ethernet (FTTC), nbn Ethernet (HFC), nbn Ethernet (Wireless) and nbn Ethernet (Satellite)" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.3(a), p.8" .

ns1:Rule_CVCTC4_Available a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC TC-4 Availability Rule" ;
    ns1:hasCondition "RSP orders a CVC TC-4" ;
    ns1:hasConsequence "CVC TC-4 is available in respect of nbn Ethernet (Fibre), nbn Ethernet (FTTB), nbn Ethernet (FTTN), nbn Ethernet (FTTC), nbn Ethernet (HFC), nbn Ethernet (Wireless) and nbn Ethernet (Satellite)" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.2(a), p.7" .

ns1:Rule_CVCTC4_BWProfiles_Fibre a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC TC-4 Bandwidth Profiles for Fibre etc." ;
    ns1:hasCondition "RSP orders a CVC TC-4 in respect of nbn Ethernet (Fibre), nbn Ethernet (FTTB), nbn Ethernet (FTTN), nbn Ethernet (FTTC), nbn Ethernet (HFC) or nbn Ethernet (Wireless)" ;
    ns1:hasConsequence "the CVC TC-4 bandwidth profiles available are as set out in the relevant sections" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.2(c)(i), p.7" .

ns1:Rule_CVCTC4_BWProfiles_Sat a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC TC-4 Bandwidth Profiles for Satellite" ;
    ns1:hasCondition "RSP orders a CVC TC-4 in respect of nbn Ethernet (Satellite)" ;
    ns1:hasConsequence "the CVC TC-4 bandwidth profiles available are as set out in the relevant sections" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.2(c)(ii), p.7" .

ns1:Rule_DetailsAvailableOnRequest a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Details of FSA/WSA, CSA and POI Available on Request Rule" ;
    ns1:hasCondition "RSP requests details of the serving area or POI for a Premises" ;
    ns1:hasConsequence "details of the FSA or WSA, CSA and POI serving that Premises are available to RSP" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 12.1(e), p.26" ;
    rdfs:comment "Details of the FSA or WSA, CSA and POI serving a Premises are available to RSP on request. [extension: nbn Ethernet Product Module, Section 12.1(e), p.26]" .

ns1:Rule_DiverseChassis a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Diverse Chassis Rule" ;
    ns1:hasCondition "RSP selects diverse chassis as the redundancy mode for an NNI Group" ;
    ns1:hasConsequence "each NNI Bearer in that NNI Group will be connected across a pair of chassis" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 1.3(e), p.7" .

ns1:Rule_EnhancedFaultRectification_NotAvailable_IsolatedLimited a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Enhanced Fault Rectification Not Available in Isolated/Limited Access Area Rule" ;
    ns1:hasCondition "a Premises is in an Isolated Area or Limited Access Area" ;
    ns1:hasConsequence "the Enhanced Fault Rectification Service is not available in respect of that Premises" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 5(f), p.20" .

ns1:Rule_FTTCBoundary_MDU a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "FTTC Network Boundary for MDU Rule" ;
    ns1:hasCondition "a Premises served by the FTTC Network is at an MDU Site" ;
    ns1:hasConsequence "the nbn Downstream Network Boundary is the Customer Side MDF" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.6(b)(i), p.19" ;
    rdfs:comment "For a Premises served by the FTTC Network that is at an MDU Site, the nbn Downstream Network Boundary is the Customer Side MDF. [extension: nbn Ethernet Product Module, Section 4.6(b)(i), p.19]" .

ns1:Rule_FTTCBoundary_NonMDU a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "FTTC Network Boundary for Non-MDU Rule" ;
    ns1:hasCondition "a Premises served by the FTTC Network is not at an MDU Site" ;
    ns1:hasConsequence "the nbn Downstream Network Boundary is the first Telecommunications Outlet or, if present, Passive NTD" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.6(b)(ii), p.19" ;
    rdfs:comment "For a Premises served by the FTTC Network that is not at an MDU Site, the nbn Downstream Network Boundary is the first Telecommunications Outlet or, if present, Passive NTD. [extension: nbn Ethernet Product Module, Section 4.6(b)(ii), p.19]" .

ns1:Rule_FTTCNCD_Not_NTD a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "FTTC-NCD is not a Network Termination Device Rule" ;
    ns1:hasCondition "an FTTC-NCD is used" ;
    ns1:hasConsequence "the FTTC-NCD is not a Network Termination Device" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.6(c), p.19" ;
    rdfs:comment "The FTTC-NCD is not a Network Termination Device. [extension: nbn Ethernet Product Module, Section 4.6(c), p.19]" .

ns1:Rule_FixedLineHierarchy a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Fixed-Line Network Hierarchy Rule" ;
    ns1:hasCondition "a Premises at which nbn Ethernet is available is in the Fibre Network, FTTB Network, FTTN Network, FTTC Network or HFC Network" ;
    ns1:hasConsequence "the Premises is located within an ADA, the ADA is located within a SAM, the SAM is located within an FSA, and the FSA is located within a CSA" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 12.1(a), p.26" ;
    rdfs:comment "In the Fibre Network, FTTB Network, FTTN Network, FTTC Network and HFC Network, each Premises is located within an ADA, each ADA is located within a SAM, each SAM is located within an FSA, and each FSA is located within a CSA. [extension: nbn Ethernet Product Module, Section 12.1(a), p.26]" .

ns1:Rule_MaxAVCTC1_HomeProfiles a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Maximum AVC TC-1 Capacity for Home Fast etc. Rule" ;
    ns1:hasCondition "RSP orders an AVC TC-1 in respect of any Home Fast, Home Superfast, Home Ultrafast, Home Hyperfast or 2000/500 Mbps (PIR) AVC TC-4 bandwidth profile" ;
    ns1:hasConsequence "the maximum AVC TC-1 capacity is 0.15 symmetrical Mbps" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.3(e), p.13" .

ns1:Rule_MaxAVCTC1_Wireless a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Maximum AVC TC-1 Capacity for Wireless Rule" ;
    ns1:hasCondition "RSP orders an AVC TC-1 in respect of each NTD used by nbn to supply nbn Ethernet (Wireless)" ;
    ns1:hasConsequence "the maximum AVC TC-1 capacity is 0.6 symmetrical Mbps" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.3(d), p.13" .

ns1:Rule_Min1600AvcsBeforeMoreCvc a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Minimum 1,600 AVCs Before Further CVC TC-4 Rule" ;
    ns1:hasCondition "RSP orders any further CVC TC-4 in the same CVC Class" ;
    ns1:hasConsequence "RSP must have associated at least 1,600 AVCs with each CVC TC-4" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.2(e)(ii), p.8" .

ns1:Rule_MinAvcsAtAllTimes a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Minimum AVCs at All Times Rule" ;
    ns1:hasCondition "RSP has a CVC TC-4 in respect of nbn Ethernet (Satellite)" ;
    ns1:hasConsequence "RSP must at all times associate at least the minimum number of AVCs with each CVC TC-4 as specified in the table per CVC Class and bandwidth profile tier" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.2(e)(iii), p.8" .

ns1:Rule_MultipleCvcSameClass a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Multiple CVCs in Same Class Rule" ;
    ns1:hasCondition "RSP orders more than one CVC in a CVC Class" ;
    ns1:hasConsequence "each limitation in section 2.2(e) applies to each such CVC" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.2(e) Note, p.8" .

ns1:Rule_MustSelectBandwidthProfile a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Must Select Bandwidth Profile Rule" ;
    ns1:hasCondition "RSP orders a CVC TC-4" ;
    ns1:hasConsequence "RSP must select a bandwidth profile for the CVC TC-4" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.2(b), p.7" .

ns1:Rule_MustSelectBwProfile_TC1 a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Must Select Bandwidth Profile for CVC TC-1 Rule" ;
    ns1:hasCondition "RSP orders a CVC TC-1" ;
    ns1:hasConsequence "RSP must select a bandwidth profile for the CVC TC-1" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.3(b), p.8" .

ns1:Rule_NoNTD_FTTB_FTTN a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "No NTD or FTTC-NCD for FTTB/FTTN Rule" ;
    ns1:hasCondition "nbn Ethernet (FTTB) or nbn Ethernet (FTTN) is supplied" ;
    ns1:hasConsequence "there is no NTD or FTTC-NCD used in connection with the supply of nbn Ethernet (FTTB) or nbn Ethernet (FTTN)" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 7, p.18" .

ns1:Rule_POIMayServeMultipleCSAs a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "POI May Serve Multiple CSAs Rule" ;
    ns1:hasCondition "a POI exists in the nbn Network" ;
    ns1:hasConsequence "that POI may serve one or more CSAs" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 12.1(d)(ii), p.26" ;
    rdfs:comment "A POI may serve one or more CSAs. [extension: nbn Ethernet Product Module, Section 12.1(d)(ii), p.26]" .

ns1:Rule_PowerOutageSupplyRestriction a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Power Outage Supply Restriction Rule" ;
    ns1:hasCondition "a Power Outage occurs in the FTTB Network or FTTN Network" ;
    ns1:hasConsequence "nbn may not be able to supply an nbn Ethernet (FTTB) Ordered Product or nbn Ethernet (FTTN) Ordered Product" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 12.3(a), p.26" ;
    rdfs:comment "nbn may not be able to supply an nbn Ethernet (FTTB) Ordered Product or nbn Ethernet (FTTN) Ordered Product in the event of a Power Outage. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" .

ns1:Rule_RSPMustOrderCVC a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "RSP Must Order CVC Rule" ;
    ns1:hasCondition "nbn supplies nbn Ethernet to RSP in a CSA" ;
    ns1:hasConsequence "RSP must order a CVC for that CSA" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2, p.7" .

ns1:Rule_RSPMustSpecifyCvcClass a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "RSP Must Specify CVC Class Rule" ;
    ns1:hasCondition "RSP orders a CVC TC-4 in respect of nbn Ethernet (Satellite)" ;
    ns1:hasConsequence "RSP must specify a CVC Class for each CVC TC-4" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.2(e)(i), p.8" .

ns1:Rule_SatelliteAVCOrderLimit a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Satellite AVC Order Limit Rule" ;
    ns1:hasCondition "RSP places an AVC order in respect of a Premises for nbn Ethernet (Satellite)" ;
    ns1:hasConsequence "RSP must not place, and nbn may decline, an AVC order if the supply of the ordered AVC would result in nbn supplying more than one AVC TC-4 and one associated AVC TC-1 to all nbn's retail service providers in respect of that Premises" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.7(a), p.15" .

ns1:Rule_SatelliteHierarchy a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Satellite Network Hierarchy Rule" ;
    ns1:hasCondition "a Premises at which nbn Ethernet is available is in the Satellite Network" ;
    ns1:hasConsequence "the Premises is located within a Beam, all Premises and Beams are located within a single CSA, and that single CSA geographically overlaps with other CSAs that contain Premises served by other access technologies" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 12.1(c), p.26" ;
    rdfs:comment "In the Satellite Network, each Premises is located within a Beam, and all Premises and Beams are located within a single CSA that geographically overlaps with other CSAs. [extension: nbn Ethernet Product Module, Section 12.1(c), p.26]" .

ns1:Rule_SatelliteTestService_OnboardingCondition a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Satellite Test Service Onboarding Condition Rule" ;
    ns1:hasCondition "RSP requests a Satellite Test Service" ;
    ns1:hasConsequence "nbn will only supply the Satellite Test Service if RSP has successfully On-boarded, or is in the process of On-boarding, for nbn Ethernet (Satellite)" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 7(d)(i), p.20" .

ns1:Rule_SatelliteTestService_RequirementDetermination a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Satellite Test Service Requirement Determination Rule" ;
    ns1:hasCondition "RSP requests a Satellite Test Service" ;
    ns1:hasConsequence "nbn will only supply the Satellite Test Service if nbn determines, acting reasonably, that RSP requires the Satellite Test Service to successfully supply RSP Products to which nbn Ethernet (Satellite) is an input" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 7(d)(ii), p.20" .

ns1:Rule_UNIBondingProhibition a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "UNI Bonding Prohibition Rule" ;
    ns1:hasCondition "RSP becomes aware that an RSP Product is being used by a Downstream Service Provider or End User in connection with the bonding of two or more UNIs (even if nbn is only supplying one of the UNIs to RSP and the other UNI(s) to an Other RSP)" ;
    ns1:hasConsequence "RSP must suspend or terminate that RSP Product" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.7(b), p.15" .

ns1:Rule_UNID_ElectricalInterface a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "UNI-D Electrical Interface Rule" ;
    ns1:hasCondition "UNI-D is made available" ;
    ns1:hasConsequence "the UNI-D has an electrical interface and will not be made available with an optical interface" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.2(b), p.17" .

ns1:Rule_UNID_Not_FTTCBoundary a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "UNI-D is not FTTC Network Boundary Rule" ;
    ns1:hasCondition "a UNI-D is at a Premises served by the FTTC Network" ;
    ns1:hasConsequence "the UNI-D is not the nbn Downstream Network Boundary for the FTTC Network" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.6(a), p.19" ;
    rdfs:comment "The UNI-D at a Premises served by the FTTC Network is not the nbn Downstream Network Boundary for the FTTC Network. [extension: nbn Ethernet Product Module, Section 4.6(a), p.19]" .

ns1:Rule_UNIV_AVCTC1_Bundle_Availability a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "UNI-V and AVC TC-1 Bundle Availability Rule" ;
    ns1:hasCondition "RSP wants to acquire the UNI-V and AVC TC-1 bundle" ;
    ns1:hasConsequence "the bundle is only available for nbn Ethernet (Fibre) and where RSP has also acquired an AVC TC-4 and UNI-D bundle" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 6, p.20" .

ns1:Rule_UNIV_ContinuedSupply_UntilWithdrawal a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "UNI-V Continued Supply Until Withdrawal Rule" ;
    ns1:hasCondition "existing orders for UNI-V Product Features are in place" ;
    ns1:hasConsequence "nbn will continue supplying UNI-V Product Features in respect of existing orders until the UNI-V Product Feature is withdrawn on 31 January 2031, unless disconnected earlier" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

ns1:Rule_UNIV_NoStandardOrder_AfterExpiry a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "UNI-V No Standard Order After Expiry Rule" ;
    ns1:hasCondition "after the expiry of the Continued Ordering Period for the UNI-V Product Feature on 26 May 2024" ;
    ns1:hasConsequence "RSP must not submit an order for a UNI-V Product Feature unless that order is a Transition-out Modify Order or Disconnect Order" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

ns1:Rule_UNIV_PermittedUse a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "UNI-V Permitted Use Rule" ;
    ns1:hasCondition "RSP uses the UNI-V" ;
    ns1:hasConsequence "RSP may only use the UNI-V to transmit voice and data traffic in the voice band" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 6(d), p.20" .

ns1:Rule_UpstreamNNILinkParams a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Upstream NNI Link Parameters Rule" ;
    ns1:hasCondition "a V-NNI is configured with an Upstream NNI Link" ;
    ns1:hasConsequence "the Upstream NNI Link Parameters will be applied to the V-NNI" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 1.4(b), p.7" .

ns1:Rule_WirelessHierarchy a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Wireless Network Hierarchy Rule" ;
    ns1:hasCondition "a Premises at which nbn Ethernet is available is in the Wireless Network" ;
    ns1:hasConsequence "the Premises is located within a WSA, and the WSA is located within a CSA" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 12.1(b), p.26" ;
    rdfs:comment "In the Wireless Network, each Premises is located within a WSA, and each WSA is located within a CSA. [extension: nbn Ethernet Product Module, Section 12.1(b), p.26]" .

ns1:Rule_WirelessPlusNoPIRorCIR a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Wireless Plus No PIR or CIR Rule" ;
    ns1:hasCondition "Wireless Plus is supplied" ;
    ns1:hasConsequence "no PIR or CIR applies in respect of Wireless Plus" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.8(a), p.15" .

ns1:S-TAGPool_Validation a owl:NamedIndividual ;
    rdfs:label "S-TAG Pool Validation" ;
    ns1:hasDescription "The pool of S-TAGs will be validated to ensure that it is not currently assigned to an existing NNI Link or CVC."^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43" .

ns1:SCVID_Allocated_Value_Unique a owl:NamedIndividual ;
    rdfs:label "S/C-VID Unique to RSP Service" ;
    ns1:avoidsMismatch ns1:SCVID_Mismatch_Potential ;
    ns1:isUniqueToRspService true ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 38" .

ns1:SCVID_Allocation_Event a ns1:Cl_SCVIDAllocationEvent,
        owl:NamedIndividual ;
    rdfs:label "S/C-VID Allocation Event" ;
    ns1:hasAgent ns1:nbn_Entity ;
    ns1:hasObjectParticipant ns1:CVC_Example,
        ns1:Unicast_1_1_AVC_Instance ;
    ns1:resultsIn ns1:SCVID_Allocated_Value ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 38" ;
    ns1:triggeredBy ns1:RSP_Generic .

ns1:SatelliteCSA_Instance a ns1:Cl_ConnectivityServingArea,
        owl:NamedIndividual ;
    rdfs:label "Satellite CSA" ;
    ns1:geographicallyOverlapsWith ns1:CSA_ObjectRole ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 12.1(c)(ii)-(iii), p.26" ;
    rdfs:comment "The single CSA that contains all Premises and Beams in the Satellite Network, which geographically overlaps with other CSAs. [extension: nbn Ethernet Product Module, Section 12.1(c)(ii)-(iii), p.26]" .

ns1:SatelliteCvcMinAvcThreshold_For_Satellite a owl:NamedIndividual ;
    rdfs:label "Satellite CVC Minimum AVC Threshold for nbn Ethernet (Satellite)" ;
    ns1:appliesInContext ns1:NetContext_Satellite ;
    ns1:hasMinAvcThreshold ns1:SatelliteCvcTable35 ;
    ns1:hasServiceAttribute ns1:SatelliteCvcMinAvcThreshold_Attribute ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 35, page 79",
        "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 8, page 38" .

ns1:SatelliteLabourRate_Instance a ns1:Cl_SatelliteLabourRate,
        owl:NamedIndividual ;
    rdfs:label "Satellite Labour Rate $98.00/hour" ;
    ns1:currency "AUD" ;
    ns1:hasLabourHours 1.0 ;
    ns1:numericValue 98.00 ;
    ns1:roundedUpToNextFullHour true ;
    ns1:sourceClause "nbn Ethernet Price List, Section 8(b), p.19" ;
    rdfs:comment "$98.00 for each of the total number of labour hours required to perform the relevant activity (rounded up to the next full hour). [extension: nbn Ethernet Price List, Section 8(b), p.19]" .

ns1:SatelliteTestService_Limit_PerBeam a ns1:Cl_ServiceLimit,
        owl:NamedIndividual ;
    rdfs:label "Satellite Test Service Per Beam Limit" ;
    ns1:appliesTo ns1:SatelliteTestService_Instance ;
    ns1:hasLimitCondition "per Beam" ;
    ns1:hasLimitValue 1 ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 7(c)(ii), p.20" ;
    rdfs:comment "Maximum of one Satellite Test Service per Beam. [extension: nbn Ethernet Product Module, Section 7(c)(ii), p.20]" .

ns1:SatelliteTestService_Limit_Total a ns1:Cl_ServiceLimit,
        owl:NamedIndividual ;
    rdfs:label "Satellite Test Service Total Limit" ;
    ns1:appliesTo ns1:SatelliteTestService_Instance ;
    ns1:hasLimitCondition "in total" ;
    ns1:hasLimitValue 5 ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 7(c)(i), p.20" ;
    rdfs:comment "Maximum of five Satellite Test Services in total. [extension: nbn Ethernet Product Module, Section 7(c)(i), p.20]" .

ns1:Satellite_CSA_Note a owl:NamedIndividual ;
    rdfs:label "Satellite CSA Note" ;
    ns1:hasDescription "nbn Ethernet (Satellite) is supplied in a separate single national CSA which geographically overlaps with the other CSAs that contain Premises served by other nbn Network technologies"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, footnote 11, page 28" .

ns1:Satellite_Test_Service a owl:NamedIndividual ;
    rdfs:label "Satellite Test Service" ;
    ns1:sourceClause "nbn Ethernet Price List, Section 1.4, Note, p.6" ;
    rdfs:comment "To be read subject to section 34 of the nbn Ethernet Product Terms. [extension: nbn Ethernet Price List, Section 1.4, Note, p.6]" .

ns1:SecondUNIV_AVCTC1_Bundle_Instance a ns1:SecondUNIV_AVCTC1_Bundle,
        owl:NamedIndividual ;
    rdfs:label "Second UNI-V and AVC TC-1 bundle (0.15 Mbps, Fibre)" ;
    ns1:hasBandwidthTierMbps 0.15 ;
    ns1:hasNetworkType ns1:AccessTechnology_FIBRE ;
    ns1:hasRecurringCharge ns1:RecurringCharge_SecondUNIV_17_50 .

ns1:Section_7 a ns1:Cl_ChargeSection,
        owl:NamedIndividual ;
    rdfs:label "Section 7" ;
    rdfs:comment "Section 7 of the nbn Ethernet Price List (Early disconnection or modification of AVC TC-2 Product Component). [extension: nbn Ethernet Price List, Section 7, p.18]" .

ns1:ServiceFault a owl:Class ;
    rdfs:label "ServiceFault" ;
    rdfs:comment "A service fault as defined in the WBA agreement. [extension: nbn Ethernet Product Module, Section 3.4(c), p.13]" .

ns1:Service_Support_Note a owl:NamedIndividual ;
    rdfs:label "Service Support Note" ;
    ns1:hasDescription "RSP must not exceed the maximum number of Product Components, in aggregate, supported in an NNI Group set out in section 6.6 (the Bearer Limit)"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.6, page 30" .

ns1:SingleChassis_Provisioning_Note a owl:NamedIndividual ;
    rdfs:label "Single Chassis Provisioning" ;
    ns1:hasDescription "In Single Chassis mode, all NNI Bearers of the NNI Group will be provisioned on the same chassis"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2.1, page 28" .

ns1:StartDateEvent a ns1:Cl_StartDate,
        owl:NamedIndividual ;
    rdfs:label "Start Date Event" ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, s5.3, p.15" .

ns1:State_Transition_DownToUp a ns1:Cl_Event,
        owl:NamedIndividual ;
    rdfs:label "State Transition: Down to Up" ;
    ns1:hasAgent ns1:nbn_Entity ;
    ns1:hasDescription "nbn will change this to an up state in co-ordination with RSP"^^xsd:string ;
    ns1:hasObjectParticipant ns1:NNIBearer_Completed_Order ;
    ns1:hasTransitionFrom ns1:State_AdminDown ;
    ns1:hasTransitionTo ns1:State_Up ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 42" .

ns1:Subset_Availability_Note a owl:NamedIndividual ;
    rdfs:label "Subset of Bandwidth Profiles Available" ;
    ns1:hasDescription "Only a subset of bandwidth profiles is available in relation to each of nbn Ethernet (Fibre), nbn Ethernet (Wireless), nbn Ethernet (HFC) and nbn Ethernet (Satellite). Additional restrictions may apply to the supply of certain of those bandwidth profiles." ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes" .

ns1:TC1_Avail_UNI_DSL_FTTB a ns1:AVCFeatureAvailability,
        owl:NamedIndividual ;
    rdfs:label "TC-1 Available on UNI-DSL for FTTB/FTTN" ;
    ns1:availableOnAccessTechnology ns1:AccessTechnology_FTTB ;
    ns1:availableOnUNI ns1:UNI_DSL_Instance ;
    ns1:hasAvailabilityState "Available"^^xsd:string ;
    ns1:hasTrafficClass ns1:TC_1 ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50" .

ns1:TC1_Avail_UNI_D_FTTB a ns1:AVCFeatureAvailability,
        owl:NamedIndividual ;
    rdfs:label "TC-1 Available on UNI-D for FTTB/FTTN" ;
    ns1:availableOnAccessTechnology ns1:AccessTechnology_FTTB ;
    ns1:availableOnUNI ns1:UNI_D_Instance ;
    ns1:hasAvailabilityState "Available"^^xsd:string ;
    ns1:hasTrafficClass ns1:TC_1 ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50" .

ns1:TC1_Avail_UNI_D_FTTC a ns1:AVCFeatureAvailability,
        owl:NamedIndividual ;
    rdfs:label "TC-1 Available on UNI-D for FTTC" ;
    ns1:availableOnAccessTechnology ns1:AccessTechnology_FTTC ;
    ns1:availableOnUNI ns1:UNI_D_Instance ;
    ns1:hasAvailabilityState "Available"^^xsd:string ;
    ns1:hasTrafficClass ns1:TC_1 ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50" .

ns1:TC1_Avail_UNI_D_Fibre a ns1:AVCFeatureAvailability,
        owl:NamedIndividual ;
    rdfs:label "TC-1 Available on UNI-D for Fibre" ;
    ns1:availableOnAccessTechnology ns1:AccessTechnology_FIBRE ;
    ns1:availableOnUNI ns1:UNI_D_Instance ;
    ns1:hasAvailabilityState "Available"^^xsd:string ;
    ns1:hasTrafficClass ns1:TC_1 ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50" .

ns1:TC1_Avail_UNI_D_HFC a ns1:AVCFeatureAvailability,
        owl:NamedIndividual ;
    rdfs:label "TC-1 Available on UNI-D for HFC" ;
    ns1:availableOnAccessTechnology ns1:AccessTechnology_HFC ;
    ns1:availableOnUNI ns1:UNI_D_Instance ;
    ns1:hasAvailabilityState "Available"^^xsd:string ;
    ns1:hasTrafficClass ns1:TC_1 ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50" .

ns1:TC1_Avail_UNI_D_Satellite a ns1:AVCFeatureAvailability,
        owl:NamedIndividual ;
    rdfs:label "TC-1 Available on UNI-D for Satellite" ;
    ns1:availableOnAccessTechnology ns1:AccessTechnology_Satellite ;
    ns1:availableOnUNI ns1:UNI_D_Instance ;
    ns1:hasAvailabilityState "Available"^^xsd:string ;
    ns1:hasTrafficClass ns1:TC_1 ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50" .

ns1:TC1_Avail_UNI_D_Wireless a ns1:AVCFeatureAvailability,
        owl:NamedIndividual ;
    rdfs:label "TC-1 Available on UNI-D for Wireless" ;
    ns1:availableOnAccessTechnology ns1:AccessTechnology_Wireless ;
    ns1:availableOnUNI ns1:UNI_D_Instance ;
    ns1:hasAvailabilityState "Available"^^xsd:string ;
    ns1:hasTrafficClass ns1:TC_1 ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50" .

ns1:TC1_Avail_UNI_V_Fibre a ns1:AVCFeatureAvailability,
        owl:NamedIndividual ;
    rdfs:label "TC-1 Available on UNI-V for Fibre" ;
    ns1:availableOnAccessTechnology ns1:AccessTechnology_FIBRE ;
    ns1:availableOnUNI ns1:UNI_V_Instance ;
    ns1:hasAvailabilityState "Available"^^xsd:string ;
    ns1:hasTrafficClass ns1:TC_1 ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50" .

ns1:TC1_Availability_Limit_Note a owl:NamedIndividual ;
    rdfs:label "TC-1 Capacity Availability Limit" ;
    ns1:appliesToTrafficClass ns1:TC_1 ;
