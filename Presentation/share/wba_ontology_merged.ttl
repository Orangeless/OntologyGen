    ns1:hasNNIGroupInterfaceRateSelection ns1:NNIGroup_Creation_Event ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.1.2, page 40" .

