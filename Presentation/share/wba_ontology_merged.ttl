        ns1:ProductComponent .

ns1:AccessTechnology_Satellite a ns1:AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "Satellite" ;
    ns1:hasDescription "Satellite access technology"^^xsd:string .

ns1:Cl_SatelliteCvcMinAvcThresholdFact a owl:Class ;
    rdfs:label "Satellite CVC Minimum AVC Threshold Fact" ;
    rdfs:comment "A reified fact node representing a specific (bandwidth, CVC Class) to minimum AVC threshold row in Table 35 of the nbn Ethernet Product Technical Specification. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 35, page 79]" ;
    rdfs:subClassOf ns1:Cl_SatelliteCvcMinAvcThreshold .

ns1:TC_4 a ns1:TrafficClass,
        owl:NamedIndividual ;
    rdfs:label "TC-4" ;
    ns1:name "Best effort / bulk" ;
    ns1:planningThresholdPct 80.0 .

ns1:RecurringCharge a owl:Class ;
    rdfs:label "RecurringCharge" ;
