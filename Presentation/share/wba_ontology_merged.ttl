ns1:NNIGroup_Disconnection a owl:NamedIndividual ;
    rdfs:label "NNI Group Disconnection" ;
    ns1:hasDisconnectionBehaviour "Disconnect an existing NNI Group - all underlying NNI Bearers and NNI Links will be automatically disconnected"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 42" .

ns1:NNIGroup_DiverseChassis_Min a ns1:Cl_NNIGroup,
        owl:NamedIndividual ;
    rdfs:label "NNI Group Diverse Chassis Minimum" ;
    ns1:hasDescription "At least one pair of NNI Bearers is required to establish a new NNI Group in Diverse Chassis mode"^^xsd:string ;
    ns1:hasRedundancyMode ns1:RedundancyMode_DIVERSE_CHASSIS ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 42" .

ns1:NNIGroup_DiverseChassis_Ordering a owl:NamedIndividual ;
    rdfs:label "NNI Group Diverse Chassis Ordering" ;
    ns1:hasOrderingConstraint "For NNI Groups configured as Diverse Chassis, NNI Bearers must be ordered in pairs, with each NNI Bearer of each pair provisioned on different chassis"^^xsd:string ;
    ns1:hasRedundancyMode ns1:RedundancyMode_DIVERSE_CHASSIS ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 42" .

ns1:NNIGroup_DiverseChassis_PairBearers a owl:NamedIndividual ;
    rdfs:label "NNI Group Diverse Chassis Pair Bearers" ;
    ns1:hasDescription "In Diverse Chassis mode, the group interface rate is set through the selection of a pair of NNI Bearers at the time the NNI Group is created"^^xsd:string ;
