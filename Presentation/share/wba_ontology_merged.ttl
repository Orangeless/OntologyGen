    rdfs:comment "Indicates that there is no restriction on the number of unicast N:1 AVCs within a CSA that can be associated with a single unicast N:1 CVC at the NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.2, page 28]" ;
    rdfs:domain ns1:CVC_N_1_VLAN ;
    rdfs:range xsd:boolean .

ns1:hasNotAvailableFor a owl:ObjectProperty ;
    rdfs:label "hasNotAvailableFor" ;
    rdfs:comment "Links an interface rate to the product variant for which it is not available. [extension: nbn Ethernet Product Module, section 8.3.1.2, page 40]" ;
    rdfs:domain ns1:Cl_NNIGroupInterfaceRate ;
    rdfs:range ns1:nbnEthernetProduct .

ns1:hasNoticeName a owl:DatatypeProperty ;
    rdfs:label "has notice name" ;
    rdfs:comment "The name of a notice. [extension: nbn Ethernet Price List, Section 7, p.18]" ;
    rdfs:domain ns1:Cl_DefaultNotice ;
    rdfs:range xsd:string .

ns1:hasNotificationStatus a owl:DatatypeProperty ;
    rdfs:label "has notification status" ;
    rdfs:comment "Indicates whether nbn has notified RSP about Network Activity outcome. [extension: nbn Ethernet Price List, Section 7(d)(i), p.19]" ;
    rdfs:range xsd:boolean .

ns1:hasNotifyingParty a owl:ObjectProperty ;
    rdfs:label "has notifying party" ;
    rdfs:comment "Links a Default Notice to the party that gives the notice. [extension: nbn Ethernet Price List, Section 7, p.18]" ;
    rdfs:domain ns1:Cl_DefaultNotice ;
    rdfs:range ns1:Party .

ns1:hasNumericValue a owl:DatatypeProperty ;
    rdfs:label "hasNumericValue" ;
    rdfs:comment "The numeric value of a bandwidth quantity in Mbps. [extension: nbn Ethernet Price List, Section 1.5(c), p.8]" ;
    rdfs:domain ns1:IncludedBandwidth,
        ns1:OrderedBandwidth ;
    rdfs:range xsd:decimal .

ns1:hasObject a owl:ObjectProperty ;
    rdfs:label "hasObject" ;
    rdfs:comment "Links a contractual event to the object participant. [extension: nbn Ethernet Product Module, Section 1-2, p.7]",
        "Links an event to its reified composite object node. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" ;
    rdfs:domain ns1:Cl_ContractualEvent,
        ns1:Cl_Event ;
    rdfs:range owl:Thing .

ns1:hasObjectParticipant a owl:ObjectProperty ;
