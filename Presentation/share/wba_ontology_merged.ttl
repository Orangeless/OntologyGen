    rdfs:domain ns1:AVC_TC2_ProductComponent ;
    rdfs:range xsd:boolean .

ns1:isCancelledBy a owl:ObjectProperty ;
    rdfs:label "isCancelledBy" ;
    rdfs:comment "Links a V-NNI to the CancelVNNIEvent that cancelled it. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:domain ns1:V_NNI ;
    rdfs:range ns1:CancelVNNIEvent .

ns1:isCausedByDisconnection a owl:ObjectProperty ;
    rdfs:label "isCausedByDisconnection" ;
