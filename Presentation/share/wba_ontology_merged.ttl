    rdfs:domain ns1:NNILink ;
    rdfs:range ns1:NNIGroup .

ns1:isCurrentlyAssigned a owl:DatatypeProperty ;
    rdfs:label "isCurrentlyAssigned" ;
    rdfs:comment "Indicates whether an S-TAG pool is currently assigned to an existing NNI Link or CVC, which is validated to ensure it is not. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" ;
    rdfs:domain ns1:S-TAGPool ;
    rdfs:range xsd:boolean .

ns1:isCvcMax a owl:DatatypeProperty ;
    rdfs:label "isCvcMax" ;
