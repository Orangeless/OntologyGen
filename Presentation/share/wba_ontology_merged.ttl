    ns1:hasBandwidthProfile ns1:BandwidthProfile_HomeSuperfast,
        ns1:BandwidthProfile_HomeUltrafast ;
    ns1:hasMinimumThroughputMbps 2 ;
    ns1:isDimensionedOn ns1:SharedNetworkResourceHfc ;
