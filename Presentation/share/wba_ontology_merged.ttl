    rdfs:comment "Links an AVC_RequiredFor node to the AVC variant required. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:domain ns1:AVC_RequiredFor ;
    rdfs:range ns1:AVC .

ns1:requiresAccessTo a owl:ObjectProperty ;
    rdfs:label "requiresAccessTo" ;
    rdfs:comment "Indicates that an RSP requires access to AVCs in a given CSA. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28]" ;
    rdfs:domain ns1:RSP ;
    rdfs:range ns1:AVC .

ns1:requiresAdditionalBeamCapacity a owl:DatatypeProperty ;
    rdfs:label "requiresAdditionalBeamCapacity" ;
    rdfs:comment "Indicates if an AVC order or modification would require additional Beam capacity. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" ;
    rdfs:domain ns1:Cl_ContractualEvent ;
    rdfs:range xsd:boolean .

ns1:requiresCVIDAllocation a owl:ObjectProperty ;
    rdfs:label "requiresCVIDAllocation" ;
    rdfs:comment "Links a service addressing mode to whether C-VID allocation is required. [extension: nbn Ethernet Product Module, page 38]" ;
    rdfs:domain ns1:Cl_ServiceAddressingMode ;
    rdfs:range owl:Thing .

ns1:requiresFacilitiesAccessRights a owl:ObjectProperty ;
    rdfs:label "requiresFacilitiesAccessRights" ;
    rdfs:comment "Links an RSP to the facilities access rights it must separately acquire to connect the NNI Bearer to its backhaul transmission cables or Active Equipment. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 12, page 42]" ;
    rdfs:domain ns1:RSP ;
    rdfs:range ns1:FacilitiesAccessRights .

ns1:reserves a owl:ObjectProperty ;
    rdfs:label "reserves" ;
    rdfs:comment "Links an NNI Link to the S-TAG pool and bandwidth profile it reserves from an NNI Group. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.3, page 30]" ;
    rdfs:domain ns1:NNILink ;
    rdfs:range owl:Thing .

ns1:resilienceScore a owl:DatatypeProperty ;
    rdfs:label "resilience_score" ;
    rdfs:domain ns1:CandidateAction ;
    rdfs:range xsd:double .

ns1:restrictsCancellation a owl:ObjectProperty ;
    rdfs:label "restrictsCancellation" ;
    rdfs:comment "Links a Downstream V-NNI to the Cancel an existing NNI Link event it restricts. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" ;
    rdfs:domain ns1:DownstreamV-NNI ;
    rdfs:range ns1:CancelAnExistingNNILink .

ns1:restrictsModification a owl:ObjectProperty ;
    rdfs:label "restrictsModification" ;
    rdfs:comment "Links a Downstream V-NNI to the Modify an existing NNI Link event it restricts. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" ;
    rdfs:domain ns1:DownstreamV-NNI ;
    rdfs:range ns1:ModifyAnExistingNNILink .

ns1:restrictsProduct a owl:ObjectProperty ;
    rdfs:label "restrictsProduct" ;
    rdfs:comment "Links a Supply Restriction to the Ordered Product that may not be supplied. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" ;
    rdfs:domain ns1:Cl_SupplyRestriction ;
    rdfs:range ns1:Cl_OrderedProduct .

ns1:resultsIn a owl:ObjectProperty ;
    rdfs:label "resultsIn" ;
    rdfs:comment "Links a Cl_ProvisioningEvent to the resulting state (TC-1 capacity provisioned on UNI-V). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52, footnote 38]",
        "Links an event to the value it produces. [extension: nbn Ethernet Product Module, page 38]" ;
    rdfs:domain ns1:Cl_Event,
        ns1:Cl_ProvisioningEvent ;
    rdfs:range owl:Thing .

ns1:resultsInMoreThanOneAVCTC4AndOneAVCTC1 a owl:DatatypeProperty ;
    rdfs:label "resultsInMoreThanOneAVCTC4AndOneAVCTC1" ;
    rdfs:comment "Indicates if an AVC order would result in nbn supplying more than one AVC TC-4 and one associated AVC TC-1 to all retail service providers in respect of a Premises. [extension: nbn Ethernet Product Module, Section 3.7(a), p.15]" ;
    rdfs:domain ns1:Cl_AVCOrder ;
    rdfs:range xsd:boolean .

ns1:resultsInState a owl:DatatypeProperty ;
    rdfs:label "resultsInState" ;
    rdfs:comment "The resulting state of an Ordered Product after an event. [extension: nbn Ethernet Product Module, Section 3.6(c), p.15]" ;
    rdfs:domain ns1:Cl_ContractualEvent ;
    rdfs:range xsd:string .

ns1:returnedInAccordanceWith a owl:ObjectProperty ;
    rdfs:label "returnedInAccordanceWith" ;
    rdfs:comment "Links an S/C-VID value to the WBA Operations Manual in accordance with which it is returned to RSP. [extension: nbn Ethernet Product Module, page 38]" ;
    rdfs:domain ns1:S_C_VID ;
    rdfs:range ns1:Cl_WBAOperationsManual .

ns1:riskRating a owl:ObjectProperty ;
    rdfs:label "risk_rating" ;
    rdfs:domain ns1:CSA ;
    rdfs:range ns1:RiskRating .

ns1:riskScore a owl:DatatypeProperty ;
    rdfs:label "risk_score" ;
    rdfs:domain ns1:CandidateAction ;
    rdfs:range xsd:double .

ns1:roundedUpToNextFullHour a owl:DatatypeProperty ;
    rdfs:label "rounded up to next full hour" ;
    rdfs:comment "Indicates that labour hours are rounded up to the next full hour. [extension: nbn Ethernet Price List, Section 8, p.19]" ;
    rdfs:range xsd:boolean .

ns1:rspOrders a owl:ObjectProperty ;
    rdfs:label "rspOrders" ;
    rdfs:comment "Links an RSP_OrdersAccessLoopID node to the RSP. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" ;
    rdfs:domain ns1:RSP_OrdersAccessLoopID ;
    rdfs:range ns1:RSP .

ns1:scalabilityConsiders a owl:ObjectProperty ;
    rdfs:label "scalabilityConsiders" ;
    rdfs:comment "Links a CVC_Scalability node to the contention concept. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2, page 27]" ;
    rdfs:domain ns1:CVC_Scalability ;
    rdfs:range ns1:Contention .

ns1:scalabilityOfAVC a owl:ObjectProperty ;
    rdfs:label "scalabilityOfAVC" ;
    rdfs:comment "Links a CVC_Scalability node to the AVC. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2, page 27]" ;
    rdfs:domain ns1:CVC_Scalability ;
    rdfs:range ns1:AVC .

ns1:scalabilityOfCVC a owl:ObjectProperty ;
    rdfs:label "scalabilityOfCVC" ;
    rdfs:comment "Links a CVC_Scalability node to the CVC. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2, page 27]" ;
    rdfs:domain ns1:CVC_Scalability ;
    rdfs:range ns1:CVC .

ns1:scaledThrough a owl:ObjectProperty ;
    rdfs:label "scaledThrough" ;
    rdfs:comment "Links an AVC to its scaling reification node. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:domain ns1:AVC ;
    rdfs:range ns1:AVC_ScaledThrough .

ns1:scalesAVC a owl:ObjectProperty ;
    rdfs:label "scalesAVC" ;
    rdfs:comment "Links an AVC_ScaledThrough node to the AVC it scales. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:domain ns1:AVC_ScaledThrough ;
    rdfs:range ns1:AVC .

ns1:scalingBoundsDescription a owl:DatatypeProperty ;
    rdfs:label "scalingBoundsDescription" ;
    rdfs:comment "Describes the bounds within which an AVC can be scaled. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:domain ns1:AVC_ScaledThrough ;
    rdfs:range xsd:string .

ns1:servedAt a owl:ObjectProperty ;
    rdfs:domain ns1:CSA ;
    rdfs:range ns1:POI .

ns1:servedByPOI a owl:ObjectProperty ;
    rdfs:label "servedByPOI" ;
    rdfs:comment "Links a CSA to the POI that serves it. Each CSA is served by exactly one POI. [extension: nbn Ethernet Product Module, Section 12.1(d)(i), p.26]" ;
    rdfs:domain ns1:Cl_ConnectivityServingArea ;
    rdfs:range ns1:POI .

ns1:servesCSA a owl:ObjectProperty ;
    rdfs:label "servesCSA" ;
    rdfs:comment "Links a POI to the CSAs it serves. A POI may serve one or more CSAs. [extension: nbn Ethernet Product Module, Section 12.1(d)(ii), p.26]" ;
    rdfs:domain ns1:POI ;
    rdfs:range ns1:Cl_ConnectivityServingArea .

ns1:servesPremises a owl:ObjectProperty ;
    rdfs:label "servesPremises" ;
    rdfs:comment "Links a UNI to the Premises it serves. [extension: nbn Ethernet Product Module, Section 3.1(a), p.10]" ;
    rdfs:domain ns1:UNI ;
    rdfs:range ns1:Premises .

ns1:services a owl:DatatypeProperty ;
    rdfs:label "services" ;
    rdfs:domain ns1:CSA ;
    rdfs:range xsd:integer .

ns1:setOutIn a owl:ObjectProperty ;
    rdfs:label "setOutIn" ;
    rdfs:comment "Links availability information to the document section where it is set out. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3, page 25]" ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:DocumentSection .

ns1:sharesCapacity a owl:ObjectProperty ;
    rdfs:label "sharesCapacity" ;
    rdfs:comment "Links a traffic class to its capacity-sharing characteristic. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" ;
    rdfs:domain ns1:TrafficClass ;
    rdfs:range ns1:Cl_CapacitySharing .

ns1:singleActionResolvesAllMust a owl:DatatypeProperty ;
    rdfs:label "single_action_resolves_all_must" ;
    rdfs:domain ns1:CandidateAction ;
    rdfs:range xsd:boolean .

ns1:sourceClause a owl:AnnotationProperty ;
    rdfs:comment "Document, clause and page a contract fact comes from." .

ns1:specificToRSP a owl:ObjectProperty ;
    rdfs:label "specificToRSP" ;
    rdfs:comment "Links an NNI to its RSP specificity reification node. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" ;
    rdfs:domain ns1:NNI ;
    rdfs:range ns1:NNI_SpecificToRSP .

ns1:specifiedFor a owl:ObjectProperty ;
    rdfs:label "specifiedFor" ;
    rdfs:comment "Links a CVC Class to the CVC it is specified for. [extension: nbn Ethernet Product Module, Section 2.2(e)(i), p.8]" ;
    rdfs:domain ns1:Cl_CvcClass ;
    rdfs:range ns1:CVC .

ns1:specifiedIn a owl:ObjectProperty ;
    rdfs:label "specifiedIn" ;
    rdfs:comment "Links a feature to the document that specifies its detailed specifications. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 25]" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

ns1:specifiedInProductOrderForm a owl:ObjectProperty ;
    rdfs:label "specifiedInProductOrderForm" ;
    rdfs:comment "Links an S/C-VID to the Product Order Form in which it is specified. [extension: nbn Ethernet Product Module, page 38]" ;
    rdfs:domain ns1:S_C_VID ;
    rdfs:range ns1:Cl_ProductOrderForm .

ns1:startsAt a owl:ObjectProperty ;
    rdfs:label "starts at" ;
    rdfs:comment "Links a PIR Affected Billing Period to the event that starts it (Start Date or Trouble Ticket acknowledgment). [extension: WBA Ethernet Service Levels Schedule, s5.3, p.15]",
        "Links an Activation's Service Level to the Order Acknowledgement event that starts the clock. [extension: WBA Ethernet Service Levels Schedule, p.13]" ;
    rdfs:domain ns1:Cl_PirAffectedBillingPeriod ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ns1:Cl_StartDate ns1:Cl_TroubleTicket ) ] .

ns1:state a owl:DatatypeProperty ;
    rdfs:label "state" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:AVC ns1:Bearer ns1:CSA ns1:POI ) ],
        [ a owl:Class ;
            owl:unionOf ( ns1:AVC ns1:Bearer ns1:CSA ns1:POI ) ],
        [ a owl:Class ;
            owl:unionOf ( ns1:AVC ns1:Bearer ns1:CSA ns1:POI ) ],
        [ a owl:Class ;
            owl:unionOf ( ns1:AVC ns1:Bearer ns1:CSA ns1:POI ) ] ;
    rdfs:range xsd:string .

ns1:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:domain ns1:CandidateAction ;
    rdfs:range xsd:string .

ns1:subjectToAdditionalLimitations a owl:ObjectProperty ;
    rdfs:label "subjectToAdditionalLimitations" ;
    rdfs:comment "Indicates that additional limitations apply in respect of a specific network type. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.3.1, page 28]" ;
    rdfs:domain ns1:CVC_BandwidthProfile ;
    rdfs:range ns1:Cl_SatelliteNetwork .

ns1:subjectToClause a owl:ObjectProperty ;
    rdfs:label "subjectToClause" ;
    rdfs:comment "Links a reification node to the document clause it is subject to. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:DocumentSection .

ns1:subjectToDocumentSection a owl:ObjectProperty ;
    rdfs:label "subjectToDocumentSection" ;
    rdfs:comment "Links a Satellite CVC table to the document section it is subject to. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 35, page 79]" ;
    rdfs:domain ns1:Cl_SatelliteCvcTable ;
    rdfs:range ns1:DocumentSection .

ns1:subscribedTo a owl:ObjectProperty ;
    rdfs:label "subscribedTo" ;
    rdfs:comment "Links a data stream result to the subscribed Traffic Class CIR. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 33]" ;
    rdfs:domain owl:Thing ;
    rdfs:range ns1:Cl_SpecificationType .

ns1:subscriberGrowthPct a owl:DatatypeProperty ;
    rdfs:label "subscriber_growth_pct" ;
    rdfs:domain ns1:CSA ;
    rdfs:range xsd:double .

ns1:suppliedAt a owl:ObjectProperty ;
    rdfs:label "suppliedAt" ;
    rdfs:comment "Links an NNI Bearer Product Component to the POI where it is supplied. [extension: nbn Ethernet Price List, Section 1.6(c), p.8]" ;
    rdfs:domain ns1:NNIBearerProductComponent ;
    rdfs:range ns1:POI .

ns1:suppliedByAccessTechnology a owl:ObjectProperty ;
    rdfs:label "suppliedByAccessTechnology" ;
    rdfs:comment "The access technology by which an nbn Ethernet product is supplied. [extension: nbn Ethernet Product Module, Section 1.1(f), p.6]" ;
    rdfs:domain ns1:nbnEthernetProduct ;
    rdfs:range ns1:AccessTechnology .

ns1:supplies a owl:ObjectProperty ;
    rdfs:label "supplies" ;
    rdfs:comment "Links a Supplier to the NNI Bearer Product Component it supplies. [extension: nbn Ethernet Price List, Section 1.6(c), p.8]" ;
    rdfs:domain ns1:Supplier ;
    rdfs:range ns1:NNIBearerProductComponent .

ns1:supportsAssociationOf a owl:ObjectProperty ;
    rdfs:label "supportsAssociationOf" ;
    rdfs:comment "Links a V-NNI to the single NNI Link it supports the association of. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.4, page 30]" ;
    rdfs:domain ns1:V_NNI ;
    rdfs:range ns1:NNILink .

ns1:supportsBundle a owl:ObjectProperty ;
    rdfs:label "supportsBundle" ;
    rdfs:comment "Links an AvailabilityConstraint to the bundle it supports. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain ns1:Cl_AvailabilityConstraint ;
    rdfs:range ns1:Cl_Bundle .

ns1:supportsCVC a owl:ObjectProperty ;
    rdfs:label "supportsCVC" ;
    rdfs:comment "Associates an NNI Group with a CVC it supports. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 6.5]" ;
    rdfs:domain ns1:NNIGroup ;
    rdfs:range ns1:CVC .

ns1:supportsClassOfService a owl:ObjectProperty ;
    rdfs:label "supportsClassOfService" ;
    rdfs:comment "Links an NNI Group to its reified class of service support description. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.7, page 31]",
        "Reified relationship between NNI Group and a class of service support description. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 6.7]" ;
    rdfs:domain ns1:NNIGroup ;
    rdfs:range ns1:Cl_ClassOfServiceSupport,
        owl:Thing .

ns1:supportsService a owl:ObjectProperty ;
    rdfs:label "supportsService" ;
    rdfs:comment "Reified relationship between NNI Group and a service support description. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 6.6]" ;
    rdfs:domain ns1:NNIGroup ;
    rdfs:range owl:Thing .

ns1:targetsApplications a owl:ObjectProperty ;
    rdfs:label "targetsApplications" ;
    rdfs:comment "Links a traffic class to an example application it targets. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" ;
    rdfs:domain ns1:TrafficClass ;
    rdfs:range ns1:Cl_Application .

ns1:tc1Pct a owl:DatatypeProperty ;
    rdfs:label "tc1_pct" ;
    rdfs:domain ns1:CVC ;
    rdfs:range xsd:integer .

ns1:tc2Pct a owl:DatatypeProperty ;
    rdfs:label "tc2_pct" ;
    rdfs:domain ns1:CVC ;
    rdfs:range xsd:integer .

ns1:tc4Pct a owl:DatatypeProperty ;
    rdfs:label "tc4_pct" ;
    rdfs:domain ns1:CVC ;
    rdfs:range xsd:integer .

ns1:tech a owl:ObjectProperty ;
    rdfs:label "tech" ;
    rdfs:domain ns1:CSA ;
    rdfs:range ns1:AccessTechnology .

ns1:technology a owl:ObjectProperty ;
    rdfs:label "technology" ;
    rdfs:domain ns1:NNIGroup ;
    rdfs:range ns1:InterfaceTechnology .

ns1:terminatedOn a owl:ObjectProperty ;
    rdfs:label "terminatedOn" ;
    rdfs:comment "Links a CVC to the NNI Group it is terminated on. [extension: nbn Ethernet Product Module, page 38]" ;
    rdfs:domain ns1:CVC ;
    rdfs:range ns1:NNIGroup .

ns1:terminatesAtPoi a owl:ObjectProperty ;
    rdfs:domain ns1:NNIGroup ;
    rdfs:range ns1:POI .

ns1:terminatesOnPort a owl:ObjectProperty ;
    rdfs:domain ns1:Bearer ;
    rdfs:range ns1:PlanningPort .

ns1:transitionsAVCsAndCVCs a owl:ObjectProperty ;
    rdfs:label "transitionsAVCsAndCVCs" ;
    rdfs:comment "Links an NNI Group relocation to the AVCs and CVCs that are transitioned from the previous NNI Group. [extension: nbn Ethernet Product Module, section 8.3.1.1, page 40]" ;
    rdfs:domain ns1:Cl_NNIGroupRelocation ;
    rdfs:range owl:Thing .

ns1:triggeredBy a owl:ObjectProperty ;
    rdfs:label "triggered by",
        "triggeredBy" ;
    rdfs:comment "Links a CVC Class adjustment to the excess usage event that triggers it. [extension: nbn Ethernet Price List, Section 6(a), p.17]",
        "Links a Cl_ProvisioningEvent to the RSP order that triggers it. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52, footnote 38]",
        "Links a Rebate or Credit to the order event that triggers it. [extension: nbn Ethernet Price List, Section 1.4, p.6]",
        "Links an event to the trigger that initiates it. [extension: nbn Ethernet Product Module, page 38]" ;
    rdfs:domain ns1:Cl_CVCClassAdjustment,
        ns1:Cl_Event,
        ns1:Cl_ProvisioningEvent,
        ns1:RebateOrCredit ;
    rdfs:range ns1:Cl_ExcessUsageEvent,
        ns1:OrderedProduct,
        owl:Thing .

ns1:triggers a owl:ObjectProperty ;
    rdfs:label "triggers" ;
    rdfs:comment "Links a Utilisation Threshold to the Utilisation Management Performance Objective it triggers. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]",
        "Links an Interference Event to the Interference Mitigation it triggers. [extension: nbn Ethernet Product Module, Section 3.6(b), p.15]" ;
    rdfs:domain ns1:Cl_InterferenceEvent ;
    rdfs:range ns1:InterferenceMitigation .

ns1:triggersCharge a owl:ObjectProperty ;
    rdfs:label "triggers charge" ;
    rdfs:comment "Links an exceedance event to the charge it triggers. [extension: nbn Ethernet Price List, Section 6(d)-(e), p.18]" ;
    rdfs:domain ns1:Cl_ExceedanceEvent ;
    rdfs:range ns1:Cl_EarlyDisconnectionModificationCharge .

ns1:triggersChargeRule a owl:ObjectProperty ;
    rdfs:label "triggersChargeRule" ;
    rdfs:comment "Links an eSLA Change Event to the charge rule it triggers (application of recurring charge for a single Billing Period without pro-ration). [extension: nbn Ethernet Price List, Section 2.2(b), p.10]" ;
    rdfs:domain ns1:ESLAChangeEvent ;
    rdfs:range ns1:RecurringCharge .

ns1:triggersRebate a owl:ObjectProperty ;
    rdfs:label "triggers rebate" ;
    rdfs:comment "Links a Co-ordinated Appointment (failure event) to the rebate it triggers. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

ns1:unevaluatedConstraintIds a owl:DatatypeProperty ;
    rdfs:label "unevaluated_constraint_ids" ;
    rdfs:domain ns1:CandidateAction ;
    rdfs:range xsd:string .

ns1:unitOfMeasure a owl:DatatypeProperty ;
    rdfs:label "unitOfMeasure" ;
    rdfs:comment "The unit of measure for a quantity (e.g. 'Mbps'). [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:domain ns1:DownstreamPIR,
        ns1:UpstreamPIR ;
    rdfs:range xsd:string .

ns1:unmaterialisedAvcCount a owl:DatatypeProperty ;
    rdfs:label "unmaterialised_avc_count" ;
    rdfs:domain ns1:CVC ;
    rdfs:range xsd:integer .

ns1:unresolvedConstraintIds a owl:DatatypeProperty ;
    rdfs:label "unresolved_constraint_ids" ;
    rdfs:domain ns1:CandidateAction ;
    rdfs:range xsd:string .

ns1:usedByNbnToSupply a owl:ObjectProperty ;
    rdfs:label "usedByNbnToSupply" ;
    rdfs:comment "Links an NTD to the nbn Ethernet product it is used to supply. [extension: nbn Ethernet Product Module, Section 3.3(d), p.13]" ;
    rdfs:domain ns1:NTD ;
    rdfs:range ns1:nbnEthernetProduct .

ns1:usedForAccessing a owl:ObjectProperty ;
    rdfs:label "usedForAccessing" ;
    rdfs:comment "Links an S/C-VID value to the CVC/AVC it is used for accessing at the NNI. [extension: nbn Ethernet Product Module, page 38]" ;
    rdfs:domain ns1:S_C_VID ;
    rdfs:range owl:Thing .

ns1:usesBandwidthProfile a owl:ObjectProperty ;
    rdfs:label "usesBandwidthProfile" ;
    rdfs:comment "Links an AVC_ScaledThrough node to the bandwidth profile used. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:domain ns1:AVC_ScaledThrough ;
    rdfs:range ns1:BandwidthProfile .

ns1:usesCvc a owl:ObjectProperty ;
    rdfs:domain ns1:AVC ;
    rdfs:range ns1:CVC .

ns1:usesLinecard a owl:ObjectProperty ;
    rdfs:domain ns1:Bearer ;
    rdfs:range ns1:PlanningLineCard .

ns1:usesS_C_VID a owl:ObjectProperty ;
    rdfs:label "usesS_C_VID" ;
    rdfs:comment "Links an AVC_LogicalIsolation node to the S/C-VID used. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:domain ns1:AVC_LogicalIsolation ;
    rdfs:range ns1:S_C_VID .

ns1:usesS_VID a owl:ObjectProperty ;
    rdfs:label "usesS_VID" ;
    rdfs:comment "Links a CVC_Isolation node to the S-VID used for isolation. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" ;
    rdfs:domain ns1:CVC_Isolation ;
    rdfs:range ns1:S_VID .

ns1:usesUNI a owl:ObjectProperty ;
    rdfs:label "usesUNI" ;
    rdfs:comment "Links an AVC_RequiredFor node to the UNI type used. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:domain ns1:AVC_RequiredFor ;
    rdfs:range ns1:AVC .

ns1:utilisationPct a owl:DatatypeProperty ;
    rdfs:label "utilisation_pct" ;
    rdfs:comment "= 100 * current load / protected" ;
    rdfs:domain ns1:NNIGroup ;
    rdfs:range xsd:double .

ns1:utilisationScore a owl:DatatypeProperty ;
    rdfs:label "utilisation_score" ;
    rdfs:domain ns1:CandidateAction ;
    rdfs:range xsd:double .

ns1:utilisesMoreThanOneCVC a owl:ObjectProperty ;
    rdfs:label "utilisesMoreThanOneCVC" ;
    rdfs:comment "Indicates that an RSP must utilise more than one CVC when requiring access to more than 4,000 AVCs in a CSA. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28]" ;
    rdfs:domain ns1:RSP ;
    rdfs:range ns1:CVC .

ns1:validatedInPresenceOf a owl:ObjectProperty ;
    rdfs:label "validatedInPresenceOf" ;
    rdfs:comment "Links a validation condition to the traffic context in which validation must occur. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 33]" ;
    rdfs:domain ns1:Cl_ValidationCondition ;
    rdfs:range owl:Thing .

ns1:waivedByNbn a owl:DatatypeProperty ;
    rdfs:label "waivedByNbn" ;
    rdfs:comment "Indicates if nbn has waived RSP's obligations in respect of a Public Interest Premises under section 39. [extension: nbn Ethernet Product Module, Section 3.7 Note, p.15]" ;
    rdfs:domain ns1:Cl_PublicInterestPremises ;
    rdfs:range xsd:boolean .

ns1:wholeOfLifeCost36m a owl:DatatypeProperty ;
    rdfs:label "whole_of_life_cost_36m" ;
    rdfs:domain ns1:CandidateAction ;
    rdfs:range xsd:double .

ns1:withNniInUse a owl:ObjectProperty ;
    rdfs:label "withNniInUse" ;
    rdfs:comment "Links a frame burst event to the NNI rate in use. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33]" ;
    rdfs:domain ns1:Cl_FrameBurstEvent ;
    rdfs:range owl:Thing .

ns1:withdrawnOn a owl:DatatypeProperty ;
    rdfs:label "withdrawnOn" ;
    rdfs:comment "The date on which a product feature is withdrawn. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain ns1:Cl_ProductFeature ;
    rdfs:range xsd:dateTime .

ns1:withinCSA a owl:ObjectProperty ;
    rdfs:label "withinCSA" ;
    rdfs:comment "Links a CVC_DeliversAVC node to the CSA. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" ;
    rdfs:domain ns1:CVC_DeliversAVC ;
    rdfs:range ns1:CSA .

