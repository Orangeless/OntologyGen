    rdfs:domain ns1:OrderedProduct ;
    rdfs:range ns1:Cl_ServiceTransferOrder .

ns1:hasShortfallPeriod a owl:ObjectProperty ;
    rdfs:label "has shortfall period" ;
    rdfs:comment "Links a Charge or ChargeFormula to the Shortfall Period component. [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    rdfs:domain ns1:Cl_ChargeFormula ;
    rdfs:range ns1:Cl_ShortfallPeriod .

ns1:hasSpecification a owl:DatatypeProperty ;
    rdfs:label "hasSpecification" ;
    rdfs:comment "The specification (provided by RSP) for a service attribute. [extension: nbn Ethernet Product Module, page 37]" ;
    rdfs:domain ns1:Cl_ServiceAttribute ;
    rdfs:range xsd:string .

ns1:hasSpecificationType a owl:ObjectProperty ;
    rdfs:label "hasSpecificationType" ;
    rdfs:comment "Links a traffic class to its specification type (CIR or PIR). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" ;
    rdfs:domain ns1:TrafficClass ;
    rdfs:range ns1:Cl_SpecificationType .

ns1:hasSqEnquiryTime a owl:ObjectProperty ;
    rdfs:label "has SQ enquiry time" ;
    rdfs:comment "Links a Connect Order to the SQ Enquiry Time. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range ns1:Cl_SQEnquiryTime .

ns1:hasStart a owl:DatatypeProperty ;
    rdfs:label "hasStart" ;
    rdfs:comment "The start of the S-TAG pool, greater than or equal to 1. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 13, page 43]" ;
    rdfs:domain ns1:S-TAGPool ;
    rdfs:range xsd:integer .

ns1:hasStartTime a owl:DatatypeProperty ;
    rdfs:label "has start time" ;
    rdfs:comment "The start time of a time interval. [extension: nbn Ethernet Price List, Section 6(f), p.18]" ;
    rdfs:domain ns1:TimeInterval ;
    rdfs:range xsd:string .

ns1:hasState a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "hasState" ;
    rdfs:comment "Links a product feature to its current state in the lifecycle. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]",
        "The activation state of an NNI Group (activated / not activated). [extension: nbn Ethernet Product Module, Section 1.3(f), p.7]" ;
    rdfs:domain ns1:Cl_ProductFeature,
        ns1:NNIGroup ;
    rdfs:range ns1:Cl_ProductFeatureState,
        xsd:string .

ns1:hasSufficientSpareCapacity a owl:DatatypeProperty ;
    rdfs:label "hasSufficientSpareCapacity" ;
    rdfs:comment "Indicates whether there is sufficient spare capacity on the associated Downstream V-NNI to accommodate a Modification. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" ;
    rdfs:domain ns1:DownstreamV-NNI ;
    rdfs:range xsd:boolean .

ns1:hasTC1Capacity a owl:DatatypeProperty ;
    rdfs:label "hasTC1Capacity" ;
    rdfs:comment "The AVC_TC-1 upstream/downstream capacity in Mbps for a Unicast 1:1 AVC bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain ns1:Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range xsd:decimal .

ns1:hasTC2Capacity a owl:DatatypeProperty ;
    rdfs:label "hasTC2Capacity" ;
    rdfs:comment "The AVC_TC-2 upstream/downstream capacity in Mbps for a Unicast 1:1 AVC bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain ns1:Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range xsd:decimal .

ns1:hasTargetPercentage a owl:DatatypeProperty ;
    rdfs:label "has target percentage" ;
    rdfs:comment "The target percentage of a Performance Objective. [extension: WBA Ethernet Service Levels Schedule, p.13]" ;
    rdfs:domain ns1:Cl_PerformanceObjective ;
    rdfs:range xsd:integer .

ns1:hasTerminationType a owl:DatatypeProperty ;
    rdfs:label "hasTerminationType" ;
    rdfs:comment "The type of termination provided by a UNI-D (e.g. physical and electromagnetic). [extension: nbn Ethernet Product Module, Section 4.6(a)(ii), p.19]" ;
    rdfs:domain ns1:Cl_FTTCCircuitTermination ;
    rdfs:range xsd:string .

ns1:hasThreshold a owl:DatatypeProperty ;
    rdfs:label "hasThreshold" ;
    rdfs:comment "The capacity threshold above which nbn may limit the availability of bandwidth profiles for a traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes]" ;
    rdfs:range xsd:decimal .

ns1:hasThresholdUnit a owl:DatatypeProperty ;
    rdfs:label "hasThresholdUnit" ;
    rdfs:comment "The unit of measurement for a capacity threshold (Mbps). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes]" ;
    rdfs:range xsd:string .

ns1:hasTotalAssociatedAVCs a owl:DatatypeProperty ;
    rdfs:label "has total associated AVCs" ;
    rdfs:comment "The total number of AVCs associated with a CVC TC-4 during a calendar week. [extension: nbn Ethernet Price List, Section 6(c), p.18]" ;
    rdfs:domain ns1:CVC_TC4_ProductComponent ;
    rdfs:range xsd:integer .

ns1:hasTotalBandwidth a owl:DatatypeProperty ;
    rdfs:label "hasTotalBandwidth" ;
    rdfs:comment "The total combination of CVC bandwidth profiles. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.3.1, page 28]" ;
    rdfs:domain ns1:CVC_BandwidthProfile ;
    rdfs:range xsd:string .

ns1:hasTrafficClass a owl:ObjectProperty ;
    rdfs:label "has traffic class",
        "hasTrafficClass" ;
    rdfs:comment "Links a BandwidthProfileSpec to the traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]",
        "Links a bandwidth profile to its traffic class (TC-4). [extension: nbn Ethernet Product Module, Section 2.2, p.8]",
        "Links a contractual event to a traffic class involved. [extension: nbn Ethernet Product Module, Section 2.1, p.7]",
        "Links an AVC TC-4 Ordered Product Component to its traffic class (TC-4). [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]",
        "Links an AVCFeatureAvailability node to the traffic class whose availability is being described. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50]" ;
    rdfs:domain ns1:AVCFeatureAvailability,
        ns1:Cl_AvcTc4OrderedProductComponent,
        ns1:Cl_BandwidthProfile,
        ns1:Cl_BandwidthProfileSpec,
        ns1:Cl_ContractualEvent ;
    rdfs:range ns1:TrafficClass .

ns1:hasTrafficClassModel a owl:DatatypeProperty ;
    rdfs:label "hasTrafficClassModel" ;
    rdfs:comment "A textual description of the traffic class and priority encoding/decoding model supported by an NNI Group. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.7, page 31]" ;
    rdfs:domain ns1:Cl_ClassOfServiceSupport ;
    rdfs:range xsd:string .

ns1:hasTrafficDiscardEvent a owl:ObjectProperty ;
    rdfs:label "hasTrafficDiscardEvent" ;
    rdfs:comment "Links an NNI Group to a reified traffic discard event. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.7, page 31]" ;
    rdfs:domain ns1:NNIGroup ;
    rdfs:range ns1:Cl_TrafficDiscardEvent .

ns1:hasTransitionFrom a owl:ObjectProperty ;
    rdfs:label "hasTransitionFrom" ;
    rdfs:comment "Links an event to the state it transitions from. [extension: nbn Ethernet Product Module, section 8.3.1.1, page 40]" ;
    rdfs:domain ns1:Cl_Event ;
    rdfs:range ns1:Cl_State .

ns1:hasTransitionTo a owl:ObjectProperty ;
    rdfs:label "hasTransitionTo" ;
    rdfs:comment "Links an event to the state it transitions to. [extension: nbn Ethernet Product Module, section 8.3.1.1, page 40]" ;
    rdfs:domain ns1:Cl_Event ;
    rdfs:range ns1:Cl_State .

ns1:hasTrigger a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "hasTrigger" ;
    rdfs:comment "Links a traffic discard event to the event that triggers the discard (e.g. failure of one or more NNI Bearers). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.7, page 31]",
        "The trigger event for a state transition. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain ns1:Cl_StateTransition,
        ns1:Cl_TrafficDiscardEvent ;
    rdfs:range xsd:string,
        owl:Thing .

ns1:hasTriggerEvent a owl:ObjectProperty ;
    rdfs:label "has trigger event" ;
    rdfs:comment "Links a Charge to the Trigger Event that causes it. [extension: nbn Ethernet Price List, Section 7, p.19]" ;
    rdfs:domain ns1:Cl_Charge ;
    rdfs:range ns1:Cl_TriggerEvent .

ns1:hasUNI a owl:ObjectProperty ;
    rdfs:label "hasUNI" ;
    rdfs:comment "Links a UNI Inclusion to the type of UNI included. [extension: nbn Ethernet Price List, Section 1.3, p.6]" ;
    rdfs:domain ns1:UNI_Inclusion ;
    rdfs:range ns1:UNI_Type .

ns1:hasUNIBoundary a owl:ObjectProperty ;
    rdfs:label "hasUNIBoundary" ;
    rdfs:comment "Links an nbn Ethernet Boundary to the UNI that serves the Premises. [extension: nbn Ethernet Product Module, Section 12.2(a), p.26]" ;
    rdfs:domain ns1:Cl_nbnEthernetBoundary ;
    rdfs:range ns1:UNI .

ns1:hasUNIDSupportedInterfaceMode a owl:DatatypeProperty ;
    rdfs:label "hasUNIDSupportedInterfaceMode" ;
    rdfs:comment "Indicates whether the UNI-D Supported Interface Mode is supported (Y) for a Unicast 1:1 AVC bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain ns1:Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range xsd:string .

ns1:hasUNIInterface a owl:ObjectProperty ;
    rdfs:label "hasUNIInterface" ;
    rdfs:comment "Links a Unicast 1:1 AVC bandwidth profile to its UNI Interface (UNI-D). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain ns1:Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range ns1:AVC .

ns1:hasUnit a owl:DatatypeProperty ;
    rdfs:label "has unit",
        "hasUnit" ;
    rdfs:comment "The unit of a Service Level duration (e.g. 'Business Days'). [extension: WBA Ethernet Service Levels Schedule, p.13]",
        "The unit of measure for a bandwidth quantity. [extension: nbn Ethernet Price List, Section 1.5(c), p.8]",
        "The unit of measurement for a bearer limit count. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.1, page 28]",
        "The unit of measurement for a rate value (e.g. Mbps). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain ns1:Cl_BandwidthProfileSpec,
        ns1:Cl_BearerLimit,
        ns1:IncludedBandwidth,
        ns1:OrderedBandwidth ;
    rdfs:range xsd:string .

ns1:hasUpperBound a owl:DatatypeProperty ;
    rdfs:label "has upper bound" ;
    rdfs:comment "The upper bound of a usage range. [extension: nbn Ethernet Price List, Section 6(a), p.17]" ;
    rdfs:domain ns1:Cl_UsageRange ;
    rdfs:range xsd:string .

ns1:hasUpstreamCapacity a owl:DatatypeProperty ;
    rdfs:label "hasUpstreamCapacity" ;
    rdfs:comment "The upstream AVC_TC-4 capacity in Mbps for a Unicast 1:1 AVC bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain ns1:Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range xsd:decimal .

ns1:hasUpstreamDownstream a owl:DatatypeProperty ;
    rdfs:label "hasUpstreamDownstream" ;
    rdfs:comment "Indicates that a bandwidth profile attribute applies to both upstream and downstream. [extension: nbn Ethernet Product Module, Table 9, page 39]" ;
