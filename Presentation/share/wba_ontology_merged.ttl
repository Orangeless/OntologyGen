        owl:NamedIndividual ;
    rdfs:label "nbn" ;
    ns1:performs ns1:NetworkActivityDesignationDateEvent ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, p.13" .

ns1:Party a owl:Class ;
    rdfs:label "Party" ;
    rdfs:comment "A party to the Agreement (e.g. nbn, RSP). [extension: nbn Ethernet Price List, Section 7, p.18]" .

ns1:ProRataRule a owl:Class ;
    rdfs:label "ProRataRule" ;
    rdfs:comment "A rule that calculates charges on a pro-rata basis when conditions are met for some days of a Billing Period but not others. [extension: nbn Ethernet Price List, Note 4, p.5]" .

ns1:ProductFeatures a owl:Class ;
    rdfs:label "ProductFeatures" ;
    rdfs:comment "The set of features selected by an RSP for a Product Component (e.g. bandwidth profile, access technology). [extension: nbn Ethernet Price List, Section 1]" .

ns1:Protocol a owl:Class ;
    rdfs:label "Protocol" ;
    rdfs:comment "A protocol used for Access Loop Identification insertion. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" .

ns1:RSP_OrdersAccessLoopID a owl:Class ;
    rdfs:label "RSP Orders Access Loop ID" ;
    rdfs:comment "Reified relationship representing that an RSP optionally orders Access Loop Identification for a unicast AVC. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" .

ns1:RebateOrCredit a owl:Class ;
    rdfs:label "RebateOrCredit" ;
    rdfs:comment "A rebate or credit equal to the recurring charge of one symmetrical AVC TC-1 of 0.15Mbps, applied when an RSP orders any symmetrical AVC TC-1 of 0.15Mbps or above. [extension: nbn Ethernet Price List, Section 1.4, p.6]" .

ns1:RspAgent a ns1:Cl_RSP,
        owl:NamedIndividual ;
    rdfs:label "RSP" ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, p.13" .

ns1:S-TAGPool a owl:Class ;
