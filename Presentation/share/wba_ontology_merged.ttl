        "Fibre to the Node access technology. [extension: nbn Ethernet Product Module, Section 1.2, p.6]" .

ns1:Cl_ContractualEvent a owl:Class ;
    rdfs:label "Cl_ContractualEvent" ;
    rdfs:comment "A reified event that captures an action or state change prescribed by the contract (e.g., selecting a redundancy mode, activating an NNI Group, ordering a CVC). [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

ns1:AccessTechnology_Wireless a ns1:AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "Wireless" ;
    ns1:hasDescription "Wireless access technology"^^xsd:string ;
    rdfs:comment "Fixed Wireless access technology. [extension: nbn Ethernet Price List, Section 1.1]",
        "Wireless access technology. [extension: nbn Ethernet Product Module, Section 1.2, p.6]" .

ns1:BillingPeriod_P1M a ns1:BillingPeriod,
        owl:NamedIndividual ;
    rdfs:label "BillingPeriod_P1M" ;
    ns1:duration "P1M"^^xsd:string ;
    rdfs:comment "Monthly billing period (1 month). [extension: nbn Ethernet Price List, Section 1.1]" .

ns1:AVC a owl:Class ;
    rdfs:label "AVC" ;
    rdfs:comment "Access Virtual Circuit: per-service circuit that uses a CVC.",
        "An Access Virtual Circuit or AVC is an Ethernet-based Layer 2 virtual connection on the Fibre Network, FTTB Network, FTTN Network, FTTC Network, HFC Network, Wireless Network or Satellite Network that carries RSP traffic to and from a UNI used to serve a Premises. [extension: nbn Ethernet Product Module, Section 3.1(a), p.10]" ;
    skos:altLabel "AVC",
        "Access Virtual Circuit",
        "OVC",
        "Unicast 1:1 AVC" .

ns1:CVC a owl:Class ;
    rdfs:label "CVC" ;
    rdfs:comment "Connectivity Virtual Circuit: carries a CSA's traffic over an NNI Group, with a traffic-class mix." ;
    rdfs:subClassOf ns1:PlanningResource ;
    skos:altLabel "CVC",
        "CVC TC-1",
        "CVC TC-2",
        "CVC TC-4",
        "Connectivity Virtual Circuit",
        "Unicast N:1 CVC" .

ns1:MonetaryAmount a owl:Class ;
    rdfs:label "MonetaryAmount" ;
    rdfs:comment "A monetary value with a currency and numeric amount. [extension: nbn Ethernet Price List, Section 1.1]" .

ns1:Cl_BandwidthProfile a owl:Class ;
    rdfs:label "Bandwidth Profile",
        "Cl_BandwidthProfile" ;
    rdfs:comment "A bandwidth profile definition for AVC TC-4, specifying downstream/upstream PIR values. [extension: WBA Ethernet Service Levels Schedule, p.33]",
        "A named or numeric specification of downstream/upstream bit rates (e.g., 0 Mbps, 12/1 Mbps, Home Fast) for a specific traffic class (TC-4) on a Unicast 1:1 AVC. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52]",
        "A reified bandwidth profile configuration for a CVC TC-4, specifying PIR/CIR parameters, increments, ranges, and CVC Max flag. [extension: nbn Ethernet Product Module, Section 2.2, p.8]",
        "A reified bandwidth profile for an AVC TC-4, specifying downstream PIR, upstream PIR, and applicable network type. [extension: nbn Ethernet Product Module, Section 3.2, p.10]",
        "A set of attributes (CVC_TC-1_CIR, CVC_TC-2_CIR, CVC_TC-4_PIR, CVC_TC-4_CIR) that define the bandwidth characteristics of a CVC, with applicability varying by access technology. [extension: nbn Ethernet Product Module, Table 9, page 39]" ;
    rdfs:subClassOf ns1:Cl_ServiceAttribute .

ns1:Cl_BusinessRule a owl:Class ;
    rdfs:label "Cl_BusinessRule" ;
    rdfs:comment "A conditional statement (if-then) that governs the validity or outcome of a contractual event or state. [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

ns1:TC_1 a ns1:TrafficClass,
        owl:NamedIndividual ;
    rdfs:label "TC-1" ;
    ns1:name "Priority / realtime" ;
    ns1:planningThresholdPct 70.0 .

ns1:AccessTechnology_FTTC a ns1:AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTC" .

ns1:NNIGroup a owl:Class ;
    rdfs:label "NNIGroup" ;
