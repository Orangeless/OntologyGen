    rdfs:comment "Links an event to the object participant it acts upon. [extension: nbn Ethernet Product Module, page 38]" ;
    rdfs:domain ns1:Cl_Event ;
    rdfs:range owl:Thing .

ns1:hasOnboardingStatus a owl:DatatypeProperty ;
    rdfs:label "hasOnboardingStatus" ;
    rdfs:comment "The onboarding status of RSP for a particular nbn Ethernet product. [extension: nbn Ethernet Product Module, Section 7(d)(i), p.20]" ;
    rdfs:domain ns1:RSP ;
    rdfs:range xsd:string .

ns1:hasOperationalStatus a owl:DatatypeProperty ;
    rdfs:label "hasOperationalStatus" ;
    rdfs:comment "The operational status of an NNI Link that a V-NNI has visibility of. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.4, page 30]" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ns1:hasOptions a owl:DatatypeProperty ;
