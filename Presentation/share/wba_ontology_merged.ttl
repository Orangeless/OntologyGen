    rdfs:comment "Links an AccessLoopID_InsertedInto node to the protocol. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" ;
    rdfs:domain ns1:AccessLoopID_InsertedInto ;
    rdfs:range ns1:Protocol .

ns1:isAcquiredBy a owl:ObjectProperty ;
    rdfs:label "isAcquiredBy" ;
    rdfs:comment "Links an AVC TC-4 Product Component to the RSP that acquires it. [extension: nbn Ethernet Product Module, Section 4.2(c), p.17]" ;
    rdfs:domain ns1:Cl_AVCTC4_ProductComponent ;
    rdfs:range ns1:RSP .

ns1:isAcquiredInConjunctionWith a owl:ObjectProperty ;
    rdfs:label "isAcquiredInConjunctionWith" ;
    rdfs:comment "Links a bundle to another bundle that must also be acquired. [extension: nbn Ethernet Product Module, Section 6, p.20]" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

ns1:isAdditionalTo a owl:ObjectProperty ;
    rdfs:label "is additional to" ;
    rdfs:comment "Links a CVC Class adjustment to the charge sections it is in addition to. [extension: nbn Ethernet Price List, Section 6, Note, p.17]" ;
    rdfs:domain ns1:Cl_CVCClassAdjustment ;
    rdfs:range ns1:Cl_ChargeSection .

ns1:isAddressedUsing a owl:ObjectProperty ;
    rdfs:label "isAddressedUsing" ;
    rdfs:comment "Links a unicast 1:1 AVC to the C-VID used to address it. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28]" ;
    rdfs:domain ns1:Unicast_1_1_AVC ;
    rdfs:range ns1:CVID .

ns1:isAffectedBy a owl:ObjectProperty ;
    rdfs:label "isAffectedBy" ;
