    ns1:appliesToTrafficClass ns1:TC_4 ;
    ns1:hasDescription "nbn may limit the availability of bandwidth profiles with TC-4 capacities greater than 100 Mbps in CSAs where nbn does not, or considers it is likely to not, have sufficient capacity to provide all requested TC-4 capacity. RSP must conduct a Site Qualification Enquiry which will indicate the availability of bandwidth profiles for TC-4 capacities greater than 100 Mbps in relation to each Premises." ;
    ns1:hasThreshold 100.0 ;
    ns1:hasThresholdUnit "Mbps" ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes" .

ns1:TC4_Performance_Variation a owl:NamedIndividual ;
    rdfs:label "TC-4 Performance Variation" ;
    ns1:hasDescription "The performance of RSP Products that use AVC TC-4s as an input will vary depending on factors both within and outside of the nbn Network"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33" .

ns1:TC4_SpecType_AVC a owl:NamedIndividual ;
