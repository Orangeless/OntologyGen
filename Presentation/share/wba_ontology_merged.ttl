    ns1:hasDescription "The group interface rate is set through the selection of the first NNI Bearer (Single Chassis mode), or pair of NNI Bearers (Diverse Chassis mode) at the time the NNI Group is created"^^xsd:string ;
    ns1:hasNNIGroupInterfaceRate ns1:NNIGroup_InterfaceRate_Attribute ;
    ns1:hasNNIGroupRedundancyMode ns1:NNIGroup_RedundancyMode_Attribute ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.1.2, page 40" .

ns1:NNIGroup_InterfaceRate_Values a owl:NamedIndividual ;
