    rdfs:label "AVC Scaled Through" ;
    rdfs:comment "Reified relationship representing that an AVC is scaled in capacity through its bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

ns1:AccessLoopID_InsertedInto a owl:Class ;
    rdfs:label "Access Loop ID Inserted Into" ;
    rdfs:comment "Reified relationship representing that Access Loop Identification information is inserted into a protocol. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" .

ns1:AccessLoopIdentification a owl:Class ;
    rdfs:label "AccessLoopIdentification" ;
    rdfs:comment "An optional feature for unicast AVCs that inserts identification into upstream Layer 3 control packets. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" .

ns1:Bandwidth a owl:Class ;
    rdfs:label "Bandwidth" ;
    rdfs:comment "The NNI Link Bandwidth attribute. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 13, page 43]",
        "The bandwidth attribute of an Upstream NNI Link, displayed during the V-NNI ordering process. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" .

ns1:Bandwidth_Example a ns1:Bandwidth,
        owl:NamedIndividual ;
    rdfs:label "NNI Link Bandwidth" ;
    ns1:isUnused true ;
    ns1:isWithinNNIGroupCapacity true ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 13, page 43" .

ns1:CIR_Objective a owl:Class ;
    rdfs:label "CIR_Objective" ;
    rdfs:comment "The committed information rate objective applicable at the nbn Downstream Network Boundary for a Premises, which may not be achievable. [extension: nbn Ethernet Product Module, Section 3.4(c), p.13]" .

ns1:CVC_Isolation a owl:Class ;
    rdfs:label "CVC Isolation" ;
    rdfs:comment "Reified relationship representing that a CVC is isolated from other CVCs on an NNI via a distinct S-VID. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" .

ns1:CVC_N_1_VLAN a owl:Class ;
    rdfs:label "CVC N:1 VLAN" ;
    rdfs:comment "A variant of CVC required for N:1 AVC unicast services delivered using the UNI-V interface. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" ;
    rdfs:subClassOf ns1:CVC .

ns1:CVC_Scalability a owl:Class ;
    rdfs:label "CVC Scalability" ;
    rdfs:comment "Reified relationship representing AVC and CVC scalability in conjunction with contention. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2, page 27]" .

ns1:Cl_Beam a owl:Class ;
    rdfs:label "Cl_Beam" ;
    rdfs:comment "Satellite capacity resource (beam) that may be at or near maximum capacity. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" .

ns1:Cl_ChargeSection a owl:Class ;
    rdfs:label "Charge Section" ;
    rdfs:comment "A section of the nbn Ethernet Price List that defines charges. [extension: nbn Ethernet Price List, Section 6, p.17]" .

ns1:Cl_CirIncrementRule a owl:Class ;
    rdfs:label "Cl_CirIncrementRule" ;
    rdfs:comment "A reified rule specifying the CIR increment for a given CVC Class for CVC TC-4 symmetrical Mbps (CIR). [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

ns1:Cl_CirRangeRule a owl:Class ;
    rdfs:label "Cl_CirRangeRule" ;
    rdfs:comment "A reified rule specifying the CIR range for a given CVC Class for CVC TC-4 symmetrical Mbps (CIR). [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

ns1:Cl_NNIGroupLocation a owl:Class ;
    rdfs:label "NNI Group Location" ;
    rdfs:comment "The location of an NNI Group, which must be specified at time of NNI Group creation. [extension: nbn Ethernet Product Module, section 8.3.1.1, page 40]" ;
    rdfs:subClassOf ns1:ServiceAttributes .

ns1:Cl_Outage a ns1:Cl_Event,
        owl:Class ;
    rdfs:label "Outage" ;
    rdfs:comment "A scheduled network outage coordinated between nbn and RSP to augment an NNI Group with additional NNI Bearers. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf ns1:Cl_Event .

ns1:Cl_PostDisconnectionModificationCharges a owl:Class ;
    rdfs:label "Post Disconnection Modification Charges" ;
    rdfs:comment "The recurring Charges for the TC-2 Bundle Components applicable after a modification event, or nil in the case of cancellation or disconnection, as set out in section 1.5. [extension: nbn Ethernet Price List, Section 7(c)(ii), p.19]" ;
    rdfs:subClassOf ns1:MonetaryAmount .

ns1:Cl_ProvisioningEvent a owl:Class ;
    rdfs:label "Provisioning Event" ;
    rdfs:comment "The automatic activation of TC-1 capacity on a UNI-V upon order by an RSP. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52, footnote 38]" ;
    rdfs:subClassOf ns1:Cl_Event .

ns1:Cl_ServiceBundle a owl:Class ;
    rdfs:label "Cl_ServiceBundle" ;
    rdfs:comment "A composite offering that groups multiple product components and features into a single purchasable unit. [extension: nbn Ethernet Product Module, Part C, p.20]" .

ns1:Cl_ServiceLimit a owl:Class ;
    rdfs:label "Cl_ServiceLimit" ;
    rdfs:comment "A quantitative or qualitative restriction on the supply or use of a service. [extension: nbn Ethernet Product Module, Part C, p.20]" .

ns1:Cl_ServiceTransferOrder a owl:Class ;
    rdfs:label "Service Transfer Order" ;
    rdfs:comment "An order accepted by nbn for transfer of service from a Losing RSP to an Other Gaining RSP, which may exempt the Charge under section 7(d)(ii). [extension: nbn Ethernet Price List, Section 7(d)(ii), p.19]" ;
    rdfs:subClassOf ns1:Event .

ns1:DocumentSection_8_3 a ns1:DocumentSection,
        owl:NamedIndividual ;
    rdfs:label "Section 8.3" ;
