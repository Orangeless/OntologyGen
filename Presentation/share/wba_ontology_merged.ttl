    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( ns1:RedundancyMode_DIVERSE_CHASSIS ns1:RedundancyMode_SINGLE ns1:RedundancyMode_SINGLE_CHASSIS ) ],
        [ a owl:Class ;
            owl:oneOf ( ns1:RedundancyMode_DIVERSE_CHASSIS ns1:RedundancyMode_SINGLE ns1:RedundancyMode_SINGLE_CHASSIS ) ],
        [ a owl:Class ;
            owl:oneOf ( ns1:RedundancyMode_DIVERSE_CHASSIS ns1:RedundancyMode_SINGLE ns1:RedundancyMode_SINGLE_CHASSIS ) ],
        [ a owl:Class ;
            owl:oneOf ( ns1:RedundancyMode_DIVERSE_CHASSIS ns1:RedundancyMode_SINGLE ns1:RedundancyMode_SINGLE_CHASSIS ) ] .

