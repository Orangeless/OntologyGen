ns1:RspInvoice a ns1:Cl_Invoice,
        owl:NamedIndividual ;
    rdfs:label "RSP Invoice" ;
    ns1:sourceClause "WBA Ethernet Service Levels Schedule, s2.5(a), p.13" .

ns1:Rule a owl:Class ;
    rdfs:label "Rule" ;
    rdfs:comment "A rule or condition that governs charges or obligations. [extension: nbn Ethernet Price List, Section 7, p.18]" .

ns1:Rule_CIRNotAchieving_ServiceFault a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CIR Not Achieving - Service Fault Rule" ;
    ns1:hasCondition "the CIR at the nbn Downstream Network Boundary in respect of a Premises is not capable of achieving an applicable CIR Objective" ;
    ns1:hasConsequence "sections 3.2(b) to 3.2(d) and 3.5 will not prevent that failure from being a Service Fault or Performance Incident until nbn designates that a Network Activity or Interference Mitigation is required in accordance with the WBA Operations Manual" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.4(c)(i), p.13" .

ns1:Rule_CVCBandwidthNotZero a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC Bandwidth Not Zero Rule" ;
    ns1:hasCondition "RSP orders a combination of CVC TC-4, CVC TC-1 or CVC TC-2" ;
    ns1:hasConsequence "the total combination of CVC bandwidth profiles is not zero" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.1(c), p.7" .

ns1:Rule_NbnConfiguresAVCTC4 a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "nbn Configures AVC in TC-4 Rule" ;
    ns1:hasCondition "RSP orders an AVC" ;
    ns1:hasConsequence "nbn will configure the AVC to carry data in traffic class 4 (AVC TC-4)" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.1(c), p.10" .

ns1:Rule_NbnMapsOneAVCTC4ToUNI a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "nbn Maps One AVC TC-4 to UNI Rule" ;
    ns1:hasCondition "a UNI is used to serve a Premises" ;
    ns1:hasConsequence "nbn will map one AVC TC-4 to that UNI and will not map more than one AVC TC-4 to the same UNI" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.1(f), p.10" .

ns1:Rule_NbnModifyBwOnNonCompliance a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "nbn May Modify Bandwidth Profile on Non-Compliance Rule" ;
    ns1:hasCondition "RSP fails to comply with section 2.2(e)(iii) in connection with a CVC TC-4" ;
    ns1:hasConsequence "nbn may modify the bandwidth profile of that CVC TC-4 by following the process set out in the WBA Operations Manual" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 2.2(f), p.8" .

ns1:Rule_RSPMustOrderAVC a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "RSP Must Order AVC Rule" ;
    ns1:hasCondition "nbn supplies nbn Ethernet to RSP" ;
    ns1:hasConsequence "RSP must order an AVC for each Premises to which nbn Ethernet will be supplied" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.1(b), p.10" .

ns1:Rule_RSPMustOrderCVCForAVCTC a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "RSP Must Order CVC for AVC Traffic Class Rule" ;
    ns1:hasCondition "RSP orders an AVC traffic class in respect of a Premises in a CSA" ;
    ns1:hasConsequence "RSP must order a CVC in the same traffic class in respect of that CSA" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 3.1(e), p.10" .

ns1:Rule_ReconfigureRedundancy a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Reconfigure Redundancy Mode Rule" ;
    ns1:hasCondition "the redundancy mode of an NNI Group is reconfigured after activation" ;
    ns1:hasConsequence "it satisfies the criteria for an NNI Diversity Upgrade in the WBA Operations Manual (including that the NNI Group is located at an Upgraded POI)" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 1.3(f), p.7" .

ns1:Rule_SingleChassis a ns1:Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Single Chassis Rule" ;
    ns1:hasCondition "RSP selects single chassis as the redundancy mode for an NNI Group" ;
    ns1:hasConsequence "each NNI Bearer in that NNI Group will be connected to the same chassis; and the NNI will operate as a single, unprotected interface" ;
    ns1:sourceClause "nbn Ethernet Product Module, Section 1.3(d)(i)-(ii), p.7" .

ns1:SCVID_Mismatch_Potential a owl:NamedIndividual ;
    rdfs:label "Potential S/C-VID Mismatch" ;
    ns1:hasDescription "Any potential for S/C-VID mismatch between RSP and nbn"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 38" .

ns1:SCVID_Nominated_Value a ns1:S_C_VID,
        owl:NamedIndividual ;
    rdfs:label "RSP-Nominated S/C-VID" ;
    ns1:forAlignmentTo ns1:Backhaul_Addressing_Scheme ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 38" ;
    ns1:specifiedInProductOrderForm ns1:ProductOrderForm_Instance .

ns1:S_C_VID_Example a ns1:S_C_VID,
        owl:NamedIndividual ;
    rdfs:label "S/C-VID Example" ;
    ns1:hasDescription "Distinct Service and Customer VLAN Identifier used for logical isolation of AVCs"^^xsd:string .

ns1:S_TAG a ns1:Cl_ServiceAttribute,
        owl:Class ;
    rdfs:label "S-TAG (NNI)" ;
    rdfs:comment "S-TAG (NNI) service attribute for CVC. RSP may choose a locally-significant S-TAG at the NNI. Optional parameter. If set to zero, nbn will assign the next available value. [extension: nbn Ethernet Product Module, page 38]" ;
    rdfs:subClassOf ns1:Cl_ServiceAttribute .

ns1:S_TAG_NNI a ns1:S_TAG,
        owl:NamedIndividual ;
    rdfs:label "S-TAG (NNI)" ;
    ns1:hasAssignmentRule "If set to zero, nbn will assign the next available value"^^xsd:string ;
    ns1:hasAttributeDescription "RSP may choose a locally-significant S-TAG at the NNI. Optional parameter. If set to zero, nbn will assign the next available value."^^xsd:string ;
    ns1:hasDefault "0"^^xsd:string ;
    ns1:hasOptions "Requested S-TAG (0 for nbn-supplied S-TAG)"^^xsd:string ;
    ns1:hasRange "S-TAG: (1 - 4000)"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 8, page 38" .

ns1:S_TAG_Pool_Example a ns1:S_TAG_Pool,
        owl:NamedIndividual ;
    rdfs:label "S-TAG Pool Example" ;
    ns1:hasDescription "An S-TAG pool reserved from an NNI Group, unique to an NNI Link or CVC"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.3, page 30" .

ns1:S_TAG_Pool_Example2 a ns1:S_TAG_Pool,
        owl:NamedIndividual ;
    rdfs:label "S-TAG Pool Example 2" ;
    ns1:hasDescription "A second S-TAG pool reserved from an NNI Group, unique to an NNI Link or CVC"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.3, page 30" .

ns1:S_VID_Example a ns1:S_VID,
        owl:NamedIndividual ;
    rdfs:label "S-VID Example" ;
    ns1:hasDescription "Service VLAN Identifier used to isolate CVCs from each other on an NNI"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26" .

