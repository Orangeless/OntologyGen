ns1:AccessTechnology_FTTN a ns1:AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTN",
        "FTTN Access Technology" ;
    ns1:hasDescription "Fibre to the Node access technology"^^xsd:string ;
