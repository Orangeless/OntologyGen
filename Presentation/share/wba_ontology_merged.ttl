ns1:NNILink_UsedBy_DownstreamV-NNI a owl:NamedIndividual ;
    rdfs:label "NNI Link Used by Downstream V-NNI" ;
    ns1:hasDescription "An NNI Link that is used by a Downstream V-NNI, which restricts modification and cancellation."^^xsd:string ;
