    rdfs:domain ns1:AVC_TC4_ProductComponent ;
    rdfs:range ns1:UpstreamPIR .

ns1:hasUpstreamPirMbps a owl:DatatypeProperty ;
    rdfs:label "hasUpstreamPirMbps" ;
