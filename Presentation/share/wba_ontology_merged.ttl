    ns1:sourceClause "nbn Ethernet Price List, Section 7(c), p.19" ;
    rdfs:comment "Charge = (Pre Disconnection Modification Charges - Post Disconnection Modification Charges) x Shortfall Period. [extension: nbn Ethernet Price List, Section 7(c), p.19]" .

ns1:ChargeFormula_Section7_Cancellation a ns1:Cl_ChargeFormula,
