ns1:NNI_Bearer_Consistency_Note a owl:NamedIndividual ;
    rdfs:label "NNI Bearer Consistency Requirement" ;
    ns1:hasDescription "All NNI Bearers within an NNI Group must be consistent with the group interface rate for that NNI Group (i.e. 1Gbps, 10Gbps or 100Gbps)"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.1, page 28" .

ns1:NNI_Group_InterfaceRate a owl:Class ;
    rdfs:label "NNI Group Interface Rate" ;
    rdfs:comment "NNI Group Interface Rate attribute. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 8.3.1.2]" ;
    rdfs:subClassOf ns1:ServiceAttributes .

ns1:NNI_Link_Overbooking_Note a owl:NamedIndividual ;
    rdfs:label "NNI Link Over-booking Prohibition" ;
    ns1:hasDescription "RSP is not permitted to over-book S-TAGs or contend bandwidth within an NNI Group. Each S-TAG pool must be unique to an NNI Link or CVC, and the total bandwidth of all NNI Links linked to an NNI cannot exceed the bandwidth of the available NNI capacity"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.3, page 30" .

