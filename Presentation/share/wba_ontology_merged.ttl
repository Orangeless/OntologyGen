        owl:NamedIndividual ;
    rdfs:label "Failure Response: Single Chassis Reduced Capacity" ;
    ns1:hasFailureDescription "NNI Group continues to operate at an aggregate capacity that is reduced by the capacity of the failed NNI Bearer"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2.1, page 28" .

ns1:FeasibilityCheck_Required a ns1:Cl_FeasibilityCheck,
        owl:NamedIndividual ;
    rdfs:label "Feasibility Check Required" ;
    ns1:hasDescription "A feasibility check will be required upon addition of any NNI Bearer to an NNI Group, to determine whether the number of allowable NNI Bearers within the NNI Group has been exceeded"^^xsd:string ;
    ns1:hasObjectParticipant ns1:NNIGroup_1G_MaxSeamless ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 42" ;
    ns1:triggeredBy ns1:Addition_Any_NNI_Bearer .

ns1:FeasibilityCheck_Result_Allowed a ns1:Cl_FeasibilityCheckResult,
        owl:NamedIndividual ;
    rdfs:label "Feasibility Check Result: Allowed" ;
    ns1:hasDescription "The number of allowable NNI Bearers within the NNI Group has not been exceeded"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 42" .

ns1:FeasibilityCheck_Result_NotAllowed a ns1:Cl_FeasibilityCheckResult,
        owl:NamedIndividual ;
    rdfs:label "Feasibility Check Result: Not Allowed" ;
    ns1:hasDescription "The number of allowable NNI Bearers within the NNI Group has been exceeded"^^xsd:string ;
    ns1:sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 42" .

ns1:FrameBurstEvent_TC4 a ns1:Cl_FrameBurstEvent,
        owl:NamedIndividual ;
    rdfs:label "AVC TC-4 Peak Burst Event" ;
    ns1:forBandwidthProfiles ns1:AVC_TC4_1000_400,
        ns1:AVC_TC4_250_100,
        ns1:AVC_TC4_500_200,
        ns1:AVC_TC4_BandwidthProfiles,
