--- CONTENT: # Additional properties and facts

:performs a owl:ObjectProperty ;
    rdfs:label "performs" ;
    rdfs:comment "Links an nbn agent to the Network Activity it performs. [extension: WBA Ethernet Service Levels Schedule, s5.1, p.14]" ;
    rdfs:domain :Cl_nbn ;
    rdfs:range :Cl_NetworkActivity .

:orderedBy a owl:ObjectProperty ;
    rdfs:label "ordered by" ;
    rdfs:comment "Links an AVC TC-4 Ordered Product Component to the RSP that ordered it. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" ;
    rdfs:domain :Cl_AvcTc4OrderedProductComponent ;
    rdfs:range :Cl_RSP .

:hasTrafficClass a owl:ObjectProperty ;
    rdfs:label "has traffic class" ;
    rdfs:comment "Links an AVC TC-4 Ordered Product Component to its traffic class (TC-4). [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" ;
    rdfs:domain :Cl_AvcTc4OrderedProductComponent ;
    rdfs:range :TrafficClass .

# Link the NetworkActivityDesignationDateEvent to trigger the PIR Objective Rebate
:NetworkActivityDesignationDateEvent :triggersRebate :PirObjectiveRebate .

# Link NbnAgent to performing Network Activities
:NbnAgent :performs :NetworkActivityDesignationDateEvent .

# Link the PIR Objective Rebate to the billing period
:PirObjectiveRebate :forBillingPeriod :PirAffectedBillingPeriodInstance .

# PIR Affected Billing Period instance
:PirAffectedBillingPeriodInstance a :Cl_PirAffectedBillingPeriod,
        owl:NamedIndividual ;
    rdfs:label "PIR Affected Billing Period" ;
    :hasDurationIso "P1M" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s5.3, p.15" .

# AVC TC-4 Ordered Product Component instance
:AvcTc4OrderedProductComponentInstance a :Cl_AvcTc4OrderedProductComponent,
        owl:NamedIndividual ;
    rdfs:label "AVC TC-4 Ordered Product Component" ;
    :orderedBy :RspAgent ;
    :hasTrafficClass :TC_4 ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s5.3, p.14" .

# Link the rebate to the AVC TC-4 component
:PirObjectiveRebate :appliesTo :AvcTc4OrderedProductComponentInstance .

# Link the billing period to the AVC TC-4 component
:PirAffectedBillingPeriodInstance :appliesTo :AvcTc4OrderedProductComponentInstance .

# PIR Objective instance
:PirObjectiveInstance a :Cl_PirObjective,
        owl:NamedIndividual ;
    rdfs:label "PIR Objective" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s5.3, p.14" .

# Link the AVC TC-4 component to its PIR Objective
:AvcTc4OrderedProductComponentInstance :hasPirObjective :PirObjectiveInstance .

# Access Technology individuals for FTTB and FTTN (FTTC already exists)
:AccessTechnology_FTTB a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTB" .

:AccessTechnology_FTTN a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTN" .

# Update the AccessTechnology equivalentClass to include FTTB and FTTN
:AccessTechnology owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( :AccessTechnology_FIBRE :AccessTechnology_FTTC :AccessTechnology_FTTB :AccessTechnology_FTTN :AccessTechnology_HFC ) ] . ---
