    rdfs:subClassOf :Cl_Activation ;
    rdfs:comment "Activation of an NNI Group. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:Cl_NniLinkActivation a owl:Class ;
    rdfs:label "NNI Link Activation" ;
    rdfs:subClassOf :Cl_Activation ;
    rdfs:comment "Activation of an NNI Link. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:Cl_VNniActivation a owl:Class ;
    rdfs:label "V-NNI Activation" ;
    rdfs:subClassOf :Cl_Activation ;
    rdfs:comment "Activation of a V-NNI. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:Cl_OrderAcknowledgement a owl:Class ;
    rdfs:label "Order Acknowledgement" ;
    rdfs:comment "The event marking the beginning of the Service Level period for Activations. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:Cl_PerformanceObjective a owl:Class ;
    rdfs:label "Performance Objective" ;
    rdfs:comment "A target percentage of activations completed within the relevant Service Level, measured monthly. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:Cl_Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "An invoice issued to an RSP to which a rebate may be applied. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:Cl_Charge a owl:Class ;
    rdfs:label "Charge" ;
    rdfs:comment "A charge for a Co-ordinated Appointment. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

# Object Properties
:hasServiceLevel a owl:ObjectProperty ;
    rdfs:label "has service level" ;
    rdfs:comment "Links an Activation to its Service Level. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:hasPerformanceObjective a owl:ObjectProperty ;
    rdfs:label "has performance objective" ;
    rdfs:comment "Links an Activation to its Performance Objective. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:isPaidBy a owl:ObjectProperty ;
    rdfs:label "is paid by" ;
    rdfs:comment "Links a rebate to the agent that pays it (nbn). [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:isPaidTo a owl:ObjectProperty ;
    rdfs:label "is paid to" ;
    rdfs:comment "Links a rebate to the agent that receives it (RSP). [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:hasAmount a owl:ObjectProperty ;
    rdfs:label "has amount" ;
    rdfs:comment "Links a rebate to the Charge that determines its amount. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:isPaidByApplyingToInvoice a owl:ObjectProperty ;
    rdfs:label "is paid by applying to invoice" ;
    rdfs:comment "Links a rebate to the Invoice it is applied to. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:hasDuration a owl:DatatypeProperty ;
    rdfs:label "has duration" ;
    rdfs:comment "The numeric duration of a Service Level in Business Days. [extension: WBA Ethernet Service Levels Schedule, p.13]" ;
    rdfs:range xsd:integer .

:hasUnit a owl:DatatypeProperty ;
    rdfs:label "has unit" ;
    rdfs:comment "The unit of a Service Level duration (e.g. 'Business Days'). [extension: WBA Ethernet Service Levels Schedule, p.13]" ;
    rdfs:range xsd:string .

:hasTargetPercentage a owl:DatatypeProperty ;
    rdfs:label "has target percentage" ;
    rdfs:comment "The target percentage of a Performance Objective. [extension: WBA Ethernet Service Levels Schedule, p.13]" ;
    rdfs:range xsd:integer .

:measuredOver a owl:DatatypeProperty ;
    rdfs:label "measured over" ;
    rdfs:comment "The time interval over which a Performance Objective is measured (e.g. 'P1M' for monthly). [extension: WBA Ethernet Service Levels Schedule, p.13]" ;
    rdfs:range xsd:string .

:startsAt a owl:ObjectProperty ;
    rdfs:label "starts at" ;
    rdfs:comment "Links an Activation's Service Level to the Order Acknowledgement event that starts the clock. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:triggersRebate a owl:ObjectProperty ;
    rdfs:label "triggers rebate" ;
    rdfs:comment "Links a Co-ordinated Appointment (failure event) to the rebate it triggers. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:appliesToActivation a owl:ObjectProperty ;
    rdfs:label "applies to activation" ;
    rdfs:comment "Links a Service Level or Performance Objective to the Activation type it applies to. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

# ===== FACTS: Service Levels for Activations (section 3.1) =====

# CVC Activation Service Level: 3 Business Days
:CvcActivationServiceLevel a :ServiceLevel, owl:NamedIndividual ;
    rdfs:label "CVC Activation Service Level" ;
    :hasDuration 3 ;
    :hasUnit "Business Days" ;
    :appliesToActivation :Cl_CvcActivation ;
    :startsAt :OrderAcknowledgementEvent ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.1, p.13" .

# NNI Group Activation Service Level: 15 Business Days
:NniGroupActivationServiceLevel a :ServiceLevel, owl:NamedIndividual ;
    rdfs:label "NNI Group Activation Service Level" ;
    :hasDuration 15 ;
    :hasUnit "Business Days" ;
    :appliesToActivation :Cl_NniGroupActivation ;
    :startsAt :OrderAcknowledgementEvent ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.1, p.13" .

# NNI Link Activation Service Level: 15 Business Days
:NniLinkActivationServiceLevel a :ServiceLevel, owl:NamedIndividual ;
    rdfs:label "NNI Link Activation Service Level" ;
    :hasDuration 15 ;
    :hasUnit "Business Days" ;
    :appliesToActivation :Cl_NniLinkActivation ;
    :startsAt :OrderAcknowledgementEvent ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.1, p.13" .

# V-NNI Activation Service Level: 15 Business Days
:VNniActivationServiceLevel a :ServiceLevel, owl:NamedIndividual ;
    rdfs:label "V-NNI Activation Service Level" ;
    :hasDuration 15 ;
    :hasUnit "Business Days" ;
    :appliesToActivation :Cl_VNniActivation ;
    :startsAt :OrderAcknowledgementEvent ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.1, p.13" .

# ===== FACTS: Performance Objectives (section 3.2) =====

# CVC Activation Performance Objective: 95% or more
:CvcActivationPerformanceObjective a :Cl_PerformanceObjective, owl:NamedIndividual ;
    rdfs:label "CVC Activation Performance Objective" ;
    :hasTargetPercentage 95 ;
    :measuredOver "P1M" ;
    :appliesToActivation :Cl_CvcActivation ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.2, p.13" .

# NNI Group Activation Performance Objective: 95% or more
:NniGroupActivationPerformanceObjective a :Cl_PerformanceObjective, owl:NamedIndividual ;
    rdfs:label "NNI Group Activation Performance Objective" ;
    :hasTargetPercentage 95 ;
    :measuredOver "P1M" ;
    :appliesToActivation :Cl_NniGroupActivation ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.2, p.13" .

# NNI Link Activation Performance Objective: 95% or more
:NniLinkActivationPerformanceObjective a :Cl_PerformanceObjective, owl:NamedIndividual ;
    rdfs:label "NNI Link Activation Performance Objective" ;
    :hasTargetPercentage 95 ;
    :measuredOver "P1M" ;
    :appliesToActivation :Cl_NniLinkActivation ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.2, p.13" .

# V-NNI Activation Performance Objective: 95% or more
:VNniActivationPerformanceObjective a :Cl_PerformanceObjective, owl:NamedIndividual ;
    rdfs:label "V-NNI Activation Performance Objective" ;
    :hasTargetPercentage 95 ;
    :measuredOver "P1M" ;
    :appliesToActivation :Cl_VNniActivation ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.2, p.13" .

# ===== FACTS: Co-ordinated Appointment Rebate (section 2.5) =====

# The Order Acknowledgement event
:OrderAcknowledgementEvent a :Cl_OrderAcknowledgement, owl:NamedIndividual ;
    rdfs:label "Order Acknowledgement Event" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.1, p.13" .

# The Co-ordinated Appointment Rebate
:CoordinatedAppointmentRebate a :Cl_CoOrdinatedAppointmentRebate, owl:NamedIndividual ;
    rdfs:label "Co-ordinated Appointment Rebate" ;
    :isPaidBy :NbnAgent ;
    :isPaidTo :RspAgent ;
    :hasAmount :CoordinatedAppointmentCharge ;
    :isPaidByApplyingToInvoice :RspInvoice ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s2.5(a), p.13" .

# nbn agent
:NbnAgent a :Cl_nbn, owl:NamedIndividual ;
    rdfs:label "nbn" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.13" .

# RSP agent
:RspAgent a :Cl_RSP, owl:NamedIndividual ;
    rdfs:label "RSP" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.13" .

# The Charge for the relevant Co-ordinated Appointment
:CoordinatedAppointmentCharge a :Cl_Charge, owl:NamedIndividual ;
    rdfs:label "Co-ordinated Appointment Charge" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s2.5(a), p.13" .

# The RSP's invoice
:RspInvoice a :Cl_Invoice, owl:NamedIndividual ;
    rdfs:label "RSP Invoice" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s2.5(a), p.13" .

# The Co-ordinated Appointment event that triggers the rebate when nbn does not attend within the Service Level
:CoordinatedAppointmentEvent a :Cl_CoOrdinatedAppointment, owl:NamedIndividual ;
    rdfs:label "Co-ordinated Appointment Event" ;
    :triggersRebate :CoordinatedAppointmentRebate ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s2.5(a), p.13" .

# Service Level for attending the Co-ordinated Appointment
:CoordinatedAppointmentServiceLevel a :ServiceLevel, owl:NamedIndividual ;
    rdfs:label "Co-ordinated Appointment Service Level" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s2.5(a), p.13" . ---
