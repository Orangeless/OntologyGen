--- CONTENT: # ===== EXTENSIONS FROM PAGE 34: Utilisation Threshold, Utilisation Management Performance Objective, FTTB/N/C Connection Performance Rebate, Downstream Performance Threshold =====

# --- New Classes ---

:Cl_UtilisationThreshold a owl:Class ;
    rdfs:label "Utilisation Threshold" ;
    rdfs:comment "The condition (90% utilisation, 30 continuous minutes, at least 3 separate days within any rolling 30-day period) that triggers nbn's utilisation management obligation. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

:Cl_UtilisationManagementPerformanceObjective a owl:Class ;
    rdfs:label "Utilisation Management Performance Objective" ;
    rdfs:comment "nbn's obligation to return utilisation of a Shared Network Resource to below the Utilisation Threshold within 15 Business Days. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:subClassOf :Cl_PerformanceObjective .

:Cl_FTTBNCConnectionPerformanceRebate a owl:Class ;
    rdfs:label "FTTB/N/C Connection Performance Rebate" ;
    rdfs:comment "A rebate of $21.22 AUD per Ordered Product, payable when Measured Connection Rate is below thresholds, with annual CPI-like increases from 1 July 2025. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

:Cl_DownstreamPerformanceThreshold a owl:Class ;
    rdfs:label "Downstream Performance Threshold" ;
    rdfs:comment "A Mbps threshold per AVC TC-4 bandwidth profile and technology, used to determine rebate eligibility. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

:Cl_ConnectionAssuredRate a owl:Class ;
    rdfs:label "Connection Assured Rate" ;
    rdfs:comment "The rate for an nbn Copper Pair that was available via the Site Qualification System at the SQ Enquiry Time. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

:Cl_MeasuredConnectionRate a owl:Class ;
    rdfs:label "Measured Connection Rate" ;
    rdfs:comment "The rate measured as at the Connection Performance Measurement Date for an nbn Copper Pair. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

:Cl_SQEnquiryTime a owl:Class ;
    rdfs:label "SQ Enquiry Time" ;
    rdfs:comment "The time at which the Site Qualification System is queried to determine the Connection Assured Rate. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

:Cl_ConnectionPerformanceMeasurementDate a owl:Class ;
    rdfs:label "Connection Performance Measurement Date" ;
    rdfs:comment "The date as at which the Measured Connection Rate is determined. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

:Cl_OriginallyConnectedAVCTC4 a owl:Class ;
    rdfs:label "Originally Connected AVC TC-4" ;
    rdfs:comment "The AVC TC-4 Ordered Product Component that was originally connected, used to determine the Downstream Performance Threshold for rebate eligibility. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

:Cl_nbnCopperPair a owl:Class ;
    rdfs:label "nbn Copper Pair" ;
    rdfs:comment "An nbn Copper Pair used to supply an nbn Ethernet (FTTB), nbn Ethernet (FTTN), or nbn Ethernet (FTTC) TC-4 Ordered Product. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

:Cl_WeightedAveragePriceChange a owl:Class ;
    rdfs:label "Weighted Average Price Change" ;
    rdfs:comment "The weighted average price change used to increase the FTTB/N/C Connection Performance Rebate amounts from 1 July 2025. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

:Cl_ConnectOrder a owl:Class ;
    rdfs:label "Connect Order" ;
    rdfs:comment "An order for connection of an nbn Ethernet (FTTB), nbn Ethernet (FTTN), or nbn Ethernet (FTTC) TC-4 Ordered Product. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" .

# --- New Data Properties ---

:hasUtilisationPercentage a owl:DatatypeProperty ;
    rdfs:label "has utilisation percentage" ;
    rdfs:comment "The utilisation percentage threshold that triggers utilisation management. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:decimal .

:hasContinuousPeriodDuration a owl:DatatypeProperty ;
    rdfs:label "has continuous period duration" ;
    rdfs:comment "The duration of the continuous period of utilisation that must be exceeded to trigger the Utilisation Threshold, in ISO-8601 format. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:string .

:hasMinimumDays a owl:DatatypeProperty ;
    rdfs:label "has minimum days" ;
    rdfs:comment "The minimum number of separate days within the rolling period on which utilisation must exceed the threshold. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:integer .

:hasRollingPeriodDuration a owl:DatatypeProperty ;
    rdfs:label "has rolling period duration" ;
    rdfs:comment "The duration of the rolling period used to count separate days for the Utilisation Threshold, in ISO-8601 format. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:string .

:hasResponseTimeBusinessDays a owl:DatatypeProperty ;
    rdfs:label "has response time business days" ;
    rdfs:comment "The number of Business Days within which nbn must respond to a Utilisation Threshold breach. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:integer .

:hasDownstreamPerformanceThresholdMbps a owl:DatatypeProperty ;
    rdfs:label "has downstream performance threshold Mbps" ;
    rdfs:comment "The downstream performance threshold value in Mbps. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:integer .

:hasConnectionAssuredRateMbps a owl:DatatypeProperty ;
    rdfs:label "has connection assured rate Mbps" ;
    rdfs:comment "The Connection Assured Rate in Mbps. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:integer .

:hasMeasuredConnectionRateMbps a owl:DatatypeProperty ;
    rdfs:label "has measured connection rate Mbps" ;
    rdfs:comment "The Measured Connection Rate in Mbps. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:integer .

:hasWeightedAveragePriceChangePct a owl:DatatypeProperty ;
    rdfs:label "has weighted average price change pct" ;
    rdfs:comment "The Weighted Average Price Change percentage. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:decimal .

:hasAnnualIncreaseStartDate a owl:DatatypeProperty ;
    rdfs:label "has annual increase start date" ;
    rdfs:comment "The date from which annual increases to rebate amounts apply. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:dateTime .

:hasMinimumIncreasePct a owl:DatatypeProperty ;
    rdfs:label "has minimum increase pct" ;
    rdfs:comment "The minimum percentage increase applied to rebate amounts. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:decimal .

:hasBandwidthProfileDownstreamPir a owl:DatatypeProperty ;
    rdfs:label "has bandwidth profile downstream PIR" ;
    rdfs:comment "The downstream PIR bandwidth profile value as a string (e.g. '25-50', 'Home Fast (25-100)'). [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:string .

:hasBandwidthProfileUpstreamPir a owl:DatatypeProperty ;
    rdfs:label "has bandwidth profile upstream PIR" ;
    rdfs:comment "The upstream PIR bandwidth profile value as a string (e.g. '5-20', '(5-20)'). [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range xsd:string .

# --- New Object Properties ---

:appliesToTechnology a owl:ObjectProperty ;
    rdfs:label "applies to technology" ;
    rdfs:comment "Links a Downstream Performance Threshold to the Access Technology it applies to. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range :AccessTechnology .

:isPayableFor a owl:ObjectProperty ;
    rdfs:label "is payable for" ;
    rdfs:comment "Links a rebate to the Connect Order it is payable for. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range :Cl_ConnectOrder .

:increasedBy a owl:ObjectProperty ;
    rdfs:label "increased by" ;
    rdfs:comment "Links a rebate to the Weighted Average Price Change that increases its amount. [extension: WBA Ethernet Service Levels Schedule, s15, p.34]" ;
    rdfs:range :Cl_WeightedAveragePriceChange .

:triggers a owl:ObjectProperty ;
    rdfs:label "triggers" ;
