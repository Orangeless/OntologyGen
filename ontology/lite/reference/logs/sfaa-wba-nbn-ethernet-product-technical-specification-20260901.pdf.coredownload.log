--- CONTENT: # ===== A.6.5 / A.6.6 Bandwidth Profile Availability (TC-1, TC-2) Extensions =====

# --- Classes ---

:Cl_BandwidthProfileAvailability a owl:Class ;
    rdfs:label "Bandwidth Profile Availability" ;
    rdfs:comment "Reified statement that a specific bandwidth profile (data rate value) for a given traffic class is available (or not) on a specific UNI type for a given access technology. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.5, page 51]" .

:Cl_HFC_NTD_Variant a owl:Class ;
    rdfs:label "HFC-NTD Variant" ;
    rdfs:comment "A specific hardware variant of the HFC Network Termination Device, such as the CM820B, which has limitations on supported features. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.6, page 51, footnote 37]" .

# --- Object Properties ---

:hasTrafficClass a owl:ObjectProperty ;
    rdfs:label "hasTrafficClass" ;
    rdfs:comment "Links a Cl_BandwidthProfileAvailability node to the traffic class whose bandwidth profile availability is being described. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.5, page 51]" ;
    rdfs:domain :Cl_BandwidthProfileAvailability ;
    rdfs:range :TrafficClass .

:availableOnUNI a owl:ObjectProperty ;
    rdfs:label "availableOnUNI" ;
    rdfs:comment "Links a Cl_BandwidthProfileAvailability node to the UNI type (UNI-V, UNI-D, UNI-DSL) on which the bandwidth profile is available. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.5, page 51]" ;
    rdfs:domain :Cl_BandwidthProfileAvailability ;
    rdfs:range :AVC .

:hasBandwidthProfileValue a owl:DatatypeProperty ;
    rdfs:label "hasBandwidthProfileValue" ;
    rdfs:comment "The numeric value of a bandwidth profile in Mbps. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.5, page 51]" ;
    rdfs:domain :Cl_BandwidthProfileAvailability ;
    rdfs:range xsd:decimal .

:hasBandwidthProfileUnit a owl:DatatypeProperty ;
    rdfs:label "hasBandwidthProfileUnit" ;
    rdfs:comment "The unit of measurement for a bandwidth profile value (Mbps). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.5, page 51]" ;
    rdfs:domain :Cl_BandwidthProfileAvailability ;
    rdfs:range xsd:string .

:doesNotSupport a owl:ObjectProperty ;
    rdfs:label "doesNotSupport" ;
    rdfs:comment "Links an HFC-NTD variant to the traffic class or bandwidth profile it does not support. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.6, page 51, footnote 37]" ;
    rdfs:domain :Cl_HFC_NTD_Variant ;
    rdfs:range owl:Thing .

