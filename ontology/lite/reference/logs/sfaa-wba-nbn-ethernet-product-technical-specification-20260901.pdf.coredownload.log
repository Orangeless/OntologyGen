    :hasDescription "In the event of AVC:CVC congestion within unicast services, the nbn Network will discard traffic in accordance with section 2.2"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.4, page 28" .

:DocumentSection_2_2 a :DocumentSection,
