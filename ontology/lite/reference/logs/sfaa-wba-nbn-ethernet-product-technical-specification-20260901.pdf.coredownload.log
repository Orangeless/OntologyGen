# --- Classes ---

:EstablishANewNNILink a owl:Class ;
    rdfs:label "Establish a new NNI Link" ;
    rdfs:comment "An event that creates a new NNI Link by specifying the range of S-TAGs, bandwidth and the V-NNI RSP. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" ;
    rdfs:subClassOf :Cl_Event .

:ModifyAnExistingNNILink a owl:Class ;
    rdfs:label "Modify an existing NNI Link" ;
    rdfs:comment "An event that modifies an existing NNI Link by updating the S-TAG pool and bandwidth, subject to there being sufficient spare capacity on the associated Downstream V-NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" ;
    rdfs:subClassOf :Cl_Event .

:CancelAnExistingNNILink a owl:Class ;
    rdfs:label "Cancel an existing NNI Link" ;
    rdfs:comment "An event that cancels an existing NNI Link, permitted only when not used by a Downstream V-NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" ;
    rdfs:subClassOf :Cl_Event .

:S-TAGPool a owl:Class ;
    rdfs:label "S-TAG Pool" ;
    rdfs:comment "The range of S-TAG values associated with an NNI Link. Start of pool greater than or equal to 1; end of pool less than or equal to 4000. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 13, page 43]" ;
    rdfs:subClassOf :S_TAG_Pool .

:Bandwidth a owl:Class ;
    rdfs:label "Bandwidth" ;
    rdfs:comment "The NNI Link Bandwidth attribute. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 13, page 43]" .

:V-NNIRSP a owl:Class ;
    rdfs:label "V-NNI RSP" ;
    rdfs:comment "The RSP name belonging to the V-NNI RSP attribute of an NNI Link. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 13, page 43]" .

:DownstreamV-NNI a owl:Class ;
    rdfs:label "Downstream V-NNI" ;
    rdfs:comment "A V-NNI that uses an NNI Link; its presence restricts modification and cancellation of the NNI Link. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" ;
    rdfs:subClassOf :V_NNI .

:nbn-suppliedNNIBearerIdentification a owl:Class ;
    rdfs:label "nbn-supplied NNI Bearer identification" ;
    rdfs:comment "The identification number yielded by each successful NNI Bearer order, which indicates a physical port on the nbn ODF to which the NNI Bearer has been cabled. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 12, page 42]" .

:nbn-designatedNNILinkIdentificationNumber a owl:Class ;
    rdfs:label "nbn-designated NNI Link identification number" ;
    rdfs:comment "The identification number assigned to each successful NNI Link order. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.2, page 43]" .

:FacilitiesAccessRights a owl:Class ;
    rdfs:label "Facilities Access Rights" ;
    rdfs:comment "The necessary facilities access rights that RSP must separately acquire to connect the NNI Bearer to RSP's backhaul transmission cables or RSP Active Equipment. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 12, page 42]" .

:PhysicalPort a owl:Class ;
    rdfs:label "Physical Port" ;
    rdfs:comment "A physical port on the nbn ODF to which the NNI Bearer has been cabled, indicated by the nbn-supplied NNI Bearer identification. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 12, page 42]" .

:EstablishObject a owl:Class ;
    rdfs:label "Establish Object" ;
    rdfs:comment "A reified node capturing the composite object of an Establish a new NNI Link event: the range of S-TAGs, bandwidth and the V-NNI RSP. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" .

:ModifyObject a owl:Class ;
    rdfs:label "Modify Object" ;
    rdfs:comment "A reified node capturing the composite object of a Modify an existing NNI Link event: the updating of the S-TAG pool and bandwidth. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" .

