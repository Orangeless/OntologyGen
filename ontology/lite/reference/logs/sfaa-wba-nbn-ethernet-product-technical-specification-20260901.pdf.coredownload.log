--- CONTENT: # ===== Class of Service Support (Section 6.7) =====

# --- New Classes ---
:Cl_ClassOfServiceSupport a owl:Class ;
    rdfs:label "ClassOfServiceSupport" ;
    rdfs:comment "A reified description of the traffic class and priority encoding/decoding model that an NNI Group transparently supports. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.7, page 31]" .

:Cl_TrafficDiscardEvent a owl:Class ;
    rdfs:label "TrafficDiscardEvent" ;
    rdfs:comment "A reified event describing the circumstances under which traffic may be discarded for an NNI Group, including the cause and the priority basis for discard. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.7, page 31]" .

# --- New Object Properties ---
:supportsClassOfService a owl:ObjectProperty ;
    rdfs:label "supportsClassOfService" ;
    rdfs:comment "Links an NNI Group to its reified class of service support description. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.7, page 31]" ;
    rdfs:domain :NNIGroup ;
    rdfs:range :Cl_ClassOfServiceSupport .

:hasTrafficDiscardEvent a owl:ObjectProperty ;
    rdfs:label "hasTrafficDiscardEvent" ;
    rdfs:comment "Links an NNI Group to a reified traffic discard event. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.7, page 31]" ;
    rdfs:domain :NNIGroup ;
    rdfs:range :Cl_TrafficDiscardEvent .

:hasCause a owl:ObjectProperty ;
    rdfs:label "hasCause" ;
    rdfs:comment "Links a traffic discard event to the cause of the discard. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.7, page 31]" ;
    rdfs:domain :Cl_TrafficDiscardEvent ;
    rdfs:range owl:Thing .

:hasTrigger a owl:ObjectProperty ;
    rdfs:label "hasTrigger" ;
    rdfs:comment "Links a traffic discard event to the event that triggers the discard (e.g. failure of one or more NNI Bearers). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.7, page 31]" ;
    rdfs:domain :Cl_TrafficDiscardEvent ;
    rdfs:range owl:Thing .

