# --- Classes ---

:Cl_CVCClass a owl:Class ;
    rdfs:label "CVC Class" ;
    rdfs:comment "The CVC Class attribute chosen by an RSP at the time of ordering a CVC for nbn Ethernet (Satellite), with values CVC Class-0 (Default), CVC Class-1 (Premium), and CVC Class-2 (Premium). [extension: nbn Ethernet Product Module, Table 8, page 38]" ;
    rdfs:subClassOf :Cl_ServiceAttribute .

:Cl_SCVIDAllocationEvent a :Cl_Event, owl:Class ;
    rdfs:label "S/C-VID Allocation Event" ;
    rdfs:comment "The event where nbn allocates an internally-generated S/C-VID to a new CVC/AVC upon request from an RSP as part of a Product Order Form. [extension: nbn Ethernet Product Module, page 38]" ;
    rdfs:subClassOf :Cl_Event .

:Cl_BandwidthProfile a owl:Class ;
    rdfs:label "Bandwidth Profile" ;
    rdfs:comment "A set of attributes (CVC_TC-1_CIR, CVC_TC-2_CIR, CVC_TC-4_PIR, CVC_TC-4_CIR) that define the bandwidth characteristics of a CVC, with applicability varying by access technology. [extension: nbn Ethernet Product Module, Table 9, page 39]" ;
    rdfs:subClassOf :Cl_ServiceAttribute .

:Cl_CVC_TC1_CIR a owl:Class ;
    rdfs:label "CVC_TC-1_CIR" ;
    rdfs:comment "CVC TC-1 CIR bandwidth profile attribute (upstream and downstream), applicable to all network types. [extension: nbn Ethernet Product Module, Table 9, page 39]" ;
    rdfs:subClassOf :Cl_BandwidthProfile .

:Cl_CVC_TC2_CIR a owl:Class ;
    rdfs:label "CVC_TC-2_CIR" ;
    rdfs:comment "CVC TC-2 CIR bandwidth profile attribute (upstream and downstream), applicable to all network types. [extension: nbn Ethernet Product Module, Table 9, page 39]" ;
    rdfs:subClassOf :Cl_BandwidthProfile .

:Cl_CVC_TC4_PIR a owl:Class ;
    rdfs:label "CVC_TC-4_PIR" ;
    rdfs:comment "CVC TC-4 PIR bandwidth profile attribute (upstream and downstream), applicable to Fibre, FTTB, FTTN, FTTC, HFC and Wireless. [extension: nbn Ethernet Product Module, Table 9, page 39]" ;
    rdfs:subClassOf :Cl_BandwidthProfile .

:Cl_CVC_TC4_CIR a owl:Class ;
    rdfs:label "CVC_TC-4_CIR" ;
    rdfs:comment "CVC TC-4 CIR bandwidth profile attribute (upstream and downstream), applicable to Satellite. [extension: nbn Ethernet Product Module, Table 9, page 39]" ;
    rdfs:subClassOf :Cl_BandwidthProfile .

:Cl_SatelliteCvcMinAvcThreshold a owl:Class ;
    rdfs:label "Satellite CVC Minimum AVC Threshold" ;
    rdfs:comment "The attribute that determines the minimum number of provisioned AVCs required before RSP can order an increased CVC bandwidth profile for nbn Ethernet (Satellite). [extension: nbn Ethernet Product Module, Table 8, page 38]" ;
    rdfs:subClassOf :Cl_ServiceAttribute .

:Cl_Unicast11CVC a owl:Class ;
    rdfs:label "Unicast 1:1 CVC" ;
    rdfs:comment "A subclass of CVC for the Unicast 1:1 CVC order type. Each unicast 1:1 CVC order must specify each of the service attributes listed in Table 9. [extension: nbn Ethernet Product Module, section 8.2.1, page 39]" ;
    rdfs:subClassOf :CVC .

:Cl_ProductOrderForm a owl:Class ;
    rdfs:label "Product Order Form" ;
    rdfs:comment "A form through which an RSP requests a CVC or AVC, including requests for S/C-VID allocation and optional nomination of S/C-VID. [extension: nbn Ethernet Product Module, page 38]" .

:Cl_WBAOperationsManual a owl:Class ;
    rdfs:label "WBA Operations Manual" ;
    rdfs:comment "The WBA Operations Manual document in accordance with which S/C-VID values are returned to RSP. [extension: nbn Ethernet Product Module, page 38]" .

:Cl_ServiceAddressingMode a owl:Class ;
    rdfs:label "Service Addressing Mode" ;
    rdfs:comment "The service addressing mode at the NNI. [extension: nbn Ethernet Product Module, page 38]" .

