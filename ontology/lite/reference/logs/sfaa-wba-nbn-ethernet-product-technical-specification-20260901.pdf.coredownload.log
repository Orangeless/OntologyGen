--- CONTENT: # ===== NNI Group and NNI Bearers (Section 6) =====

# --- New Classes ---
:Cl_ProtectionMode a owl:Class ;
    rdfs:label "ProtectionMode" ;
    rdfs:comment "The protection mode (N:1 or 1:1) under which NNI Bearers of an NNI Group operate. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2, page 28]" .

:Cl_ChassisRole a owl:Class ;
    rdfs:label "ChassisRole" ;
    rdfs:comment "The role (working or protect) of a chassis on which NNI Bearers are provisioned in Diverse Chassis mode. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2.2, page 28]" .

:Cl_BearerLimit a owl:Class ;
    rdfs:label "BearerLimit" ;
    rdfs:comment "A reified conditional maximum number of NNI Bearers an NNI Group can support, dependent on interface rate and redundancy mode. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.1, page 28]" .

:Cl_BearerLimitCondition a owl:Class ;
    rdfs:label "BearerLimitCondition" ;
    rdfs:comment "A reified condition (interface rate and redundancy mode) under which a bearer limit applies. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.1, page 28]" .

:Cl_FailureResponse a owl:Class ;
    rdfs:label "FailureResponse" ;
    rdfs:comment "A reified description of the behaviour of an NNI Group when an NNI Bearer fails, dependent on the redundancy mode. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2, page 28]" .

# --- New Object Properties ---
:hasBearerLimit a owl:ObjectProperty ;
    rdfs:label "hasBearerLimit" ;
    rdfs:comment "Links an NNI Group to a reified conditional bearer limit. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.1, page 28]" ;
    rdfs:domain :NNIGroup ;
    rdfs:range :Cl_BearerLimit .

:hasCondition a owl:ObjectProperty ;
    rdfs:label "hasCondition" ;
    rdfs:comment "Links a bearer limit to its reified condition (rate and mode). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.1, page 28]" ;
    rdfs:domain :Cl_BearerLimit ;
    rdfs:range :Cl_BearerLimitCondition .

:hasMode a owl:ObjectProperty ;
    rdfs:label "hasMode" ;
    rdfs:comment "Links a bearer limit condition to the redundancy mode. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.1, page 28]" ;
    rdfs:domain :Cl_BearerLimitCondition ;
    rdfs:range :RedundancyMode .

:hasProtectionMode a owl:ObjectProperty ;
    rdfs:label "hasProtectionMode" ;
    rdfs:comment "Links an NNI Group to its protection mode (N:1 or 1:1). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2, page 28]" ;
    rdfs:domain :NNIGroup ;
    rdfs:range :Cl_ProtectionMode .

:hasChassisRole a owl:ObjectProperty ;
    rdfs:label "hasChassisRole" ;
    rdfs:comment "Links an NNI Bearer to its chassis role (working or protect) in Diverse Chassis mode. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2.2, page 28]" ;
    rdfs:domain :Bearer ;
    rdfs:range :Cl_ChassisRole .

:hasFailureResponse a owl:ObjectProperty ;
    rdfs:label "hasFailureResponse" ;
    rdfs:comment "Links an NNI Group to its reified failure response behaviour. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2, page 28]" ;
    rdfs:domain :NNIGroup ;
    rdfs:range :Cl_FailureResponse .

# --- New Data Properties ---
:hasMaxBearers a owl:DatatypeProperty ;
    rdfs:label "hasMaxBearers" ;
    rdfs:comment "The maximum number of NNI Bearers an NNI Group can support under a given condition. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.1, page 28]" ;
    rdfs:domain :Cl_BearerLimit ;
    rdfs:range xsd:integer .

:hasRate a owl:DatatypeProperty ;
    rdfs:label "hasRate" ;
    rdfs:comment "The interface rate (Gbps) of a bearer limit condition. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.1, page 28]" ;
    rdfs:domain :Cl_BearerLimitCondition ;
    rdfs:range xsd:decimal .

:hasFailureDescription a owl:DatatypeProperty ;
    rdfs:label "hasFailureDescription" ;
    rdfs:comment "A textual description of the failure response behaviour of an NNI Group. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2, page 28]" ;
    rdfs:domain :Cl_FailureResponse ;
    rdfs:range xsd:string .

:hasUnit a owl:DatatypeProperty ;
    rdfs:label "hasUnit" ;
    rdfs:comment "The unit of measurement for a bearer limit count. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.1, page 28]" ;
    rdfs:domain :Cl_BearerLimit ;
    rdfs:range xsd:string .

# --- Protection Mode Individuals ---
:ProtectionMode_N_1 a :Cl_ProtectionMode, owl:NamedIndividual ;
    rdfs:label "N:1 Protection Mode" ;
    :hasDescription "N:1 protection mode, meaning that if any NNI Bearer within the NNI Group fails, the NNI Group will continue to operate at an aggregate capacity that is reduced by the capacity of the failed NNI Bearer"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2.1, page 28" .

:ProtectionMode_1_1 a :Cl_ProtectionMode, owl:NamedIndividual ;
    rdfs:label "1:1 Protection Mode" ;
    :hasDescription "1:1 protection mode, meaning that if any NNI Bearer on the working chassis fails, traffic will be re-directed to the NNI Bearers on the protect chassis"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2.2, page 28" .

# --- Chassis Role Individuals ---
:ChassisRole_Working a :Cl_ChassisRole, owl:NamedIndividual ;
    rdfs:label "Working Chassis" ;
    :hasDescription "The working chassis on which half of the NNI Bearers of an NNI Group are provisioned in Diverse Chassis mode"^^xsd:string ;
