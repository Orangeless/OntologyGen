--- CONTENT: # ===== EXTENSIONS: Section 4.1.3.2 - Unicast N:1 AVC Bandwidth Profile Availability (Page 26) =====

# Document section for 4.1.3.2
:DocumentSection_4_1_3_2 a :DocumentSection,
        owl:NamedIndividual ;
    rdfs:label "Section 4.1.3.2" ;
    :hasSectionNumber "4.1.3.2"^^xsd:string ;
    :hasSectionTitle "Unicast N:1 AVC Bandwidth Profile Availability"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 26" .

# New classes for Unicast N:1 AVC modeling
:Cl_UnicastN1AVC a owl:Class ;
    rdfs:label "Unicast N:1 AVC" ;
    rdfs:comment "A specific type of Access Virtual Circuit (AVC) that is exclusively available to support a bundle comprising the UNI-V interface and the AVC TC-1 traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:subClassOf :AVC .

:Cl_Bundle a owl:Class ;
    rdfs:label "Bundle" ;
    rdfs:comment "A bundle comprising the UNI-V interface and the AVC TC-1 traffic class that the Unicast N:1 AVC is available only to support. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" .

:Cl_AvailabilityConstraint a owl:Class ;
    rdfs:label "AvailabilityConstraint" ;
    rdfs:comment "Reified relationship representing that a Unicast N:1 AVC is available only to support a specific bundle (UNI-V + AVC TC-1). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" .

:Cl_BandwidthProfileSpec a owl:Class ;
    rdfs:label "BandwidthProfileSpec" ;
    rdfs:comment "Reified relationship representing a traffic class specification (traffic class, rate type, rate value, unit) within a bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" .

# Object properties for Unicast N:1 AVC
:availableOnlyToSupport a owl:ObjectProperty ;
    rdfs:label "availableOnlyToSupport" ;
    rdfs:comment "Links a Unicast N:1 AVC to its availability constraint reification node. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain :Cl_UnicastN1AVC ;
    rdfs:range :Cl_AvailabilityConstraint .

:hasBandwidthProfile a owl:ObjectProperty ;
    rdfs:label "hasBandwidthProfile" ;
    rdfs:comment "Links a Unicast N:1 AVC to its bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain :Cl_UnicastN1AVC ;
    rdfs:range :BandwidthProfile .

:includesTrafficClassSpec a owl:ObjectProperty ;
    rdfs:label "includesTrafficClassSpec" ;
    rdfs:comment "Links a BandwidthProfile to a traffic class specification reification node. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain :BandwidthProfile ;
    rdfs:range :Cl_BandwidthProfileSpec .

:hasTrafficClass a owl:ObjectProperty ;
    rdfs:label "hasTrafficClass" ;
    rdfs:comment "Links a BandwidthProfileSpec to the traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain :Cl_BandwidthProfileSpec ;
    rdfs:range :TrafficClass .

:hasRateType a owl:ObjectProperty ;
    rdfs:label "hasRateType" ;
    rdfs:comment "Links a BandwidthProfileSpec to the rate type (CIR or PIR). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain :Cl_BandwidthProfileSpec ;
    rdfs:range :Cl_SpecificationType .

:hasRateValue a owl:DatatypeProperty ;
    rdfs:label "hasRateValue" ;
    rdfs:comment "The numeric value of a rate (CIR or PIR) in a bandwidth profile specification. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain :Cl_BandwidthProfileSpec ;
    rdfs:range xsd:string .

:hasUnit a owl:DatatypeProperty ;
    rdfs:label "hasUnit" ;
    rdfs:comment "The unit of measurement for a rate value (e.g. Mbps). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain :Cl_BandwidthProfileSpec ;
    rdfs:range xsd:string .

# Object properties for Cl_AvailabilityConstraint
:constrainsAVC a owl:ObjectProperty ;
    rdfs:label "constrainsAVC" ;
    rdfs:comment "Links an AvailabilityConstraint to the AVC it constrains. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain :Cl_AvailabilityConstraint ;
    rdfs:range :Cl_UnicastN1AVC .

:supportsBundle a owl:ObjectProperty ;
    rdfs:label "supportsBundle" ;
    rdfs:comment "Links an AvailabilityConstraint to the bundle it supports. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain :Cl_AvailabilityConstraint ;
    rdfs:range :Cl_Bundle .

:comprisesUNI a owl:ObjectProperty ;
    rdfs:label "comprisesUNI" ;
    rdfs:comment "Links a Bundle to the UNI type it comprises. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain :Cl_Bundle ;
    rdfs:range :AVC .

:comprisesTrafficClass a owl:ObjectProperty ;
    rdfs:label "comprisesTrafficClass" ;
    rdfs:comment "Links a Bundle to the traffic class it comprises. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain :Cl_Bundle ;
    rdfs:range :TrafficClass .

# ===== FACTS: Unicast N:1 AVC Instance =====

