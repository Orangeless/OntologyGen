# ===== FACTS: Unicast 1:1 AVC Bandwidth Profile (Section 4.1.3.1) =====

# A Unicast 1:1 AVC comprises a combination of mandatory (TC-4) and optional (TC-1 and/or TC-2) traffic classes
:Unicast_1_1_AVC_BandwidthProfile a :Unicast_1_1_AVC,
        owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC Bandwidth Profile" ;
    :hasDescription "A Unicast 1:1 AVC comprises a combination of mandatory (TC-4) and optional (TC-1 and/or TC-2) traffic classes as described in section 3.1 of the nbn Ethernet Product Description"^^xsd:string ;
    :describedIn :nbnEthernetProductDescription_Doc ;
    :describedInSection :DocumentSection_4_1_3_1 ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

# The comprises relationship with mandatory/optional qualifiers
:Unicast_1_1_AVC_Comprises_TC4 a owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC comprises TC-4 (mandatory)" ;
    :comprises :TC_4 ;
    :hasDescription "TC-4 is a mandatory traffic class in a Unicast 1:1 AVC"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

:Unicast_1_1_AVC_Comprises_TC1 a owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC comprises TC-1 (optional)" ;
    :comprises :TC_1 ;
    :hasDescription "TC-1 is an optional traffic class in a Unicast 1:1 AVC"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

:Unicast_1_1_AVC_Comprises_TC2 a owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC comprises TC-2 (optional)" ;
    :comprises :TC_2 ;
    :hasDescription "TC-2 is an optional traffic class in a Unicast 1:1 AVC"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

# A valid Unicast 1:1 AVC bandwidth profile comprises a combination of available upstream/downstream bandwidth profiles for each traffic class
:Unicast_1_1_AVC_BWProfile_Instance a :AVCBandwidthProfile,
        owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC Bandwidth Profile Instance" ;
    :hasDescription "A valid Unicast 1:1 AVC bandwidth profile comprises a combination of available upstream/downstream bandwidth profiles for each traffic class as specified from the available combinations in sections B.1 and B.2 to Appendix B"^^xsd:string ;
    :setOutIn :DocumentSection_AppendixB ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

:Unicast_1_1_AVC_BandwidthProfile :hasBandwidthProfile :Unicast_1_1_AVC_BWProfile_Instance .

# Availability by access technology for each Unicast 1:1 AVC bandwidth profile combination is set out in sections B.1 and B.2 to Appendix B
:Unicast_1_1_AVC_BWProfile_Avail_Note a owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC Bandwidth Profile Availability Note" ;
    :hasDescription "Availability by access technology for each Unicast 1:1 AVC bandwidth profile combination is also set out in sections B.1 and B.2 to Appendix B"^^xsd:string ;
    :setOutIn :DocumentSection_AppendixB ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

