    rdfs:label "Discarded Traffic" ;
    :hasDescription "Traffic discarded by the nbn network in the event of AVC:CVC congestion within unicast services"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.4, page 28" .

:nbnNetwork_Discard_Example a owl:NamedIndividual ;
