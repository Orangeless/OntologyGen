# CVC implements the S-VLAN component of an IEEE802.1ad Provider Bridge
:CVC_Implements_SVLAN a owl:NamedIndividual ;
    rdfs:label "CVC Implements S-VLAN" ;
    :hasDescription "The CVC implements the S-VLAN component of an IEEE802.1ad Provider Bridge, as further described in the Network Interface Specification - CVC"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26" .

# CVC is an Ethernet virtual circuit providing connectivity from NNI to CSA
:CVC_Example a :CVC,
        owl:NamedIndividual ;
    rdfs:label "CVC Example" ;
    :hasDescription "Connectivity Virtual Circuit - an Ethernet virtual circuit that provides connectivity from an NNI to a CSA"^^xsd:string ;
    :dimensionedWithBandwidth "specific configured amount of bandwidth capacity"^^xsd:string ;
    :describedInSection :DocumentSection_5 ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26" .

# ===== FACTS: CVC Connectivity (from NNI to CSA) =====
