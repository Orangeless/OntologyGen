# ===== FACTS: CVC Description and Relationships =====

# CVC description
:CVC rdfs:comment "The CVC implements the S-VLAN component of an IEEE802.1ad Provider Bridge, as further described in the Network Interface Specification - CVC. This is an Ethernet virtual circuit that provides connectivity from an NNI to a CSA. It is dimensioned with a specific, configured amount of bandwidth capacity to deliver a higher-layer service (or number of services) to a range of AVCs within a particular CSA. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" .

# CVC has two variants
:CVC :hasCvcType :CvcType_1_1 .
:CVC :hasCvcType :CvcType_N_1 .

# CVC carries a CSA
:CVC :carries :CSA .

# CVC maps to an NNI Group
:CVC :mapsTo :NNIGroup .

# CVC delivers AVCs
:CVC :delivers :AVC .

# CVC is isolated via S-VID
:CVC :isolatedVia :S_VID .

# CVC is specific to RSP
:CVC :specificTo :RSP .

# NNI is specific to RSP
:NNIGroup :specificTo :RSP .

# RSP may have multiple CVCs within a CSA
:RSP :mayHaveMultipleCVCsWithin :CSA .

# Different CVC types can co-exist on the same NNI
:NNIGroup :hasCvcType :CvcType_1_1 .
:NNIGroup :hasCvcType :CvcType_N_1 .

# ===== FACTS: AVC and CVC Scalability (Section 5.1.2) =====

# RSP should consider AVC and CVC scalability in conjunction with contention
:RSP :mayControlEndUserExperienceThrough :Contention .

# RSP may control End User experience through contention applied by dimensioning of capacity between the AVC and CVC
:Contention a owl:NamedIndividual ;
    rdfs:label "Contention between AVC and CVC" ;
    rdfs:comment "Contention applied by dimensioning of capacity between the AVC and CVC subject to conditions set out in the nbn Ethernet Product Description. [extension: nbn Ethernet Product Module, Section 5.1.2, p.27]" ;
    :sourceClause "nbn Ethernet Product Module, Section 5.1.2, p.27" .

:CVC :hasContention :Contention .
:AVC :hasContention :Contention .

# ===== FACTS: CVC Max CVC TC-4 Bandwidth Profile (Footnote 10) =====

:CvcMaxCvcTC4BandwidthProfile_Default a :CvcMaxCvcTC4BandwidthProfile,
        owl:NamedIndividual ;
    rdfs:label "CVC Max CVC TC-4 Bandwidth Profile" ;
    rdfs:comment "For the CVC Max CVC TC-4 bandwidth profile, the amount of bandwidth capacity will be automatically configured to equal the bandwidth of the associated NNI. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27 (footnote 10)]" ;
    :automaticallyConfiguredToEqual :NNIGroup ;
    :sourceClause "nbn Ethernet Product Module, Section 5.1.1, p.27 (footnote 10)" .

:CVC :hasCvcMaxCvcTC4BandwidthProfile :CvcMaxCvcTC4BandwidthProfile_Default .

