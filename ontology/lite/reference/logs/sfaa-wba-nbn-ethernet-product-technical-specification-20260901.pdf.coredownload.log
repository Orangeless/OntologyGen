--- CONTENT: # ===== Traffic Class Extension: Specification Types, Network Contexts, Applications, etc. =====
# New classes for the traffic class domain (page 9-10)

:Cl_SpecificationType a owl:Class ;
    rdfs:label "SpecificationType" ;
    rdfs:comment "The type of capacity specification (CIR or PIR) applied to a traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_CIR a owl:Class ;
    rdfs:subClassOf :Cl_SpecificationType ;
    rdfs:label "CIR" ;
    rdfs:comment "Committed Information Rate specification type. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_PIR a owl:Class ;
    rdfs:subClassOf :Cl_SpecificationType ;
    rdfs:label "PIR" ;
    rdfs:comment "Peak Information Rate specification type. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_NetworkContext a owl:Class ;
    rdfs:label "NetworkContext" ;
    rdfs:comment "A network element or variant that determines applicable specification type and capacity-sharing behavior. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_AVC a owl:Class ;
    rdfs:subClassOf :Cl_NetworkContext ;
    rdfs:label "AVC_Context" ;
    rdfs:comment "Access Virtual Circuit network context. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_CVC a owl:Class ;
    rdfs:subClassOf :Cl_NetworkContext ;
    rdfs:label "CVC_Context" ;
    rdfs:comment "Connectivity Virtual Circuit network context. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_SatelliteNetwork a owl:Class ;
    rdfs:subClassOf :Cl_NetworkContext ;
    rdfs:label "SatelliteNetwork" ;
    rdfs:comment "Satellite network context (nbn Ethernet Satellite). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_WirelessPlus a owl:Class ;
    rdfs:subClassOf :Cl_NetworkContext ;
    rdfs:label "WirelessPlus" ;
    rdfs:comment "Wireless Plus network context. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_UNI a owl:Class ;
    rdfs:subClassOf :Cl_NetworkContext ;
    rdfs:label "UNI_Context" ;
    rdfs:comment "User Network Interface network context. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_NNI a owl:Class ;
    rdfs:subClassOf :Cl_NetworkContext ;
    rdfs:label "NNI_Context" ;
    rdfs:comment "Network-Network Interface network context. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_Application a owl:Class ;
    rdfs:label "Application" ;
    rdfs:comment "An example application targeted by a traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_PerHopBehavior a owl:Class ;
    rdfs:label "PerHopBehavior" ;
    rdfs:comment "Per-hop behavior that traffic class attributes are aligned to. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_BurstCapability a owl:Class ;
    rdfs:label "BurstCapability" ;
    rdfs:comment "Burst capability characteristic of a traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_CapacitySharing a owl:Class ;
    rdfs:label "CapacitySharing" ;
    rdfs:comment "Capacity-sharing characteristic of a traffic class in a given network context. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

# Reification object properties

:hasSpecificationType a owl:ObjectProperty ;
    rdfs:label "hasSpecificationType" ;
    rdfs:domain :TrafficClass ;
    rdfs:range :Cl_SpecificationType ;
    rdfs:comment "Links a traffic class to its specification type (CIR or PIR). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:targetsApplications a owl:ObjectProperty ;
    rdfs:label "targetsApplications" ;
    rdfs:domain :TrafficClass ;
    rdfs:range :Cl_Application ;
    rdfs:comment "Links a traffic class to an example application it targets. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:alignedTo a owl:ObjectProperty ;
    rdfs:label "alignedTo" ;
    rdfs:domain :TrafficClass ;
    rdfs:range :Cl_PerHopBehavior ;
    rdfs:comment "Links a traffic class to the per-hop behavior its attributes are aligned to. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:hasBurstCapability a owl:ObjectProperty ;
    rdfs:label "hasBurstCapability" ;
    rdfs:domain :TrafficClass ;
    rdfs:range :Cl_BurstCapability ;
    rdfs:comment "Links a traffic class to its burst capability description. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:sharesCapacity a owl:ObjectProperty ;
    rdfs:label "sharesCapacity" ;
    rdfs:domain :TrafficClass ;
    rdfs:range :Cl_CapacitySharing ;
    rdfs:comment "Links a traffic class to its capacity-sharing characteristic. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:appliesInContext a owl:ObjectProperty ;
    rdfs:label "appliesInContext" ;
    rdfs:domain owl:Thing ;
    rdfs:range :Cl_NetworkContext ;
    rdfs:comment "Links a reified relationship to the network context in which it applies. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:hasContext a owl:ObjectProperty ;
    rdfs:label "hasContext" ;
    rdfs:domain :TrafficClass ;
    rdfs:range :Cl_NetworkContext ;
    rdfs:comment "Links a traffic class to a network context. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:hasDescription a owl:DatatypeProperty ;
    rdfs:label "hasDescription" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:comment "A textual description of an entity. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

