# ===== FACTS: Section 5.1.2.1 - Unicast 1:1 CVC Scalability =====

# A single unicast 1:1 CVC can support up to 4,000 unicast 1:1 AVCs
:CVC_1_1_VLAN_Scalability_Example a :CVC_1_1_VLAN,
        owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 CVC Scalability Example" ;
    :hasMaxSupportedAvc 4000 ;
    :hasDescription "A single unicast 1:1 CVC can support up to 4,000 unicast 1:1 AVCs, and is able to deliver AVCs to any UNI within a single CSA"^^xsd:string ;
    :describedInSection :DocumentSection_5_1_2_1 ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28" .

# Each of the 4,000 unicast 1:1 AVCs is addressed using a single, unique C-VID, locally significant to the CVC
:CVID_Example a :CVID,
        owl:NamedIndividual ;
    rdfs:label "C-VID Example" ;
    :hasCvidValue "100"^^xsd:string ;
    :isLocallySignificantTo :CVC_1_1_VLAN_Scalability_Example ;
    :hasDescription "A single, unique Customer-VLAN ID used to address a unicast 1:1 AVC, locally significant to the CVC"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28" .

:Unicast_1_1_AVC_Addressed_Example a :Unicast_1_1_AVC,
        owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC Addressed by C-VID" ;
    :isAddressedUsing :CVID_Example ;
    :hasDescription "Each unicast 1:1 AVC is addressed using a single, unique C-VID, locally significant to the CVC"^^xsd:string ;
    :describedInSection :DocumentSection_5_1_2_1 ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28" .

# Subject to section 2.1(d) of the nbn Ethernet Product Description, the number of CVCs that RSP may purchase in relation to a given CSA is limited only by the NNI resources that RSP has purchased for that CSA
:RSP_Purchase_CVC_Example a owl:NamedIndividual ;
    rdfs:label "RSP May Purchase CVC in Relation to CSA" ;
    :mayPurchase :CVC_1_1_VLAN_Scalability_Example ;
    :inRelationToCSA :CSA_Example ;
    :limitedByNNIResources :NNIGroup_Example ;
    :subjectToClause :DocumentSection_2_1_d ;
    :hasDescription "Subject to section 2.1(d) of the nbn Ethernet Product Description, the number of CVCs that RSP may purchase in relation to a given CSA is limited only by the NNI resources that RSP has purchased for that CSA"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28" .

:DocumentSection_2_1_d a :DocumentSection,
        owl:NamedIndividual ;
    rdfs:label "Section 2.1(d)" ;
    :hasSectionNumber "2.1(d)"^^xsd:string ;
    :hasSectionTitle "nbn Ethernet Product Description section 2.1(d)"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28" .

# Where RSP requires access to more than 4,000 AVCs in a given CSA, it is necessary to utilise more than one CVC
:RSP_RequiresAccess_Example a owl:NamedIndividual ;
    rdfs:label "RSP Requires Access to More Than 4,000 AVCs" ;
    :requiresAccessTo :Unicast_1_1_AVC_Addressed_Example ;
    :inRelationToCSA :CSA_Example ;
    :utilisesMoreThanOneCVC :CVC_1_1_VLAN_Scalability_Example ;
    :hasDescription "Where RSP requires access to more than 4,000 AVCs in a given CSA, it is necessary to utilise more than one CVC"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28" .

# ===== FACTS: Section 5.1.2.2 - Unicast N:1 CVC Scalability =====

# As Unicast N:1 does not use C-VLANs there is no restriction on the number of unicast N:1 AVCs within a CSA that can be associated with a single unicast N:1 CVC at the NNI
:CVC_N_1_VLAN_Scalability_Example a :CVC_N_1_VLAN,
        owl:NamedIndividual ;
    rdfs:label "Unicast N:1 CVC Scalability Example" ;
    :hasNoRestriction true ;
    :associatesWithAVC :Unicast_N_1_AVC_Instance ;
    :hasDescription "As Unicast N:1 does not use C-VLANs there is no restriction on the number of unicast N:1 AVCs within a CSA that can be associated with a single unicast N:1 CVC at the NNI"^^xsd:string ;
    :describedInSection :DocumentSection_5_1_2_2 ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.2, page 28" .

# ===== FACTS: Section 5.1.3.1 - Unicast 1:1 CVC Bandwidth Profile Availability =====

# The available unicast 1:1 CVC bandwidth profiles comprise a combination of available upstream/downstream bandwidth profiles for each traffic class as defined in sections 2.2 to 2.4 of the nbn Ethernet Product Description
:CVC_1_1_BandwidthProfile_Example a :CVC_BandwidthProfile,
        owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 CVC Bandwidth Profile" ;
    :hasUpstreamDownstreamProfile "combination of available upstream/downstream bandwidth profiles for each traffic class"^^xsd:string ;
    :hasTotalBandwidth "not zero"^^xsd:string ;
    :definedInSection :DocumentSection_2_2_to_2_4 ;
    :hasDescription "The available unicast 1:1 CVC bandwidth profiles comprise a combination of available upstream/downstream bandwidth profiles for each traffic class as defined in sections 2.2 to 2.4 of the nbn Ethernet Product Description, provided that the total combination of CVC bandwidth profiles is not zero"^^xsd:string ;
    :describedInSection :DocumentSection_5_1_3_1 ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.3.1, page 28" .

:CVC_1_1_VLAN_Scalability_Example :comprisesBandwidthProfile :CVC_1_1_BandwidthProfile_Example .

:DocumentSection_2_2_to_2_4 a :DocumentSection,
        owl:NamedIndividual ;
    rdfs:label "Sections 2.2 to 2.4" ;
    :hasSectionNumber "2.2-2.4"^^xsd:string ;
    :hasSectionTitle "nbn Ethernet Product Description sections 2.2 to 2.4"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.3.1, page 28" .

# Those sections set out additional limitations that apply in respect of nbn Ethernet (Satellite)
:CVC_1_1_BandwidthProfile_Satellite_Example a :CVC_BandwidthProfile,
        owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 CVC Bandwidth Profile (Satellite)" ;
    :subjectToAdditionalLimitations :NetContext_Satellite ;
    :hasDescription "Additional limitations apply in respect of nbn Ethernet (Satellite) for unicast 1:1 CVC bandwidth profiles as set out in sections 2.2 to 2.4 of the nbn Ethernet Product Description"^^xsd:string ;
    :describedInSection :DocumentSection_5_1_3_1 ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.3.1, page 28" .

# ===== FACTS: Section 5.1.3.2 - Unicast N:1 CVC Bandwidth Profile Availability =====

# The available unicast N:1 CVC bandwidth profiles comprise the TC-1 traffic class bandwidth profiles set out in section 2.3(b) of the nbn Ethernet Product Description
:CVC_N_1_BandwidthProfile_Example a :CVC_BandwidthProfile,
        owl:NamedIndividual ;
    rdfs:label "Unicast N:1 CVC Bandwidth Profile" ;
    :hasUpstreamDownstreamProfile "TC-1 traffic class bandwidth profiles"^^xsd:string ;
    :definedInSection :DocumentSection_2_3_b ;
    :hasDescription "The available unicast N:1 CVC bandwidth profiles comprise the TC-1 traffic class bandwidth profiles set out in section 2.3(b) of the nbn Ethernet Product Description"^^xsd:string ;
    :describedInSection :DocumentSection_5_1_3_2 ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.3.2, page 28" .

:CVC_N_1_VLAN_Scalability_Example :comprisesBandwidthProfile :CVC_N_1_BandwidthProfile_Example .

:DocumentSection_2_3_b a :DocumentSection,
        owl:NamedIndividual ;
    rdfs:label "Section 2.3(b)" ;
    :hasSectionNumber "2.3(b)"^^xsd:string ;
    :hasSectionTitle "nbn Ethernet Product Description section 2.3(b)"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.3.2, page 28" .

# ===== FACTS: Section 5.1.4 - CVC Contention Management =====

# Subject to section 2.1(d) of the nbn Ethernet Product Description, RSP should control AVC:CVC contention for the purpose of managing service utilisation
:AVC_CVC_Contention_Example a :AVC_CVC_Contention,
        owl:NamedIndividual ;
    rdfs:label "AVC:CVC Contention Example" ;
    :hasDescription "State of congestion between AVCs and the CVC that RSP should control for the purpose of managing service utilisation"^^xsd:string ;
    :describedInSection :DocumentSection_5_1_4 ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.4, page 28" .

:RSP_Contention_Control_Example a owl:NamedIndividual ;
    rdfs:label "RSP Controls AVC:CVC Contention" ;
    :controlsContention :AVC_CVC_Contention_Example ;
    :subjectToClause :DocumentSection_2_1_d ;
    :hasDescription "Subject to section 2.1(d) of the nbn Ethernet Product Description, RSP should control AVC:CVC contention for the purpose of managing service utilisation"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.4, page 28" .

# In the event of AVC:CVC congestion within unicast services, the nbn Network will discard traffic in accordance with section 2.2
:nbnNetwork_Example a :nbnNetwork,
