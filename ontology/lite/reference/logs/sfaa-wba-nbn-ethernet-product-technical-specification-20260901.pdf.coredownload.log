# ===== FACTS: CVC Scalability - Unicast N:1 (Section 5.1.2.2) =====

# Reification: No restriction on the number of unicast N:1 AVCs within a CSA associated with a single unicast N:1 CVC
:CvcSupportsAvcReification_UnicastN_1 a :CvcSupportsAvcReification, owl:NamedIndividual ;
    rdfs:label "Unicast N:1 CVC supports unrestricted number of AVCs" ;
    :hasNoRestriction true ;
    :sourceClause "nbn Ethernet Product Module, Section 5.1.2.2, p.28" .

:UnicastN_1CVC :hasCvcSupportsAvcReification :CvcSupportsAvcReification_UnicastN_1 .

# ===== FACTS: CVC Bandwidth Profile Availability - Unicast 1:1 (Section 5.1.3.1) =====

# Reification: Available unicast 1:1 CVC bandwidth profiles comprise a combination of available upstream/downstream bandwidth profiles for each traffic class
:CvcBandwidthProfileComprises_Unicast1_1 a :CvcBandwidthProfileComprises, owl:NamedIndividual ;
