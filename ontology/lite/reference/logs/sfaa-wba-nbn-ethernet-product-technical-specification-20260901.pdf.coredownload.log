--- CONTENT: # ===== EXTENSIONS: Section 5 - Connectivity Virtual Circuit (CVC) (Page 26-27) =====

# New classes for CVC variants and related concepts
:CVC_1_1_VLAN a owl:Class ;
    rdfs:label "CVC 1:1 VLAN" ;
    rdfs:comment "A variant of CVC required for 1:1 AVC unicast services delivered using the UNI-D or UNI-DSL interface. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" ;
    rdfs:subClassOf :CVC .

:CVC_N_1_VLAN a owl:Class ;
    rdfs:label "CVC N:1 VLAN" ;
    rdfs:comment "A variant of CVC required for N:1 AVC unicast services delivered using the UNI-V interface. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" ;
    rdfs:subClassOf :CVC .

:S_VID a owl:Class ;
    rdfs:label "S-VID" ;
    rdfs:comment "Service VLAN Identifier used to isolate CVCs from each other on an NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" .

:CVC_BandwidthProfile a owl:Class ;
    rdfs:label "CVC Bandwidth Profile" ;
    rdfs:comment "A bandwidth profile for a CVC, e.g. CVC Max CVC TC-4. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" .

:Contention a owl:Class ;
    rdfs:label "Contention" ;
    rdfs:comment "Contention management between AVC and CVC capacity dimensioning. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2, page 27]" .

# Reified relationship classes for CVC
:CVC_Connectivity a owl:Class ;
    rdfs:label "CVC Connectivity" ;
    rdfs:comment "Reified relationship representing that a CVC provides connectivity from an NNI to a CSA. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" .

:CVC_DeliversAVC a owl:Class ;
    rdfs:label "CVC Delivers AVC" ;
    rdfs:comment "Reified relationship representing that a CVC delivers higher-layer services to AVCs within a CSA. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" .

:CVC_Isolation a owl:Class ;
    rdfs:label "CVC Isolation" ;
    rdfs:comment "Reified relationship representing that a CVC is isolated from other CVCs on an NNI via a distinct S-VID. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" .

:NNI_SpecificToRSP a owl:Class ;
    rdfs:label "NNI Specific To RSP" ;
    rdfs:comment "Reified relationship representing that an NNI and all CVCs delivered through it are specific to an RSP. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" .

:CVC_CoExistence a owl:Class ;
    rdfs:label "CVC Co-Existence" ;
    rdfs:comment "Reified relationship representing that different CVC types can co-exist on the same NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" .

:CVC_Scalability a owl:Class ;
    rdfs:label "CVC Scalability" ;
    rdfs:comment "Reified relationship representing AVC and CVC scalability in conjunction with contention. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2, page 27]" .

:CVC_ContentionManagement a owl:Class ;
    rdfs:label "CVC Contention Management" ;
    rdfs:comment "Reified relationship representing that RSP controls End User experience through contention applied by dimensioning of capacity between the AVC and CVC. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2, page 27]" .

:CVC_BandwidthProfileAutoConfig a owl:Class ;
    rdfs:label "CVC Bandwidth Profile Auto-Configuration" ;
    rdfs:comment "Reified relationship representing that for the CVC Max CVC TC-4 bandwidth profile, the amount of bandwidth capacity will be automatically configured to equal the bandwidth of the associated NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 27]" .

