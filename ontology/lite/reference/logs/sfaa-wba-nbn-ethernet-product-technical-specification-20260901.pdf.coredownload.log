    rdfs:label "nbn Network" ;
    :hasDescription "The nbn network that will discard traffic in the event of AVC:CVC congestion within unicast services"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.4, page 28" .

:Traffic_Discarded_Example a :Traffic,
