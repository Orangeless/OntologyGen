--- CONTENT: # ===== EXTENSIONS: nbn Ethernet Product Module, page 41-42 (NNI Bearer Ordering, Feasibility Check, States, Scaling) =====

# --- Classes ---

:Cl_FeasibilityCheck a :Cl_Event, owl:Class ;
    rdfs:label "Feasibility Check" ;
    rdfs:comment "An event that determines whether the number of allowable NNI Bearers within an NNI Group has been exceeded upon the addition of a new NNI Bearer. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :Cl_Event .

:Cl_Outage a :Cl_Event, owl:Class ;
    rdfs:label "Outage" ;
    rdfs:comment "A scheduled network outage coordinated between nbn and RSP to augment an NNI Group with additional NNI Bearers. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :Cl_Event .

:Cl_State_AdminDown a :Cl_State, owl:Class ;
    rdfs:label "Administratively Down State" ;
    rdfs:comment "The administratively down state in which nbn initially provisions each completed NNI Bearer order to RSP. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :Cl_State .

:Cl_State_Up a :Cl_State, owl:Class ;
    rdfs:label "Up State" ;
    rdfs:comment "The up state to which nbn changes a completed NNI Bearer order in co-ordination with RSP. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :Cl_State .

:Cl_State_Active a :Cl_State, owl:Class ;
    rdfs:label "Active State" ;
    rdfs:comment "The active state of an NNI Group. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :Cl_State .

:Cl_State_Cancelled a :Cl_State, owl:Class ;
    rdfs:label "Cancelled State" ;
    rdfs:comment "The cancelled state of an NNI Group. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :Cl_State .

:Cl_NNIGroup a owl:Class ;
    rdfs:label "NNI Group" ;
    rdfs:comment "A group of NNI Bearers at a POI sharing a redundancy mode, interface rate, and protected capacity. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :NNIGroup .

:Cl_Bearer a owl:Class ;
    rdfs:label "NNI Bearer" ;
    rdfs:comment "A physical interface of an NNI Group, landed on a line-card/port in a failure domain. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :Bearer .

:Cl_NNI a owl:Class ;
    rdfs:label "NNI" ;
    rdfs:comment "A single NNI within an NNI Group, realised on one Bearer. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :NNI .

:Cl_ChassisRole a owl:Class ;
    rdfs:label "Chassis Role" ;
    rdfs:comment "The role (working or protect) of a chassis on which NNI Bearers are provisioned in Diverse Chassis mode. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :Cl_ChassisRole .

:Cl_FeasibilityCheckResult a :Cl_State, owl:Class ;
    rdfs:label "Feasibility Check Result" ;
    rdfs:comment "The result of a feasibility check, indicating whether the number of allowable NNI Bearers within an NNI Group has been exceeded. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :Cl_State .

:Cl_NNIBearerType a owl:Class ;
    rdfs:label "NNI Bearer Type" ;
    rdfs:comment "The physical interface type of an NNI Bearer. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :Cl_ServiceAttribute .

:Cl_NNIGroupAttribute a owl:Class ;
    rdfs:label "NNI Group Attribute" ;
    rdfs:comment "The NNI Group to which the NNI Bearer is intended to be associated. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :Cl_ServiceAttribute .

# --- Object Properties ---

:hasAssociatedGroup a owl:ObjectProperty ;
    rdfs:label "hasAssociatedGroup" ;
    rdfs:comment "Links an NNI Bearer to the NNI Group it is intended to be associated with. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain :Cl_Bearer ;
    rdfs:range :Cl_NNIGroup .

:hasFeasibilityCheck a owl:ObjectProperty ;
    rdfs:label "hasFeasibilityCheck" ;
    rdfs:comment "Links an NNI Group to its feasibility check events. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain :Cl_NNIGroup ;
    rdfs:range :Cl_FeasibilityCheck .

:hasOutage a owl:ObjectProperty ;
    rdfs:label "hasOutage" ;
    rdfs:comment "Links an NNI Group to its outage events. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain :Cl_NNIGroup ;
    rdfs:range :Cl_Outage .

:hasMinBearers a owl:DatatypeProperty ;
    rdfs:label "hasMinBearers" ;
    rdfs:comment "The minimum number of NNI Bearers required to establish a new NNI Group. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain :Cl_NNIGroup ;
    rdfs:range xsd:integer .

:hasMaxSeamlessBearers a owl:DatatypeProperty ;
    rdfs:label "hasMaxSeamlessBearers" ;
    rdfs:comment "The maximum number of NNI Bearers to which nbn intends to use reasonable endeavours to provide the ability to seamlessly scale an NNI Group. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain :Cl_NNIGroup ;
    rdfs:range xsd:integer .

:hasInitialState a owl:ObjectProperty ;
    rdfs:label "hasInitialState" ;
    rdfs:comment "Links an NNI Bearer to its initial state (administratively down). [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain :Cl_Bearer ;
    rdfs:range :Cl_State .

:hasBearerType a owl:ObjectProperty ;
    rdfs:label "hasBearerType" ;
    rdfs:comment "Links an NNI Bearer to its physical interface type. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain :Cl_Bearer ;
    rdfs:range :Cl_NNIBearerType .

:hasNNIBearerTypeOption a owl:ObjectProperty ;
    rdfs:label "hasNNIBearerTypeOption" ;
    rdfs:comment "Links an NNI Bearer Type attribute to its selectable options. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain :Cl_NNIBearerType ;
    rdfs:range owl:Thing .

:notAvailableFor a owl:ObjectProperty ;
    rdfs:label "notAvailableFor" ;
    rdfs:comment "Links an NNI Bearer Type option to the product variant for which it is not available. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain owl:Thing ;
    rdfs:range :nbnEthernetProduct .

:hasFeasibilityCheckResult a owl:ObjectProperty ;
    rdfs:label "hasFeasibilityCheckResult" ;
    rdfs:comment "Links a feasibility check to its result state. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain :Cl_FeasibilityCheck ;
    rdfs:range :Cl_FeasibilityCheckResult .

:hasNNIBearerState a owl:ObjectProperty ;
    rdfs:label "hasNNIBearerState" ;
    rdfs:comment "Links an NNI Bearer to its current state. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain :Cl_Bearer ;
    rdfs:range :Cl_State .

:hasNNIGroupAttribute a owl:ObjectProperty ;
    rdfs:label "hasNNIGroupAttribute" ;
    rdfs:comment "Links an NNI Bearer to the NNI Group attribute that specifies the NNI Group to which the NNI Bearer is intended to be associated. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain :Cl_Bearer ;
    rdfs:range :Cl_NNIGroupAttribute .

