--- CONTENT: # ===== EXTENSIONS: AVC Section 4.1.3.2 (p.26) - Unicast N:1 AVC Bandwidth Profile Availability =====

# --- New Classes ---

:AvcBandwidthProfile a owl:Class ;
    rdfs:label "AvcBandwidthProfile" ;
    rdfs:comment "Reification of the bandwidth profile relationship for an AVC, composed of traffic class specifications. [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" .

:UniVAndAvcTc1Bundle a owl:Class ;
    rdfs:label "UniVAndAvcTc1Bundle" ;
    rdfs:comment "Stub class representing the bundle of UNI-V and AVC TC-1. [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" .

:AvcBundleSupport a owl:Class ;
    rdfs:label "AvcBundleSupport" ;
    rdfs:comment "Reification of the availableOnlyToSupport relationship between an AVC and a bundle. [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" .

# --- New Object Properties ---

:hasBandwidthProfile a owl:ObjectProperty ;
    rdfs:label "hasBandwidthProfile" ;
    rdfs:comment "Links an AVC to its bandwidth profile reification. [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" ;
    rdfs:domain :AVC ;
    rdfs:range :AvcBandwidthProfile .

:hasBandwidthProfileComponent a owl:ObjectProperty ;
    rdfs:label "hasBandwidthProfileComponent" ;
    rdfs:comment "Links an AvcBandwidthProfile to a TrafficClassSpecification that is part of the profile. [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" ;
    rdfs:domain :AvcBandwidthProfile ;
    rdfs:range :TrafficClassSpecification .

:availableOnlyToSupport a owl:ObjectProperty ;
    rdfs:label "availableOnlyToSupport" ;
    rdfs:comment "Links an AVC to the reification of its bundle support constraint. [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" ;
    rdfs:domain :UnicastN_1AVC ;
    rdfs:range :AvcBundleSupport .

:supportsBundle a owl:ObjectProperty ;
    rdfs:label "supportsBundle" ;
    rdfs:comment "Links an AvcBundleSupport to the bundle it supports. [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" ;
    rdfs:domain :AvcBundleSupport ;
    rdfs:range :UniVAndAvcTc1Bundle .

# --- New Data Properties ---

:numericValue a owl:DatatypeProperty ;
    rdfs:label "numericValue" ;
    rdfs:comment "Numeric value of a rate specification (e.g. 0.0, 0.15). [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" ;
    rdfs:domain :TrafficClassSpecification ;
    rdfs:range xsd:decimal .

:unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    rdfs:comment "Unit of measurement for a rate specification (e.g. Mbps). [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" ;
    rdfs:domain :TrafficClassSpecification ;
    rdfs:range xsd:string .

# ===== FACTS: Individuals for Section 4.1.3.2 =====

# --- Bundle Instance ---

:UniVAndAvcTc1Bundle_Instance a :UniVAndAvcTc1Bundle,
        owl:NamedIndividual ;
    rdfs:label "UNI-V and AVC TC-1 Bundle" ;
    rdfs:comment "The bundle of UNI-V and AVC TC-1 described in section 6 of the nbn Ethernet Product Description. [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.1.3.2, p.26" .

# --- Bundle Support Reification ---

:AvcBundleSupport_UnicastN_1 a :AvcBundleSupport,
        owl:NamedIndividual ;
    rdfs:label "Unicast N:1 AVC Bundle Support" ;
    rdfs:comment "Reification of the availableOnlyToSupport relationship for Unicast N:1 AVC. [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" ;
    :supportsBundle :UniVAndAvcTc1Bundle_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 4.1.3.2, p.26" .

# Link Unicast N:1 AVC to its bundle support
:UnicastN_1AVC :availableOnlyToSupport :AvcBundleSupport_UnicastN_1 .

# --- Bandwidth Profile Reification ---

:AvcBandwidthProfile_UnicastN_1 a :AvcBandwidthProfile,
        owl:NamedIndividual ;
    rdfs:label "Unicast N:1 AVC Bandwidth Profile" ;
    rdfs:comment "Bandwidth profile for the Unicast N:1 AVC on the UNI-V, composed of AVC TC-4 0/0 Mbps (PIR) and AVC TC-1 0.15 Mbps (CIR). [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.1.3.2, p.26" .

# Link Unicast N:1 AVC to its bandwidth profile
:UnicastN_1AVC :hasBandwidthProfile :AvcBandwidthProfile_UnicastN_1 .

# --- Traffic Class Specifications for the Bandwidth Profile ---

# TC-4 PIR specification: 0/0 Mbps
:TC4_Spec_PIR_AVC_UnicastN_1 a :TrafficClassSpecification,
        owl:NamedIndividual ;
    rdfs:label "TC-4 PIR Specification for Unicast N:1 AVC" ;
    rdfs:comment "TC-4 PIR specification for the Unicast N:1 AVC bandwidth profile on UNI-V: 0/0 Mbps. [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" ;
    :specifiesRateType :InformationRateType_PIR ;
    :appliesAt :UNI_V ;
    :numericValue "0.0"^^xsd:decimal ;
    :unit "Mbps" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.1.3.2, p.26" .

# TC-1 CIR specification: 0.15 Mbps
:TC1_Spec_CIR_UnicastN_1 a :TrafficClassSpecification,
        owl:NamedIndividual ;
    rdfs:label "TC-1 CIR Specification for Unicast N:1 AVC" ;
    rdfs:comment "TC-1 CIR specification for the Unicast N:1 AVC bandwidth profile on UNI-V: 0.15 Mbps. [extension: nbn Ethernet Product Module, Section 4.1.3.2, p.26]" ;
    :specifiesRateType :InformationRateType_CIR ;
    :appliesAt :UNI_V ;
    :numericValue "0.15"^^xsd:decimal ;
    :unit "Mbps" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.1.3.2, p.26" .

# Link the bandwidth profile to its component specifications
:AvcBandwidthProfile_UnicastN_1 :hasBandwidthProfileComponent :TC4_Spec_PIR_AVC_UnicastN_1 .
:AvcBandwidthProfile_UnicastN_1 :hasBandwidthProfileComponent :TC1_Spec_CIR_UnicastN_1 .

# ===== FACTS: Section reference for 4.1.3.2 =====

:Section_4_1_3_2 a :DocumentSection,
        owl:NamedIndividual ;
    rdfs:label "4.1.3.2 Unicast N:1 AVC Bandwidth Profile Availability" ;
    rdfs:label "Unicast N:1 AVC Bandwidth Profile Availability" ;
    :describes :UnicastN_1AVC ;
    :hasParentSection :Section_4_1_3 ;
    :sectionNumber "4.1.3.2" ;
    :sectionTitle "Unicast N:1 AVC Bandwidth Profile Availability" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.1.3.2, p.26" .

