--- CONTENT: # ===== NNI Link, V-NNI, CVC Support, Service Support (Sections 6.3-6.6) =====

# --- New Classes ---
:V_NNI a owl:Class ;
    rdfs:label "V-NNI" ;
    rdfs:comment "A virtual NNI that supports the association of a single NNI Link and inherits characteristics from the NNI Group from which the NNI Link was created. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.4, page 30]" .

:S_TAG_Pool a owl:Class ;
    rdfs:label "S-TAG Pool" ;
    rdfs:comment "A pool of S-TAGs reserved from an NNI Group that can be assigned to a V-NNI. Each S-TAG pool must be unique to an NNI Link or CVC. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.3, page 30]" .

:BandwidthProfile a owl:Class ;
    rdfs:label "BandwidthProfile" ;
    rdfs:comment "A bandwidth profile reserved from an NNI Group that can be assigned to a V-NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.3, page 30]" .

:BearerLimit a owl:Class ;
    rdfs:label "BearerLimit" ;
    rdfs:comment "The maximum number of Product Components, in aggregate, supported in an NNI Group. The Bearer Limit includes the total number of Unicast 1:1 AVCs, OVCs, and Unicast N:1 CVCs associated with an NNI Group. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.6, page 30]" .

:BearerLimitCondition a owl:Class ;
    rdfs:label "BearerLimitCondition" ;
    rdfs:comment "A reified condition (bearer count, interface rate, redundancy mode) under which a Bearer Limit applies. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.6.1, page 30]" .

# --- New Object Properties ---
:isCreatedFrom a owl:ObjectProperty ;
    rdfs:label "isCreatedFrom" ;
    rdfs:comment "Links an NNI Link to the NNI Group from which it is created. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.3, page 30]" ;
    rdfs:domain :NNILink ;
    rdfs:range :NNIGroup .

:reserves a owl:ObjectProperty ;
    rdfs:label "reserves" ;
    rdfs:comment "Links an NNI Link to the S-TAG pool and bandwidth profile it reserves from an NNI Group. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.3, page 30]" ;
    rdfs:domain :NNILink ;
    rdfs:range owl:Thing .

:supportsAssociationOf a owl:ObjectProperty ;
    rdfs:label "supportsAssociationOf" ;
    rdfs:comment "Links a V-NNI to the single NNI Link it supports the association of. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.4, page 30]" ;
    rdfs:domain :V_NNI ;
    rdfs:range :NNILink .

:obtainsFrom a owl:ObjectProperty ;
    rdfs:label "obtainsFrom" ;
    rdfs:comment "Links a V-NNI to the NNI Link from which it obtains its S-TAG pool and bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.4, page 30]" ;
    rdfs:domain :V_NNI ;
    rdfs:range :NNILink .

:inheritsFrom a owl:ObjectProperty ;
    rdfs:label "inheritsFrom" ;
    rdfs:comment "Links a V-NNI to the NNI Group from which it inherits the redundancy mode. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.4, page 30]" ;
    rdfs:domain :V_NNI ;
    rdfs:range :NNIGroup .

:hasBearerLimit a owl:ObjectProperty ;
    rdfs:label "hasBearerLimit" ;
    rdfs:comment "Links an NNI Group to its reified Bearer Limit. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.6, page 30]" ;
    rdfs:domain :NNIGroup ;
    rdfs:range :BearerLimit .

:hasCondition a owl:ObjectProperty ;
    rdfs:label "hasCondition" ;
