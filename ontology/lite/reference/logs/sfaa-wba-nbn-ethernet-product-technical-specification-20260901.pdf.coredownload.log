--- CONTENT: # ===== EXTENSIONS: CVC Section 5 (p.27) =====

# --- New Classes ---

:CvcType a owl:Class ;
    rdfs:label "CvcType" ;
    rdfs:comment "The variant of CVC (1:1 VLAN or N:1 VLAN) determining the type of AVC unicast service supported. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" .

:RSP a owl:Class ;
    rdfs:label "RSP" ;
    rdfs:comment "Retail Service Provider role to which the NNI and all CVCs delivered through it are specific. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" .

:S_VID a owl:Class ;
    rdfs:label "S_VID" ;
    rdfs:comment "S-VLAN identifier used to isolate CVCs from each other on an NNI. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" .

:CvcTypeAvailability a owl:Class ;
    rdfs:label "CvcTypeAvailability" ;
    rdfs:comment "Reification of CVC type availability per access technology. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" .

:CvcMaxCvcTC4BandwidthProfile a owl:Class ;
    rdfs:label "CvcMaxCvcTC4BandwidthProfile" ;
    rdfs:comment "Reification for the Max CVC TC-4 bandwidth profile rule where bandwidth capacity is automatically configured to equal the bandwidth of the associated NNI. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" .

:Contention a owl:Class ;
    rdfs:label "Contention" ;
    rdfs:comment "Reification for contention applied by dimensioning of capacity between the AVC and CVC. [extension: nbn Ethernet Product Module, Section 5.1.2, p.27]" .

# --- New Object Properties ---

:hasCvcType a owl:ObjectProperty ;
    rdfs:label "hasCvcType" ;
    rdfs:comment "Links a CVC to its CVC type variant. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" ;
    rdfs:domain :CVC ;
    rdfs:range :CvcType .

:typeAvailabilityDependentOn a owl:ObjectProperty ;
    rdfs:label "typeAvailabilityDependentOn" ;
    rdfs:comment "Links a CvcType to its availability reification. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" ;
    rdfs:domain :CvcType ;
    rdfs:range :CvcTypeAvailability .

:availableOnAccessTechnology a owl:ObjectProperty ;
    rdfs:label "availableOnAccessTechnology" ;
    rdfs:comment "Links a CvcTypeAvailability to the access technology it is available on. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" ;
    rdfs:domain :CvcTypeAvailability ;
    rdfs:range :AccessTechnology .

:specificTo a owl:ObjectProperty ;
    rdfs:label "specificTo" ;
    rdfs:comment "Links a CVC or NNI to the RSP it is specific to. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" ;
    rdfs:domain :CVC ;
    rdfs:range :RSP .

:delivers a owl:ObjectProperty ;
    rdfs:label "delivers" ;
    rdfs:comment "Links a CVC to the AVCs it delivers. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" ;
    rdfs:domain :CVC ;
    rdfs:range :AVC .

:isolatedVia a owl:ObjectProperty ;
    rdfs:label "isolatedVia" ;
    rdfs:comment "Links a CVC to the S-VID that isolates it from other CVCs on an NNI. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" ;
    rdfs:domain :CVC ;
    rdfs:range :S_VID .

:containedWithin a owl:ObjectProperty ;
    rdfs:label "containedWithin" ;
    rdfs:comment "Links an AVC to the CVC it is contained within. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" ;
    rdfs:domain :AVC ;
    rdfs:range :CVC .

:mayHaveMultipleCVCsWithin a owl:ObjectProperty ;
    rdfs:label "mayHaveMultipleCVCsWithin" ;
    rdfs:comment "Links an RSP to the CSA where it may have multiple CVCs. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" ;
    rdfs:domain :RSP ;
    rdfs:range :CSA .

:mayControlEndUserExperienceThrough a owl:ObjectProperty ;
    rdfs:label "mayControlEndUserExperienceThrough" ;
    rdfs:comment "Links an RSP to the Contention through which it may control End User experience. [extension: nbn Ethernet Product Module, Section 5.1.2, p.27]" ;
    rdfs:domain :RSP ;
    rdfs:range :Contention .

:hasContention a owl:ObjectProperty ;
    rdfs:label "hasContention" ;
    rdfs:comment "Links a CVC to its contention reification. [extension: nbn Ethernet Product Module, Section 5.1.2, p.27]" ;
    rdfs:domain :CVC ;
    rdfs:range :Contention .

:hasCvcMaxCvcTC4BandwidthProfile a owl:ObjectProperty ;
    rdfs:label "hasCvcMaxCvcTC4BandwidthProfile" ;
    rdfs:comment "Links a CVC to its Max CVC TC-4 bandwidth profile reification. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" ;
    rdfs:domain :CVC ;
    rdfs:range :CvcMaxCvcTC4BandwidthProfile .

:automaticallyConfiguredToEqual a owl:ObjectProperty ;
    rdfs:label "automaticallyConfiguredToEqual" ;
    rdfs:comment "Links a CvcMaxCvcTC4BandwidthProfile to the NNIGroup whose bandwidth it equals. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" ;
    rdfs:domain :CvcMaxCvcTC4BandwidthProfile ;
    rdfs:range :NNIGroup .

:bandwidthCapacity a owl:DatatypeProperty ;
    rdfs:label "bandwidthCapacity" ;
    rdfs:comment "The amount of bandwidth capacity with which a CVC is dimensioned. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" ;
    rdfs:domain :CVC ;
    rdfs:range xsd:decimal .

# --- New Individuals: CvcType enumeration ---

:CvcType_1_1 a :CvcType,
        owl:NamedIndividual ;
    rdfs:label "1:1 VLAN" ;
    rdfs:comment "1:1 VLAN CVC variant - required for 1:1 AVC unicast services delivered using the UNI-D or UNI-DSL interface. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" .

:CvcType_N_1 a :CvcType,
        owl:NamedIndividual ;
    rdfs:label "N:1 VLAN" ;
    rdfs:comment "N:1 VLAN CVC variant - required for N:1 AVC unicast services delivered using the UNI-V interface. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" .

# --- New Individuals: Access Technology individuals for CVC type availability ---

:AccessTechnology_FTTB_FTTN a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTB/FTTN Network" ;
    rdfs:comment "FTTB/FTTN access network. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" .

:AccessTechnology_Wireless a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "Wireless Network" ;
    rdfs:comment "Wireless access network. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" .

:AccessTechnology_Satellite a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "Satellite Network" ;
    rdfs:comment "Satellite access network. [extension: nbn Ethernet Product Module, Section 5.1.1, p.27]" .

# ===== FACTS: CVC Type Availability Reifications =====

# 1:1 CVC - Available on all access technologies
:CvcTypeAvailability_1_1_Fibre a :CvcTypeAvailability,
        owl:NamedIndividual ;
    rdfs:label "1:1 CVC available on Fibre" ;
    :availableOnAccessTechnology :AccessTechnology_FIBRE ;
    :sourceClause "nbn Ethernet Product Module, Section 5.1.1, p.27" .

:CvcTypeAvailability_1_1_FTTB_FTTN a :CvcTypeAvailability,
        owl:NamedIndividual ;
    rdfs:label "1:1 CVC available on FTTB/FTTN" ;
    :availableOnAccessTechnology :AccessTechnology_FTTB_FTTN ;
    :sourceClause "nbn Ethernet Product Module, Section 5.1.1, p.27" .

:CvcTypeAvailability_1_1_FTTC a :CvcTypeAvailability,
