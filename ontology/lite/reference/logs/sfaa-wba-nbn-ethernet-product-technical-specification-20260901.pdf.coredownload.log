--- CONTENT: # --- New Classes for CVC Variants ---

:Unicast1_1CVC a owl:Class ;
    rdfs:label "Unicast 1:1 CVC" ;
    rdfs:subClassOf :CVC ;
    rdfs:comment "A specific type of CVC that supports up to 4,000 unicast 1:1 AVCs, each addressed by a unique C-VID, locally significant to the CVC. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" .

:UnicastN_1CVC a owl:Class ;
    rdfs:label "Unicast N:1 CVC" ;
    rdfs:subClassOf :CVC ;
    rdfs:comment "A specific type of CVC that supports unicast N:1 AVCs without using C-VLANs, with no restriction on the number of AVCs. [extension: nbn Ethernet Product Module, Section 5.1.2.2, p.28]" .

:CVID a owl:Class ;
    rdfs:label "C-VID" ;
    rdfs:comment "A single, unique C-VID (Component VLAN ID) used to address each unicast 1:1 AVC within a unicast 1:1 CVC, locally significant to the CVC. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" .

:AvcCvcContention a owl:Class ;
    rdfs:label "AVC:CVC Contention" ;
    rdfs:comment "Event of AVC:CVC contention within unicast services, which the RSP should control for managing service utilisation. In the event of congestion, the nbn Network will discard traffic. [extension: nbn Ethernet Product Module, Section 5.1.4, p.28]" .

:NNIResources a owl:Class ;
    rdfs:label "NNI Resources" ;
    rdfs:comment "NNI resources that an RSP has purchased for a given CSA, which limit the number of CVCs the RSP may purchase in relation to that CSA. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" .

:BandwidthProfileCombination a owl:Class ;
    rdfs:label "Bandwidth Profile Combination" ;
    rdfs:comment "Reification of the combination of available upstream/downstream bandwidth profiles for each traffic class as defined in sections 2.2 to 2.4 of the nbn Ethernet Product Description. [extension: nbn Ethernet Product Module, Section 5.1.3.1, p.28]" .

:SatelliteCvcBandwidthProfile a owl:Class ;
    rdfs:label "Satellite CVC Bandwidth Profile" ;
    rdfs:comment "Additional limitations that apply in respect of nbn Ethernet (Satellite) for unicast 1:1 CVC bandwidth profiles. [extension: nbn Ethernet Product Module, Section 5.1.3.1, p.28]" .

:RSP a owl:Class ;
    rdfs:label "RSP" ;
    rdfs:comment "Retail Service Provider that purchases CVCs and controls AVC:CVC contention for the purpose of managing service utilisation. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" .

:nbnNetwork a owl:Class ;
    rdfs:label "nbn Network" ;
    rdfs:comment "The nbn Network that will discard traffic in the event of AVC:CVC congestion within unicast services, in accordance with section 2.2. [extension: nbn Ethernet Product Module, Section 5.1.4, p.28]" .

# --- Reification (Pivot) Classes for CVC ---

:CvcSupportsAvcReification a owl:Class ;
    rdfs:label "CVC Supports AVC Reification" ;
    rdfs:comment "Reification of the supports relationship between a CVC and its AVCs, capturing cardinality constraints. [extension: nbn Ethernet Product Module, Section 5.1.2, p.28]" .

:CvcAddressedByCvid a owl:Class ;
    rdfs:label "CVC Addressed By C-VID" ;
    rdfs:comment "Reification of the addressing relationship between a unicast 1:1 AVC and its C-VID, which is locally significant to the CVC. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" .

:CvcLimitedByNniResources a owl:Class ;
    rdfs:label "CVC Limited By NNI Resources" ;
    rdfs:comment "Reification of the limitation relationship: the number of CVCs an RSP may purchase in relation to a given CSA is limited by the NNI resources purchased for that CSA. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" .

:RspRequiresMultipleCvc a owl:Class ;
    rdfs:label "RSP Requires Multiple CVC" ;
    rdfs:comment "Reification of the conditional rule: where RSP requires access to more than 4,000 AVCs in a given CSA, it is necessary to utilise more than one CVC. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" .

:CvcBandwidthProfileComprises a owl:Class ;
    rdfs:label "CVC Bandwidth Profile Comprises" ;
    rdfs:comment "Reification of the comprises relationship between a CVC bandwidth profile and a combination of traffic class bandwidth profiles. [extension: nbn Ethernet Product Module, Section 5.1.3, p.28]" .

:SatelliteLimitationAppliesTo a owl:Class ;
    rdfs:label "Satellite Limitation Applies To" ;
    rdfs:comment "Reification of the relationship that satellite-specific limitations apply to unicast 1:1 CVC bandwidth profiles. [extension: nbn Ethernet Product Module, Section 5.1.3.1, p.28]" .

:RspControlsContention a owl:Class ;
    rdfs:label "RSP Controls Contention" ;
    rdfs:comment "Reification of the relationship that the RSP should control AVC:CVC contention for the purpose of managing service utilisation. [extension: nbn Ethernet Product Module, Section 5.1.4, p.28]" .

:NetworkDiscardsTraffic a owl:Class ;
    rdfs:label "Network Discards Traffic" ;
    rdfs:comment "Reification of the event where the nbn Network discards traffic in the event of AVC:CVC congestion within unicast services. [extension: nbn Ethernet Product Module, Section 5.1.4, p.28]" .

# --- New Object Properties ---

:supports a owl:ObjectProperty ;
    rdfs:label "supports" ;
    rdfs:comment "Links a CVC to the AVCs it supports. [extension: nbn Ethernet Product Module, Section 5.1.2, p.28]" ;
    rdfs:domain :CVC ;
    rdfs:range :AVC .

:isAddressedUsing a owl:ObjectProperty ;
    rdfs:label "isAddressedUsing" ;
    rdfs:comment "Links a unicast 1:1 AVC to the C-VID that addresses it. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" ;
    rdfs:domain :Unicast1_1AVC ;
    rdfs:range :CVID .

:isLocallySignificantTo a owl:ObjectProperty ;
    rdfs:label "isLocallySignificantTo" ;
    rdfs:comment "Links a C-VID to the CVC it is locally significant to. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" ;
    rdfs:domain :CVID ;
    rdfs:range :Unicast1_1CVC .

:isLimitedBy a owl:ObjectProperty ;
    rdfs:label "isLimitedBy" ;
    rdfs:comment "Links the number of CVCs an RSP may purchase to the NNI resources purchased for a CSA. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" ;
    rdfs:domain :CVC ;
    rdfs:range :NNIResources .

:mayPurchase a owl:ObjectProperty ;
    rdfs:label "mayPurchase" ;
    rdfs:comment "Links an RSP to the CVCs it may purchase. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" ;
    rdfs:domain :RSP ;
    rdfs:range :CVC .

:shouldControl a owl:ObjectProperty ;
    rdfs:label "shouldControl" ;
    rdfs:comment "Links an RSP to the AVC:CVC contention it should control. [extension: nbn Ethernet Product Module, Section 5.1.4, p.28]" ;
    rdfs:domain :RSP ;
    rdfs:range :AvcCvcContention .

:comprises a owl:ObjectProperty ;
    rdfs:label "comprises" ;
    rdfs:comment "Links a CVC bandwidth profile to the combination of traffic class bandwidth profiles it comprises. [extension: nbn Ethernet Product Module, Section 5.1.3, p.28]" ;
    rdfs:domain :CvcBandwidthProfile ;
    rdfs:range :BandwidthProfileCombination .

:hasCombinationOf a owl:ObjectProperty ;
    rdfs:label "hasCombinationOf" ;
    rdfs:comment "Links a BandwidthProfileCombination to the traffic class profiles it combines. [extension: nbn Ethernet Product Module, Section 5.1.3, p.28]" ;
    rdfs:domain :BandwidthProfileCombination ;
    rdfs:range :TrafficClass .

:hasSatelliteLimitation a owl:ObjectProperty ;
    rdfs:label "hasSatelliteLimitation" ;
    rdfs:comment "Links a unicast 1:1 CVC bandwidth profile to its satellite-specific limitations. [extension: nbn Ethernet Product Module, Section 5.1.3.1, p.28]" ;
    rdfs:domain :CvcBandwidthProfile ;
    rdfs:range :SatelliteCvcBandwidthProfile .

:appliesToCvcBandwidthProfile a owl:ObjectProperty ;
    rdfs:label "appliesToCvcBandwidthProfile" ;
    rdfs:comment "Links a satellite limitation to the CVC bandwidth profile it applies to. [extension: nbn Ethernet Product Module, Section 5.1.3.1, p.28]" ;
    rdfs:domain :SatelliteCvcBandwidthProfile ;
    rdfs:range :CvcBandwidthProfile .

:discardsTraffic a owl:ObjectProperty ;
    rdfs:label "discardsTraffic" ;
    rdfs:comment "Links the nbn Network to the traffic discarding event during AVC:CVC congestion. [extension: nbn Ethernet Product Module, Section 5.1.4, p.28]" ;
    rdfs:domain :nbnNetwork ;
    rdfs:range :AvcCvcContention .

:inAccordanceWith a owl:DatatypeProperty ;
    rdfs:label "inAccordanceWith" ;
    rdfs:comment "Reference to the section in accordance with which traffic is discarded. [extension: nbn Ethernet Product Module, Section 5.1.4, p.28]" ;
    rdfs:domain :AvcCvcContention ;
    rdfs:range xsd:string .

:hasMaxAvcCount a owl:DatatypeProperty ;
    rdfs:label "hasMaxAvcCount" ;
    rdfs:comment "Maximum number of AVCs a CVC can support. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" ;
    rdfs:domain :CvcSupportsAvcReification ;
    rdfs:range xsd:integer .

:hasAvcCountUnit a owl:DatatypeProperty ;
    rdfs:label "hasAvcCountUnit" ;
    rdfs:comment "Unit of the maximum AVC count. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" ;
    rdfs:domain :CvcSupportsAvcReification ;
    rdfs:range xsd:string .

:isNotZero a owl:DatatypeProperty ;
    rdfs:label "isNotZero" ;
    rdfs:comment "Indicates that the total combination of CVC bandwidth profiles is not zero. [extension: nbn Ethernet Product Module, Section 5.1.3.1, p.28]" ;
    rdfs:domain :BandwidthProfileCombination ;
    rdfs:range xsd:boolean .

:hasNoRestriction a owl:DatatypeProperty ;
    rdfs:label "hasNoRestriction" ;
    rdfs:comment "Indicates that there is no restriction on the number of AVCs. [extension: nbn Ethernet Product Module, Section 5.1.2.2, p.28]" ;
    rdfs:domain :CvcSupportsAvcReification ;
    rdfs:range xsd:boolean .

:requiresAccessToMoreThan a owl:DatatypeProperty ;
    rdfs:label "requiresAccessToMoreThan" ;
    rdfs:comment "Threshold number of AVCs beyond which more than one CVC is required. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" ;
    rdfs:domain :RspRequiresMultipleCvc ;
    rdfs:range xsd:integer .

:necessitatesUtilisingMoreThanOneCvc a owl:DatatypeProperty ;
    rdfs:label "necessitatesUtilisingMoreThanOneCvc" ;
    rdfs:comment "Indicates that more than one CVC is necessary. [extension: nbn Ethernet Product Module, Section 5.1.2.1, p.28]" ;
    rdfs:domain :RspRequiresMultipleCvc ;
    rdfs:range xsd:boolean .

