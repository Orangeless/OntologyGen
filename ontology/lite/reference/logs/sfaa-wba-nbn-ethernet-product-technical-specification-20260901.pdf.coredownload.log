# ===== FACTS: CVC Scalability - Unicast 1:1 (Section 5.1.2.1) =====

# Reification: Unicast 1:1 CVC supports up to 4,000 unicast 1:1 AVCs
:CvcSupportsAvcReification_Unicast1_1 a :CvcSupportsAvcReification, owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 CVC supports up to 4,000 AVCs" ;
    :hasMaxAvcCount 4000 ;
    :hasAvcCountUnit "AVCs" ;
    :sourceClause "nbn Ethernet Product Module, Section 5.1.2.1, p.28" .

:Unicast1_1CVC :hasCvcSupportsAvcReification :CvcSupportsAvcReification_Unicast1_1 .

# Reification: Each unicast 1:1 AVC is addressed using a single, unique C-VID, locally significant to the CVC
:CvcAddressedByCvid_Unicast1_1 a :CvcAddressedByCvid, owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC addressed by unique C-VID, locally significant to CVC" ;
    :sourceClause "nbn Ethernet Product Module, Section 5.1.2.1, p.28" .

:Unicast1_1AVC :hasCvcAddressedByCvid :CvcAddressedByCvid_Unicast1_1 .

# C-VID individual
:CVID_Default a :CVID, owl:NamedIndividual ;
    rdfs:label "Default C-VID for unicast 1:1 AVC addressing" ;
    :isLocallySignificantTo :Unicast1_1CVC ;
    :sourceClause "nbn Ethernet Product Module, Section 5.1.2.1, p.28" .

:Unicast1_1AVC :isAddressedUsing :CVID_Default .

# Reification: Number of CVCs RSP may purchase in relation to a given CSA is limited by NNI resources
:CvcLimitedByNniResources_Default a :CvcLimitedByNniResources, owl:NamedIndividual ;
    rdfs:label "CVC limited by NNI resources for a CSA" ;
    :sourceClause "nbn Ethernet Product Module, Section 5.1.2.1, p.28 (subject to section 2.1(d))" .

:Unicast1_1CVC :hasCvcLimitedByNniResources :CvcLimitedByNniResources_Default .

# NNI Resources individual
:NNIResources_Default a :NNIResources, owl:NamedIndividual ;
    rdfs:label "NNI resources purchased for a CSA" ;
    :sourceClause "nbn Ethernet Product Module, Section 5.1.2.1, p.28" .

:Unicast1_1CVC :isLimitedBy :NNIResources_Default .

# Reification: Where RSP requires access to more than 4,000 AVCs in a given CSA, it is necessary to utilise more than one CVC
:RspRequiresMultipleCvc_Default a :RspRequiresMultipleCvc, owl:NamedIndividual ;
    rdfs:label "RSP requires more than one CVC when access to more than 4,000 AVCs needed" ;
    :requiresAccessToMoreThan 4000 ;
    :necessitatesUtilisingMoreThanOneCvc true ;
    :sourceClause "nbn Ethernet Product Module, Section 5.1.2.1, p.28" .

