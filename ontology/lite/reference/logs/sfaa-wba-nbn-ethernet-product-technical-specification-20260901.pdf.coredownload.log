--- CONTENT: # ===== Network Performance (Section 7) =====
# --- New Classes ---
:Cl_TrafficClassPerformance a owl:Class ;
    rdfs:label "TrafficClassPerformance" ;
    rdfs:comment "A reified relationship between a TrafficClass and its ServiceLevel performance standards (Frame Delay, Frame Delay Variation, Frame Loss), qualified by NetworkType. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.1, page 32]" .

:Cl_PerformanceCondition a owl:Class ;
    rdfs:label "PerformanceCondition" ;
    rdfs:comment "A reified set of conditions (Layer 2 Frame Size, Frame Rate, CVC Utilisation) under which the performance standards in section 7.1 apply. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 32]" .

:Cl_FrameDelayGuidance a owl:Class ;
    rdfs:label "FrameDelayGuidance" ;
    rdfs:comment "A reified guidance for Frame Delay based on the distance between UNI and NNI, including the distance threshold and extra latency allowance. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 32]" .

:Cl_FrameLossCondition a owl:Class ;
    rdfs:label "FrameLossCondition" ;
    rdfs:comment "A reified condition that must be met for Frame Loss targets to be achieved, namely that the CBS is less than the specified limits at both the AVC and CVC level. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.1, page 32, footnote 14]" .

# --- New Object Properties ---
:hasPerformanceStandard a owl:ObjectProperty ;
    rdfs:label "hasPerformanceStandard" ;
    rdfs:comment "Links a TrafficClass to its reified performance standard node. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.1, page 32]" ;
    rdfs:domain :TrafficClass ;
    rdfs:range :Cl_TrafficClassPerformance .

:appliesToNetworkType a owl:ObjectProperty ;
    rdfs:label "appliesToNetworkType" ;
    rdfs:comment "Links a TrafficClassPerformance node to the AccessNetwork type to which the performance standard applies. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.1, page 32]" ;
    rdfs:domain :Cl_TrafficClassPerformance ;
    rdfs:range :AccessNetwork .

:hasPerformanceCondition a owl:ObjectProperty ;
    rdfs:label "hasPerformanceCondition" ;
    rdfs:comment "Links a TrafficClass to its reified performance condition node. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 32]" ;
    rdfs:domain :TrafficClass ;
    rdfs:range :Cl_PerformanceCondition .

:hasFrameDelayGuidance a owl:ObjectProperty ;
    rdfs:label "hasFrameDelayGuidance" ;
    rdfs:comment "Links a TrafficClass to its reified Frame Delay guidance node. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 32]" ;
    rdfs:domain :TrafficClass ;
    rdfs:range :Cl_FrameDelayGuidance .

:hasFrameLossCondition a owl:ObjectProperty ;
    rdfs:label "hasFrameLossCondition" ;
    rdfs:comment "Links a TrafficClassPerformance node to its reified Frame Loss condition. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.1, page 32, footnote 14]" ;
    rdfs:domain :Cl_TrafficClassPerformance ;
    rdfs:range :Cl_FrameLossCondition .

:appliesToDistance a owl:ObjectProperty ;
    rdfs:label "appliesToDistance" ;
    rdfs:comment "Links a FrameDelayGuidance node to the UNI and NNI between which the distance applies. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 32]" ;
    rdfs:domain :Cl_FrameDelayGuidance ;
    rdfs:range owl:Thing .

:atAVCLevel a owl:ObjectProperty ;
    rdfs:label "atAVCLevel" ;
    rdfs:comment "Links a FrameLossCondition to the AVC at which the CBS limit applies. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.1, page 32, footnote 14]" ;
    rdfs:domain :Cl_FrameLossCondition ;
    rdfs:range :AVC .

:atCVCLevel a owl:ObjectProperty ;
    rdfs:label "atCVCLevel" ;
    rdfs:comment "Links a FrameLossCondition to the CVC at which the CBS limit applies. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.1, page 32, footnote 14]" ;
    rdfs:domain :Cl_FrameLossCondition ;
    rdfs:range :CVC .

:describedInSection a owl:ObjectProperty ;
    rdfs:label "describedInSection" ;
    rdfs:comment "Links a performance node to the document section that describes it. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7, page 32]" ;
    rdfs:domain owl:Thing ;
    rdfs:range :DocumentSection .

# --- New Data Properties ---
:hasFrameDelayMsec a owl:DatatypeProperty ;
    rdfs:label "hasFrameDelayMsec" ;
    rdfs:comment "The Frame Delay (One-Way) value in milliseconds for a traffic class on a network type. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.1, page 32]" ;
    rdfs:domain :Cl_TrafficClassPerformance ;
    rdfs:range xsd:decimal .

:hasFrameDelayVariationMsec a owl:DatatypeProperty ;
    rdfs:label "hasFrameDelayVariationMsec" ;
    rdfs:comment "The Frame Delay Variation value in milliseconds for a traffic class on a network type. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.1, page 32]" ;
    rdfs:domain :Cl_TrafficClassPerformance ;
    rdfs:range xsd:decimal .

:hasFrameLossPct a owl:DatatypeProperty ;
    rdfs:label "hasFrameLossPct" ;
    rdfs:comment "The Frame Loss target as a percentage for a traffic class on a network type. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.1, page 32]" ;
    rdfs:domain :Cl_TrafficClassPerformance ;
    rdfs:range xsd:decimal .

:hasLayer2FrameSizeBytes a owl:DatatypeProperty ;
    rdfs:label "hasLayer2FrameSizeBytes" ;
    rdfs:comment "The Layer 2 Frame Size at NNI in bytes for a traffic class performance condition. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 32]" ;
    rdfs:domain :Cl_PerformanceCondition ;
    rdfs:range xsd:integer .

:hasFrameRateCondition a owl:DatatypeProperty ;
    rdfs:label "hasFrameRateCondition" ;
    rdfs:comment "The Frame Rate condition (e.g. Periodic <=CIR) for a traffic class performance condition. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 32]" ;
    rdfs:domain :Cl_PerformanceCondition ;
    rdfs:range xsd:string .

:hasCvcUtilisationPct a owl:DatatypeProperty ;
    rdfs:label "hasCvcUtilisationPct" ;
    rdfs:comment "The CVC Traffic Class Capacity Utilisation as a percentage for a traffic class performance condition. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 32]" ;
    rdfs:domain :Cl_PerformanceCondition ;
    rdfs:range xsd:decimal .

:hasDistanceThresholdKm a owl:DatatypeProperty ;
    rdfs:label "hasDistanceThresholdKm" ;
    rdfs:comment "The distance threshold in kilometres between UNI and NNI for Frame Delay guidance. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 32]" ;
    rdfs:domain :Cl_FrameDelayGuidance ;
    rdfs:range xsd:decimal .

:hasExtraAllowanceMsec a owl:DatatypeProperty ;
    rdfs:label "hasExtraAllowanceMsec" ;
    rdfs:comment "The extra latency allowance in milliseconds per additional 200km air path distance (or part thereof) when UNI to NNI distance exceeds the threshold. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 32]" ;
    rdfs:domain :Cl_FrameDelayGuidance ;
    rdfs:range xsd:decimal .

:hasExtraAllowancePerKm a owl:DatatypeProperty ;
    rdfs:label "hasExtraAllowancePerKm" ;
    rdfs:comment "The distance increment (200km) per which the extra latency allowance applies. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 32]" ;
    rdfs:domain :Cl_FrameDelayGuidance ;
    rdfs:range xsd:decimal .

:hasCbsLimitDescription a owl:DatatypeProperty ;
    rdfs:label "hasCbsLimitDescription" ;
    rdfs:comment "A textual description of the CBS limit condition that must be met for Frame Loss targets to be achieved. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.1, page 32, footnote 14]" ;
    rdfs:domain :Cl_FrameLossCondition ;
    rdfs:range xsd:string .

:hasUnit a owl:DatatypeProperty ;
    rdfs:label "hasUnit" ;
    rdfs:comment "The unit of measurement for a performance value (msec or %). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.1, page 32]" ;
    rdfs:domain :Cl_TrafficClassPerformance ;
    rdfs:range xsd:string .

