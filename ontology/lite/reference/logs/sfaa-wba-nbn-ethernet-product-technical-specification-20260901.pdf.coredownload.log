--- CONTENT: # ===== EXTENSIONS: Section 4.1 - Access Virtual Circuit (AVC) =====

# New classes for AVC variants and related concepts
:Unicast_1_1_AVC a owl:Class ;
    rdfs:label "Unicast 1:1 AVC" ;
    rdfs:comment "A variant of AVC required for unicast data applications using the UNI-D or UNI-DSL. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:subClassOf :AVC .

:Unicast_N_1_AVC a owl:Class ;
    rdfs:label "Unicast N:1 AVC" ;
    rdfs:comment "A variant of AVC required for unicast data applications using the UNI-V. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:subClassOf :AVC .

:UNI_V a owl:Class ;
    rdfs:label "UNI-V" ;
    rdfs:comment "UNI-V (User Network Interface - V) entity, a type of UNI used with Unicast N:1 AVC. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:subClassOf :AVC .

:S_C_VID a owl:Class ;
    rdfs:label "S/C-VID" ;
    rdfs:comment "Distinct Service and Customer VLAN Identifiers used to logically isolate AVCs from each other. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

:BandwidthProfile a owl:Class ;
    rdfs:label "BandwidthProfile" ;
    rdfs:comment "A bandwidth profile through which an AVC is designed to be scaled in capacity. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

:AccessLoopIdentification a owl:Class ;
    rdfs:label "AccessLoopIdentification" ;
    rdfs:comment "An optional feature for unicast AVCs that inserts identification into upstream Layer 3 control packets. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" .

:LineCharacteristicInformation a owl:Class ;
    rdfs:label "LineCharacteristicInformation" ;
    rdfs:comment "Optional line characteristic information that may be inserted into upstream Layer 3 control packets as part of Access Loop Identification. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" .

:AVC_ID a owl:Class ;
    rdfs:label "AVC ID" ;
    rdfs:comment "An identifier for an AVC that can be included in Access Loop Identification. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" .

:CircuitIDField a owl:Class ;
    rdfs:label "Circuit ID Field" ;
    rdfs:comment "The Circuit ID field in DHCPv4, DHCPv6 or PPPoE protocols where the AVC ID is configured. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" .

:Protocol a owl:Class ;
    rdfs:label "Protocol" ;
    rdfs:comment "A protocol used for Access Loop Identification insertion. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" .

:AccessNetwork a owl:Class ;
    rdfs:label "AccessNetwork" ;
    rdfs:comment "An access network type that determines AVC type availability. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

# Reified relationship classes for AVC
:AVC_LogicalIsolation a owl:Class ;
    rdfs:label "AVC Logical Isolation" ;
    rdfs:comment "Reified relationship representing that an AVC is logically isolated by a distinct S/C-VID. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

:AVC_ScaledThrough a owl:Class ;
    rdfs:label "AVC Scaled Through" ;
    rdfs:comment "Reified relationship representing that an AVC is scaled in capacity through its bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

:AVC_RequiredFor a owl:Class ;
    rdfs:label "AVC Required For" ;
    rdfs:comment "Reified relationship representing that an AVC variant is required for unicast data applications. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

:AVC_AvailableOn a owl:Class ;
    rdfs:label "AVC Available On" ;
    rdfs:comment "Reified relationship representing that an AVC type is available on a specific UNI type qualified by access network. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

:RSP_OrdersAccessLoopID a owl:Class ;
    rdfs:label "RSP Orders Access Loop ID" ;
