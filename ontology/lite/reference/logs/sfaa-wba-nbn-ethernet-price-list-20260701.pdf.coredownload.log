--- CONTENT: # ===== EXTENSIONS FOR SECTION 7 (EARLY DISCONNECTION/MODIFICATION CHARGE) AND SECTION 8 (LABOUR RATES) =====

# --- NEW CLASSES ---

:Cl_Charge a owl:Class ;
    rdfs:label "Charge under Section 7" ;
    rdfs:comment "A monetary amount calculated as (Pre Disconnection Modification Charges - Post Disconnection Modification Charges) x Shortfall Period, applicable under section 7. [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    rdfs:subClassOf :Cl_EarlyDisconnectionModificationCharge .

:Cl_PreDisconnectionModificationCharges a owl:Class ;
    rdfs:label "Pre Disconnection Modification Charges" ;
    rdfs:comment "The recurring Charges for the TC-2 Bundle Components applicable prior to a cancellation, disconnection, or modification event, as set out in section 1.5. [extension: nbn Ethernet Price List, Section 7(c)(i), p.19]" ;
    rdfs:subClassOf :MonetaryAmount .

:Cl_PostDisconnectionModificationCharges a owl:Class ;
    rdfs:label "Post Disconnection Modification Charges" ;
    rdfs:comment "The recurring Charges for the TC-2 Bundle Components applicable after a modification event, or nil in the case of cancellation or disconnection, as set out in section 1.5. [extension: nbn Ethernet Price List, Section 7(c)(ii), p.19]" ;
    rdfs:subClassOf :MonetaryAmount .

:Cl_ShortfallPeriod a owl:Class ;
    rdfs:label "Shortfall Period" ;
    rdfs:comment "A time interval used in the Charge calculation: 12 months for cancellation, or 12 months less the period Pre Disconnection Modification Charges applied for disconnection or modification, calculated on a pro rata daily basis. [extension: nbn Ethernet Price List, Section 7(c)(iii), p.19]" ;
    rdfs:subClassOf :TimeInterval .

:Cl_TriggerEvent a owl:Class ;
    rdfs:label "Trigger Event" ;
    rdfs:comment "An event (cancellation, disconnection, or modification) that triggers the calculation of the Charge under section 7. [extension: nbn Ethernet Price List, Section 7, p.19]" ;
    rdfs:subClassOf :Event .

:Cl_ServiceTransferOrder a owl:Class ;
    rdfs:label "Service Transfer Order" ;
    rdfs:comment "An order accepted by nbn for transfer of service from a Losing RSP to an Other Gaining RSP, which may exempt the Charge under section 7(d)(ii). [extension: nbn Ethernet Price List, Section 7(d)(ii), p.19]" ;
    rdfs:subClassOf :Event .

:Cl_CIRObjective a owl:Class ;
    rdfs:label "CIR Objective" ;
    rdfs:comment "The Committed Information Rate objective applicable to an AVC TC-2 bandwidth profile, used in exemption conditions under section 7(d). [extension: nbn Ethernet Price List, Section 7(d), p.19]" ;
    rdfs:subClassOf :Attribute .

:Cl_LabourRate a owl:Class ;
    rdfs:label "Labour Rate" ;
    rdfs:comment "$75.00 for each of the total number of labour hours required to perform the relevant activity (rounded up to the next full hour). [extension: nbn Ethernet Price List, Section 8(a), p.19]" ;
    rdfs:subClassOf :MonetaryAmount .

:Cl_SatelliteLabourRate a owl:Class ;
    rdfs:label "Satellite Labour Rate" ;
    rdfs:comment "$98.00 for each of the total number of labour hours required to perform the relevant activity (rounded up to the next full hour). [extension: nbn Ethernet Price List, Section 8(b), p.19]" ;
    rdfs:subClassOf :MonetaryAmount .

:Cl_ChargeFormula a owl:Class ;
    rdfs:label "Charge Formula" ;
    rdfs:comment "A reified representation of the formula: Charge = (Pre Disconnection Modification Charges - Post Disconnection Modification Charges) x Shortfall Period. [extension: nbn Ethernet Price List, Section 7(c), p.19]" .

:Cl_ExemptionCondition a owl:Class ;
    rdfs:label "Exemption Condition" ;
    rdfs:comment "A condition under which the Charge under section 7 does not apply, such as unsuccessful Network Activity or Service Transfer Order with qualifying CIR Objective. [extension: nbn Ethernet Price List, Section 7(d), p.19]" .

:Attribute a owl:Class ;
    rdfs:label "Attribute" ;
    rdfs:comment "A generic attribute or characteristic. [extension: nbn Ethernet Price List, Section 7, p.19]" .

# --- NEW OBJECT PROPERTIES ---

:hasPreDisconnectionModificationCharges a owl:ObjectProperty ;
    rdfs:label "has pre disconnection modification charges" ;
    rdfs:comment "Links a Charge or ChargeFormula to the Pre Disconnection Modification Charges component. [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    rdfs:domain :Cl_ChargeFormula ;
    rdfs:range :Cl_PreDisconnectionModificationCharges .

:hasPostDisconnectionModificationCharges a owl:ObjectProperty ;
    rdfs:label "has post disconnection modification charges" ;
    rdfs:comment "Links a Charge or ChargeFormula to the Post Disconnection Modification Charges component. [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    rdfs:domain :Cl_ChargeFormula ;
    rdfs:range :Cl_PostDisconnectionModificationCharges .

:hasShortfallPeriod a owl:ObjectProperty ;
    rdfs:label "has shortfall period" ;
    rdfs:comment "Links a Charge or ChargeFormula to the Shortfall Period component. [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    rdfs:domain :Cl_ChargeFormula ;
    rdfs:range :Cl_ShortfallPeriod .

:hasTriggerEvent a owl:ObjectProperty ;
    rdfs:label "has trigger event" ;
    rdfs:comment "Links a Charge to the Trigger Event that causes it. [extension: nbn Ethernet Price List, Section 7, p.19]" ;
    rdfs:domain :Cl_Charge ;
    rdfs:range :Cl_TriggerEvent .

