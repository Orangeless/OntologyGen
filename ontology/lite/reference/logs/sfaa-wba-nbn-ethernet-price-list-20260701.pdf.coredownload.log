    rdfs:comment "A condition that, when satisfied, triggers reduced NNI Bearer charges. [extension: nbn Ethernet Price List, Section 1.6(c), p.8]" .

:Supplier a owl:Class ;
    rdfs:label "Supplier" ;
    rdfs:comment "A role representing the supplier of a product component. [extension: nbn Ethernet Price List, Section 1.6(c), p.8]" .

