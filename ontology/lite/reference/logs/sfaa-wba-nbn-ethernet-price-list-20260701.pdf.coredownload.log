--- CONTENT: # ===== EXTENSIONS: Section 1.5 TC-2 Charges (Bundle Components) =====
# New classes for TC-2 Bundle Components

:EnhancedFaultRectificationService a owl:Class ;
    rdfs:label "EnhancedFaultRectificationService" ;
    rdfs:comment "An Enhanced Fault Rectification Service Product Feature for TC-2 Bundle Components. [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:subClassOf :ServiceLevel .

:TC2_BundleComponents a owl:Class ;
    rdfs:label "TC2_BundleComponents" ;
    rdfs:comment "A bundled product offering comprising an AVC TC-2 Product Component, a CVC TC-2 inclusion, and an Enhanced Fault Rectification Service Product Feature, charged as a single recurring amount. [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:subClassOf :ProductComponent .

:AVC_TC2_ProductComponent a owl:Class ;
    rdfs:label "AVC_TC2_ProductComponent" ;
    rdfs:comment "An Access Virtual Circuit product component for traffic class TC-2, defined by its symmetrical committed information rate (CIR) in Mbps and the access technologies it supports. [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:subClassOf :AVC,
        :ProductComponent .

:CVC_TC2_Inclusion a owl:Class ;
    rdfs:label "CVC_TC2_Inclusion" ;
    rdfs:comment "A CVC TC-2 inclusion that is part of the TC-2 Bundle Components, defined by symmetrical Mbps (CIR). [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:subClassOf :CVC,
        :ProductComponent .

:CVC_TC2_OrderedProductComponent a owl:Class ;
    rdfs:label "CVC_TC2_OrderedProductComponent" ;
    rdfs:comment "A CVC TC-2 Ordered Product Component supplied to RSP in excess of the total CVC TC-2 inclusions. [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:subClassOf :CVC,
        :ProductComponent .

:SymmetricalMbpsCIR a owl:Class ;
    rdfs:label "SymmetricalMbpsCIR" ;
    rdfs:comment "A symmetrical committed information rate (CIR) value in Mbps for TC-2 product components. [extension: nbn Ethernet Price List, Section 1.5, p.7]" .

# New object properties

:includes a owl:ObjectProperty ;
    rdfs:label "includes" ;
    rdfs:comment "Links TC-2 Bundle Components to the product components or service features it includes. [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:domain :TC2_BundleComponents ;
    rdfs:range :ProductComponent .

:isPartOfBundle a owl:ObjectProperty ;
    rdfs:label "isPartOfBundle" ;
    rdfs:comment "Inverse of includes. Links a product component or service feature to the TC-2 Bundle Components it is part of. [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:domain :ProductComponent ;
    rdfs:range :TC2_BundleComponents .

:hasSymmetricalMbpsCIR a owl:ObjectProperty ;
    rdfs:label "hasSymmetricalMbpsCIR" ;
    rdfs:comment "Links an AVC TC-2 Product Component or CVC TC-2 Inclusion to its symmetrical Mbps (CIR) value. [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:domain :AVC_TC2_ProductComponent ;
    rdfs:range :SymmetricalMbpsCIR .

:hasDefaultService a owl:ObjectProperty ;
    rdfs:label "hasDefaultService" ;
    rdfs:comment "Links TC-2 Bundle Components to its default Enhanced Fault Rectification Service (Enhanced-12 24/7). [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:domain :TC2_BundleComponents ;
    rdfs:range :EnhancedFaultRectificationService .

:hasAlternativeService a owl:ObjectProperty ;
    rdfs:label "hasAlternativeService" ;
    rdfs:comment "Links TC-2 Bundle Components to an alternative Enhanced Fault Rectification Service (Alternative ESLA). [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:domain :TC2_BundleComponents ;
    rdfs:range :EnhancedFaultRectificationService .

:isChargedInAdditionTo a owl:ObjectProperty ;
    rdfs:label "isChargedInAdditionTo" ;
    rdfs:comment "Links an Alternative ESLA to the recurring charge it is charged in addition to. [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:domain :EnhancedFaultRectificationService ;
    rdfs:range :RecurringCharge .

:exceeds a owl:ObjectProperty ;
    rdfs:label "exceeds" ;
    rdfs:comment "Links a CVC TC-2 Ordered Product Component to the CVC TC-2 Inclusion it exceeds. [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:domain :CVC_TC2_OrderedProductComponent ;
    rdfs:range :CVC_TC2_Inclusion .

:orders a owl:ObjectProperty ;
    rdfs:label "orders" ;
    rdfs:comment "Links an RSP to the product components or bandwidth profiles they order. [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:domain :RSP ;
    rdfs:range :ProductComponent .

:associates a owl:ObjectProperty ;
    rdfs:label "associates" ;
    rdfs:comment "Links an AVC TC-2 Product Component to the CVC-2 Product Component it is associated with. [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:domain :AVC_TC2_ProductComponent ;
    rdfs:range :CVC_ProductComponent .

:charges a owl:ObjectProperty ;
    rdfs:label "charges" ;
    rdfs:comment "Links nbn to the RSP that is charged. [extension: nbn Ethernet Price List, Section 1.5, p.7]" ;
    rdfs:domain :nbn ;
    rdfs:range :RSP .

