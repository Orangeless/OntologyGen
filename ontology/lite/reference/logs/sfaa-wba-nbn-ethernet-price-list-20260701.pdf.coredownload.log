# ===== Section 2.2(c) Charge Calculation Rules =====

:ChargeCalculationRule_FirstMonth_PreEvent a :ProRataRule, owl:NamedIndividual ;
    rdfs:label "Charge Calculation Rule: First Month portion on or before eSLA Change Event" ;
    :conditionDescription "For the portion of the first month on or before the day on which the eSLA Change Event occurs, the Charge is calculated in accordance with the applicable Charge in this nbn Ethernet Price List and any applicable Discounts, Credits, Rebates or Waivers." ;
    :sourceClause "nbn Ethernet Price List, Section 2.2(c)(i), p.10" .

:ChargeCalculationRule_FirstMonth_PostEvent a :ProRataRule, owl:NamedIndividual ;
    rdfs:label "Charge Calculation Rule: First Month portion after eSLA Change Event" ;
    :conditionDescription "For the portion of the first month after the day on which the eSLA Change Event occurs, the Charge is calculated in accordance with the applicable Charge in section 2.2(a), without the application of any Discount, Credit, Rebate or Waiver." ;
    :sourceClause "nbn Ethernet Price List, Section 2.2(c)(ii), p.10" .

# ===== Link eSLA Change Event to Enhanced Fault Rectification Services =====

:EnhancedFaultRectification_Enhanced4_24_7 :hasESLAChangeEvent :ESLAChangeEvent_Instance ;
    :hasFirstMonth :FirstMonth_Instance ;
    :sourceClause "nbn Ethernet Price List, Section 2.2(b), p.10" .

:ESLAChangeEvent_Instance :occursWithin :FirstMonth_Instance ;
    :triggersChargeRule :RecurringCharge_Enhanced4_24_7_25_00 ;
    :isCausedByDisconnection :EnhancedFaultRectification_Enhanced4_24_7 ;
    :isCausedByModification :EnhancedFaultRectification_Enhanced4_24_7 ;
    :hasExemptionCondition :ExemptionCondition_AVCTC2 ;
    :sourceClause "nbn Ethernet Price List, Section 2.2(e), p.10" .

# ===== Link the exemption condition to the Ordered Product and AVC TC-2 =====

:ExemptionCondition_AVCTC2 :appliesTo :EnhancedFaultRectification_Enhanced4_24_7 ;
    :sourceClause "nbn Ethernet Price List, Section 2.2(d), p.10" .

