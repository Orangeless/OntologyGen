    rdfs:label "has charge formula" ;
    rdfs:comment "Links a Charge to its reified ChargeFormula. [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    rdfs:domain :Cl_Charge ;
    rdfs:range :Cl_ChargeFormula .

