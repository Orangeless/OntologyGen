--- CONTENT: # ===== EXTENSIONS FROM DOCUMENTS: append new classes / properties / facts BELOW this line =====

# ===== EXTENSIONS FOR SECTION 7 (EARLY DISCONNECTION/MODIFICATION CHARGE) AND SECTION 8 (LABOUR RATES) =====

# --- NEW CLASSES ---

:Cl_Charge a owl:Class ;
    rdfs:label "Charge under Section 7" ;
    rdfs:comment "A monetary amount calculated as (Pre Disconnection Modification Charges - Post Disconnection Modification Charges) x Shortfall Period, applicable under section 7. [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    rdfs:subClassOf :Cl_EarlyDisconnectionModificationCharge .

:Cl_PreDisconnectionModificationCharges a owl:Class ;
    rdfs:label "Pre Disconnection Modification Charges" ;
    rdfs:comment "The recurring Charges for the TC-2 Bundle Components applicable prior to a cancellation, disconnection, or modification event, as set out in section 1.5. [extension: nbn Ethernet Price List, Section 7(c)(i), p.19]" ;
    rdfs:subClassOf :MonetaryAmount .

:Cl_PostDisconnectionModificationCharges a owl:Class ;
    rdfs:label "Post Disconnection Modification Charges" ;
    rdfs:comment "The recurring Charges for the TC-2 Bundle Components applicable after a modification event, or nil in the case of cancellation or disconnection, as set out in section 1.5. [extension: nbn Ethernet Price List, Section 7(c)(ii), p.19]" ;
    rdfs:subClassOf :MonetaryAmount .

:Cl_ShortfallPeriod a owl:Class ;
    rdfs:label "Shortfall Period" ;
    rdfs:comment "A time interval used in the Charge calculation: 12 months for cancellation, or 12 months less the period Pre Disconnection Modification Charges applied for disconnection or modification, calculated on a pro rata daily basis. [extension: nbn Ethernet Price List, Section 7(c)(iii), p.19]" ;
    rdfs:subClassOf :TimeInterval .

:Cl_TriggerEvent a owl:Class ;
    rdfs:label "Trigger Event" ;
    rdfs:comment "An event (cancellation, disconnection, or modification) that triggers the calculation of the Charge under section 7. [extension: nbn Ethernet Price List, Section 7, p.19]" ;
    rdfs:subClassOf :Event .

:Cl_ServiceTransferOrder a owl:Class ;
    rdfs:label "Service Transfer Order" ;
    rdfs:comment "An order accepted by nbn for transfer of service from a Losing RSP to an Other Gaining RSP, which may exempt the Charge under section 7(d)(ii). [extension: nbn Ethernet Price List, Section 7(d)(ii), p.19]" ;
    rdfs:subClassOf :Event .

:Cl_CIRObjective a owl:Class ;
    rdfs:label "CIR Objective" ;
    rdfs:comment "The Committed Information Rate objective applicable to an AVC TC-2 bandwidth profile, used in exemption conditions under section 7(d). [extension: nbn Ethernet Price List, Section 7(d), p.19]" ;
    rdfs:subClassOf :Attribute .

:Cl_LabourRate a owl:Class ;
    rdfs:label "Labour Rate" ;
    rdfs:comment "$75.00 for each of the total number of labour hours required to perform the relevant activity (rounded up to the next full hour). [extension: nbn Ethernet Price List, Section 8(a), p.19]" ;
    rdfs:subClassOf :MonetaryAmount .

:Cl_SatelliteLabourRate a owl:Class ;
    rdfs:label "Satellite Labour Rate" ;
    rdfs:comment "$98.00 for each of the total number of labour hours required to perform the relevant activity (rounded up to the next full hour). [extension: nbn Ethernet Price List, Section 8(b), p.19]" ;
    rdfs:subClassOf :MonetaryAmount .

:Cl_ChargeFormula a owl:Class ;
    rdfs:label "Charge Formula" ;
    rdfs:comment "A reified representation of the formula: Charge = (Pre Disconnection Modification Charges - Post Disconnection Modification Charges) x Shortfall Period. [extension: nbn Ethernet Price List, Section 7(c), p.19]" .

:Cl_ExemptionCondition a owl:Class ;
    rdfs:label "Exemption Condition" ;
    rdfs:comment "A condition under which the Charge under section 7 does not apply, such as unsuccessful Network Activity or Service Transfer Order with qualifying CIR Objective. [extension: nbn Ethernet Price List, Section 7(d), p.19]" .

:Attribute a owl:Class ;
    rdfs:label "Attribute" ;
    rdfs:comment "A generic attribute or characteristic. [extension: nbn Ethernet Price List, Section 7, p.19]" .

# --- NEW OBJECT PROPERTIES ---

:hasPreDisconnectionModificationCharges a owl:ObjectProperty ;
    rdfs:label "has pre disconnection modification charges" ;
    rdfs:comment "Links a Charge or ChargeFormula to the Pre Disconnection Modification Charges component. [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    rdfs:domain :Cl_ChargeFormula ;
    rdfs:range :Cl_PreDisconnectionModificationCharges .

:hasPostDisconnectionModificationCharges a owl:ObjectProperty ;
    rdfs:label "has post disconnection modification charges" ;
    rdfs:comment "Links a Charge or ChargeFormula to the Post Disconnection Modification Charges component. [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    rdfs:domain :Cl_ChargeFormula ;
    rdfs:range :Cl_PostDisconnectionModificationCharges .

:hasShortfallPeriod a owl:ObjectProperty ;
    rdfs:label "has shortfall period" ;
    rdfs:comment "Links a Charge or ChargeFormula to the Shortfall Period component. [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    rdfs:domain :Cl_ChargeFormula ;
    rdfs:range :Cl_ShortfallPeriod .

:hasTriggerEvent a owl:ObjectProperty ;
    rdfs:label "has trigger event" ;
    rdfs:comment "Links a Charge to the Trigger Event that causes it. [extension: nbn Ethernet Price List, Section 7, p.19]" ;
    rdfs:domain :Cl_Charge ;
    rdfs:range :Cl_TriggerEvent .

:hasChargeFormula a owl:ObjectProperty ;
    rdfs:label "has charge formula" ;
    rdfs:comment "Links a Charge to its reified ChargeFormula. [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    rdfs:domain :Cl_Charge ;
    rdfs:range :Cl_ChargeFormula .

:hasExemptionCondition a owl:ObjectProperty ;
    rdfs:label "has exemption condition" ;
    rdfs:comment "Links a Charge to an ExemptionCondition under which it does not apply. [extension: nbn Ethernet Price List, Section 7(d), p.19]" ;
    rdfs:domain :Cl_Charge ;
    rdfs:range :Cl_ExemptionCondition .

:hasCIRObjective a owl:ObjectProperty ;
    rdfs:label "has CIR objective" ;
    rdfs:comment "Links an AVC TC-2 bandwidth profile or ordered product to its CIR Objective. [extension: nbn Ethernet Price List, Section 7(d), p.19]" ;
    rdfs:range :Cl_CIRObjective .

:hasServiceTransferOrder a owl:ObjectProperty ;
    rdfs:label "has service transfer order" ;
    rdfs:comment "Links an Ordered Product to a Service Transfer Order accepted by nbn. [extension: nbn Ethernet Price List, Section 7(d)(ii), p.19]" ;
    rdfs:domain :OrderedProduct ;
    rdfs:range :Cl_ServiceTransferOrder .

:hasLosingRSP a owl:ObjectProperty ;
    rdfs:label "has losing RSP" ;
    rdfs:comment "Links a Service Transfer Order to the Losing RSP. [extension: nbn Ethernet Price List, Section 7(d)(ii), p.19]" ;
    rdfs:domain :Cl_ServiceTransferOrder ;
    rdfs:range :Party .

:hasOtherGainingRSP a owl:ObjectProperty ;
    rdfs:label "has other gaining RSP" ;
    rdfs:comment "Links a Service Transfer Order to the Other Gaining RSP. [extension: nbn Ethernet Price List, Section 7(d)(ii), p.19]" ;
    rdfs:domain :Cl_ServiceTransferOrder ;
    rdfs:range :Party .

:hasOrderedAVCTC2 a owl:ObjectProperty ;
    rdfs:label "has ordered AVC TC-2" ;
    rdfs:comment "Links a Service Transfer Order to the AVC TC-2 Product Component ordered by the Other Gaining RSP. [extension: nbn Ethernet Price List, Section 7(d)(ii), p.19]" ;
    rdfs:domain :Cl_ServiceTransferOrder ;
    rdfs:range :AVC_TC2_ProductComponent .

:hasBandwidthProfileCIR a owl:DatatypeProperty ;
    rdfs:label "has bandwidth profile CIR" ;
    rdfs:comment "The CIR value in Mbps of a bandwidth profile. [extension: nbn Ethernet Price List, Section 7, p.19]" ;
    rdfs:domain :BandwidthProfile ;
    rdfs:range xsd:decimal .

:hasDurationISO8601 a owl:DatatypeProperty ;
    rdfs:label "has duration ISO 8601" ;
    rdfs:comment "The duration of a time interval in ISO 8601 format. [extension: nbn Ethernet Price List, Section 7(c)(iii), p.19]" ;
    rdfs:domain :TimeInterval ;
    rdfs:range xsd:string .

:hasProRataDailyBasis a owl:DatatypeProperty ;
    rdfs:label "has pro rata daily basis" ;
    rdfs:comment "Indicates that a calculation is performed on a pro rata daily basis. [extension: nbn Ethernet Price List, Section 7(c)(iii)(B), p.19]" ;
    rdfs:range xsd:boolean .

:hasNotificationStatus a owl:DatatypeProperty ;
    rdfs:label "has notification status" ;
    rdfs:comment "Indicates whether nbn has notified RSP about Network Activity outcome. [extension: nbn Ethernet Price List, Section 7(d)(i), p.19]" ;
    rdfs:range xsd:boolean .

:hasNetworkActivityOutcome a owl:DatatypeProperty ;
    rdfs:label "has network activity outcome" ;
    rdfs:comment "Indicates whether Network Activity to achieve the CIR Objective was unsuccessful. [extension: nbn Ethernet Price List, Section 7(d)(i), p.19]" ;
    rdfs:range xsd:boolean .

:hasLabourHours a owl:DatatypeProperty ;
    rdfs:label "has labour hours" ;
    rdfs:comment "The total number of labour hours required to perform the relevant activity. [extension: nbn Ethernet Price List, Section 8, p.19]" ;
    rdfs:range xsd:decimal .

:roundedUpToNextFullHour a owl:DatatypeProperty ;
    rdfs:label "rounded up to next full hour" ;
    rdfs:comment "Indicates that labour hours are rounded up to the next full hour. [extension: nbn Ethernet Price List, Section 8, p.19]" ;
    rdfs:range xsd:boolean .

# --- INSTANCES / FACTS ---

# Trigger Event types
:TriggerEvent_Cancellation a :Cl_TriggerEvent, owl:NamedIndividual ;
    rdfs:label "Cancellation Trigger Event" ;
    rdfs:comment "A cancellation of an order for an AVC TC-2 Product Component that triggers the Charge under section 7. [extension: nbn Ethernet Price List, Section 7(c)(i)(A), p.19]" ;
    :sourceClause "nbn Ethernet Price List, Section 7(c)(i)(A), p.19" .

:TriggerEvent_Disconnection a :Cl_TriggerEvent, owl:NamedIndividual ;
    rdfs:label "Disconnection Trigger Event" ;
    rdfs:comment "A disconnection of an nbn Ethernet Ordered Product that triggers the Charge under section 7. [extension: nbn Ethernet Price List, Section 7(c)(i)(B)(1), p.19]" ;
    :sourceClause "nbn Ethernet Price List, Section 7(c)(i)(B)(1), p.19" .

:TriggerEvent_Modification a :Cl_TriggerEvent, owl:NamedIndividual ;
    rdfs:label "Modification Trigger Event" ;
    rdfs:comment "A modification of the AVC TC-2 bandwidth profile that triggers the Charge under section 7. [extension: nbn Ethernet Price List, Section 7(c)(i)(B)(2), p.19]" ;
    :sourceClause "nbn Ethernet Price List, Section 7(c)(i)(B)(2), p.19" .

# Shortfall Period instances
:ShortfallPeriod_Cancellation a :Cl_ShortfallPeriod, owl:NamedIndividual ;
    rdfs:label "Shortfall Period for Cancellation" ;
    rdfs:comment "12 months, applicable in the case of a cancellation. [extension: nbn Ethernet Price List, Section 7(c)(iii)(A), p.19]" ;
    :hasDurationISO8601 "P12M" ;
    :sourceClause "nbn Ethernet Price List, Section 7(c)(iii)(A), p.19" .

:ShortfallPeriod_DisconnectionModification a :Cl_ShortfallPeriod, owl:NamedIndividual ;
    rdfs:label "Shortfall Period for Disconnection or Modification" ;
    rdfs:comment "12 months less the period during which the Pre Disconnection Modification Charges applied, calculated on a pro rata daily basis. [extension: nbn Ethernet Price List, Section 7(c)(iii)(B), p.19]" ;
    :hasDurationISO8601 "P12M" ;
    :hasProRataDailyBasis true ;
    :sourceClause "nbn Ethernet Price List, Section 7(c)(iii)(B), p.19" .

# Charge Formula instance
:ChargeFormula_Section7 a :Cl_ChargeFormula, owl:NamedIndividual ;
    rdfs:label "Charge Formula under Section 7(c)" ;
    rdfs:comment "Charge = (Pre Disconnection Modification Charges - Post Disconnection Modification Charges) x Shortfall Period. [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    :sourceClause "nbn Ethernet Price List, Section 7(c), p.19" .

# Exemption Condition instances
:ExemptionCondition_UnsuccessfulNetworkActivity a :Cl_ExemptionCondition, owl:NamedIndividual ;
    rdfs:label "Exemption: Unsuccessful Network Activity" ;
    rdfs:comment "The Charge under section 7 will not apply if nbn has undertaken Network Activity activities in respect of the relevant nbn Ethernet Ordered Product and has notified RSP that Network Activity to achieve the CIR Objective was unsuccessful. [extension: nbn Ethernet Price List, Section 7(d)(i), p.19]" ;
    :sourceClause "nbn Ethernet Price List, Section 7(d)(i), p.19" .

:ExemptionCondition_ServiceTransferOrder a :Cl_ExemptionCondition, owl:NamedIndividual ;
    rdfs:label "Exemption: Service Transfer Order with Qualifying CIR Objective" ;
    rdfs:comment "The Charge under section 7 will not apply if the nbn Ethernet Ordered Product is disconnected following acceptance by nbn of a Service Transfer Order and the Other Gaining RSP has ordered an AVC TC-2 Product Component with a bandwidth profile with a CIR Objective that is the same as, or higher than, the CIR Objective applicable to the Losing RSP's AVC TC-2 Product Component. [extension: nbn Ethernet Price List, Section 7(d)(ii), p.19]" ;
    :sourceClause "nbn Ethernet Price List, Section 7(d)(ii), p.19" .

# Labour Rate instances
:LabourRate_Instance a :Cl_LabourRate, owl:NamedIndividual ;
    rdfs:label "Labour Rate $75.00/hour" ;
    rdfs:comment "$75.00 for each of the total number of labour hours required to perform the relevant activity (rounded up to the next full hour). [extension: nbn Ethernet Price List, Section 8(a), p.19]" ;
    :currency "AUD" ;
    :numericValue 75.00 ;
    :roundedUpToNextFullHour true ;
    :sourceClause "nbn Ethernet Price List, Section 8(a), p.19" .

:SatelliteLabourRate_Instance a :Cl_SatelliteLabourRate, owl:NamedIndividual ;
    rdfs:label "Satellite Labour Rate $98.00/hour" ;
    rdfs:comment "$98.00 for each of the total number of labour hours required to perform the relevant activity (rounded up to the next full hour). [extension: nbn Ethernet Price List, Section 8(b), p.19]" ;
    :currency "AUD" ;
    :numericValue 98.00 ;
    :roundedUpToNextFullHour true ;
    :sourceClause "nbn Ethernet Price List, Section 8(b), p.19" .

# CIR Objective instance
:CIRObjective_Instance a :Cl_CIRObjective, owl:NamedIndividual ;
    rdfs:label "CIR Objective" ;
    rdfs:comment "The Committed Information Rate objective applicable to an AVC TC-2 bandwidth profile. [extension: nbn Ethernet Price List, Section 7(d), p.19]" ;
    :sourceClause "nbn Ethernet Price List, Section 7(d), p.19" .

# Service Transfer Order instance
:ServiceTransferOrder_Instance a :Cl_ServiceTransferOrder, owl:NamedIndividual ;
    rdfs:label "Service Transfer Order" ;
    rdfs:comment "A Service Transfer Order accepted by nbn for transfer of service from a Losing RSP to an Other Gaining RSP. [extension: nbn Ethernet Price List, Section 7(d)(ii), p.19]" ;
    :sourceClause "nbn Ethernet Price List, Section 7(d)(ii), p.19" .

# Link the existing EarlyDisconnectionModificationCharge_Instance to the new Charge class
:EarlyDisconnectionModificationCharge_Instance a :Cl_Charge, :Cl_EarlyDisconnectionModificationCharge, owl:NamedIndividual ;
    rdfs:label "Early Disconnection or Modification Charge under Section 7" ;
    rdfs:comment "Charge triggered when an AVC TC-2 Product Component is cancelled, disconnected, or modified within 12 months of order completion, calculated as (Pre - Post) x Shortfall Period. [extension: nbn Ethernet Price List, Section 7, p.19]" ;
    :appliesToOrderedProduct :OrderedProduct_WithAVCTC2 ;
    :currency "AUD" ;
    :hasChargeRule :EarlyDisconnectionModificationCharge_Rule ;
    :hasChargeFormula :ChargeFormula_Section7 ;
    :hasDurationInMonths 12 ;
    :sourceClause "nbn Ethernet Price List, Section 7, p.19" .

# Link the Charge to its exemption conditions
:EarlyDisconnectionModificationCharge_Instance :hasExemptionCondition :ExemptionCondition_UnsuccessfulNetworkActivity, :ExemptionCondition_ServiceTransferOrder .

# Link the Charge to trigger events
:EarlyDisconnectionModificationCharge_Instance :hasTriggerEvent :TriggerEvent_Cancellation, :TriggerEvent_Disconnection, :TriggerEvent_Modification .

# Link the ChargeFormula to its components
:ChargeFormula_Section7 :hasPreDisconnectionModificationCharges :PreDisconnectionModificationCharges_Instance ;
    :hasPostDisconnectionModificationCharges :PostDisconnectionModificationCharges_Instance ;
    :hasShortfallPeriod :ShortfallPeriod_Cancellation .

# Pre Disconnection Modification Charges instance
:PreDisconnectionModificationCharges_Instance a :Cl_PreDisconnectionModificationCharges, owl:NamedIndividual ;
    rdfs:label "Pre Disconnection Modification Charges" ;
    rdfs:comment "The recurring Charges for the TC-2 Bundle Components applicable prior to the trigger event, as set out in section 1.5. [extension: nbn Ethernet Price List, Section 7(c)(i), p.19]" ;
    :currency "AUD" ;
    :sourceClause "nbn Ethernet Price List, Section 7(c)(i), p.19" .

# Post Disconnection Modification Charges instance
:PostDisconnectionModificationCharges_Instance a :Cl_PostDisconnectionModificationCharges, owl:NamedIndividual ;
    rdfs:label "Post Disconnection Modification Charges" ;
    rdfs:comment "The recurring Charges for the TC-2 Bundle Components applicable after the trigger event, or nil in case of cancellation or disconnection, as set out in section 1.5. [extension: nbn Ethernet Price List, Section 7(c)(ii), p.19]" ;
    :currency "AUD" ;
    :sourceClause "nbn Ethernet Price List, Section 7(c)(ii), p.19" .

# Nil Post Disconnection Modification Charges for cancellation
:PostDisconnectionModificationCharges_Nil_Cancellation a :Cl_PostDisconnectionModificationCharges, owl:NamedIndividual ;
    rdfs:label "Post Disconnection Modification Charges (Cancellation) - nil" ;
    rdfs:comment "In the case of a cancellation, Post Disconnection Modification Charges means nil. [extension: nbn Ethernet Price List, Section 7(c)(ii)(A), p.19]" ;
    :currency "AUD" ;
    :numericValue 0.00 ;
    :sourceClause "nbn Ethernet Price List, Section 7(c)(ii)(A), p.19" .

# Nil Post Disconnection Modification Charges for disconnection
:PostDisconnectionModificationCharges_Nil_Disconnection a :Cl_PostDisconnectionModificationCharges, owl:NamedIndividual ;
    rdfs:label "Post Disconnection Modification Charges (Disconnection) - nil" ;
    rdfs:comment "In the case of a disconnection, Post Disconnection Modification Charges means nil. [extension: nbn Ethernet Price List, Section 7(c)(ii)(A), p.19]" ;
    :currency "AUD" ;
    :numericValue 0.00 ;
    :sourceClause "nbn Ethernet Price List, Section 7(c)(ii)(A), p.19" .

# Bandwidth Profile instances for CIR Objectives
:BandwidthProfile_5Mbps a :BandwidthProfile, owl:NamedIndividual ;
    rdfs:label "Bandwidth Profile 5 Mbps (CIR)" ;
    rdfs:comment "AVC TC-2 bandwidth profile with 5 Mbps CIR. [extension: nbn Ethernet Price List, Section 7, p.19]" ;
    :hasBandwidthProfileCIR 5.0 ;
    :sourceClause "nbn Ethernet Price List, Section 7, p.19" .

:BandwidthProfile_10Mbps a :BandwidthProfile, owl:NamedIndividual ;
    rdfs:label "Bandwidth Profile 10 Mbps (CIR)" ;
    rdfs:comment "AVC TC-2 bandwidth profile with 10 Mbps CIR. [extension: nbn Ethernet Price List, Section 7, p.19]" ;
    :hasBandwidthProfileCIR 10.0 ;
    :sourceClause "nbn Ethernet Price List, Section 7, p.19" .

:BandwidthProfile_20Mbps a :BandwidthProfile, owl:NamedIndividual ;
    rdfs:label "Bandwidth Profile 20 Mbps (CIR)" ;
    rdfs:comment "AVC TC-2 bandwidth profile with 20 Mbps CIR. [extension: nbn Ethernet Price List, Section 7, p.19]" ;
    :hasBandwidthProfileCIR 20.0 ;
    :sourceClause "nbn Ethernet Price List, Section 7, p.19" .

# Link the existing AVC_TC2_ProdComp_Instance to its bandwidth profile
:AVC_TC2_ProdComp_Instance :hasBandwidthProfile :BandwidthProfile_10Mbps .

# Link the existing ModifyOrder instances to their bandwidth profiles
:ModifyOrder_10MbpsTo5Mbps :hasBandwidthProfileCIR 5.0 .
:ModifyOrder_20MbpsTo5Mbps :hasBandwidthProfileCIR 5.0 .
:ModifyOrder_10MbpsTo0 :hasBandwidthProfileCIR 0.0 .
:ModifyOrder_20MbpsTo0 :hasBandwidthProfileCIR 0.0 .
:ModifyOrder_5MbpsTo0 :hasBandwidthProfileCIR 0.0 .

# Link the existing NetworkActivity_Instance to the CIR Objective
:NetworkActivity_Instance :hasCIRObjective :CIRObjective_Instance .

# Link the existing OrderedProduct_FTTB_FTTN to the Service Transfer Order
:OrderedProduct_FTTB_FTTN :hasServiceTransferOrder :ServiceTransferOrder_Instance .

# Link the Service Transfer Order to parties
:ServiceTransferOrder_Instance :hasLosingRSP :RSP_Instance ;
    :hasOtherGainingRSP :OtherGainingRSP_Instance .

# Other Gaining RSP instance
:OtherGainingRSP_Instance a :Party, owl:NamedIndividual ;
    rdfs:label "Other Gaining RSP" ;
    rdfs:comment "The RSP that gains service through a Service Transfer Order. [extension: nbn Ethernet Price List, Section 7(d)(ii), p.19]" ;
    :sourceClause "nbn Ethernet Price List, Section 7(d)(ii), p.19" .

# Losing RSP instance (reuse existing RSP_Instance)
:RSP_Instance a :Party, :RSP, owl:NamedIndividual ;
    rdfs:label "Losing RSP" ;
    rdfs:comment "The RSP that loses service through a Service Transfer Order. [extension: nbn Ethernet Price List, Section 7(d)(ii), p.19]" ;
    :sourceClause "nbn Ethernet Price List, Section 7(d)(ii), p.19" .

# nbn as a Party (already exists as Supplier, add Party type)
:nbn a :Party, :Supplier, owl:NamedIndividual .

# Link the Service Transfer Order to the ordered AVC TC-2 by Other Gaining RSP
:ServiceTransferOrder_Instance :hasOrderedAVCTC2 :AVC_TC2_ProdComp_Instance .

# Link the AVC TC-2 ProdComp to its CIR Objective
:AVC_TC2_ProdComp_Instance :hasCIRObjective :CIRObjective_Instance . ---
