:PreDisconnectionModificationCharges_Instance :hasTriggerEvent :TriggerEvent_Cancellation, :TriggerEvent_Disconnection, :TriggerEvent_Modification .

# Post Disconnection Modification Charges linked to trigger events
:PostDisconnectionModificationCharges_Nil_Cancellation :hasTriggerEvent :TriggerEvent_Cancellation .
:PostDisconnectionModificationCharges_Nil_Disconnection :hasTriggerEvent :TriggerEvent_Disconnection .
:PostDisconnectionModificationCharges_Modification :hasTriggerEvent :TriggerEvent_Modification .

# Shortfall Periods linked to trigger events
:ShortfallPeriod_Cancellation :hasTriggerEvent :TriggerEvent_Cancellation .
:ShortfallPeriod_DisconnectionModification :hasTriggerEvent :TriggerEvent_Disconnection, :TriggerEvent_Modification .

# CIR Objective linked to bandwidth profiles
:BandwidthProfile_5Mbps :hasCIRObjective :CIRObjective_Instance .
:BandwidthProfile_10Mbps :hasCIRObjective :CIRObjective_Instance .
:BandwidthProfile_20Mbps :hasCIRObjective :CIRObjective_Instance .

