--- CONTENT: # ===== EXTENSIONS: Section 1.3 TC-4 UNI Inclusion and Section 1.4 TC-1 Charges =====
# New classes for AVC TC-1 and CVC TC-1 Product Components

:AVC_TC1_ProductComponent a owl:Class ;
    rdfs:label "AVC_TC1_ProductComponent" ;
    rdfs:comment "An Access Virtual Circuit with Traffic Class 1, charged per Billing Period based on symmetrical Mbps (CIR) and network type. [extension: nbn Ethernet Price List, Section 1.4, p.6]" ;
    rdfs:subClassOf :AVC,
        :ProductComponent .

:CVC_TC1_ProductComponent a owl:Class ;
    rdfs:label "CVC_TC1_ProductComponent" ;
    rdfs:comment "A Connectivity Virtual Circuit with Traffic Class 1, charged per provisioned symmetrical Mbps (CIR). [extension: nbn Ethernet Price List, Section 1.4(b), p.6]" ;
    rdfs:subClassOf :CVC,
        :ProductComponent .

:CVC_ProductComponent a owl:Class ;
    rdfs:label "CVC_ProductComponent" ;
    rdfs:comment "A Connectivity Virtual Circuit Product Component, made available separately and in different TC-4 capacity increments. [extension: nbn Ethernet Price List, Section 1.2, p.6]" ;
    rdfs:subClassOf :CVC,
        :ProductComponent .

:UNI_Type a owl:Class ;
    rdfs:label "UNI_Type" ;
    rdfs:comment "A type of User Network Interface (UNI-D, UNI-DSL, or UNI-V). [extension: nbn Ethernet Price List, Section 1.3, p.6]" .

:UNI_Inclusion a owl:Class ;
    rdfs:label "UNI_Inclusion" ;
    rdfs:comment "A reified relationship representing that a UNI type is included in the recurring charge for the AVC TC-4 and UNI bundle, conditional on network type. [extension: nbn Ethernet Price List, Section 1.3, p.6]" .

:RebateOrCredit a owl:Class ;
    rdfs:label "RebateOrCredit" ;
    rdfs:comment "A rebate or credit equal to the recurring charge of one symmetrical AVC TC-1 of 0.15Mbps, applied when an RSP orders any symmetrical AVC TC-1 of 0.15Mbps or above. [extension: nbn Ethernet Price List, Section 1.4, p.6]" .

:OrderedProduct a owl:Class ;
    rdfs:label "OrderedProduct" ;
    rdfs:comment "A product ordered by an RSP. [extension: nbn Ethernet Price List, Section 1.4, p.6]" .

:RSP a owl:Class ;
    rdfs:label "RSP" ;
    rdfs:comment "Retail Service Provider role. [extension: nbn Ethernet Price List, Section 1.4, p.6]" .

:BandwidthTier a owl:Class ;
    rdfs:label "BandwidthTier" ;
    rdfs:comment "A symmetrical bandwidth tier in Mbps (CIR) for an AVC TC-1 Product Component. [extension: nbn Ethernet Price List, Section 1.4, p.6]" .

# New object properties

:hasBandwidthTier a owl:ObjectProperty ;
    rdfs:label "hasBandwidthTier" ;
    rdfs:comment "Links an AVC TC-1 Product Component to its symmetrical bandwidth tier (CIR). [extension: nbn Ethernet Price List, Section 1.4, p.6]" ;
    rdfs:domain :AVC_TC1_ProductComponent ;
    rdfs:range :BandwidthTier .

:hasNetworkType a owl:ObjectProperty ;
    rdfs:label "hasNetworkType" ;
    rdfs:comment "Links a Product Component to its Access Technology / network type. [extension: nbn Ethernet Price List, Section 1.4, p.6]" ;
    rdfs:domain :ProductComponent ;
    rdfs:range :AccessTechnology .

:hasRecurringChargePerMbps a owl:ObjectProperty ;
    rdfs:label "hasRecurringChargePerMbps" ;
    rdfs:comment "Links a CVC TC-1 Product Component to its recurring charge per provisioned symmetrical Mbps (CIR). [extension: nbn Ethernet Price List, Section 1.4(b), p.6]" ;
    rdfs:domain :CVC_TC1_ProductComponent ;
    rdfs:range :RecurringCharge .

:hasUNI a owl:ObjectProperty ;
    rdfs:label "hasUNI" ;
    rdfs:comment "Links a UNI Inclusion to the type of UNI included. [extension: nbn Ethernet Price List, Section 1.3, p.6]" ;
    rdfs:domain :UNI_Inclusion ;
    rdfs:range :UNI_Type .

:includedIn a owl:ObjectProperty ;
    rdfs:label "includedIn" ;
    rdfs:comment "Links a UNI Inclusion to the Recurring Charge it is included in. [extension: nbn Ethernet Price List, Section 1.3, p.6]" ;
    rdfs:domain :UNI_Inclusion ;
    rdfs:range :RecurringCharge .

:conditionalOn a owl:ObjectProperty ;
    rdfs:label "conditionalOn" ;
    rdfs:comment "Links a UNI Inclusion to the Access Technology it is conditional on. [extension: nbn Ethernet Price List, Section 1.3, p.6]" ;
    rdfs:domain :UNI_Inclusion ;
    rdfs:range :AccessTechnology .

:providesRebateOrCredit a owl:ObjectProperty ;
    rdfs:label "providesRebateOrCredit" ;
    rdfs:comment "Links an Ordered Product to the Rebate or Credit that applies. [extension: nbn Ethernet Price List, Section 1.4, p.6]" ;
    rdfs:domain :OrderedProduct ;
