:ChargeFormula_Section7_Cancellation a :Cl_ChargeFormula, owl:NamedIndividual ;
    rdfs:label "Charge Formula under Section 7(c) for Cancellation" ;
    rdfs:comment "Charge = (Pre Disconnection Modification Charges - Post Disconnection Modification Charges) x Shortfall Period (12 months). [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    :hasPreDisconnectionModificationCharges :PreDisconnectionModificationCharges_Instance ;
    :hasPostDisconnectionModificationCharges :PostDisconnectionModificationCharges_Nil_Cancellation ;
    :hasShortfallPeriod :ShortfallPeriod_Cancellation ;
    :sourceClause "nbn Ethernet Price List, Section 7(c), p.19" .

# Post Disconnection Modification Charges for modification (the recurring Charges after modification)
:PostDisconnectionModificationCharges_Modification a :Cl_PostDisconnectionModificationCharges, owl:NamedIndividual ;
    rdfs:label "Post Disconnection Modification Charges (Modification)" ;
    rdfs:comment "In the case of a modification, the recurring Charges for the TC-2 Bundle Components applicable after the modification of the AVC TC-2 bandwidth profile, as set out in section 1.5. [extension: nbn Ethernet Price List, Section 7(c)(ii)(B), p.19]" ;
    :currency "AUD" ;
    :sourceClause "nbn Ethernet Price List, Section 7(c)(ii)(B), p.19" .

# Link the ChargeFormula for modification
:ChargeFormula_Section7_Modification a :Cl_ChargeFormula, owl:NamedIndividual ;
    rdfs:label "Charge Formula under Section 7(c) for Modification" ;
    rdfs:comment "Charge = (Pre Disconnection Modification Charges - Post Disconnection Modification Charges) x Shortfall Period (pro rata daily basis). [extension: nbn Ethernet Price List, Section 7(c), p.19]" ;
    :hasPreDisconnectionModificationCharges :PreDisconnectionModificationCharges_Instance ;
    :hasPostDisconnectionModificationCharges :PostDisconnectionModificationCharges_Modification ;
    :hasShortfallPeriod :ShortfallPeriod_DisconnectionModification ;
    :sourceClause "nbn Ethernet Price List, Section 7(c), p.19" .

