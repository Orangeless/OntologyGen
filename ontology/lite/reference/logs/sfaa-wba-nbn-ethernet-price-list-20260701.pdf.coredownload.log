--- CONTENT: # ===== EXTENSIONS: AVC TC-4 Product Components and Recurring Charges (Price List, Section 1) =====

# --- New Access Technology individuals ---
:AccessTechnology_FTTB a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTB" ;
    rdfs:comment "Fibre to the Building access technology. [extension: nbn Ethernet Price List, Section 1.1]" .

:AccessTechnology_FTTN a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTN" ;
    rdfs:comment "Fibre to the Node access technology. [extension: nbn Ethernet Price List, Section 1.1]" .

:AccessTechnology_Wireless a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "Wireless" ;
    rdfs:comment "Fixed Wireless access technology. [extension: nbn Ethernet Price List, Section 1.1]" .

# --- New Classes ---

:AVC_TC4_ProductComponent a owl:Class ;
    rdfs:label "AVC_TC4_ProductComponent" ;
    rdfs:comment "A specific type of Product Component that is an AVC with Traffic Class 4, which can be ordered and charged separately. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:subClassOf :AVC, :ProductComponent .

:RecurringCharge a owl:Class ;
    rdfs:label "RecurringCharge" ;
    rdfs:comment "A monetary amount that recurs per Billing Period for a Product Component. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:subClassOf :CostItem .

:FlatRateAVCCharge a owl:Class ;
    rdfs:label "FlatRateAVCCharge" ;
    rdfs:comment "A specific type of Recurring Charge that applies per Billing Period for AVC TC-4 Product Components and associated CVC TC-4 capacity. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:subClassOf :RecurringCharge .

:BillingPeriod a owl:Class ;
    rdfs:label "BillingPeriod" ;
    rdfs:comment "A period of time for which a recurring charge is billed. [extension: nbn Ethernet Price List, Section 1.1]" .

:ProductFeatures a owl:Class ;
    rdfs:label "ProductFeatures" ;
    rdfs:comment "The set of features selected by an RSP for a Product Component (e.g. bandwidth profile, access technology). [extension: nbn Ethernet Price List, Section 1]" .

:ProductComponentName a owl:Class ;
    rdfs:label "ProductComponentName" ;
    rdfs:comment "A named variant of a Product Component (e.g. 'Wireless Plus', 'Home Fast'). [extension: nbn Ethernet Price List, Section 1.1]" .

:DownstreamPIR a owl:Class ;
    rdfs:label "DownstreamPIR" ;
    rdfs:comment "The downstream Peak Information Rate (Mbps) for an AVC TC-4 Product Component. [extension: nbn Ethernet Price List, Section 1.1]" .

:UpstreamPIR a owl:Class ;
    rdfs:label "UpstreamPIR" ;
    rdfs:comment "The upstream Peak Information Rate (Mbps) for an AVC TC-4 Product Component. [extension: nbn Ethernet Price List, Section 1.1]" .

:MonetaryAmount a owl:Class ;
    rdfs:label "MonetaryAmount" ;
    rdfs:comment "A monetary value with a currency and numeric amount. [extension: nbn Ethernet Price List, Section 1.1]" .

# --- New Object Properties ---

:hasRecurringCharge a owl:ObjectProperty ;
    rdfs:label "hasRecurringCharge" ;
    rdfs:comment "Links a Product Component to its Recurring Charge. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:domain :AVC_TC4_ProductComponent ;
    rdfs:range :RecurringCharge .

:hasDownstreamPIR a owl:ObjectProperty ;
    rdfs:label "hasDownstreamPIR" ;
    rdfs:comment "Links an AVC TC-4 Product Component to its Downstream PIR. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:domain :AVC_TC4_ProductComponent ;
    rdfs:range :DownstreamPIR .

:hasUpstreamPIR a owl:ObjectProperty ;
    rdfs:label "hasUpstreamPIR" ;
    rdfs:comment "Links an AVC TC-4 Product Component to its Upstream PIR. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:domain :AVC_TC4_ProductComponent ;
    rdfs:range :UpstreamPIR .

:hasAccessTechnology a owl:ObjectProperty ;
    rdfs:label "hasAccessTechnology" ;
    rdfs:comment "Links an AVC TC-4 Product Component to its Access Technology. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:domain :AVC_TC4_ProductComponent ;
    rdfs:range :AccessTechnology .

:hasProductFeatures a owl:ObjectProperty ;
    rdfs:label "hasProductFeatures" ;
    rdfs:comment "Links a Recurring Charge to the Product Features it depends on. [extension: nbn Ethernet Price List, Section 1]" ;
    rdfs:domain :RecurringCharge ;
    rdfs:range :ProductFeatures .

:hasName a owl:ObjectProperty ;
    rdfs:label "hasName" ;
    rdfs:comment "Links an AVC TC-4 Product Component to its Product Component Name. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:domain :AVC_TC4_ProductComponent ;
    rdfs:range :ProductComponentName .

:hasAmount a owl:ObjectProperty ;
    rdfs:label "hasAmount" ;
    rdfs:comment "Links a Recurring Charge to its Monetary Amount. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:domain :RecurringCharge ;
    rdfs:range :MonetaryAmount .

:hasBillingPeriod a owl:ObjectProperty ;
    rdfs:label "hasBillingPeriod" ;
    rdfs:comment "Links a Recurring Charge to its Billing Period. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:domain :RecurringCharge ;
    rdfs:range :BillingPeriod .

:appliesTo a owl:ObjectProperty ;
    rdfs:label "appliesTo" ;
    rdfs:comment "Links a FlatRateAVCCharge to the AVC TC-4 Product Component or CVC TC-4 capacity it applies to. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:domain :FlatRateAVCCharge ;
    rdfs:range :AVC_TC4_ProductComponent .

:dependsOn a owl:ObjectProperty ;
    rdfs:label "dependsOn" ;
    rdfs:comment "Links a Recurring Charge to the Product Features that determine its value. [extension: nbn Ethernet Price List, Section 1]" ;
    rdfs:domain :RecurringCharge ;
    rdfs:range :ProductFeatures .

:hasDownstreamRange a owl:ObjectProperty ;
    rdfs:label "hasDownstreamRange" ;
    rdfs:comment "Links a ProductFeatures to a DownstreamPIR that defines a range. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:domain :ProductFeatures ;
    rdfs:range :DownstreamPIR .

:hasUpstreamRange a owl:ObjectProperty ;
    rdfs:label "hasUpstreamRange" ;
    rdfs:comment "Links a ProductFeatures to an UpstreamPIR that defines a range. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:domain :ProductFeatures ;
    rdfs:range :UpstreamPIR .

# --- New Datatype Properties ---

:numericValue a owl:DatatypeProperty ;
    rdfs:label "numericValue" ;
    rdfs:comment "The numeric value of a quantity (e.g. PIR in Mbps, monetary amount). [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:domain :DownstreamPIR, :UpstreamPIR, :MonetaryAmount ;
    rdfs:range xsd:decimal .

:unitOfMeasure a owl:DatatypeProperty ;
    rdfs:label "unitOfMeasure" ;
