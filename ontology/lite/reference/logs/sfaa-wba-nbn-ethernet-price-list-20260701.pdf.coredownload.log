# ===== BASIC OFFER CONDITIONS (Note 4, Section 1.1) =====

# --- Classes for Basic Offer ---
:BasicOfferCondition a owl:Class ;
    rdfs:label "BasicOfferCondition" ;
    rdfs:comment "A condition that, when satisfied, triggers the Basic Offer charge for a 12/1 Mbps AVC TC-4 on a given day. [extension: nbn Ethernet Price List, Note 4, p.5]" .

:Day a owl:Class ;
    rdfs:label "Day" ;
    rdfs:comment "A calendar day defined as the period from 12:00am to 11:59pm based on local time in Sydney. [extension: nbn Ethernet Price List, Note 4, p.5]" .

:UsageCondition a owl:Class ;
    rdfs:label "UsageCondition" ;
    rdfs:comment "A condition related to the usage or capacity utilisation of an AVC. [extension: nbn Ethernet Price List, Note 4, p.5]" .

# --- Object Properties for Basic Offer ---
:hasBasicOfferCondition a owl:ObjectProperty ;
    rdfs:label "hasBasicOfferCondition" ;
    rdfs:comment "Links an AVC TC-4 Product Component to its Basic Offer Condition. [extension: nbn Ethernet Price List, Note 4, p.5]" ;
    rdfs:domain :AVC_TC4_ProductComponent ;
    rdfs:range :BasicOfferCondition .

:hasDayDefinition a owl:ObjectProperty ;
    rdfs:label "hasDayDefinition" ;
    rdfs:comment "Links a Basic Offer Condition to the Day definition it uses. [extension: nbn Ethernet Price List, Note 4, p.5]" ;
    rdfs:domain :BasicOfferCondition ;
    rdfs:range :Day .

:hasConditionTrigger a owl:ObjectProperty ;
    rdfs:label "hasConditionTrigger" ;
    rdfs:comment "Links a Basic Offer Condition to the Usage Condition that triggers it. [extension: nbn Ethernet Price List, Note 4, p.5]" ;
    rdfs:domain :BasicOfferCondition ;
    rdfs:range :UsageCondition .

# --- Datatype Properties for conditions ---
:conditionDescription a owl:DatatypeProperty ;
    rdfs:label "conditionDescription" ;
    rdfs:comment "A textual description of a condition. [extension: nbn Ethernet Price List, Note 4, p.5]" ;
    rdfs:domain :UsageCondition, :BasicOfferCondition, :Day ;
    rdfs:range xsd:string .

:averageUtilisationThresholdMbps a owl:DatatypeProperty ;
    rdfs:label "averageUtilisationThresholdMbps" ;
    rdfs:comment "The average utilisation threshold in Mbps for a usage condition. [extension: nbn Ethernet Price List, Note 4, p.5]" ;
    rdfs:domain :UsageCondition ;
    rdfs:range xsd:decimal .

:monitoringPeriodMinutes a owl:DatatypeProperty ;
    rdfs:label "monitoringPeriodMinutes" ;
    rdfs:comment "The monitoring period in minutes for a usage condition. [extension: nbn Ethernet Price List, Note 4, p.5]" ;
    rdfs:domain :UsageCondition ;
    rdfs:range xsd:integer .

# --- Individuals for Basic Offer ---
:Day_Sydney a :Day,
        owl:NamedIndividual ;
    rdfs:label "Day (Sydney local time)" ;
    :conditionDescription "The period from 12:00am to 11:59pm based on the local time in Sydney." ;
    :sourceClause "nbn Ethernet Price List, Note 4, p.5" .

:UsageCondition_VoiceBroadband a :UsageCondition,
        owl:NamedIndividual ;
    rdfs:label "Usage Condition: Voice Broadband" ;
    :conditionDescription "RSP uses that AVC TC-4 as an input into an RSP Product or Downstream Product which is a broadband service which includes a voice component." ;
    :sourceClause "nbn Ethernet Price List, Note 4, p.5" .

:UsageCondition_LowUtilisation a :UsageCondition,
        owl:NamedIndividual ;
    rdfs:label "Usage Condition: Low Utilisation" ;
    :conditionDescription "That AVC does not utilise, on average, more than 0.1 Mbps of capacity during any 60-minute period on that day." ;
    :averageUtilisationThresholdMbps 0.1 ;
    :monitoringPeriodMinutes 60 ;
    :sourceClause "nbn Ethernet Price List, Note 4, p.5" .

:BasicOfferCondition_12_1 a :BasicOfferCondition,
        owl:NamedIndividual ;
    rdfs:label "Basic Offer Condition for 12/1 AVC TC-4" ;
    :conditionDescription "Basic Offer applies if RSP uses the AVC TC-4 as input into a broadband service with voice component, and the AVC does not utilise more than 0.1 Mbps average during any 60-minute period on that day." ;
    :hasDayDefinition :Day_Sydney ;
    :hasConditionTrigger :UsageCondition_VoiceBroadband ;
    :hasConditionTrigger :UsageCondition_LowUtilisation ;
    :appliesTo :AVC_TC4_ProdComp_12_1_Basic ;
    :sourceClause "nbn Ethernet Price List, Note 4, p.5" .

# --- Pro-rata rule for Basic Offer ---
:ProRataRule a owl:Class ;
    rdfs:label "ProRataRule" ;
    rdfs:comment "A rule that calculates charges on a pro-rata basis when conditions are met for some days of a Billing Period but not others. [extension: nbn Ethernet Price List, Note 4, p.5]" .

:hasProRataRule a owl:ObjectProperty ;
    rdfs:label "hasProRataRule" ;
    rdfs:comment "Links a Basic Offer Condition to its Pro-Rata Rule. [extension: nbn Ethernet Price List, Note 4, p.5]" ;
    rdfs:domain :BasicOfferCondition ;
    rdfs:range :ProRataRule .

:ProRataRule_12_1 a :ProRataRule,
        owl:NamedIndividual ;
    rdfs:label "Pro-Rata Rule for 12/1 Basic Offer" ;
    :conditionDescription "If an AVC TC-4 satisfies the conditions of the Basic Offer for certain days during a Billing Period but not others, the two different Charges will be calculated and applied on a pro-rata basis." ;
    :sourceClause "nbn Ethernet Price List, Note 4, p.5" .

:BasicOfferCondition_12_1 :hasProRataRule :ProRataRule_12_1 .

