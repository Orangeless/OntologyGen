    rdfs:label "Ordered Product that includes an AVC TC-2 Product Component" ;
    rdfs:comment "An Ordered Product that also includes an AVC TC-2 Product Component at the time that the eSLA Change Event occurs, which exempts the Enhanced Fault Rectification Service from section 2.2(b). [extension: nbn Ethernet Price List, Section 2.2(d), p.10]" ;
    :sourceClause "nbn Ethernet Price List, Section 2.2(d), p.10" .

:EnhancedFaultRectification_Enhanced4_24_7 :isSuppliedAsPartOf :OrderedProduct_WithAVCTC2 ;
    :sourceClause "nbn Ethernet Price List, Section 2.2(d), p.10" .

