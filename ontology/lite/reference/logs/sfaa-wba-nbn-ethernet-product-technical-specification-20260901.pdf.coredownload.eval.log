Evaluating CQ 44/67: "What is the unit of the bandwidth profile (TC-1) that is available on UNI-D for Fibre, HFC, FTTC, and FTTB/FTTN but not available on Wireless and Satellite?"
============================================================
--- Starting evaluation for CQ 44 ---
--- 📝 QueryGenerator Agent: Generating SPARQL... ---
--- ROUTER: Generated SPARQL query.
Generated Query: PREFIX : <http://www.example.org/test#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?unit
WHERE {
  ?avail a :AVCFeatureAvailability ;
        :hasTrafficClass :TC_1 ;
        :hasBandwidthProfile ?bwProfile ;
        :hasAvailabilityState ?state .
  ?bwProfile :hasBandwidthUnit ?unit .
  
  # Available on Fibre, HFC, FTTC, FTTB/FTTN
  {
    ?avail :availableOnAccessTechnology :AccessTechnology_FIBRE .
  } UNION {
    ?avail :availableOnAccessTechnology :AccessTechnology_HFC .
  } UNION {
    ?avail :availableOnAccessTechnology :AccessTechnology_FTTC .
  } UNION {
    ?avail :availableOnAccessTechnology :AccessTechnology_FTTB .
  }
  
  # Not available on Wireless and Satellite
  FILTER NOT EXISTS {
    ?avail :availableOnAccessTechnology :AccessTechnology_Wireless .
  }
  FILTER NOT EXISTS {
    ?avail :availableOnAccessTechnology :AccessTechnology_Satellite .
  }
  
  # Available on UNI-D
  ?avail :availableOnUNI :UNI_D_Instance .
  
  # Only consider Available status
  FILTER(?state = "Available"^^xsd:string)
}

