--- CONTENT: # ===== EXTENSIONS FOR SECTIONS 3.5-3.8 (Page 14-15) =====

# --- New Classes ---

:Cl_InterferenceEvent a owl:Class ;
    rdfs:label "Cl_InterferenceEvent" ;
    rdfs:comment "An event caused by a third party's equipment or network that prejudices the integrity or causes deterioration of an nbn Ethernet (FTTB/FTTN/FTTC) Ordered Product. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" ;
    rdfs:subClassOf :Cl_ContractualEvent .

:Cl_OrderedProduct a owl:Class ;
    rdfs:label "Cl_OrderedProduct" ;
    rdfs:comment "An nbn Ethernet Ordered Product (FTTB, FTTN, FTTC) that can be affected by interference events. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" ;
    rdfs:subClassOf :AVC .

:Cl_ThirdPartyEquipmentOrNetwork a owl:Class ;
    rdfs:label "Cl_ThirdPartyEquipmentOrNetwork" ;
    rdfs:comment "Equipment or network of a third party that may cause an Interference Event. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" .

:Cl_Beam a owl:Class ;
    rdfs:label "Cl_Beam" ;
    rdfs:comment "Satellite capacity resource (beam) that may be at or near maximum capacity. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" .

:Cl_WirelessPlus a owl:Class ;
    rdfs:label "Cl_WirelessPlus" ;
    rdfs:comment "Wireless Plus product variant for which no PIR or CIR applies. [extension: nbn Ethernet Product Module, Section 3.8(a), p.15]" ;
    rdfs:subClassOf :nbnEthernetProduct .

:Cl_AVCOrder a owl:Class ;
    rdfs:label "Cl_AVCOrder" ;
    rdfs:comment "An event representing an AVC order placed by RSP. [extension: nbn Ethernet Product Module, Section 3.7(a), p.15]" ;
    rdfs:subClassOf :Cl_ContractualEvent .

:Cl_AVCModification a owl:Class ;
    rdfs:label "Cl_AVCModification" ;
    rdfs:comment "An event representing a modification to an AVC. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" ;
    rdfs:subClassOf :Cl_ContractualEvent .

:Cl_PublicInterestPremises a owl:Class ;
    rdfs:label "Cl_PublicInterestPremises" ;
    rdfs:comment "A Premises designated as a Public Interest Premises for which nbn may waive RSP obligations under section 39 of the nbn Ethernet Product Terms. [extension: nbn Ethernet Product Module, Section 3.7 Note, p.15]" ;
    rdfs:subClassOf :Premises .

# --- New Object Properties ---

:causedBy a owl:ObjectProperty ;
    rdfs:label "causedBy" ;
    rdfs:comment "Links an Interference Event to the third party equipment or network that caused it. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" ;
    rdfs:domain :Cl_InterferenceEvent ;
    rdfs:range :Cl_ThirdPartyEquipmentOrNetwork .

:affectsProduct a owl:ObjectProperty ;
    rdfs:label "affectsProduct" ;
    rdfs:comment "Links an Interference Event to the Ordered Product it affects. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" ;
    rdfs:domain :Cl_InterferenceEvent ;
    rdfs:range :Cl_OrderedProduct .

:triggers a owl:ObjectProperty ;
    rdfs:label "triggers" ;
    rdfs:comment "Links an Interference Event to the Interference Mitigation it triggers. [extension: nbn Ethernet Product Module, Section 3.6(b), p.15]" ;
    rdfs:domain :Cl_InterferenceEvent ;
    rdfs:range :InterferenceMitigation .

:isResponseTo a owl:ObjectProperty ;
    rdfs:label "isResponseTo" ;
    rdfs:comment "Links an Interference Mitigation to the Interference Event it responds to. [extension: nbn Ethernet Product Module, Section 3.6(b), p.15]" ;
    rdfs:domain :InterferenceMitigation ;
    rdfs:range :Cl_InterferenceEvent .

:isPerformedBy a owl:ObjectProperty ;
    rdfs:label "isPerformedBy" ;
    rdfs:comment "Links an Interference Mitigation to the agent that performs it. [extension: nbn Ethernet Product Module, Section 3.6(b), p.15]" ;
    rdfs:domain :InterferenceMitigation ;
    rdfs:range :Cl_Agent .

:resultsInState a owl:DatatypeProperty ;
    rdfs:label "resultsInState" ;
    rdfs:comment "The resulting state of an Ordered Product after an event. [extension: nbn Ethernet Product Module, Section 3.6(c), p.15]" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range xsd:string .

:hasProductState a owl:DatatypeProperty ;
    rdfs:label "hasProductState" ;
    rdfs:comment "The operational state of an Ordered Product. [extension: nbn Ethernet Product Module, Section 3.6(c), p.15]" ;
    rdfs:domain :Cl_OrderedProduct ;
    rdfs:range xsd:string .

:isAffectedBy a owl:ObjectProperty ;
    rdfs:label "isAffectedBy" ;
    rdfs:comment "Links an Ordered Product to the Interference Event that affects it. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" ;
    rdfs:domain :Cl_OrderedProduct ;
    rdfs:range :Cl_InterferenceEvent .

:requiresAdditionalBeamCapacity a owl:DatatypeProperty ;
    rdfs:label "requiresAdditionalBeamCapacity" ;
    rdfs:comment "Indicates if an AVC order or modification would require additional Beam capacity. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" ;
    rdfs:domain :Cl_AVCOrder ;
    rdfs:range xsd:boolean .

:isAtOrNearMaxCapacity a owl:DatatypeProperty ;
    rdfs:label "isAtOrNearMaxCapacity" ;
    rdfs:comment "Indicates if a Beam is at or near maximum capacity. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" ;
    rdfs:domain :Cl_Beam ;
    rdfs:range xsd:boolean .

:hasBeam a owl:ObjectProperty ;
    rdfs:label "hasBeam" ;
    rdfs:comment "Links an AVC order or modification to the Beam it would require capacity from. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range :Cl_Beam .

:deprioritisesDataTransfers a owl:DatatypeProperty ;
    rdfs:label "deprioritisesDataTransfers" ;
    rdfs:comment "Indicates if nbn may deprioritise data transfers for an AVC contributing disproportionately to Beam capacity utilisation. [extension: nbn Ethernet Product Module, Section 3.7(d), p.15]" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range xsd:boolean .

:reducesMaxDataTransferRate a owl:DatatypeProperty ;
    rdfs:label "reducesMaxDataTransferRate" ;
    rdfs:comment "Indicates if nbn may reduce the maximum data transfer rate of an AVC contributing disproportionately to Beam capacity utilisation. [extension: nbn Ethernet Product Module, Section 3.7(d), p.15]" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range xsd:boolean .

:contributesDisproportionately a owl:DatatypeProperty ;
    rdfs:label "contributesDisproportionately" ;
    rdfs:comment "Indicates if an AVC contributes disproportionately to Beam capacity utilisation. [extension: nbn Ethernet Product Module, Section 3.7(d), p.15]" ;
    rdfs:domain :AVC ;
    rdfs:range xsd:boolean .

:hasPIR a owl:DatatypeProperty ;
    rdfs:label "hasPIR" ;
    rdfs:comment "Indicates if a Peak Information Rate applies. [extension: nbn Ethernet Product Module, Section 3.8(a), p.15]" ;
    rdfs:domain :Cl_WirelessPlus ;
    rdfs:range xsd:boolean .

:hasCIR a owl:DatatypeProperty ;
    rdfs:label "hasCIR" ;
    rdfs:comment "Indicates if a Committed Information Rate applies. [extension: nbn Ethernet Product Module, Section 3.8(a), p.15]" ;
    rdfs:domain :Cl_WirelessPlus ;
    rdfs:range xsd:boolean .

:mayDecline a owl:ObjectProperty ;
    rdfs:label "mayDecline" ;
    rdfs:comment "Links nbn to an AVC order or modification that nbn may decline. [extension: nbn Ethernet Product Module, Section 3.7(a), p.15]" ;
    rdfs:domain :Cl_Agent ;
    rdfs:range :Cl_ContractualEvent .

:resultsInMoreThanOneAVCTC4AndOneAVCTC1 a owl:DatatypeProperty ;
    rdfs:label "resultsInMoreThanOneAVCTC4AndOneAVCTC1" ;
    rdfs:comment "Indicates if an AVC order would result in nbn supplying more than one AVC TC-4 and one associated AVC TC-1 to all retail service providers in respect of a Premises. [extension: nbn Ethernet Product Module, Section 3.7(a), p.15]" ;
    rdfs:domain :Cl_AVCOrder ;
    rdfs:range xsd:boolean .

:isUsedForBonding a owl:DatatypeProperty ;
    rdfs:label "isUsedForBonding" ;
    rdfs:comment "Indicates if an RSP Product is being used in connection with the bonding of two or more UNIs. [extension: nbn Ethernet Product Module, Section 3.7(b), p.15]" ;
    rdfs:domain :AVC ;
    rdfs:range xsd:boolean .

:mustSuspendOrTerminate a owl:ObjectProperty ;
    rdfs:label "mustSuspendOrTerminate" ;
    rdfs:comment "Links RSP to an RSP Product that RSP must suspend or terminate. [extension: nbn Ethernet Product Module, Section 3.7(b), p.15]" ;
    rdfs:domain :RSP ;
    rdfs:range :AVC .

:waivedByNbn a owl:DatatypeProperty ;
    rdfs:label "waivedByNbn" ;
    rdfs:comment "Indicates if nbn has waived RSP's obligations in respect of a Public Interest Premises under section 39. [extension: nbn Ethernet Product Module, Section 3.7 Note, p.15]" ;
    rdfs:domain :Cl_PublicInterestPremises ;
    rdfs:range xsd:boolean .

# --- New Data Properties ---

:mitigationTimeframe a owl:DatatypeProperty ;
    rdfs:label "mitigationTimeframe" ;
    rdfs:comment "The timeframe within which nbn must undertake Interference Mitigation. [extension: nbn Ethernet Product Module, Section 3.6(b), p.15]" ;
    rdfs:domain :InterferenceMitigation ;
    rdfs:range xsd:string .

:lineRateNotCapable a owl:DatatypeProperty ;
    rdfs:label "lineRateNotCapable" ;
    rdfs:comment "Indicates if the Line Rate of an nbn Ethernet Ordered Product is not capable of supporting the provision of all AVC TC-1 and AVC TC-2 bandwidth profiles ordered by RSP. [extension: nbn Ethernet Product Module, Section 3.5, p.15]" ;
    rdfs:domain :Cl_OrderedProduct ;
    rdfs:range xsd:boolean .

# --- Individuals / Facts ---

# Section 3.5 - CIR limitation when Line Rate insufficient
:Rule_CIRLineRateInsufficient a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "CIR Line Rate Insufficient Rule" ;
    :hasCondition "the Line Rate of an nbn Ethernet Ordered Product is not capable of supporting the provision of all AVC TC-1 and AVC TC-2 bandwidth profiles ordered by RSP in respect of that Ordered Product (including as set out in sections 3.2.2 and 3.3.2 of the nbn Ethernet Product Technical Specification)" ;
    :hasConsequence "for both AVC TC-1 and AVC TC-2: (a) the Information Rate experienced by RSP, Downstream Service Provider and End Users may each be significantly less than the downstream CIR and upstream CIR of the bandwidth profile ordered by RSP; and (b) the Frame Delay, Frame Delay Variation and Frame Loss of the relevant Ordered Product may each be significantly worse than the Traffic Class performance specified in section 7.1 of the nbn Ethernet Product Technical Specification" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.5, p.15" .

# Section 3.6(a) - Interference Event concept
:Event_InterferenceEvent_FTTB a :Cl_InterferenceEvent, owl:NamedIndividual ;
    rdfs:label "Interference Event - FTTB" ;
    :eventType "Interference Event caused by the equipment or network of a third party prejudicing the integrity or causing deterioration of an nbn Ethernet (FTTB) Ordered Product" ;
    :causedBy :ThirdPartyEquipmentOrNetwork_Generic ;
    :affectsProduct :OrderedProduct_FTTB_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(a), p.15" .

:Event_InterferenceEvent_FTTN a :Cl_InterferenceEvent, owl:NamedIndividual ;
    rdfs:label "Interference Event - FTTN" ;
    :eventType "Interference Event caused by the equipment or network of a third party prejudicing the integrity or causing deterioration of an nbn Ethernet (FTTN) Ordered Product" ;
    :causedBy :ThirdPartyEquipmentOrNetwork_Generic ;
    :affectsProduct :OrderedProduct_FTTN_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(a), p.15" .

:Event_InterferenceEvent_FTTC a :Cl_InterferenceEvent, owl:NamedIndividual ;
    rdfs:label "Interference Event - FTTC" ;
    :eventType "Interference Event caused by the equipment or network of a third party prejudicing the integrity or causing deterioration of an nbn Ethernet (FTTC) Ordered Product" ;
    :causedBy :ThirdPartyEquipmentOrNetwork_Generic ;
    :affectsProduct :OrderedProduct_FTTC_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(a), p.15" .

:ThirdPartyEquipmentOrNetwork_Generic a :Cl_ThirdPartyEquipmentOrNetwork, owl:NamedIndividual ;
    rdfs:label "Third Party Equipment or Network" ;
    rdfs:comment "Generic representation of equipment or network of a third party that may cause an Interference Event. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" .

:OrderedProduct_FTTB_Instance a :Cl_OrderedProduct, owl:NamedIndividual ;
    rdfs:label "nbn Ethernet (FTTB) Ordered Product" ;
    :hasProductState "operating normally" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(a), p.15" .

:OrderedProduct_FTTN_Instance a :Cl_OrderedProduct, owl:NamedIndividual ;
    rdfs:label "nbn Ethernet (FTTN) Ordered Product" ;
    :hasProductState "operating normally" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(a), p.15" .

:OrderedProduct_FTTC_Instance a :Cl_OrderedProduct, owl:NamedIndividual ;
    rdfs:label "nbn Ethernet (FTTC) Ordered Product" ;
    :hasProductState "operating normally" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(a), p.15" .

# Section 3.6(b) - Interference Mitigation obligation
:Event_InterferenceMitigation_Response a :InterferenceMitigation, owl:NamedIndividual ;
    rdfs:label "Interference Mitigation in response to Third Party Interference" ;
    :eventType "Interference Mitigation undertaken by nbn as soon as reasonably practicable in the circumstances" ;
    :isResponseTo :Event_InterferenceEvent_FTTB ;
    :isPerformedBy :nbn ;
    :mitigationTimeframe "as soon as reasonably practicable in the circumstances" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(b), p.15" .

# Section 3.6(c) - Affected Ordered Product state
:Event_InterferenceEvent_AffectsState a :Cl_InterferenceEvent, owl:NamedIndividual ;
    rdfs:label "Interference Event - Affected State" ;
    :eventType "Interference Event causing affected Ordered Product to not operate in accordance with the nbn Ethernet Product Description or the nbn Ethernet Product Technical Specification" ;
    :resultsInState "may not operate in accordance with this nbn Ethernet Product Description or the nbn Ethernet Product Technical Specification" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(c), p.15" .

# Section 3.7(a) - Satellite AVC order limit
:Rule_SatelliteAVCOrderLimit a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Satellite AVC Order Limit Rule" ;
    :hasCondition "RSP places an AVC order in respect of a Premises for nbn Ethernet (Satellite)" ;
    :hasConsequence "RSP must not place, and nbn may decline, an AVC order if the supply of the ordered AVC would result in nbn supplying more than one AVC TC-4 and one associated AVC TC-1 to all nbn's retail service providers in respect of that Premises" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(a), p.15" .

:Event_AVCOrder_Satellite_Declined a :Cl_AVCOrder, owl:NamedIndividual ;
    rdfs:label "AVC Order Declined - Satellite" ;
    :eventType "AVC order that would result in more than one AVC TC-4 and one associated AVC TC-1 per Premises" ;
    :resultsInMoreThanOneAVCTC4AndOneAVCTC1 true ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(a), p.15" .

# Section 3.7(b) - UNI bonding prohibition
:Rule_UNIBondingProhibition a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI Bonding Prohibition Rule" ;
    :hasCondition "RSP becomes aware that an RSP Product is being used by a Downstream Service Provider or End User in connection with the bonding of two or more UNIs (even if nbn is only supplying one of the UNIs to RSP and the other UNI(s) to an Other RSP)" ;
    :hasConsequence "RSP must suspend or terminate that RSP Product" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(b), p.15" .

# Section 3.7(c) - Beam capacity decline
:Rule_BeamCapacityDecline a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Beam Capacity Decline Rule" ;
    :hasCondition "an AVC order or AVC modification would require additional Beam capacity to be supplied during any period in which a Beam is at or near maximum capacity" ;
    :hasConsequence "nbn may decline that AVC order or AVC modification" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(c), p.15" .

:Beam_GenericInstance a :Cl_Beam, owl:NamedIndividual ;
    rdfs:label "Generic Satellite Beam" ;
    :isAtOrNearMaxCapacity false ;
    rdfs:comment "A satellite beam that may be at or near maximum capacity. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" .

:Event_AVCOrder_RequiringBeamCapacity a :Cl_AVCOrder, owl:NamedIndividual ;
    rdfs:label "AVC Order Requiring Additional Beam Capacity" ;
    :eventType "AVC order which would require additional Beam capacity to be supplied" ;
    :requiresAdditionalBeamCapacity true ;
    :hasBeam :Beam_GenericInstance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(c), p.15" .

:Event_AVCModification_RequiringBeamCapacity a :Cl_AVCModification, owl:NamedIndividual ;
    rdfs:label "AVC Modification Requiring Additional Beam Capacity" ;
    :eventType "AVC modification which would require additional Beam capacity to be supplied" ;
    :requiresAdditionalBeamCapacity true ;
    :hasBeam :Beam_GenericInstance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(c), p.15" .

# Section 3.7(d) - Beam capacity deprioritisation
:Rule_BeamDeprioritisation a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Beam Deprioritisation Rule" ;
    :hasCondition "an AVC contributes disproportionately to Beam capacity utilisation" ;
    :hasConsequence "nbn may deprioritise data transfers or reduce the maximum data transfer rate of that AVC" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(d), p.15" .

:Event_BeamDeprioritisation a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "Beam Deprioritisation Event" ;
    :eventType "nbn deprioritises data transfers or reduces the maximum data transfer rate of an AVC contributing disproportionately to Beam capacity utilisation" ;
    :hasAgent :nbn ;
    :deprioritisesDataTransfers true ;
    :reducesMaxDataTransferRate true ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(d), p.15" .

# Section 3.7 Note - Public Interest Premises waiver
:PublicInterestPremises_Instance a :Cl_PublicInterestPremises, owl:NamedIndividual ;
    rdfs:label "Public Interest Premises Instance" ;
    :waivedByNbn false ;
    rdfs:comment "A Public Interest Premises for which nbn may waive RSP's obligations under section 39 of the nbn Ethernet Product Terms. [extension: nbn Ethernet Product Module, Section 3.7 Note, p.15]" .

# Section 3.8 - Wireless Plus Information Rate
:WirelessPlus_Instance a :Cl_WirelessPlus, owl:NamedIndividual ;
    rdfs:label "Wireless Plus" ;
    :hasPIR false ;
    :hasCIR false ;
    rdfs:comment "Wireless Plus product for which no PIR or CIR applies. [extension: nbn Ethernet Product Module, Section 3.8(a), p.15]" .

:Rule_WirelessPlusNoPIRorCIR a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Wireless Plus No PIR or CIR Rule" ;
    :hasCondition "Wireless Plus is supplied" ;
    :hasConsequence "no PIR or CIR applies in respect of Wireless Plus" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.8(a), p.15" . ---
