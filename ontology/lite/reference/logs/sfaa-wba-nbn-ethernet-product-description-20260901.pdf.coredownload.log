:Rule_FixedLineHierarchy a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Fixed-Line Network Hierarchy Rule" ;
    rdfs:comment "In the Fibre Network, FTTB Network, FTTN Network, FTTC Network and HFC Network, each Premises is located within an ADA, each ADA is located within a SAM, each SAM is located within an FSA, and each FSA is located within a CSA. [extension: nbn Ethernet Product Module, Section 12.1(a), p.26]" ;
    :hasCondition "a Premises at which nbn Ethernet is available is in the Fibre Network, FTTB Network, FTTN Network, FTTC Network or HFC Network" ;
    :hasConsequence "the Premises is located within an ADA, the ADA is located within a SAM, the SAM is located within an FSA, and the FSA is located within a CSA" ;
    :sourceClause "nbn Ethernet Product Module, Section 12.1(a), p.26" .

:Rule_WirelessHierarchy a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Wireless Network Hierarchy Rule" ;
    rdfs:comment "In the Wireless Network, each Premises is located within a WSA, and each WSA is located within a CSA. [extension: nbn Ethernet Product Module, Section 12.1(b), p.26]" ;
    :hasCondition "a Premises at which nbn Ethernet is available is in the Wireless Network" ;
    :hasConsequence "the Premises is located within a WSA, and the WSA is located within a CSA" ;
    :sourceClause "nbn Ethernet Product Module, Section 12.1(b), p.26" .

:Rule_SatelliteHierarchy a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Satellite Network Hierarchy Rule" ;
    rdfs:comment "In the Satellite Network, each Premises is located within a Beam, and all Premises and Beams are located within a single CSA that geographically overlaps with other CSAs. [extension: nbn Ethernet Product Module, Section 12.1(c), p.26]" ;
    :hasCondition "a Premises at which nbn Ethernet is available is in the Satellite Network" ;
    :hasConsequence "the Premises is located within a Beam, all Premises and Beams are located within a single CSA, and that single CSA geographically overlaps with other CSAs that contain Premises served by other access technologies" ;
    :sourceClause "nbn Ethernet Product Module, Section 12.1(c), p.26" .

:Rule_CSAServedByOnePOI a :Cl_BusinessRule, owl:NamedIndividual ;
