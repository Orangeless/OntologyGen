:Cl_ServiceLimit a owl:Class ;
    rdfs:label "Cl_ServiceLimit" ;
    rdfs:comment "A quantitative or qualitative restriction on the supply or use of a service. [extension: nbn Ethernet Product Module, Part C, p.20]" .

:Cl_AreaType a owl:Class ;
    rdfs:label "Cl_AreaType" ;
    rdfs:comment "An enumeration of area types that may affect service availability (e.g. Isolated Area, Limited Access Area). [extension: nbn Ethernet Product Module, Section 5(f), p.20]" .

:EnhancedFaultRectificationService a owl:Class ;
    rdfs:label "EnhancedFaultRectificationService" ;
