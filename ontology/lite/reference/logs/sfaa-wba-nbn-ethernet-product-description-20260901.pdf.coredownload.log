--- CONTENT: # ===== EXTENSIONS FROM PAGE 6: Contractual Events, Agents, Business Rules, CVC, V-NNI, Redundancy Mode ====="
# New classes for contractual modeling
:Cl_Agent a owl:Class ;
    rdfs:label "Cl_Agent" ;
    rdfs:comment "A party that performs actions under the agreement. Superclass for RSP and nbn. [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

:Cl_ContractualEvent a owl:Class ;
    rdfs:label "Cl_ContractualEvent" ;
    rdfs:comment "A reified event that captures an action or state change prescribed by the contract (e.g., selecting a redundancy mode, activating an NNI Group, ordering a CVC). [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

:Cl_BusinessRule a owl:Class ;
    rdfs:label "Cl_BusinessRule" ;
    rdfs:comment "A conditional statement (if-then) that governs the validity or outcome of a contractual event or state. [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

# Make RSP a subclass of Cl_Agent (RSP already defined above, so we add the subclass axiom)
:RSP rdfs:subClassOf :Cl_Agent .

# nbn individual
:nbn a :Cl_Agent, owl:NamedIndividual ;
    rdfs:label "nbn" ;
    rdfs:comment "The wholesale network provider (nbn co). [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

# Object properties for contractual events
:hasAgent a owl:ObjectProperty ;
    rdfs:label "hasAgent" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range :Cl_Agent ;
    rdfs:comment "Links a contractual event to the agent that performs it. [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

:hasObject a owl:ObjectProperty ;
    rdfs:label "hasObject" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range owl:Thing ;
    rdfs:comment "Links a contractual event to the object participant. [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

:governedBy a owl:ObjectProperty ;
    rdfs:label "governedBy" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range :Cl_BusinessRule ;
    rdfs:comment "Links a contractual event to the business rule that governs it. [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

:hasTrafficClass a owl:ObjectProperty ;
    rdfs:label "hasTrafficClass" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range :TrafficClass ;
    rdfs:comment "Links a contractual event to a traffic class involved. [extension: nbn Ethernet Product Module, Section 2.1, p.7]" .

:hasCVC a owl:ObjectProperty ;
    rdfs:label "hasCVC" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range :CVC ;
    rdfs:comment "Links a contractual event to a CVC involved. [extension: nbn Ethernet Product Module, Section 2, p.7]" .

:hasNNIGroup a owl:ObjectProperty ;
    rdfs:label "hasNNIGroup" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range :NNIGroup ;
    rdfs:comment "Links a contractual event to an NNI Group involved. [extension: nbn Ethernet Product Module, Section 1.3, p.7]" .

:hasNNILink a owl:ObjectProperty ;
    rdfs:label "hasNNILink" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range :NNILink ;
    rdfs:comment "Links a contractual event to a V-NNI/NNI Link involved. [extension: nbn Ethernet Product Module, Section 1.4, p.7]" .

:hasCSA a owl:ObjectProperty ;
    rdfs:label "hasCSA" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range :CSA ;
    rdfs:comment "Links a contractual event to a CSA involved. [extension: nbn Ethernet Product Module, Section 2, p.7]" .

:hasAVC a owl:ObjectProperty ;
    rdfs:label "hasAVC" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range :AVC ;
    rdfs:comment "Links a contractual event to an AVC involved. [extension: nbn Ethernet Product Module, Section 1.4, p.7]" .

# Datatype properties for contractual events and rules
:eventType a owl:DatatypeProperty ;
    rdfs:label "eventType" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range xsd:string ;
    rdfs:comment "The name/type of a contractual event. [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

:hasCondition a owl:DatatypeProperty ;
    rdfs:label "hasCondition" ;
    rdfs:domain :Cl_BusinessRule ;
    rdfs:range xsd:string ;
    rdfs:comment "The condition part of a business rule (if-clause). [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

:hasConsequence a owl:DatatypeProperty ;
    rdfs:label "hasConsequence" ;
    rdfs:domain :Cl_BusinessRule ;
    rdfs:range xsd:string ;
    rdfs:comment "The consequence part of a business rule (then-clause). [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

:hasState a owl:DatatypeProperty ;
    rdfs:label "hasState" ;
    rdfs:domain :NNIGroup ;
    rdfs:range xsd:string ;
    rdfs:comment "The activation state of an NNI Group (activated / not activated). [extension: nbn Ethernet Product Module, Section 1.3(f), p.7]" .

:hasBandwidthProfile a owl:DatatypeProperty ;
    rdfs:label "hasBandwidthProfile" ;
    rdfs:domain :CVC ;
    rdfs:range xsd:string ;
    rdfs:comment "The selected bandwidth profile for a CVC TC-4. [extension: nbn Ethernet Product Module, Section 2.2(b), p.7]" .

# ===== CONTRACTUAL EVENT INSTANCES (FACTS) =====

# --- Event 1: RSP selects single chassis as redundancy mode for an NNI Group ---
:Event_SelectSingleChassis a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "Select Single Chassis Redundancy Mode" ;
    :eventType "selects single chassis as the redundancy mode for an NNI Group" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :NNIGroup_ObjectRole_1 ;
    :sourceClause "nbn Ethernet Product Module, Section 1.3(d), p.7" .

:RSP_AgentRole a :Cl_Agent, owl:NamedIndividual ;
    rdfs:label "RSP (agent role)" ;
    rdfs:comment "RSP acting as agent in contractual events. [extension: nbn Ethernet Product Module, Section 1.3(d), p.7]" .

:NNIGroup_ObjectRole_1 a :NNIGroup, owl:NamedIndividual ;
    rdfs:label "NNI Group (object role)" ;
    rdfs:comment "An NNI Group that is the object of contractual events. [extension: nbn Ethernet Product Module, Section 1.3(d), p.7]" .

# --- Business Rule 1: If RSP selects single chassis, each NNI Bearer connected to same chassis ---
:Rule_SingleChassis a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Single Chassis Rule" ;
    :hasCondition "RSP selects single chassis as the redundancy mode for an NNI Group" ;
    :hasConsequence "each NNI Bearer in that NNI Group will be connected to the same chassis; and the NNI will operate as a single, unprotected interface" ;
    :sourceClause "nbn Ethernet Product Module, Section 1.3(d)(i)-(ii), p.7" .

:Event_SelectSingleChassis :governedBy :Rule_SingleChassis .

# --- Business Rule 2: If RSP selects diverse chassis, each NNI Bearer connected across a pair of chassis ---
:Rule_DiverseChassis a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Diverse Chassis Rule" ;
    :hasCondition "RSP selects diverse chassis as the redundancy mode for an NNI Group" ;
    :hasConsequence "each NNI Bearer in that NNI Group will be connected across a pair of chassis" ;
    :sourceClause "nbn Ethernet Product Module, Section 1.3(e), p.7" .

# --- Event 2: NNI Group is activated ---
:Event_NNIGroupActivated a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "NNI Group Activated" ;
    :eventType "NNI Group is activated" ;
    :hasObject :NNIGroup_ObjectRole_1 ;
    :sourceClause "nbn Ethernet Product Module, Section 1.3(f), p.7" .

# --- Event 3: Redundancy mode of NNI Group is reconfigured ---
:Event_ReconfigureRedundancyMode a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "Reconfigure Redundancy Mode" ;
    :eventType "reconfigured" ;
    :hasObject :NNIGroup_ObjectRole_1 ;
    :sourceClause "nbn Ethernet Product Module, Section 1.3(f), p.7" .

# --- Business Rule 3: Redundancy mode can only be reconfigured if criteria for NNI Diversity Upgrade met ---
:Rule_ReconfigureRedundancy a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Reconfigure Redundancy Mode Rule" ;
    :hasCondition "the redundancy mode of an NNI Group is reconfigured after activation" ;
    :hasConsequence "it satisfies the criteria for an NNI Diversity Upgrade in the WBA Operations Manual (including that the NNI Group is located at an Upgraded POI)" ;
    :sourceClause "nbn Ethernet Product Module, Section 1.3(f), p.7" .

:Event_ReconfigureRedundancyMode :governedBy :Rule_ReconfigureRedundancy .

# --- Event 4: V-NNI configured with an Upstream NNI Link ---
:Event_ConfigureVNNI a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "Configure V-NNI with Upstream NNI Link" ;
    :eventType "configured with an Upstream NNI Link" ;
    :hasObject :VNNI_ObjectRole ;
    :sourceClause "nbn Ethernet Product Module, Section 1.4(a), p.7" .

:VNNI_ObjectRole a :NNILink, owl:NamedIndividual ;
    rdfs:label "V-NNI (object role)" ;
    rdfs:comment "A V-NNI that is configured with an Upstream NNI Link. [extension: nbn Ethernet Product Module, Section 1.4(a), p.7]" .

# --- Event 5: RSP associates CVCs and AVC/UNIs with a V-NNI ---
:Event_AssociateCVCsWithVNNI a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "Associate CVCs and AVC/UNIs with V-NNI" ;
    :eventType "associate CVCs and AVC/UNIs with a V-NNI" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :VNNI_ObjectRole ;
    :sourceClause "nbn Ethernet Product Module, Section 1.4(c), p.7" .

# --- Event 6: RSP orders a CVC for a CSA ---
:Event_OrderCVCForCSA a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "Order CVC for CSA" ;
    :eventType "order a CVC for each CSA" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :CVC_ObjectRole ;
    :hasCSA :CSA_ObjectRole ;
    :sourceClause "nbn Ethernet Product Module, Section 2, p.7" .

:CVC_ObjectRole a :CVC, owl:NamedIndividual ;
    rdfs:label "CVC (object role)" ;
    rdfs:comment "A CVC that is the object of contractual events. [extension: nbn Ethernet Product Module, Section 2, p.7]" .

:CSA_ObjectRole a :CSA, owl:NamedIndividual ;
    rdfs:label "CSA (object role)" ;
    rdfs:comment "A CSA that is the object of contractual events. [extension: nbn Ethernet Product Module, Section 2, p.7]" .

# --- Event 7: nbn makes CVC available in traffic classes ---
:Event_MakeCVCAvailable a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "Make CVC Available in Traffic Classes" ;
    :eventType "make the CVC available in traffic class 1 (CVC TC-1), traffic class 2 (CVC TC-2) and traffic class 4 (CVC TC-4)" ;
    :hasAgent :nbn ;
    :hasObject :CVC_ObjectRole ;
    :hasTrafficClass :TC_1 ;
    :hasTrafficClass :TC_2 ;
    :hasTrafficClass :TC_4 ;
    :sourceClause "nbn Ethernet Product Module, Section 2.1(b), p.7" .

# --- Event 8: RSP orders a CVC TC-4, CVC TC-1 or CVC TC-2 ---
:Event_OrderCVCTrafficClass a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "Order CVC by Traffic Class" ;
    :eventType "order a CVC TC-4, CVC TC-1 or CVC TC-2, or any combination of the three" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :CVC_ObjectRole ;
    :sourceClause "nbn Ethernet Product Module, Section 2.1(c), p.7" .

# --- Business Rule 4: Total combination of CVC bandwidth profiles is not zero ---
:Rule_CVCBandwidthNotZero a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "CVC Bandwidth Not Zero Rule" ;
    :hasCondition "RSP orders a combination of CVC TC-4, CVC TC-1 or CVC TC-2" ;
    :hasConsequence "the total combination of CVC bandwidth profiles is not zero" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.1(c), p.7" .

:Event_OrderCVCTrafficClass :governedBy :Rule_CVCBandwidthNotZero .

# --- Event 9: RSP selects a bandwidth profile for the CVC TC-4 ---
:Event_SelectBandwidthProfile a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "Select Bandwidth Profile for CVC TC-4" ;
    :eventType "select a bandwidth profile for the CVC TC-4" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :CVC_ObjectRole ;
    :hasTrafficClass :TC_4 ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(b), p.7" .

# ===== FACTS: CVC description and properties =====
# 2.1(a): CVC is Ethernet-based Layer 2 virtual capacity
:CVC_ObjectRole rdfs:comment "Ethernet-based Layer 2 virtual capacity on the nbn Network used to carry RSP traffic between multiple AVCs in a CSA on an aggregated basis and the NNI at the POI serving that CSA. [extension: nbn Ethernet Product Module, Section 2.1(a), p.7]" .

# ===== FACTS: CVC not made available across different access technologies (Section 2.1(d)) =====
# 2.1(d)(i): CVC supplied for nbn Ethernet (Satellite) not made available for other access technologies
:Rule_CVCNotCrossTech_Sat a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "CVC Satellite Not Cross-Available Rule" ;
    :hasCondition "a CVC is supplied in respect of nbn Ethernet (Satellite)" ;
    :hasConsequence "it will not be made available in respect of nbn Ethernet supplied by means of any other access technology" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.1(d)(i), p.7" .

# 2.1(d)(ii): CVC supplied for non-Satellite access technologies not made available for Satellite
:Rule_CVCNotCrossTech_NonSat a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "CVC Non-Satellite Not Cross-Available Rule" ;
    :hasCondition "a CVC is supplied in respect of nbn Ethernet supplied by means of any access technology other than the Satellite Network" ;
    :hasConsequence "it will not be made available in respect of nbn Ethernet (Satellite)" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.1(d)(ii), p.7" .

# ===== FACTS: CVC TC-4 bandwidth profiles available per access technology (Section 2.2) =====
# 2.2(a): RSP may order CVC TC-4 for Fibre, FTTB, FTTN, FTTC, HFC, Wireless and Satellite
:Rule_CVCTC4_Available a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "CVC TC-4 Availability Rule" ;
    :hasCondition "RSP orders a CVC TC-4" ;
    :hasConsequence "CVC TC-4 is available in respect of nbn Ethernet (Fibre), nbn Ethernet (FTTB), nbn Ethernet (FTTN), nbn Ethernet (FTTC), nbn Ethernet (HFC), nbn Ethernet (Wireless) and nbn Ethernet (Satellite)" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(a), p.7" .

# ===== FACTS: Upstream NNI Link Parameters (Section 1.4(b)) =====
:Rule_UpstreamNNILinkParams a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Upstream NNI Link Parameters Rule" ;
    :hasCondition "a V-NNI is configured with an Upstream NNI Link" ;
    :hasConsequence "the Upstream NNI Link Parameters will be applied to the V-NNI" ;
    :sourceClause "nbn Ethernet Product Module, Section 1.4(b), p.7" .

# ===== FACTS: CVC size at discretion of RSP (Section 2) =====
:Rule_CVCSizeDiscretion a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "CVC Size at RSP Discretion Rule" ;
    :hasCondition "RSP orders a CVC for a CSA where nbn supplies nbn Ethernet to RSP" ;
    :hasConsequence "the size of the CVC that RSP requires is at the discretion of RSP (subject to section 2 and the nbn Ethernet Fair Use Policy)" ;
    :sourceClause "nbn Ethernet Product Module, Section 2, p.7" .

# ===== FACTS: RSP must order CVC for each CSA (Section 2) =====
:Rule_RSPMustOrderCVC a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "RSP Must Order CVC Rule" ;
    :hasCondition "nbn supplies nbn Ethernet to RSP in a CSA" ;
    :hasConsequence "RSP must order a CVC for that CSA" ;
    :sourceClause "nbn Ethernet Product Module, Section 2, p.7" .

# ===== FACTS: RSP must select bandwidth profile for CVC TC-4 (Section 2.2(b)) =====
:Rule_MustSelectBandwidthProfile a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Must Select Bandwidth Profile Rule" ;
    :hasCondition "RSP orders a CVC TC-4" ;
    :hasConsequence "RSP must select a bandwidth profile for the CVC TC-4" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(b), p.7" .

# ===== FACTS: RSP must associate CVCs and AVC/UNIs with V-NNI in same way as NNI (Section 1.4(c)) =====
:Rule_AssociateLikeNNI a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Associate Like NNI Rule" ;
    :hasCondition "RSP associates CVCs and AVC/UNIs with a V-NNI" ;
    :hasConsequence "RSP must do so in the same way as an NNI" ;
    :sourceClause "nbn Ethernet Product Module, Section 1.4(c), p.7" . ---
