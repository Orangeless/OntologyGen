--- CONTENT: # ===== EXTENSIONS FROM PAGE 5: NNI, NNI Bearer, NNI Group, Profiles, Products =====
# New classes
:NNIBearerProfile a owl:Class ;
    rdfs:label "NNIBearerProfile" ;
    rdfs:comment "Physical interface profile for an NNI Bearer (e.g. 1000BaseLX, 10GBaseLR). [extension: nbn Ethernet Product Module, Section 1.2, p.6]" .

:nbnEthernetProduct a owl:Class ;
    rdfs:label "nbnEthernetProduct" ;
    rdfs:comment "An nbn Ethernet product variant distinguished by access technology (Satellite, Fibre, FTTB, etc.). [extension: nbn Ethernet Product Module, Section 1.1(f), p.6]" .

:RSP a owl:Class ;
    rdfs:label "RSP" ;
    rdfs:comment "Retail Service Provider that orders and connects to the nbn Network via NNI. [extension: nbn Ethernet Product Module, Section 1, p.6]" .

# New object properties
:hasProfile a owl:ObjectProperty ;
    rdfs:label "hasProfile" ;
    rdfs:domain :Bearer ;
    rdfs:range :NNIBearerProfile ;
    rdfs:comment "The NNI Bearer profile of a Bearer. [extension: nbn Ethernet Product Module, Section 1.2, p.6]" .

:hasRedundancyMode a owl:ObjectProperty ;
    rdfs:label "hasRedundancyMode" ;
    rdfs:domain :Bearer ;
    rdfs:range :RedundancyMode ;
    rdfs:comment "The redundancy mode configured on an NNI Bearer. [extension: nbn Ethernet Product Module, Section 1.3(b), p.6]" .

:locatedAt a owl:ObjectProperty ;
    rdfs:label "locatedAt" ;
    rdfs:domain :NNI ;
    rdfs:range :POI ;
    rdfs:comment "The POI where an NNI is located. [extension: nbn Ethernet Product Module, Section 1.1(a), p.6]" .

:handoverFor a owl:ObjectProperty ;
    rdfs:label "handoverFor" ;
    rdfs:domain :NNI ;
    rdfs:range :CVC ;
    rdfs:comment "The NNI is the point of handover for all CVCs associated with that NNI. [extension: nbn Ethernet Product Module, Section 1.1(b), p.6]" .

:isPhysicalInterfaceOf a owl:ObjectProperty ;
    rdfs:label "isPhysicalInterfaceOf" ;
    rdfs:domain :Bearer ;
    rdfs:range :NNI ;
    rdfs:comment "The NNI Bearer is the physical interface of an NNI. [extension: nbn Ethernet Product Module, Section 1.1(c), p.6]" .

:memberOf a owl:ObjectProperty ;
    rdfs:label "memberOf" ;
    rdfs:domain :Bearer ;
    rdfs:range :NNIGroup ;
    rdfs:comment "An NNI Bearer is configured as a member of an NNI Group. [extension: nbn Ethernet Product Module, Section 1.1(d), p.6]" .

:comprises a owl:ObjectProperty ;
    rdfs:label "comprises" ;
    rdfs:domain :NNIGroup ;
    rdfs:range :Bearer ;
    rdfs:comment "An NNI Group comprises one or more NNI Bearers. [extension: nbn Ethernet Product Module, Section 1.1(d), p.6]" .

:includes a owl:ObjectProperty ;
    rdfs:label "includes" ;
    rdfs:domain :NNI ;
    rdfs:range :NNILink ;
    rdfs:comment "An NNI includes a V-NNI when RSP has configured a V-NNI with an Upstream NNI Link. [extension: nbn Ethernet Product Module, Section 1.1(e), p.6]" .

:hasUpstreamNNILink a owl:DatatypeProperty ;
    rdfs:label "hasUpstreamNNILink" ;
    rdfs:domain :NNILink ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Indicates if a V-NNI has an Upstream NNI Link configured. [extension: nbn Ethernet Product Module, Section 1.1(e), p.6]" .

:suppliedByAccessTechnology a owl:ObjectProperty ;
    rdfs:label "suppliedByAccessTechnology" ;
    rdfs:domain :nbnEthernetProduct ;
    rdfs:range :AccessTechnology ;
    rdfs:comment "The access technology by which an nbn Ethernet product is supplied. [extension: nbn Ethernet Product Module, Section 1.1(f), p.6]" .

:notMadeAvailableFor a owl:ObjectProperty ;
    rdfs:label "notMadeAvailableFor" ;
    rdfs:domain :NNI ;
    rdfs:range :nbnEthernetProduct ;
    rdfs:comment "An NNI supplied in respect of one nbn Ethernet product will not be made available in respect of another. [extension: nbn Ethernet Product Module, Section 1.1(f), p.6]" .

:mustOrder a owl:ObjectProperty ;
    rdfs:label "mustOrder" ;
    rdfs:domain :RSP ;
    rdfs:range :NNI ;
    rdfs:comment "RSP must order an NNI for each CSA where nbn supplies nbn Ethernet to RSP. [extension: nbn Ethernet Product Module, Section 1, p.6]" .

:hasInterfaceRate a owl:DatatypeProperty ;
    rdfs:label "hasInterfaceRate" ;
    rdfs:comment "Interface rate in Gbps of a Bearer or NNI Group. [extension: nbn Ethernet Product Module, Section 1.3(a), p.6]" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Bearer :NNIGroup ) ] ;
    rdfs:range xsd:double .

# New individuals for NNIBearerProfile
:Profile_1000BaseLX a :NNIBearerProfile, owl:NamedIndividual ;
