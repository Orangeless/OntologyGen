--- CONTENT: # ===== EXTENSIONS FROM PAGE 7: CVC TC-4 Bandwidth Profiles, CVC Classes, Minimum AVC Requirements =====
# New classes for bandwidth profile reification
:Cl_BandwidthProfile a owl:Class ;
    rdfs:label "Cl_BandwidthProfile" ;
    rdfs:comment "A reified bandwidth profile configuration for a CVC TC-4, specifying PIR/CIR parameters, increments, ranges, and CVC Max flag. [extension: nbn Ethernet Product Module, Section 2.2, p.8]" .

:Cl_CvcClass a owl:Class ;
    rdfs:label "Cl_CvcClass" ;
    rdfs:comment "A classification (0, 1, 2) for CVC TC-4 on nbn Ethernet (Satellite) that determines CIR increments and minimum AVC association rules. [extension: nbn Ethernet Product Module, Section 2.2(e), p.8]" .

:Cl_MinimumAvcRequirement a owl:Class ;
    rdfs:label "Cl_MinimumAvcRequirement" ;
    rdfs:comment "A reified rule specifying the minimum number of AVCs that must be associated with a CVC TC-4, conditional on CVC Class and bandwidth profile tier. [extension: nbn Ethernet Product Module, Section 2.2(e), p.8]" .

:Cl_PirIncrementRule a owl:Class ;
    rdfs:label "Cl_PirIncrementRule" ;
    rdfs:comment "A reified rule specifying the PIR increment for a given PIR range for CVC TC-4 symmetrical Mbps (PIR). [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

:Cl_CirIncrementRule a owl:Class ;
    rdfs:label "Cl_CirIncrementRule" ;
    rdfs:comment "A reified rule specifying the CIR increment for a given CVC Class for CVC TC-4 symmetrical Mbps (CIR). [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

:Cl_CirRangeRule a owl:Class ;
    rdfs:label "Cl_CirRangeRule" ;
    rdfs:comment "A reified rule specifying the CIR range for a given CVC Class for CVC TC-4 symmetrical Mbps (CIR). [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

# New object properties for bandwidth profile reification
:hasProfile a owl:ObjectProperty ;
    rdfs:label "hasProfile" ;
    rdfs:domain :CVC ;
    rdfs:range :Cl_BandwidthProfile ;
    rdfs:comment "Links a CVC to its reified bandwidth profile. [extension: nbn Ethernet Product Module, Section 2.2, p.8]" .

:isProfileOf a owl:ObjectProperty ;
    rdfs:label "isProfileOf" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range :CVC ;
    rdfs:comment "Links a bandwidth profile to the CVC it configures. [extension: nbn Ethernet Product Module, Section 2.2, p.8]" .

:hasTrafficClass a owl:ObjectProperty ;
    rdfs:label "hasTrafficClass" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range :TrafficClass ;
    rdfs:comment "Links a bandwidth profile to its traffic class (TC-4). [extension: nbn Ethernet Product Module, Section 2.2, p.8]" .

:hasCvcClass a owl:ObjectProperty ;
    rdfs:label "hasCvcClass" ;
    rdfs:domain :CVC ;
    rdfs:range :Cl_CvcClass ;
    rdfs:comment "Links a CVC to its CVC Class (0, 1, or 2) for nbn Ethernet (Satellite). [extension: nbn Ethernet Product Module, Section 2.2(e)(i), p.8]" .

:specifiedFor a owl:ObjectProperty ;
    rdfs:label "specifiedFor" ;
    rdfs:domain :Cl_CvcClass ;
    rdfs:range :CVC ;
    rdfs:comment "Links a CVC Class to the CVC it is specified for. [extension: nbn Ethernet Product Module, Section 2.2(e)(i), p.8]" .

:appliesToCvcClass a owl:ObjectProperty ;
    rdfs:label "appliesToCvcClass" ;
    rdfs:domain :Cl_MinimumAvcRequirement ;
    rdfs:range :Cl_CvcClass ;
    rdfs:comment "Links a minimum AVC requirement to the CVC Class it applies to. [extension: nbn Ethernet Product Module, Section 2.2(e)(iii), p.8]" .

:hasPirIncrementRule a owl:ObjectProperty ;
    rdfs:label "hasPirIncrementRule" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range :Cl_PirIncrementRule ;
    rdfs:comment "Links a bandwidth profile to its PIR increment rules. [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

:hasCirIncrementRule a owl:ObjectProperty ;
    rdfs:label "hasCirIncrementRule" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range :Cl_CirIncrementRule ;
    rdfs:comment "Links a bandwidth profile to its CIR increment rules. [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

:hasCirRangeRule a owl:ObjectProperty ;
    rdfs:label "hasCirRangeRule" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range :Cl_CirRangeRule ;
    rdfs:comment "Links a bandwidth profile to its CIR range rules. [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

:hasMinimumAvcRequirement a owl:ObjectProperty ;
    rdfs:label "hasMinimumAvcRequirement" ;
    rdfs:domain :Cl_CvcClass ;
    rdfs:range :Cl_MinimumAvcRequirement ;
    rdfs:comment "Links a CVC Class to its minimum AVC requirements. [extension: nbn Ethernet Product Module, Section 2.2(e)(iii), p.8]" .

# New datatype properties
:hasPirIncrement a owl:DatatypeProperty ;
    rdfs:label "hasPirIncrement" ;
    rdfs:domain :Cl_PirIncrementRule ;
    rdfs:range xsd:integer ;
    rdfs:comment "The PIR increment value in Mbps for a given PIR range. [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

:hasPirRange a owl:DatatypeProperty ;
    rdfs:label "hasPirRange" ;
    rdfs:domain :Cl_PirIncrementRule ;
    rdfs:range xsd:string ;
    rdfs:comment "The PIR range string (e.g. '0', '100-300', '300-10,000') for which the increment applies. [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

:hasCirIncrement a owl:DatatypeProperty ;
    rdfs:label "hasCirIncrement" ;
