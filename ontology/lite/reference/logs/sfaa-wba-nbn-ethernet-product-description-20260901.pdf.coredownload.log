--- CONTENT: :Cl_InterfaceType a owl:Class ;
    rdfs:label "Cl_InterfaceType" ;
    rdfs:comment "A reified class representing the type of interface (e.g. electrical, optical) for a UNI. [extension: nbn Ethernet Product Module, Section 4.2(b), p.17]" .

:Cl_ProductFeature a owl:Class ;
    rdfs:label "Cl_ProductFeature" ;
    rdfs:comment "An optional product feature that can be added to an nbn Ethernet product. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" .

:Cl_ProductFeatureState a owl:Class ;
    rdfs:label "Cl_ProductFeatureState" ;
    rdfs:comment "An enumeration of states in the lifecycle of a product feature: Orderable, Transition-out Only, Withdrawn. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:Cl_StateTransition a owl:Class ;
    rdfs:label "Cl_StateTransition" ;
    rdfs:comment "A reified state transition with a trigger and guard condition for a product feature lifecycle. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:Cl_AnalogueTelephoneAdaptor a owl:Class ;
    rdfs:label "Cl_AnalogueTelephoneAdaptor" ;
    rdfs:comment "An analogue telephone adaptor incorporated in the UNI-V product feature for the supply of telephony services to a Premises. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" .

:Cl_OrderType a owl:Class ;
    rdfs:label "Cl_OrderType" ;
    rdfs:comment "An enumeration of order types: Standard, Transition-out Modify, Disconnect. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:Cl_AVCTC4_ProductComponent a owl:Class ;
    rdfs:label "Cl_AVCTC4_ProductComponent" ;
    rdfs:comment "A specific product component (AVC TC-4) that is a required component for certain nbn Ethernet products, with conditional UNI requirements. [extension: nbn Ethernet Product Module, Section 4.2(c), p.17]" .

:UNI_DSL a owl:Class ;
    rdfs:label "UNI_DSL" ;
    rdfs:comment "User Network Interface - DSL, used for FTTB and FTTN networks. [extension: nbn Ethernet Product Module, Section 4.4, p.17]" ;
    rdfs:subClassOf :UNI .

# --- New Object Properties ---

:hasInterfaceType a owl:ObjectProperty ;
    rdfs:label "hasInterfaceType" ;
    rdfs:comment "Links a UNI to its reified interface type (e.g. electrical, optical). [extension: nbn Ethernet Product Module, Section 4.2(b), p.17]" ;
    rdfs:domain :UNI ;
    rdfs:range :Cl_InterfaceType .

:isOptionalProductFeatureOf a owl:ObjectProperty ;
    rdfs:label "isOptionalProductFeatureOf" ;
    rdfs:comment "Links a product feature to the nbn Ethernet product it is an optional feature of. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" ;
    rdfs:domain :Cl_ProductFeature ;
    rdfs:range :nbnEthernetProduct .

:incorporates a owl:ObjectProperty ;
    rdfs:label "incorporates" ;
    rdfs:comment "Links a product feature to a component it incorporates. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" ;
    rdfs:domain :Cl_ProductFeature ;
    rdfs:range :Cl_AnalogueTelephoneAdaptor .

:hasState a owl:ObjectProperty ;
    rdfs:label "hasState" ;
    rdfs:comment "Links a product feature to its current state in the lifecycle. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain :Cl_ProductFeature ;
    rdfs:range :Cl_ProductFeatureState .

:hasTrigger a owl:DatatypeProperty ;
    rdfs:label "hasTrigger" ;
    rdfs:comment "The trigger event for a state transition. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain :Cl_StateTransition ;
    rdfs:range xsd:string .

:hasGuard a owl:DatatypeProperty ;
    rdfs:label "hasGuard" ;
    rdfs:comment "The guard condition for a state transition. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain :Cl_StateTransition ;
    rdfs:range xsd:string .

:hasEffectiveDate a owl:DatatypeProperty ;
    rdfs:label "hasEffectiveDate" ;
    rdfs:comment "The effective date for a temporal constraint or event. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:date .

:withdrawnOn a owl:DatatypeProperty ;
    rdfs:label "withdrawnOn" ;
    rdfs:comment "The date on which a product feature is withdrawn. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain :Cl_ProductFeature ;
    rdfs:range xsd:date .

:issuedNoticeOn a owl:DatatypeProperty ;
    rdfs:label "issuedNoticeOn" ;
    rdfs:comment "The date on which a notice was issued. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range xsd:date .

:expiresOn a owl:DatatypeProperty ;
    rdfs:label "expiresOn" ;
    rdfs:comment "The date on which a period expires. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:date .

:mustNotSubmitOrderFor a owl:ObjectProperty ;
    rdfs:label "mustNotSubmitOrderFor" ;
    rdfs:comment "Links an RSP to the order types that must not be submitted for a product feature after a certain date. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain :RSP ;
    rdfs:range :Cl_OrderType .

:requires a owl:ObjectProperty ;
    rdfs:label "requires" ;
    rdfs:comment "Links an AVC TC-4 Product Component to the UNI type it requires as a condition of supply. [extension: nbn Ethernet Product Module, Section 4.2(c), p.17]" ;
    rdfs:domain :Cl_AVCTC4_ProductComponent ;
    rdfs:range :UNI .

:isConditionOfSupplyFor a owl:ObjectProperty ;
    rdfs:label "isConditionOfSupplyFor" ;
    rdfs:comment "Links an AVC TC-4 Product Component to the nbn Ethernet product variants for which it is a condition of supply. [extension: nbn Ethernet Product Module, Section 4.2(c), p.17]" ;
    rdfs:domain :Cl_AVCTC4_ProductComponent ;
    rdfs:range :nbnEthernetProduct .

:isAcquiredBy a owl:ObjectProperty ;
    rdfs:label "isAcquiredBy" ;
    rdfs:comment "Links an AVC TC-4 Product Component to the RSP that acquires it. [extension: nbn Ethernet Product Module, Section 4.2(c), p.17]" ;
    rdfs:domain :Cl_AVCTC4_ProductComponent ;
    rdfs:range :RSP .

:forEachPremises a owl:ObjectProperty ;
    rdfs:label "forEachPremises" ;
    rdfs:comment "Links an AVC TC-4 Product Component acquisition to the Premises at which it is supplied. [extension: nbn Ethernet Product Module, Section 4.2(c), p.17]" ;
    rdfs:domain :Cl_AVCTC4_ProductComponent ;
    rdfs:range :Premises .

:dependsOnNumberOfNTDs a owl:DatatypeProperty ;
    rdfs:label "dependsOnNumberOfNTDs" ;
    rdfs:comment "Indicates that the number of UNI-Ds available depends on the number and type of NTDs or FTTC-NCDs installed. [extension: nbn Ethernet Product Module, Section 4.2(a)(ii), p.17]" ;
    rdfs:domain :UNI_D ;
    rdfs:range xsd:boolean .

:dependsOnFootprint a owl:DatatypeProperty ;
    rdfs:label "dependsOnFootprint" ;
    rdfs:comment "Indicates that the number of UNI-Ds available depends on whether a Premises is located in the footprint of a network type. [extension: nbn Ethernet Product Module, Section 4.2(a)(i), p.17]" ;
    rdfs:domain :UNI_D ;
    rdfs:range xsd:boolean .

:dependsOnCopperPairs a owl:DatatypeProperty ;
    rdfs:label "dependsOnCopperPairs" ;
    rdfs:comment "Indicates that the number of UNI-DSLs available depends on the number of distinct nbn Copper Pairs installed. [extension: nbn Ethernet Product Module, Section 4.4(a)(i), p.17]" ;
    rdfs:domain :UNI_DSL ;
    rdfs:range xsd:boolean .

:dependsOnXDSLPortAllocation a owl:DatatypeProperty ;
    rdfs:label "dependsOnXDSLPortAllocation" ;
    rdfs:comment "Indicates that the number of UNI-DSLs available depends on the allocation and installation of a single xDSL port to each distinct nbn Copper Pair. [extension: nbn Ethernet Product Module, Section 4.4(a)(ii), p.17]" ;
    rdfs:domain :UNI_DSL ;
    rdfs:range xsd:boolean .

:dependsOnNTDVersion a owl:DatatypeProperty ;
    rdfs:label "dependsOnNTDVersion" ;
    rdfs:comment "Indicates that the number of UNI-Vs available depends on the number and version of NTDs installed. [extension: nbn Ethernet Product Module, Section 4.3(a), p.17]" ;
    rdfs:domain :UNI_V ;
    rdfs:range xsd:boolean .

# --- Individuals / Facts ---

# Section 4.2(a) - UNI-D availability depends on footprint and NTDs
:UNI_D_Availability_Rule a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-D Availability Rule" ;
    :hasCondition "a Premises is served by the Fibre Network, FTTC Network, HFC Network, Wireless Network or Satellite Network" ;
    :hasConsequence "the number of UNI-Ds available depends on: (i) whether the Premises is located in the footprint of those networks; and (ii) the number and type of NTDs or FTTC-NCDs installed at that Premises" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.2(a), p.17" .

# Section 4.2(b) - UNI-D has electrical interface
:InterfaceType_Electrical a :Cl_InterfaceType, owl:NamedIndividual ;
    rdfs:label "Electrical Interface" ;
    rdfs:comment "An electrical interface type for UNI-D. [extension: nbn Ethernet Product Module, Section 4.2(b), p.17]" .

:UNI_D_InterfaceType_Relation a owl:NamedIndividual ;
    rdfs:label "UNI-D has electrical interface" ;
    rdfs:comment "Reified relationship: UNI-D has an electrical interface and will not be made available with an optical interface. [extension: nbn Ethernet Product Module, Section 4.2(b), p.17]" ;
    :hasInterfaceType :InterfaceType_Electrical .

:Rule_UNID_ElectricalInterface a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-D Electrical Interface Rule" ;
    :hasCondition "UNI-D is made available" ;
    :hasConsequence "the UNI-D has an electrical interface and will not be made available with an optical interface" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.2(b), p.17" .

# Section 4.2(c) - AVC TC-4 requires UNI-D for Fibre, FTTC, HFC, Wireless, Satellite
:AVCTC4_ProductComponent_FibreUNID a :Cl_AVCTC4_ProductComponent, owl:NamedIndividual ;
    rdfs:label "AVC TC-4 Product Component requiring UNI-D" ;
    :requires :UNI_D ;
    :isConditionOfSupplyFor :nbnEthernet_Fibre, :nbnEthernet_FTTC, :nbnEthernet_HFC, :nbnEthernet_Wireless, :nbnEthernet_Satellite ;
    :sourceClause "nbn Ethernet Product Module, Section 4.2(c), p.17" .

:Rule_AVCTC4_Requires_UNID a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "AVC TC-4 Requires UNI-D Rule" ;
    :hasCondition "an AVC TC-4 Product Component of nbn Ethernet (Fibre), nbn Ethernet (FTTC), nbn Ethernet (HFC), nbn Ethernet (Wireless) or nbn Ethernet (Satellite) is supplied" ;
    :hasConsequence "RSP also acquires a UNI-D in conjunction with that AVC TC-4 for each Premises at which nbn Ethernet will be supplied" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.2(c), p.17" .

# Section 4.3(a) - UNI-V availability depends on NTDs
:UNI_V_Availability_Rule a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-V Availability Rule" ;
    :hasCondition "a Premises is served by the Fibre Network" ;
    :hasConsequence "the number of UNI-Vs available depends on the number and version of NTDs which nbn has installed at that Premises" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.3(a), p.17" .

# Section 4.3(b) - UNI-V is optional Product Feature of nbn Ethernet (Fibre), incorporates analogue telephone adaptor
:UNIV_ProductFeature a :Cl_ProductFeature, owl:NamedIndividual ;
    rdfs:label "UNI-V Product Feature" ;
    rdfs:comment "The UNI-V is an optional Product Feature of nbn Ethernet (Fibre) and incorporates an analogue telephone adaptor for the supply of telephony services to a Premises. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" ;
    :isOptionalProductFeatureOf :nbnEthernet_Fibre ;
    :incorporates :AnalogueTelephoneAdaptor_Instance .

:AnalogueTelephoneAdaptor_Instance a :Cl_AnalogueTelephoneAdaptor, owl:NamedIndividual ;
    rdfs:label "Analogue Telephone Adaptor" ;
    rdfs:comment "An analogue telephone adaptor incorporated in the UNI-V for the supply of telephony services to a Premises. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" .

# Section 4.3 Notes - UNI-V withdrawal lifecycle
:Event_UNIV_NoticeIssued a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "UNI-V Notice Issued" ;
    :eventType "nbn issued a notice in relation to the withdrawal of the UNI-V Product Feature" ;
    :hasAgent :nbn ;
    :issuedNoticeOn "2023-05-26"^^xsd:date ;
    :sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

:UNIV_ContinuedOrderingPeriod a owl:NamedIndividual ;
    rdfs:label "UNI-V Continued Ordering Period" ;
    rdfs:comment "The Continued Ordering Period for the UNI-V Product Feature, expiring on 26 May 2024. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    :expiresOn "2024-05-26"^^xsd:date .

:UNIV_WithdrawalDate a owl:NamedIndividual ;
    rdfs:label "UNI-V Withdrawal Date" ;
    rdfs:comment "The date on which the UNI-V Product Feature will be withdrawn: 31 January 2031. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    :withdrawnOn "2031-01-31"^^xsd:date .

# UNI-V Lifecycle States
:ProductFeatureState_Orderable a :Cl_ProductFeatureState, owl:NamedIndividual ;
    rdfs:label "Orderable" ;
    rdfs:comment "State in which the UNI-V Product Feature is orderable. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:ProductFeatureState_TransitionOutOnly a :Cl_ProductFeatureState, owl:NamedIndividual ;
    rdfs:label "Transition-out Only" ;
    rdfs:comment "State in which the UNI-V Product Feature can only be ordered via Transition-out Modify Order or Disconnect Order. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:ProductFeatureState_Withdrawn a :Cl_ProductFeatureState, owl:NamedIndividual ;
    rdfs:label "Withdrawn" ;
    rdfs:comment "State in which the UNI-V Product Feature is withdrawn. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

# UNI-V State Transitions
:UNIV_StateTransition_OrderableToTransitionOut a :Cl_StateTransition, owl:NamedIndividual ;
    rdfs:label "UNI-V: Orderable to Transition-out Only" ;
    :hasTrigger "expiry of Continued Ordering Period on 26 May 2024" ;
    :hasGuard "after 26 May 2024" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

:UNIV_StateTransition_TransitionOutToWithdrawn a :Cl_StateTransition, owl:NamedIndividual ;
    rdfs:label "UNI-V: Transition-out Only to Withdrawn" ;
    :hasTrigger "withdrawal date of 31 January 2031" ;
    :hasGuard "on 31 January 2031, unless disconnected earlier" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

# Order Types
:OrderType_Standard a :Cl_OrderType, owl:NamedIndividual ;
    rdfs:label "Standard Order" ;
    rdfs:comment "A standard order type. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:OrderType_TransitionOutModify a :Cl_OrderType, owl:NamedIndividual ;
    rdfs:label "Transition-out Modify Order" ;
    rdfs:comment "A Transition-out Modify Order type. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:OrderType_Disconnect a :Cl_OrderType, owl:NamedIndividual ;
    rdfs:label "Disconnect Order" ;
    rdfs:comment "A Disconnect Order type. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

# Business Rule: RSP must not submit Standard Order for UNI-V after Continued Ordering Period expiry
:Rule_UNIV_NoStandardOrder_AfterExpiry a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-V No Standard Order After Expiry Rule" ;
    :hasCondition "after the expiry of the Continued Ordering Period for the UNI-V Product Feature on 26 May 2024" ;
    :hasConsequence "RSP must not submit an order for a UNI-V Product Feature unless that order is a Transition-out Modify Order or Disconnect Order" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

:Rule_UNIV_ContinuedSupply_UntilWithdrawal a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-V Continued Supply Until Withdrawal Rule" ;
    :hasCondition "existing orders for UNI-V Product Features are in place" ;
    :hasConsequence "nbn will continue supplying UNI-V Product Features in respect of existing orders until the UNI-V Product Feature is withdrawn on 31 January 2031, unless disconnected earlier" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

# Section 4.4(a) - UNI-DSL availability depends on Copper Pairs and xDSL port allocation
:UNI_DSL_Availability_Rule a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-DSL Availability Rule" ;
    :hasCondition "a Premises is served by the FTTB Network or FTTN Network" ;
    :hasConsequence "the number of UNI-DSLs available depends on: (i) the number of distinct nbn Copper Pairs installed at the Premises which terminate at an accessible xDSL port; and (ii) the allocation and installation by nbn of a single xDSL port to each distinct nbn Copper Pair" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.4(a), p.17" .

# Section 4.4(b) - AVC TC-4 requires UNI-DSL for FTTB and FTTN
:AVCTC4_ProductComponent_FTTBFTTN_UNIDSL a :Cl_AVCTC4_ProductComponent, owl:NamedIndividual ;
    rdfs:label "AVC TC-4 Product Component requiring UNI-DSL" ;
    :requires :UNI_DSL ;
    :isConditionOfSupplyFor :nbnEthernet_FTTB, :nbnEthernet_FTTN ;
    :sourceClause "nbn Ethernet Product Module, Section 4.4(b), p.17" .

:Rule_AVCTC4_Requires_UNIDSL a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "AVC TC-4 Requires UNI-DSL Rule" ;
    :hasCondition "an AVC TC-4 Product Component of nbn Ethernet (FTTB) or nbn Ethernet (FTTN) is supplied" ;
    :hasConsequence "RSP also acquires a UNI-DSL in conjunction with that AVC TC-4 for each Premises at which nbn Ethernet will be supplied" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.4(b), p.17" .

# Section 7 (Page 18) - No NTD or FTTC-NCD for FTTB/FTTN
:Rule_NoNTD_FTTB_FTTN a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "No NTD or FTTC-NCD for FTTB/FTTN Rule" ;
    :hasCondition "nbn Ethernet (FTTB) or nbn Ethernet (FTTN) is supplied" ;
    :hasConsequence "there is no NTD or FTTC-NCD used in connection with the supply of nbn Ethernet (FTTB) or nbn Ethernet (FTTN)" ;
    :sourceClause "nbn Ethernet Product Module, Section 7, p.18" .

# UNI-DSL Instance
:UNI_DSL_Instance a :UNI_DSL, owl:NamedIndividual ;
    rdfs:label "UNI-DSL Instance" ;
    rdfs:comment "An instance of a UNI-DSL. [extension: nbn Ethernet Product Module, Section 4.4, p.17]" . ---
