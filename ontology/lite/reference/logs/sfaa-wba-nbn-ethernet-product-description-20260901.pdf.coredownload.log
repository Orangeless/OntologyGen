--- CONTENT: # ===== EXTENSIONS FROM PAGE 9: AVC Description, AVC TC-4 Bandwidth Profiles, Business Rules =====
# New classes for AVC modeling
:AVC_TC_4 a owl:Class ;
    rdfs:label "AVC_TC_4" ;
    rdfs:subClassOf :AVC ;
    rdfs:comment "An AVC configured in traffic class 4 (default traffic class). [extension: nbn Ethernet Product Module, Section 3.1(c), p.10]" .

:AVC_TC_1 a owl:Class ;
    rdfs:label "AVC_TC_1" ;
    rdfs:subClassOf :AVC ;
    rdfs:comment "An AVC configured in traffic class 1 (optional). [extension: nbn Ethernet Product Module, Section 3.1(c), p.10]" .

:AVC_TC_2 a owl:Class ;
    rdfs:label "AVC_TC_2" ;
    rdfs:subClassOf :AVC ;
    rdfs:comment "An AVC configured in traffic class 2 (optional). [extension: nbn Ethernet Product Module, Section 3.1(c), p.10]" .

:UNI a owl:Class ;
    rdfs:label "UNI" ;
    rdfs:comment "User Network Interface: the physical or logical interface at a Premises that an AVC connects to. [extension: nbn Ethernet Product Module, Section 3.1(a), p.10]" .

:Premises a owl:Class ;
    rdfs:label "Premises" ;
    rdfs:comment "A location to which nbn Ethernet is supplied and served by a UNI. [extension: nbn Ethernet Product Module, Section 3.1(a), p.10]" .

:Cl_BandwidthProfile a owl:Class ;
    rdfs:label "Cl_BandwidthProfile" ;
    rdfs:comment "A reified bandwidth profile for an AVC TC-4, specifying downstream PIR, upstream PIR, and applicable network type. [extension: nbn Ethernet Product Module, Section 3.2, p.10]" .

# New object properties
:isConfiguredInTrafficClass a owl:ObjectProperty ;
    rdfs:label "isConfiguredInTrafficClass" ;
    rdfs:domain :AVC ;
    rdfs:range :TrafficClass ;
    rdfs:comment "Links an AVC to the traffic class in which it is configured. [extension: nbn Ethernet Product Module, Section 3.1(c), p.10]" .

:hasBandwidthProfile a owl:ObjectProperty ;
    rdfs:label "hasBandwidthProfile" ;
    rdfs:domain :AVC ;
    rdfs:range :Cl_BandwidthProfile ;
    rdfs:comment "Links an AVC to its reified bandwidth profile. [extension: nbn Ethernet Product Module, Section 3.2, p.10]" .

:isProfileOf a owl:ObjectProperty ;
    rdfs:label "isProfileOf" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range :AVC ;
    rdfs:comment "Links a bandwidth profile to the AVC it configures. [extension: nbn Ethernet Product Module, Section 3.2, p.10]" .

:servesPremises a owl:ObjectProperty ;
    rdfs:label "servesPremises" ;
    rdfs:domain :UNI ;
    rdfs:range :Premises ;
    rdfs:comment "Links a UNI to the Premises it serves. [extension: nbn Ethernet Product Module, Section 3.1(a), p.10]" .

:isOrderedForPremises a owl:ObjectProperty ;
    rdfs:label "isOrderedForPremises" ;
    rdfs:domain :AVC ;
    rdfs:range :Premises ;
    rdfs:comment "Links an AVC to the Premises for which it is ordered. [extension: nbn Ethernet Product Module, Section 3.1(b), p.10]" .

:isInCSA a owl:ObjectProperty ;
    rdfs:label "isInCSA" ;
    rdfs:domain :Premises ;
    rdfs:range :CSA ;
    rdfs:comment "Links a Premises to the CSA it belongs to. [extension: nbn Ethernet Product Module, Section 3.1(e), p.10]" .

:mapsOneAVCTC4ToUNI a owl:ObjectProperty ;
    rdfs:label "mapsOneAVCTC4ToUNI" ;
    rdfs:domain :Cl_Agent ;
    rdfs:range :UNI ;
    rdfs:comment "Links nbn to a UNI to indicate that nbn maps one AVC TC-4 to that UNI. [extension: nbn Ethernet Product Module, Section 3.1(f), p.10]" .

:appliesToNetworkType a owl:DatatypeProperty ;
    rdfs:label "appliesToNetworkType" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The nbn network type(s) to which a bandwidth profile applies (e.g. 'Fibre, FTTB, FTTN, FTTC, HFC, Wireless and Satellite'). [extension: nbn Ethernet Product Module, Section 3.2, p.10]" .

:hasDownstreamPirMbps a owl:DatatypeProperty ;
    rdfs:label "hasDownstreamPirMbps" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The downstream PIR value in Mbps for an AVC TC-4 bandwidth profile (may be a range like '300-1000'). [extension: nbn Ethernet Product Module, Section 3.2, p.10]" .

:hasUpstreamPirMbps a owl:DatatypeProperty ;
    rdfs:label "hasUpstreamPirMbps" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "The upstream PIR value in Mbps for an AVC TC-4 bandwidth profile (may be a range like '5-10'). [extension: nbn Ethernet Product Module, Section 3.2, p.10]" .

# ===== FACTS: Business Rules from Section 3.1 =====
# Rule 3.1(b): RSP must order an AVC for each Premises
:Rule_RSPMustOrderAVC a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "RSP Must Order AVC Rule" ;
    :hasCondition "nbn supplies nbn Ethernet to RSP" ;
    :hasConsequence "RSP must order an AVC for each Premises to which nbn Ethernet will be supplied" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(b), p.10" .

# Rule 3.1(c): nbn will configure AVC in traffic class 4 (default)
:Rule_NbnConfiguresAVCTC4 a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "nbn Configures AVC in TC-4 Rule" ;
    :hasCondition "RSP orders an AVC" ;
    :hasConsequence "nbn will configure the AVC to carry data in traffic class 4 (AVC TC-4)" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(c), p.10" .

# Rule 3.1(c): RSP may elect to partition AVC to carry TC-1, TC-2, or both
:Rule_RSPMayPartitionAVC a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "RSP May Partition AVC Rule" ;
    :hasCondition "RSP orders an AVC" ;
    :hasConsequence "RSP may elect to partition the AVC to additionally carry data in traffic class 1 (AVC TC-1), traffic class 2 (AVC TC-2), or both" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(c), p.10" .

# Rule 3.1(d): RSP must order AVC TC-4, may elect to order AVC TC-1, AVC TC-2, or both
:Rule_RSPMustOrderAVCTC4 a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "RSP Must Order AVC TC-4 Rule" ;
    :hasCondition "RSP orders an AVC" ;
    :hasConsequence "RSP must order an AVC TC-4, and may additionally elect to order one AVC TC-1, one AVC TC-2, or both, in any of the bandwidth profiles set out in sections 3.2, 3.3 and 3.4 subject to section 4.1.3 of, and Appendix B to, the nbn Ethernet Product Technical Specification" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(d), p.10" .

# Rule 3.1(e): For each AVC traffic class, RSP must order a CVC in the same traffic class
:Rule_RSPMustOrderCVCForAVCTC a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "RSP Must Order CVC for AVC Traffic Class Rule" ;
    :hasCondition "RSP orders an AVC traffic class in respect of a Premises in a CSA" ;
    :hasConsequence "RSP must order a CVC in the same traffic class in respect of that CSA" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(e), p.10" .

# Rule 3.1(f): nbn will map one AVC TC-4 to any UNI
:Rule_NbnMapsOneAVCTC4ToUNI a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "nbn Maps One AVC TC-4 to UNI Rule" ;
    :hasCondition "a UNI is used to serve a Premises" ;
    :hasConsequence "nbn will map one AVC TC-4 to that UNI and will not map more than one AVC TC-4 to the same UNI" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(f), p.10" .

# ===== FACTS: Contractual Events from Section 3.1 =====
# Event: RSP orders an AVC for a Premises
:Event_RSPOrdersAVC a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "RSP Orders AVC for Premises" ;
    :eventType "order an AVC for each Premises to which nbn Ethernet will be supplied" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVC_ObjectRole ;
    :governedBy :Rule_RSPMustOrderAVC ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(b), p.10" .

:AVC_ObjectRole a :AVC, owl:NamedIndividual ;
    rdfs:label "AVC (object role)" ;
    rdfs:comment "An AVC that is the object of contractual events. [extension: nbn Ethernet Product Module, Section 3.1, p.10]" .

# Event: nbn configures AVC in traffic class 4
:Event_NbnConfiguresAVCTC4 a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "nbn Configures AVC in TC-4" ;
    :eventType "configure the AVC to carry data in traffic class 4 (AVC TC-4)" ;
    :hasAgent :nbn ;
    :hasObject :AVC_ObjectRole ;
    :hasTrafficClass :TC_4 ;
    :governedBy :Rule_NbnConfiguresAVCTC4 ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(c), p.10" .

# Event: RSP elects to partition AVC to carry TC-1
:Event_RSPElectsPartitionTC1 a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "RSP Elects to Partition AVC to TC-1" ;
    :eventType "elect to partition the AVC to additionally carry data in traffic class 1 (AVC TC-1)" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVC_ObjectRole ;
    :hasTrafficClass :TC_1 ;
    :governedBy :Rule_RSPMayPartitionAVC ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(c), p.10" .

# Event: RSP elects to partition AVC to carry TC-2
:Event_RSPElectsPartitionTC2 a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "RSP Elects to Partition AVC to TC-2" ;
    :eventType "elect to partition the AVC to additionally carry data in traffic class 2 (AVC TC-2)" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVC_ObjectRole ;
    :hasTrafficClass :TC_2 ;
    :governedBy :Rule_RSPMayPartitionAVC ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(c), p.10" .

# Event: RSP orders AVC TC-4
:Event_RSPOrdersAVCTC4 a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "RSP Orders AVC TC-4" ;
    :eventType "order an AVC TC-4" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVC_ObjectRole ;
    :hasTrafficClass :TC_4 ;
    :governedBy :Rule_RSPMustOrderAVCTC4 ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(d), p.10" .

# Event: RSP orders AVC TC-1
:Event_RSPOrdersAVCTC1 a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "RSP Orders AVC TC-1" ;
    :eventType "elect to order one AVC TC-1" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVC_ObjectRole ;
    :hasTrafficClass :TC_1 ;
    :governedBy :Rule_RSPMustOrderAVCTC4 ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(d), p.10" .

# Event: RSP orders AVC TC-2
:Event_RSPOrdersAVCTC2 a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "RSP Orders AVC TC-2" ;
    :eventType "elect to order one AVC TC-2" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVC_ObjectRole ;
    :hasTrafficClass :TC_2 ;
    :governedBy :Rule_RSPMustOrderAVCTC4 ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(d), p.10" .

# Event: RSP orders CVC for AVC traffic class in respect of CSA
:Event_RSPOrdersCVCForAVCTC a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "RSP Orders CVC for AVC Traffic Class" ;
    :eventType "order a CVC in the same traffic class in respect of that CSA" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :CVC_ObjectRole ;
    :hasCSA :CSA_ObjectRole ;
    :governedBy :Rule_RSPMustOrderCVCForAVCTC ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(e), p.10" .

# Event: nbn maps one AVC TC-4 to a UNI
:Event_NbnMapsOneAVCTC4ToUNI a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "nbn Maps One AVC TC-4 to UNI" ;
    :eventType "map one AVC TC-4 to any UNI used to serve the relevant Premises" ;
    :hasAgent :nbn ;
    :hasObject :UNI_ObjectRole ;
    :governedBy :Rule_NbnMapsOneAVCTC4ToUNI ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(f), p.10" .

:UNI_ObjectRole a :UNI, owl:NamedIndividual ;
    rdfs:label "UNI (object role)" ;
    rdfs:comment "A UNI that is the object of contractual events. [extension: nbn Ethernet Product Module, Section 3.1(f), p.10]" .

