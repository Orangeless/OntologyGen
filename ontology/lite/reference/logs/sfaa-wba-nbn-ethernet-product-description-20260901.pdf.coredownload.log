:nbnEthernet_Fibre a :nbnEthernetProduct, owl:NamedIndividual ;
    rdfs:label "nbn Ethernet (Fibre)" ;
    rdfs:comment "nbn Ethernet product supplied via Fibre access technology. [extension: nbn Ethernet Product Module, Section 1.2, p.6]" .

:nbnEthernet_FTTB a :nbnEthernetProduct, owl:NamedIndividual ;
    rdfs:label "nbn Ethernet (FTTB)" ;
    rdfs:comment "nbn Ethernet product supplied via FTTB access technology. [extension: nbn Ethernet Product Module, Section 1.2, p.6]" .

:nbnEthernet_FTTN a :nbnEthernetProduct, owl:NamedIndividual ;
    rdfs:label "nbn Ethernet (FTTN)" ;
    rdfs:comment "nbn Ethernet product supplied via FTTN access technology. [extension: nbn Ethernet Product Module, Section 1.2, p.6]" .

:nbnEthernet_FTTC a :nbnEthernetProduct, owl:NamedIndividual ;
    rdfs:label "nbn Ethernet (FTTC)" ;
    rdfs:comment "nbn Ethernet product supplied via FTTC access technology. [extension: nbn Ethernet Product Module, Section 1.2, p.6]" .

:nbnEthernet_HFC a :nbnEthernetProduct, owl:NamedIndividual ;
    rdfs:label "nbn Ethernet (HFC)" ;
    rdfs:comment "nbn Ethernet product supplied via HFC access technology. [extension: nbn Ethernet Product Module, Section 1.2, p.6]" .

:nbnEthernet_Wireless a :nbnEthernetProduct, owl:NamedIndividual ;
    rdfs:label "nbn Ethernet (Wireless)" ;
    rdfs:comment "nbn Ethernet product supplied via Wireless access technology. [extension: nbn Ethernet Product Module, Section 1.2, p.6]" .

# New individual for AccessTechnology_SATELLITE
:AccessTechnology_SATELLITE a :AccessTechnology, owl:NamedIndividual ;
    rdfs:label "SATELLITE" ;
    rdfs:comment "Satellite access technology. [extension: nbn Ethernet Product Module, Section 1.1(f), p.6]" .

# Update AccessTechnology equivalentClass to include SATELLITE
:AccessTechnology a owl:Class ;
    rdfs:label "AccessTechnology" ;
    rdfs:comment "Access technology of a CSA (csas.tech; a CSA may have several, separated by '|')." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :AccessTechnology_FIBRE :AccessTechnology_FTTC :AccessTechnology_HFC :AccessTechnology_SATELLITE ) ] .

# ===== FACTS: Product-to-AccessTechnology mappings =====
:nbnEthernet_Satellite :suppliedByAccessTechnology :AccessTechnology_SATELLITE ;
    :sourceClause "nbn Ethernet Product Module, Section 1.1(f), p.6" .

:nbnEthernet_Fibre :suppliedByAccessTechnology :AccessTechnology_FIBRE ;
    :sourceClause "nbn Ethernet Product Module, Section 1.2, p.6" .

:nbnEthernet_FTTB :suppliedByAccessTechnology :AccessTechnology_FTTC ;
    :sourceClause "nbn Ethernet Product Module, Section 1.2, p.6" .

:nbnEthernet_FTTN :suppliedByAccessTechnology :AccessTechnology_FTTC ;
    :sourceClause "nbn Ethernet Product Module, Section 1.2, p.6" .

:nbnEthernet_FTTC :suppliedByAccessTechnology :AccessTechnology_FTTC ;
    :sourceClause "nbn Ethernet Product Module, Section 1.2, p.6" .

:nbnEthernet_HFC :suppliedByAccessTechnology :AccessTechnology_HFC ;
    :sourceClause "nbn Ethernet Product Module, Section 1.2, p.6" .

# ===== FACTS: NNI Bearer profile availability per access technology (Section 1.2 table) =====
# 1000BaseLX available for: Fibre, FTTB, FTTN, FTTC, HFC, Wireless and Satellite
:Profile_1000BaseLX :sourceClause "nbn Ethernet Product Module, Section 1.2, p.6" .

# 10GBaseLR available for: Fibre, FTTB, FTTN, FTTC, HFC, Wireless and Satellite
:Profile_10GBaseLR :sourceClause "nbn Ethernet Product Module, Section 1.2, p.6" .

# 100GBaseLR4 available for: Fibre, FTTB, FTTN, FTTC, HFC and Wireless (NOT Satellite)
:Profile_100GBaseLR4 :sourceClause "nbn Ethernet Product Module, Section 1.2, p.6" .

# 1000BaseEX available for: Fibre, FTTB, FTTN, FTTC, HFC, Wireless and Satellite
:Profile_1000BaseEX :sourceClause "nbn Ethernet Product Module, Section 1.2, p.6" .

# 10GBaseER available for: Fibre, FTTB, FTTN, FTTC, HFC, Wireless and Satellite
:Profile_10GBaseER :sourceClause "nbn Ethernet Product Module, Section 1.2, p.6" .

# 100GBaseER4 available for: Fibre, FTTB, FTTN, FTTC, HFC and Wireless (NOT Satellite)
:Profile_100GBaseER4 :sourceClause "nbn Ethernet Product Module, Section 1.2, p.6" .

# ===== FACTS: Business rules from Section 1.1(f) =====
# Rule 1: NNI supplied for nbn Ethernet (Satellite) not made available for other access technologies
# Rule 2: NNI supplied for other access technologies not made available for nbn Ethernet (Satellite)

# ===== FACTS: NNI Group rules from Section 1.3 =====
# 1.3(a): Bearer can only be member of NNI Group if interface rate matches
# 1.3(b): Each Bearer configured with single or diverse chassis redundancy mode
# 1.3(c): Single chassis is only mode for NNI Group with single Bearer ---
