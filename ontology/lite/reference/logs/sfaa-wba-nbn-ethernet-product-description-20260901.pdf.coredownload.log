--- CONTENT: # ===== EXTENSIONS FOR SECTION 4.6 (Page 18-19) - FTTC Network - UNI-D and nbn Downstream Network Boundary =====
# --- New Classes ---

:Cl_FTTCNetworkBoundary a owl:Class ;
    rdfs:label "Cl_FTTCNetworkBoundary" ;
    rdfs:comment "The nbn Downstream Network Boundary for the FTTC Network, determined by premises type (MDU vs non-MDU). [extension: nbn Ethernet Product Module, Section 4.6(b), p.19]" .

:Cl_FTTCCircuitTermination a owl:Class ;
    rdfs:label "Cl_FTTCCircuitTermination" ;
    rdfs:comment "A reified relationship representing the physical and electromagnetic termination of an AVC provided by the UNI-D at a premises served by the FTTC Network. [extension: nbn Ethernet Product Module, Section 4.6(a)(ii), p.19]" .

:Cl_FTTCNCD a owl:Class ;
    rdfs:label "Cl_FTTCNCD" ;
    rdfs:comment "The Fibre-to-the-Curb Network Connection Device at a premises served by the FTTC Network that hosts the UNI-D and is explicitly not a Network Termination Device. [extension: nbn Ethernet Product Module, Section 4.6(a)(i), p.19]" ;
    owl:disjointWith :NTD .

:Cl_CustomerSideMDF a owl:Class ;
    rdfs:label "Cl_CustomerSideMDF" ;
    rdfs:comment "The Customer Side MDF at an MDU site, which is the nbn Downstream Network Boundary for FTTC when the premises is at an MDU Site. [extension: nbn Ethernet Product Module, Section 4.6(b)(i), p.19]" .

:Cl_TelecommunicationsOutlet a owl:Class ;
    rdfs:label "Cl_TelecommunicationsOutlet" ;
    rdfs:comment "The first Telecommunications Outlet at a non-MDU premises, which is the nbn Downstream Network Boundary for FTTC when the premises is not at an MDU Site (or the Passive NTD if present). [extension: nbn Ethernet Product Module, Section 4.6(b)(ii), p.19]" .

:Cl_PassiveNTD a owl:Class ;
    rdfs:label "Cl_PassiveNTD" ;
    rdfs:comment "The Passive Network Termination Device at a non-MDU premises, which is the nbn Downstream Network Boundary for FTTC when present. [extension: nbn Ethernet Product Module, Section 4.6(b)(ii), p.19]" .

:Cl_MDUSite a owl:Class ;
    rdfs:label "Cl_MDUSite" ;
    rdfs:comment "A premises that is an MDU (Multi-Dwelling Unit) Site. [extension: nbn Ethernet Product Module, Section 4.6(b)(i), p.19]" ;
    rdfs:subClassOf :Premises .

# --- New Object Properties ---

:isDownstreamNetworkBoundaryFor a owl:ObjectProperty ;
    rdfs:label "isDownstreamNetworkBoundaryFor" ;
    rdfs:comment "Links the FTTC Network Boundary to the Premises for which it is the boundary. [extension: nbn Ethernet Product Module, Section 4.6(b), p.19]" ;
    rdfs:domain :Cl_FTTCNetworkBoundary ;
    rdfs:range :Premises .

:isRealizedBy a owl:ObjectProperty ;
    rdfs:label "isRealizedBy" ;
    rdfs:comment "Links the FTTC Network Boundary to the physical entity that realizes it (Customer Side MDF, Telecommunications Outlet, or Passive NTD). [extension: nbn Ethernet Product Module, Section 4.6(b), p.19]" ;
    rdfs:domain :Cl_FTTCNetworkBoundary ;
    rdfs:range owl:Thing .

:hosts a owl:ObjectProperty ;
    rdfs:label "hosts" ;
    rdfs:comment "Links an FTTC-NCD to the UNI-D it hosts. [extension: nbn Ethernet Product Module, Section 4.6(a)(i), p.19]" ;
    rdfs:domain :Cl_FTTCNCD ;
    rdfs:range :UNI_D .

:providesTerminationOf a owl:ObjectProperty ;
    rdfs:label "providesTerminationOf" ;
    rdfs:comment "Links a UNI-D to the AVC it provides termination of. [extension: nbn Ethernet Product Module, Section 4.6(a)(ii), p.19]" ;
    rdfs:domain :UNI_D ;
    rdfs:range :AVC .

:isLocatedOn a owl:ObjectProperty ;
    rdfs:label "isLocatedOn" ;
    rdfs:comment "Links a UNI-D to the FTTC-NCD on which it is located. [extension: nbn Ethernet Product Module, Section 4.6(a)(i), p.19]" ;
    rdfs:domain :UNI_D ;
    rdfs:range :Cl_FTTCNCD .

:isAtMDUSite a owl:DatatypeProperty ;
    rdfs:label "isAtMDUSite" ;
    rdfs:comment "Indicates if a Premises is at an MDU Site. [extension: nbn Ethernet Product Module, Section 4.6(b), p.19]" ;
    rdfs:domain :Premises ;
    rdfs:range xsd:boolean .

:hasTerminationType a owl:DatatypeProperty ;
    rdfs:label "hasTerminationType" ;
    rdfs:comment "The type of termination provided by a UNI-D (e.g. physical and electromagnetic). [extension: nbn Ethernet Product Module, Section 4.6(a)(ii), p.19]" ;
    rdfs:domain :Cl_FTTCCircuitTermination ;
    rdfs:range xsd:string .

