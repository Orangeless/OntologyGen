# New classes for AVC TC-1 and TC-2 modeling
:DataTransferRate a owl:Class ;
    rdfs:label "DataTransferRate" ;
    rdfs:comment "A reified data transfer rate value with unit (Mbps) for an AVC traffic class. [extension: nbn Ethernet Product Module, Section 3.3(b), p.13]" .
:InclusionCondition a owl:Class ;
    rdfs:label "InclusionCondition" ;
    rdfs:comment "A reified relationship representing the conditional or unconditional inclusion of one AVC traffic class's data transfer rate in another's. [extension: nbn Ethernet Product Module, Section 3.3(b), p.13]" .
:CIR_Objective a owl:Class ;
    rdfs:label "CIR_Objective" ;
    rdfs:comment "The committed information rate objective applicable at the nbn Downstream Network Boundary for a Premises, which may not be achievable. [extension: nbn Ethernet Product Module, Section 3.4(c), p.13]" .
:NetworkActivity a owl:Class ;
    rdfs:label "NetworkActivity" ;
    rdfs:subClassOf :Cl_ContractualEvent ;
    rdfs:comment "A network activity designated by nbn that may be required to address a CIR Objective not being achieved. [extension: nbn Ethernet Product Module, Section 3.4(c), p.13]" .
:InterferenceMitigation a owl:Class ;
    rdfs:label "InterferenceMitigation" ;
    rdfs:subClassOf :Cl_ContractualEvent ;
    rdfs:comment "An interference mitigation activity designated by nbn that may be required to address a CIR Objective not being achieved. [extension: nbn Ethernet Product Module, Section 3.4(c), p.13]" .
