    :atDownstreamNetworkBoundary true ;
    :appliesToPremises :Premises_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.4(c), p.13" .
:Premises_Instance a :Premises, owl:NamedIndividual ;
    rdfs:label "Premises Instance" ;
