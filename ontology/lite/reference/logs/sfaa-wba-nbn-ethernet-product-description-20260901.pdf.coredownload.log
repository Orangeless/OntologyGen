# ===== EXTENSIONS FROM PAGE 8: CVC TC-1 Bandwidth Profiles, Minimum AVCs for Satellite, CVC TC-2 =====

# New classes
:Cl_OrderableProductComponent a owl:Class ;
    rdfs:label \"Cl_OrderableProductComponent\" ;
    rdfs:comment \"A product component (like CVC TC-2) that an RSP may or must order, with a defined set of allowable bandwidth profiles. [extension: nbn Ethernet Product Module, Section 2.4, p.9]\" .

# New object properties
:appliesToCvc a owl:ObjectProperty ;
    rdfs:label \"appliesToCvc\" ;
    rdfs:domain :Cl_MinimumAvcRequirement ;
    rdfs:range :CVC ;
    rdfs:comment \"Links a minimum AVC requirement to the CVC it applies to. [extension: nbn Ethernet Product Module, Section 2.3(c), p.9]\" .

:appliesToAccessTechnology a owl:ObjectProperty ;
    rdfs:label \"appliesToAccessTechnology\" ;
    rdfs:domain :Cl_MinimumAvcRequirement ;
    rdfs:range :AccessTechnology ;
    rdfs:comment \"Links a minimum AVC requirement to the access technology it applies to. [extension: nbn Ethernet Product Module, Section 2.3(c), p.9]\" .

:appliesToProduct a owl:ObjectProperty ;
    rdfs:label \"appliesToProduct\" ;
    rdfs:domain :Cl_MinimumAvcRequirement ;
    rdfs:range :nbnEthernetProduct ;
    rdfs:comment \"Links a minimum AVC requirement to the nbn Ethernet product it applies to. [extension: nbn Ethernet Product Module, Section 2.3(c), p.9]\" .

:mayOrder a owl:ObjectProperty ;
    rdfs:label \"mayOrder\" ;
    rdfs:domain :RSP ;
    rdfs:range :Cl_OrderableProductComponent ;
    rdfs:comment \"RSP may order a product component. [extension: nbn Ethernet Product Module, Section 2.4(a), p.9]\" .

:mustSelect a owl:ObjectProperty ;
    rdfs:label \"mustSelect\" ;
    rdfs:domain :RSP ;
    rdfs:range :Cl_OrderableProductComponent ;
    rdfs:comment \"RSP must select a bandwidth profile for a product component. [extension: nbn Ethernet Product Module, Section 2.4(b), p.9]\" .

:hasAllowableBandwidthProfile a owl:DatatypeProperty ;
    rdfs:label \"hasAllowableBandwidthProfile\" ;
    rdfs:domain :Cl_OrderableProductComponent ;
    rdfs:range xsd:integer ;
    rdfs:comment \"An allowable bandwidth profile value (in Mbps) for an orderable product component like CVC TC-2. [extension: nbn Ethernet Product Module, Section 2.4(b), p.9]\" .

:hasListPosition a owl:DatatypeProperty ;
    rdfs:label \"hasListPosition\" ;
    rdfs:domain :Cl_OrderableProductComponent ;
    rdfs:range xsd:integer ;
    rdfs:comment \"The position in the ordered list of allowable bandwidth profiles. [extension: nbn Ethernet Product Module, Section 2.4(b), p.9]\" .

:hasLowerBound a owl:DatatypeProperty ;
    rdfs:label \"hasLowerBound\" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range xsd:integer ;
    rdfs:comment \"The lower bound of a bandwidth range in Mbps. [extension: nbn Ethernet Product Module, Section 2.3(b), p.9]\" .

:hasUpperBound a owl:DatatypeProperty ;
    rdfs:label \"hasUpperBound\" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range xsd:integer ;
    rdfs:comment \"The upper bound of a bandwidth range in Mbps. [extension: nbn Ethernet Product Module, Section 2.3(b), p.9]\" .

:hasIncrement a owl:DatatypeProperty ;
    rdfs:label \"hasIncrement\" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range xsd:integer ;
    rdfs:comment \"The increment value in Mbps for a bandwidth range. [extension: nbn Ethernet Product Module, Section 2.3(b), p.9]\" .

:hasUnit a owl:DatatypeProperty ;
    rdfs:label \"hasUnit\" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range xsd:string ;
    rdfs:comment \"The unit of measurement for bandwidth values (e.g. 'Mbps'). [extension: nbn Ethernet Product Module, Section 2.3(b), p.9]\" .

# CVC TC-1 and CVC TC-2 individuals
