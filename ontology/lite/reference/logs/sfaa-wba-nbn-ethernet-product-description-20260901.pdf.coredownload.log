# ===== ADDITIONAL FACTS: CVC TC-4 bandwidth profiles available for Satellite (Section 2.2(c)(ii)) =====
:Rule_CVCTC4_BWProfiles_Sat a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "CVC TC-4 Bandwidth Profiles for Satellite" ;
    :hasCondition "RSP orders a CVC TC-4 in respect of nbn Ethernet (Satellite)" ;
    :hasConsequence "the CVC TC-4 bandwidth profiles available are as set out in the relevant sections" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(c)(ii), p.7" .

# ===== ADDITIONAL FACTS: hasRedundancyMode object property for events =====
:hasRedundancyMode a owl:ObjectProperty ;
    rdfs:label "hasRedundancyMode" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range :RedundancyMode ;
    rdfs:comment "Links a contractual event to the redundancy mode involved. [extension: nbn Ethernet Product Module, Section 1.3(d)-(e), p.7]" . ---
