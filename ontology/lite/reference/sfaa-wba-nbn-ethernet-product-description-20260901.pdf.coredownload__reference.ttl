        :MinAvcReq_C2_Initial100,
        :MinAvcReq_C2_Initial25 ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(c)(ii), p.8",
        "nbn Ethernet Product Module, Section 2.2(e)(iii), p.8" ;
    rdfs:comment "CVC Class 2 for nbn Ethernet (Satellite). CIR increment: 25 Mbps. CIR range: 100-1,000. [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

:NNIGroup_ObjectRole_1 a :NNIGroup,
        owl:NamedIndividual ;
    rdfs:label "NNI Group (object role)" ;
    :hasState "activated" ;
    :sourceClause "nbn Ethernet Product Module, Section 1.3(f), p.7" ;
    rdfs:comment "An NNI Group that is the object of contractual events. [extension: nbn Ethernet Product Module, Section 1.3(d), p.7]" .

:Rule_RSPMustOrderAVCTC4 a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "RSP Must Order AVC TC-4 Rule" ;
    :hasCondition "RSP orders an AVC" ;
    :hasConsequence "RSP must order an AVC TC-4, and may additionally elect to order one AVC TC-1, one AVC TC-2, or both, in any of the bandwidth profiles set out in sections 3.2, 3.3 and 3.4 subject to section 4.1.3 of, and Appendix B to, the nbn Ethernet Product Technical Specification" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(d), p.10" .

:InterfaceTechnology a owl:Class ;
    rdfs:label "InterfaceTechnology" ;
    rdfs:comment "NNI interface technology (nni_groups.technology)." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :InterfaceTechnology_100GE :InterfaceTechnology_10GE :InterfaceTechnology_1GE ) ] .

:MaterialisationCoverage a owl:Class ;
    rdfs:label "MaterialisationCoverage" ;
    rdfs:comment "How many of a CVC's AVCs exist as explicit records." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :MaterialisationCoverage_COMPLETE :MaterialisationCoverage_PARTIAL :MaterialisationCoverage_NONE ) ] .

:NNILink a owl:Class ;
    rdfs:label "NNILink" ;
    rdfs:comment "WBA NNI Link / V-NNI / S-TAG concepts. Not modelled." ;
    skos:altLabel "NNI Link",
        "S-TAG",
        "V-NNI",
        "over-book" .

:RiskRating a owl:Class ;
    rdfs:label "RiskRating" ;
    rdfs:comment "CSA risk rating (csas.risk_rating)." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :RiskRating_High :RiskRating_Low :RiskRating_Medium ) ] .

:TC_2 a :TrafficClass,
        owl:NamedIndividual ;
    rdfs:label "TC-2" ;
    :name "Interactive" ;
    :planningThresholdPct 75.0 .

:CIR_Objective a owl:Class ;
    rdfs:label "CIR_Objective" ;
    rdfs:comment "The committed information rate objective applicable at the nbn Downstream Network Boundary for a Premises, which may not be achievable. [extension: nbn Ethernet Product Module, Section 3.4(c), p.13]" .

:Cl_CirIncrementRule a owl:Class ;
    rdfs:label "Cl_CirIncrementRule" ;
    rdfs:comment "A reified rule specifying the CIR increment for a given CVC Class for CVC TC-4 symmetrical Mbps (CIR). [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

:Cl_CirRangeRule a owl:Class ;
    rdfs:label "Cl_CirRangeRule" ;
    rdfs:comment "A reified rule specifying the CIR range for a given CVC Class for CVC TC-4 symmetrical Mbps (CIR). [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

:InclusionCondition a owl:Class ;
    rdfs:label "InclusionCondition" ;
    rdfs:comment "A reified relationship representing the conditional or unconditional inclusion of one AVC traffic class's data transfer rate in another's. [extension: nbn Ethernet Product Module, Section 3.3(b), p.13]" .

:POI a owl:Class ;
    rdfs:label "POI" ;
    rdfs:comment "Point of Interconnect: where CSAs and NNI Groups meet the wholesale network. One per region, hosted on aggregation devices." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "Local POI",
        "POI",
        "Point of Interconnect",
        "State Aggregation POI" .

:Premises a owl:Class ;
    rdfs:label "Premises" ;
    rdfs:comment "A location to which nbn Ethernet is supplied and served by a UNI. [extension: nbn Ethernet Product Module, Section 3.1(a), p.10]" .

:RedundancyMode a owl:Class ;
    rdfs:label "RedundancyMode" ;
    rdfs:comment "NNI Group redundancy mode (nni_groups.mode)." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :RedundancyMode_DIVERSE_CHASSIS :RedundancyMode_SINGLE :RedundancyMode_SINGLE_CHASSIS ) ] .

:TC_1 a :TrafficClass,
        owl:NamedIndividual ;
    rdfs:label "TC-1" ;
    :name "Priority / realtime" ;
    :planningThresholdPct 70.0 .

:AccessTechnology_FTTC a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTC" .

:Cl_Agent a owl:Class ;
    rdfs:label "Cl_Agent" ;
    rdfs:comment "A party that performs actions under the agreement. Superclass for RSP and nbn. [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

:Cl_PirIncrementRule a owl:Class ;
    rdfs:label "Cl_PirIncrementRule" ;
    rdfs:comment "A reified rule specifying the PIR increment for a given PIR range for CVC TC-4 symmetrical Mbps (PIR). [extension: nbn Ethernet Product Module, Section 2.2(c)(ii), p.8]" .

:PlanningResource a owl:Class ;
    rdfs:label "PlanningResource" ;
    rdfs:comment "Run-scoped planning inventory object (not a new physical asset). Superclass of POI, CSA, NNIGroup, CVC, PlanningLineCard, PlanningPort." .

:UNI a owl:Class ;
    rdfs:label "UNI" ;
    rdfs:comment "User Network Interface: the physical or logical interface at a Premises that an AVC connects to. [extension: nbn Ethernet Product Module, Section 3.1(a), p.10]" .

:AVC_ObjectRole a :AVC,
        owl:NamedIndividual ;
    rdfs:label "AVC (object role)" ;
    rdfs:comment "An AVC that is the object of contractual events. [extension: nbn Ethernet Product Module, Section 3.1, p.10]" .

:CVC_ObjectRole a :CVC,
        owl:NamedIndividual ;
    rdfs:label "CVC (object role)" ;
    :hasBandwidthProfile "to be selected by RSP" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(b), p.7" ;
    rdfs:comment "A CVC that is the object of contractual events. [extension: nbn Ethernet Product Module, Section 2, p.7]",
        "Ethernet-based Layer 2 virtual capacity on the nbn Network used to carry RSP traffic between multiple AVCs in a CSA on an aggregated basis and the NNI at the POI serving that CSA. [extension: nbn Ethernet Product Module, Section 2.1(a), p.7]" .

:Cl_CvcClass a owl:Class ;
    rdfs:label "Cl_CvcClass" ;
    rdfs:comment "A classification (0, 1, 2) for CVC TC-4 on nbn Ethernet (Satellite) that determines CIR increments and minimum AVC association rules. [extension: nbn Ethernet Product Module, Section 2.2(e), p.8]" .

:NNI a owl:Class ;
    rdfs:label "NNI" ;
    rdfs:comment "A single NNI within an NNI Group, realised on one Bearer." .

:NNIBearerProfile a owl:Class ;
    rdfs:label "NNIBearerProfile" ;
    rdfs:comment "Physical interface profile for an NNI Bearer (e.g. 1000BaseLX, 10GBaseLR). [extension: nbn Ethernet Product Module, Section 1.2, p.6]" .

:TC_4 a :TrafficClass,
        owl:NamedIndividual ;
    rdfs:label "TC-4" ;
    :name "Best effort / bulk" ;
    :planningThresholdPct 80.0 .

:TrafficClass a owl:Class ;
    rdfs:label "TrafficClass" ;
    rdfs:comment "Traffic class (TC-1, TC-2, TC-4) with a planning utilisation threshold." ;
    skos:altLabel "TC-1",
        "TC-2",
        "TC-4",
        "bandwidth profile",
        "traffic class" .

:nbn a :Cl_Agent,
        owl:NamedIndividual ;
    rdfs:label "nbn" ;
    rdfs:comment "The wholesale network provider (nbn co). [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

:AccessTechnology a owl:Class ;
    rdfs:label "AccessTechnology" ;
    rdfs:comment "Access technology of a CSA (csas.tech; a CSA may have several, separated by '|')." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :AccessTechnology_FIBRE :AccessTechnology_FTTC :AccessTechnology_HFC ) ],
        [ a owl:Class ;
            owl:oneOf ( :AccessTechnology_FIBRE :AccessTechnology_FTTC :AccessTechnology_HFC :AccessTechnology_SATELLITE :AccessTechnology_FTTB :AccessTechnology_FTTN :AccessTechnology_Wireless ) ] .

:nbnEthernetProduct a owl:Class ;
    rdfs:label "nbnEthernetProduct" ;
    rdfs:comment "An nbn Ethernet product variant distinguished by access technology (Satellite, Fibre, FTTB, etc.). [extension: nbn Ethernet Product Module, Section 1.1(f), p.6]" .

:ActionType a owl:Class ;
    rdfs:label "ActionType" ;
    rdfs:comment "Planning action types (legacy fixture action generation)." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :ActionType_INCREASE_CVC_BW :ActionType_ADD_PORT :ActionType_MOVE_CSA_LOAD :ActionType_REBALANCE_AVCS :ActionType_SPLIT_CAPACITY_POOL :ActionType_CREATE_NEW_NNI :ActionType_CREATE_NEW_CVC :ActionType_UPGRADE_PORT :ActionType_ADD_BACKHAUL :ActionType_ADD_AGGREGATION :ActionType_CREATE_RESILIENCE_PATH :ActionType_CREATE_NEW_BEARER ) ] .

:Cl_MinimumAvcRequirement a owl:Class ;
    rdfs:label "Cl_MinimumAvcRequirement" ;
    rdfs:comment "A reified rule specifying the minimum number of AVCs that must be associated with a CVC TC-4, conditional on CVC Class and bandwidth profile tier. [extension: nbn Ethernet Product Module, Section 2.2(e), p.8]" .

:RSP_AgentRole a :Cl_Agent,
        owl:NamedIndividual ;
    rdfs:label "RSP (agent role)" ;
    rdfs:comment "RSP acting as agent in contractual events. [extension: nbn Ethernet Product Module, Section 1.3(d), p.7]" .

:Bearer a owl:Class ;
    rdfs:label "Bearer" ;
    rdfs:comment "NNI Bearer: one physical interface of an NNI Group, landed on a line-card/port in a failure domain." ;
    skos:altLabel "Diverse Chassis",
        "NNI Bearer",
        "Redundancy Mode",
        "Single Chassis",
        "interface rate" .

:CSA a owl:Class ;
    rdfs:label "CSA" ;
    rdfs:comment "Connectivity Serving Area: a served area with services, premises and demand growth." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "CSA",
        "Connectivity Serving Area" .

:AVC a owl:Class ;
    rdfs:label "AVC" ;
    rdfs:comment "Access Virtual Circuit: per-service circuit that uses a CVC.",
        "An Access Virtual Circuit or AVC is an Ethernet-based Layer 2 virtual connection on the Fibre Network, FTTB Network, FTTN Network, FTTC Network, HFC Network, Wireless Network or Satellite Network that carries RSP traffic to and from a UNI used to serve a Premises. [extension: nbn Ethernet Product Module, Section 3.1(a), p.10]" ;
    skos:altLabel "AVC",
        "Access Virtual Circuit",
        "OVC",
        "Unicast 1:1 AVC" .

:CandidateAction a owl:Class ;
    rdfs:label "CandidateAction" ;
    rdfs:comment "Candidate planning action with lead time, cost, feasibility, blocking reasons and scores." ;
    skos:altLabel "Modify",
        "NNI Diversity Upgrade",
        "NNI Upsize Migration",
        "charge",
        "lead time",
        "order",
        "price" .

:CVC a owl:Class ;
    rdfs:label "CVC" ;
    rdfs:comment "Connectivity Virtual Circuit: carries a CSA's traffic over an NNI Group, with a traffic-class mix." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "CVC",
        "CVC TC-1",
        "CVC TC-2",
        "CVC TC-4",
        "Connectivity Virtual Circuit",
        "Unicast N:1 CVC" .

:Cl_BandwidthProfile a owl:Class ;
    rdfs:label "Cl_BandwidthProfile" ;
    rdfs:comment "A reified bandwidth profile configuration for a CVC TC-4, specifying PIR/CIR parameters, increments, ranges, and CVC Max flag. [extension: nbn Ethernet Product Module, Section 2.2, p.8]",
        "A reified bandwidth profile for an AVC TC-4, specifying downstream PIR, upstream PIR, and applicable network type. [extension: nbn Ethernet Product Module, Section 3.2, p.10]" .

:DataTransferRate a owl:Class ;
    rdfs:label "DataTransferRate" ;
    rdfs:comment "A reified data transfer rate value with unit (Mbps) for an AVC traffic class. [extension: nbn Ethernet Product Module, Section 3.3(b), p.13]" .

:NNIGroup a owl:Class ;
    rdfs:label "NNIGroup" ;
    rdfs:comment "Group of NNI Bearers/NNIs at a POI sharing a redundancy mode, interface rate and protected capacity." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "NNI",
        "NNI Group",
        "NNI Product Component",
        "Network-Network Interface" .

:Cl_BusinessRule a owl:Class ;
    rdfs:label "Cl_BusinessRule" ;
    rdfs:comment "A conditional statement (if-then) that governs the validity or outcome of a contractual event or state. [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .

:Cl_ContractualEvent a owl:Class ;
    rdfs:label "Cl_ContractualEvent" ;
    rdfs:comment "A reified event that captures an action or state change prescribed by the contract (e.g., selecting a redundancy mode, activating an NNI Group, ordering a CVC). [extension: nbn Ethernet Product Module, Section 1-2, p.7]" .


# ===== EXTENSIONS FROM DOCUMENTS: append new classes / properties / facts BELOW this line =====
# ===== EXTENSIONS FOR SECTIONS 3.5-3.8 (Page 14-15) =====

# --- New Classes ---

:Cl_InterferenceEvent a owl:Class ;
    rdfs:label "Cl_InterferenceEvent" ;
    rdfs:comment "An event caused by a third party's equipment or network that prejudices the integrity or causes deterioration of an nbn Ethernet (FTTB/FTTN/FTTC) Ordered Product. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" ;
    rdfs:subClassOf :Cl_ContractualEvent .

:Cl_OrderedProduct a owl:Class ;
    rdfs:label "Cl_OrderedProduct" ;
    rdfs:comment "An nbn Ethernet Ordered Product (FTTB, FTTN, FTTC) that can be affected by interference events. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" ;
    rdfs:subClassOf :AVC .

:Cl_ThirdPartyEquipmentOrNetwork a owl:Class ;
    rdfs:label "Cl_ThirdPartyEquipmentOrNetwork" ;
    rdfs:comment "Equipment or network of a third party that may cause an Interference Event. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" .

:Cl_Beam a owl:Class ;
    rdfs:label "Cl_Beam" ;
    rdfs:comment "Satellite capacity resource (beam) that may be at or near maximum capacity. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" .

:Cl_WirelessPlus a owl:Class ;
    rdfs:label "Cl_WirelessPlus" ;
    rdfs:comment "Wireless Plus product variant for which no PIR or CIR applies. [extension: nbn Ethernet Product Module, Section 3.8(a), p.15]" ;
    rdfs:subClassOf :nbnEthernetProduct .

:Cl_AVCOrder a owl:Class ;
    rdfs:label "Cl_AVCOrder" ;
    rdfs:comment "An event representing an AVC order placed by RSP. [extension: nbn Ethernet Product Module, Section 3.7(a), p.15]" ;
    rdfs:subClassOf :Cl_ContractualEvent .

:Cl_AVCModification a owl:Class ;
    rdfs:label "Cl_AVCModification" ;
    rdfs:comment "An event representing a modification to an AVC. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" ;
    rdfs:subClassOf :Cl_ContractualEvent .

:Cl_PublicInterestPremises a owl:Class ;
    rdfs:label "Cl_PublicInterestPremises" ;
    rdfs:comment "A Premises designated as a Public Interest Premises for which nbn may waive RSP obligations under section 39 of the nbn Ethernet Product Terms. [extension: nbn Ethernet Product Module, Section 3.7 Note, p.15]" ;
    rdfs:subClassOf :Premises .

# --- New Object Properties ---

:causedBy a owl:ObjectProperty ;
    rdfs:label "causedBy" ;
    rdfs:comment "Links an Interference Event to the third party equipment or network that caused it. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" ;
    rdfs:domain :Cl_InterferenceEvent ;
    rdfs:range :Cl_ThirdPartyEquipmentOrNetwork .

:affectsProduct a owl:ObjectProperty ;
    rdfs:label "affectsProduct" ;
    rdfs:comment "Links an Interference Event to the Ordered Product it affects. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" ;
    rdfs:domain :Cl_InterferenceEvent ;
    rdfs:range :Cl_OrderedProduct .

:triggers a owl:ObjectProperty ;
    rdfs:label "triggers" ;
    rdfs:comment "Links an Interference Event to the Interference Mitigation it triggers. [extension: nbn Ethernet Product Module, Section 3.6(b), p.15]" ;
    rdfs:domain :Cl_InterferenceEvent ;
    rdfs:range :InterferenceMitigation .

:isResponseTo a owl:ObjectProperty ;
    rdfs:label "isResponseTo" ;
    rdfs:comment "Links an Interference Mitigation to the Interference Event it responds to. [extension: nbn Ethernet Product Module, Section 3.6(b), p.15]" ;
    rdfs:domain :InterferenceMitigation ;
    rdfs:range :Cl_InterferenceEvent .

:isPerformedBy a owl:ObjectProperty ;
    rdfs:label "isPerformedBy" ;
    rdfs:comment "Links an Interference Mitigation to the agent that performs it. [extension: nbn Ethernet Product Module, Section 3.6(b), p.15]" ;
    rdfs:domain :InterferenceMitigation ;
    rdfs:range :Cl_Agent .

:resultsInState a owl:DatatypeProperty ;
    rdfs:label "resultsInState" ;
    rdfs:comment "The resulting state of an Ordered Product after an event. [extension: nbn Ethernet Product Module, Section 3.6(c), p.15]" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range xsd:string .

:hasProductState a owl:DatatypeProperty ;
    rdfs:label "hasProductState" ;
    rdfs:comment "The operational state of an Ordered Product. [extension: nbn Ethernet Product Module, Section 3.6(c), p.15]" ;
    rdfs:domain :Cl_OrderedProduct ;
    rdfs:range xsd:string .

:isAffectedBy a owl:ObjectProperty ;
    rdfs:label "isAffectedBy" ;
    rdfs:comment "Links an Ordered Product to the Interference Event that affects it. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" ;
    rdfs:domain :Cl_OrderedProduct ;
    rdfs:range :Cl_InterferenceEvent .

:requiresAdditionalBeamCapacity a owl:DatatypeProperty ;
    rdfs:label "requiresAdditionalBeamCapacity" ;
    rdfs:comment "Indicates if an AVC order or modification would require additional Beam capacity. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" ;
rdfs:domain :Cl_ContractualEvent ;
    rdfs:range xsd:boolean .

:isAtOrNearMaxCapacity a owl:DatatypeProperty ;
    rdfs:label "isAtOrNearMaxCapacity" ;
    rdfs:comment "Indicates if a Beam is at or near maximum capacity. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" ;
    rdfs:domain :Cl_Beam ;
    rdfs:range xsd:boolean .

:hasBeam a owl:ObjectProperty ;
    rdfs:label "hasBeam" ;
    rdfs:comment "Links an AVC order or modification to the Beam it would require capacity from. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range :Cl_Beam .

:deprioritisesDataTransfers a owl:DatatypeProperty ;
    rdfs:label "deprioritisesDataTransfers" ;
    rdfs:comment "Indicates if nbn may deprioritise data transfers for an AVC contributing disproportionately to Beam capacity utilisation. [extension: nbn Ethernet Product Module, Section 3.7(d), p.15]" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range xsd:boolean .

:reducesMaxDataTransferRate a owl:DatatypeProperty ;
    rdfs:label "reducesMaxDataTransferRate" ;
    rdfs:comment "Indicates if nbn may reduce the maximum data transfer rate of an AVC contributing disproportionately to Beam capacity utilisation. [extension: nbn Ethernet Product Module, Section 3.7(d), p.15]" ;
    rdfs:domain :Cl_ContractualEvent ;
    rdfs:range xsd:boolean .

:contributesDisproportionately a owl:DatatypeProperty ;
    rdfs:label "contributesDisproportionately" ;
    rdfs:comment "Indicates if an AVC contributes disproportionately to Beam capacity utilisation. [extension: nbn Ethernet Product Module, Section 3.7(d), p.15]" ;
    rdfs:domain :AVC ;
    rdfs:range xsd:boolean .

:hasPIR a owl:DatatypeProperty ;
    rdfs:label "hasPIR" ;
    rdfs:comment "Indicates if a Peak Information Rate applies. [extension: nbn Ethernet Product Module, Section 3.8(a), p.15]" ;
    rdfs:domain :Cl_WirelessPlus ;
    rdfs:range xsd:boolean .

:hasCIR a owl:DatatypeProperty ;
    rdfs:label "hasCIR" ;
    rdfs:comment "Indicates if a Committed Information Rate applies. [extension: nbn Ethernet Product Module, Section 3.8(a), p.15]" ;
    rdfs:domain :Cl_WirelessPlus ;
    rdfs:range xsd:boolean .

:mayDecline a owl:ObjectProperty ;
    rdfs:label "mayDecline" ;
    rdfs:comment "Links nbn to an AVC order or modification that nbn may decline. [extension: nbn Ethernet Product Module, Section 3.7(a), p.15]" ;
    rdfs:domain :Cl_Agent ;
    rdfs:range :Cl_ContractualEvent .

:resultsInMoreThanOneAVCTC4AndOneAVCTC1 a owl:DatatypeProperty ;
    rdfs:label "resultsInMoreThanOneAVCTC4AndOneAVCTC1" ;
    rdfs:comment "Indicates if an AVC order would result in nbn supplying more than one AVC TC-4 and one associated AVC TC-1 to all retail service providers in respect of a Premises. [extension: nbn Ethernet Product Module, Section 3.7(a), p.15]" ;
    rdfs:domain :Cl_AVCOrder ;
    rdfs:range xsd:boolean .

:isUsedForBonding a owl:DatatypeProperty ;
    rdfs:label "isUsedForBonding" ;
    rdfs:comment "Indicates if an RSP Product is being used in connection with the bonding of two or more UNIs. [extension: nbn Ethernet Product Module, Section 3.7(b), p.15]" ;
    rdfs:domain :AVC ;
    rdfs:range xsd:boolean .

:mustSuspendOrTerminate a owl:ObjectProperty ;
    rdfs:label "mustSuspendOrTerminate" ;
    rdfs:comment "Links RSP to an RSP Product that RSP must suspend or terminate. [extension: nbn Ethernet Product Module, Section 3.7(b), p.15]" ;
    rdfs:domain :RSP ;
    rdfs:range :AVC .

:waivedByNbn a owl:DatatypeProperty ;
    rdfs:label "waivedByNbn" ;
    rdfs:comment "Indicates if nbn has waived RSP's obligations in respect of a Public Interest Premises under section 39. [extension: nbn Ethernet Product Module, Section 3.7 Note, p.15]" ;
    rdfs:domain :Cl_PublicInterestPremises ;
    rdfs:range xsd:boolean .

# --- New Data Properties ---

:mitigationTimeframe a owl:DatatypeProperty ;
    rdfs:label "mitigationTimeframe" ;
    rdfs:comment "The timeframe within which nbn must undertake Interference Mitigation. [extension: nbn Ethernet Product Module, Section 3.6(b), p.15]" ;
    rdfs:domain :InterferenceMitigation ;
    rdfs:range xsd:string .

:lineRateNotCapable a owl:DatatypeProperty ;
    rdfs:label "lineRateNotCapable" ;
    rdfs:comment "Indicates if the Line Rate of an nbn Ethernet Ordered Product is not capable of supporting the provision of all AVC TC-1 and AVC TC-2 bandwidth profiles ordered by RSP. [extension: nbn Ethernet Product Module, Section 3.5, p.15]" ;
    rdfs:domain :Cl_OrderedProduct ;
    rdfs:range xsd:boolean .

# --- Individuals / Facts ---

# Section 3.5 - CIR limitation when Line Rate insufficient
:Rule_CIRLineRateInsufficient a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "CIR Line Rate Insufficient Rule" ;
    :hasCondition "the Line Rate of an nbn Ethernet Ordered Product is not capable of supporting the provision of all AVC TC-1 and AVC TC-2 bandwidth profiles ordered by RSP in respect of that Ordered Product (including as set out in sections 3.2.2 and 3.3.2 of the nbn Ethernet Product Technical Specification)" ;
    :hasConsequence "for both AVC TC-1 and AVC TC-2: (a) the Information Rate experienced by RSP, Downstream Service Provider and End Users may each be significantly less than the downstream CIR and upstream CIR of the bandwidth profile ordered by RSP; and (b) the Frame Delay, Frame Delay Variation and Frame Loss of the relevant Ordered Product may each be significantly worse than the Traffic Class performance specified in section 7.1 of the nbn Ethernet Product Technical Specification" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.5, p.15" .

# Section 3.6(a) - Interference Event concept
:Event_InterferenceEvent_FTTB a :Cl_InterferenceEvent, owl:NamedIndividual ;
    rdfs:label "Interference Event - FTTB" ;
    :eventType "Interference Event caused by the equipment or network of a third party prejudicing the integrity or causing deterioration of an nbn Ethernet (FTTB) Ordered Product" ;
    :causedBy :ThirdPartyEquipmentOrNetwork_Generic ;
    :affectsProduct :OrderedProduct_FTTB_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(a), p.15" .

:Event_InterferenceEvent_FTTN a :Cl_InterferenceEvent, owl:NamedIndividual ;
    rdfs:label "Interference Event - FTTN" ;
    :eventType "Interference Event caused by the equipment or network of a third party prejudicing the integrity or causing deterioration of an nbn Ethernet (FTTN) Ordered Product" ;
    :causedBy :ThirdPartyEquipmentOrNetwork_Generic ;
    :affectsProduct :OrderedProduct_FTTN_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(a), p.15" .

:Event_InterferenceEvent_FTTC a :Cl_InterferenceEvent, owl:NamedIndividual ;
    rdfs:label "Interference Event - FTTC" ;
    :eventType "Interference Event caused by the equipment or network of a third party prejudicing the integrity or causing deterioration of an nbn Ethernet (FTTC) Ordered Product" ;
    :causedBy :ThirdPartyEquipmentOrNetwork_Generic ;
    :affectsProduct :OrderedProduct_FTTC_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(a), p.15" .

:ThirdPartyEquipmentOrNetwork_Generic a :Cl_ThirdPartyEquipmentOrNetwork, owl:NamedIndividual ;
    rdfs:label "Third Party Equipment or Network" ;
    rdfs:comment "Generic representation of equipment or network of a third party that may cause an Interference Event. [extension: nbn Ethernet Product Module, Section 3.6(a), p.15]" .

:OrderedProduct_FTTB_Instance a :Cl_OrderedProduct, owl:NamedIndividual ;
    rdfs:label "nbn Ethernet (FTTB) Ordered Product" ;
    :hasProductState "operating normally" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(a), p.15" .

:OrderedProduct_FTTN_Instance a :Cl_OrderedProduct, owl:NamedIndividual ;
    rdfs:label "nbn Ethernet (FTTN) Ordered Product" ;
    :hasProductState "operating normally" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(a), p.15" .

:OrderedProduct_FTTC_Instance a :Cl_OrderedProduct, owl:NamedIndividual ;
    rdfs:label "nbn Ethernet (FTTC) Ordered Product" ;
    :hasProductState "operating normally" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(a), p.15" .

# Section 3.6(b) - Interference Mitigation obligation
:Event_InterferenceMitigation_Response a :InterferenceMitigation, owl:NamedIndividual ;
    rdfs:label "Interference Mitigation in response to Third Party Interference" ;
    :eventType "Interference Mitigation undertaken by nbn as soon as reasonably practicable in the circumstances" ;
    :isResponseTo :Event_InterferenceEvent_FTTB ;
    :isPerformedBy :nbn ;
    :mitigationTimeframe "as soon as reasonably practicable in the circumstances" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(b), p.15" .

# Section 3.6(c) - Affected Ordered Product state
:Event_InterferenceEvent_AffectsState a :Cl_InterferenceEvent, owl:NamedIndividual ;
    rdfs:label "Interference Event - Affected State" ;
    :eventType "Interference Event causing affected Ordered Product to not operate in accordance with the nbn Ethernet Product Description or the nbn Ethernet Product Technical Specification" ;
    :resultsInState "may not operate in accordance with this nbn Ethernet Product Description or the nbn Ethernet Product Technical Specification" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.6(c), p.15" .

# Section 3.7(a) - Satellite AVC order limit
:Rule_SatelliteAVCOrderLimit a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Satellite AVC Order Limit Rule" ;
    :hasCondition "RSP places an AVC order in respect of a Premises for nbn Ethernet (Satellite)" ;
    :hasConsequence "RSP must not place, and nbn may decline, an AVC order if the supply of the ordered AVC would result in nbn supplying more than one AVC TC-4 and one associated AVC TC-1 to all nbn's retail service providers in respect of that Premises" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(a), p.15" .

:Event_AVCOrder_Satellite_Declined a :Cl_AVCOrder, owl:NamedIndividual ;
    rdfs:label "AVC Order Declined - Satellite" ;
    :eventType "AVC order that would result in more than one AVC TC-4 and one associated AVC TC-1 per Premises" ;
    :resultsInMoreThanOneAVCTC4AndOneAVCTC1 true ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(a), p.15" .

# Section 3.7(b) - UNI bonding prohibition
:Rule_UNIBondingProhibition a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI Bonding Prohibition Rule" ;
    :hasCondition "RSP becomes aware that an RSP Product is being used by a Downstream Service Provider or End User in connection with the bonding of two or more UNIs (even if nbn is only supplying one of the UNIs to RSP and the other UNI(s) to an Other RSP)" ;
    :hasConsequence "RSP must suspend or terminate that RSP Product" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(b), p.15" .

# Section 3.7(c) - Beam capacity decline
:Rule_BeamCapacityDecline a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Beam Capacity Decline Rule" ;
    :hasCondition "an AVC order or AVC modification would require additional Beam capacity to be supplied during any period in which a Beam is at or near maximum capacity" ;
    :hasConsequence "nbn may decline that AVC order or AVC modification" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(c), p.15" .

:Beam_GenericInstance a :Cl_Beam, owl:NamedIndividual ;
    rdfs:label "Generic Beam" ;
    :isAtOrNearMaxCapacity true ;
    rdfs:comment "A beam that may be at or near maximum capacity. [extension: nbn Ethernet Product Module, Section 3.7(c), p.15]" .

:Event_AVCOrder_RequiringBeamCapacity a :Cl_AVCOrder, owl:NamedIndividual ;
    rdfs:label "AVC Order Requiring Additional Beam Capacity" ;
    :eventType "AVC order which would require additional Beam capacity to be supplied" ;
    :requiresAdditionalBeamCapacity true ;
    :hasBeam :Beam_GenericInstance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(c), p.15" .

:Event_AVCModification_RequiringBeamCapacity a :Cl_AVCModification, owl:NamedIndividual ;
    rdfs:label "AVC Modification Requiring Additional Beam Capacity" ;
    :eventType "AVC modification which would require additional Beam capacity to be supplied" ;
    :requiresAdditionalBeamCapacity true ;
    :hasBeam :Beam_GenericInstance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(c), p.15" .

# Section 3.7(d) - Beam capacity deprioritisation
:Rule_BeamDeprioritisation a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Beam Deprioritisation Rule" ;
    :hasCondition "an AVC contributes disproportionately to Beam capacity utilisation" ;
    :hasConsequence "nbn may deprioritise data transfers or reduce the maximum data transfer rate of that AVC" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(d), p.15" .

:Event_BeamDeprioritisation a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "Beam Deprioritisation Event" ;
    :eventType "nbn deprioritises data transfers or reduces the maximum data transfer rate of an AVC contributing disproportionately to Beam capacity utilisation" ;
    :hasAgent :nbn ;
    :deprioritisesDataTransfers true ;
    :reducesMaxDataTransferRate true ;
    :sourceClause "nbn Ethernet Product Module, Section 3.7(d), p.15" .

# Section 3.7 Note - Public Interest Premises waiver
:PublicInterestPremises_Instance a :Cl_PublicInterestPremises, owl:NamedIndividual ;
    rdfs:label "Public Interest Premises Instance" ;
    :waivedByNbn true ;
    rdfs:comment "A Public Interest Premises for which nbn may waive RSP's obligations under section 39 of the nbn Ethernet Product Terms. [extension: nbn Ethernet Product Module, Section 3.7 Note, p.15]" .

# Section 3.8 - Wireless Plus Information Rate
:WirelessPlus_Instance a :Cl_WirelessPlus, owl:NamedIndividual ;
    rdfs:label "Wireless Plus" ;
    :hasPIR false ;
    :hasCIR false ;
    rdfs:comment "Wireless Plus product for which no PIR or CIR applies. [extension: nbn Ethernet Product Module, Section 3.8(a), p.15]" .

:Rule_WirelessPlusNoPIRorCIR a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Wireless Plus No PIR or CIR Rule" ;
    :hasCondition "Wireless Plus is supplied" ;
    :hasConsequence "no PIR or CIR applies in respect of Wireless Plus" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.8(a), p.15" .
# ===== EXTENSIONS FOR SECTIONS 4.2-4.5 (Page 17-18) - UNI Types, AVC TC-4 Product Component, UNI-V Withdrawal =====""
:Cl_InterfaceType a owl:Class ;
    rdfs:label "Cl_InterfaceType" ;
    rdfs:comment "A reified class representing the type of interface (e.g. electrical, optical) for a UNI. [extension: nbn Ethernet Product Module, Section 4.2(b), p.17]" .

:Cl_ProductFeature a owl:Class ;
    rdfs:label "Cl_ProductFeature" ;
    rdfs:comment "An optional product feature that can be added to an nbn Ethernet product. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" .

:Cl_ProductFeatureState a owl:Class ;
    rdfs:label "Cl_ProductFeatureState" ;
    rdfs:comment "An enumeration of states in the lifecycle of a product feature: Orderable, Transition-out Only, Withdrawn. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:Cl_StateTransition a owl:Class ;
    rdfs:label "Cl_StateTransition" ;
    rdfs:comment "A reified state transition with a trigger and guard condition for a product feature lifecycle. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:Cl_AnalogueTelephoneAdaptor a owl:Class ;
    rdfs:label "Cl_AnalogueTelephoneAdaptor" ;
    rdfs:comment "An analogue telephone adaptor incorporated in the UNI-V product feature for the supply of telephony services to a Premises. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" .

:Cl_OrderType a owl:Class ;
    rdfs:label "Cl_OrderType" ;
    rdfs:comment "An enumeration of order types: Standard, Transition-out Modify, Disconnect. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:Cl_AVCTC4_ProductComponent a owl:Class ;
    rdfs:label "Cl_AVCTC4_ProductComponent" ;
    rdfs:comment "A specific product component (AVC TC-4) that is a required component for certain nbn Ethernet products, with conditional UNI requirements. [extension: nbn Ethernet Product Module, Section 4.2(c), p.17]" .

:UNI_DSL a owl:Class ;
    rdfs:label "UNI_DSL" ;
    rdfs:comment "User Network Interface - DSL, used for FTTB and FTTN networks. [extension: nbn Ethernet Product Module, Section 4.4, p.17]" ;
    rdfs:subClassOf :UNI .

# --- New Object Properties ---

:hasInterfaceType a owl:ObjectProperty ;
    rdfs:label "hasInterfaceType" ;
    rdfs:comment "Links a UNI to its reified interface type (e.g. electrical, optical). [extension: nbn Ethernet Product Module, Section 4.2(b), p.17]" ;
    rdfs:domain :UNI ;
    rdfs:range :Cl_InterfaceType .

:isOptionalProductFeatureOf a owl:ObjectProperty ;
    rdfs:label "isOptionalProductFeatureOf" ;
    rdfs:comment "Links a product feature to the nbn Ethernet product it is an optional feature of. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" ;
    rdfs:domain :Cl_ProductFeature ;
    rdfs:range :nbnEthernetProduct .

:incorporates a owl:ObjectProperty ;
    rdfs:label "incorporates" ;
    rdfs:comment "Links a product feature to a component it incorporates. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" ;
    rdfs:domain :Cl_ProductFeature ;
    rdfs:range :Cl_AnalogueTelephoneAdaptor .

:hasState a owl:ObjectProperty ;
    rdfs:label "hasState" ;
    rdfs:comment "Links a product feature to its current state in the lifecycle. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain :Cl_ProductFeature ;
    rdfs:range :Cl_ProductFeatureState .

:hasTrigger a owl:DatatypeProperty ;
    rdfs:label "hasTrigger" ;
    rdfs:comment "The trigger event for a state transition. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain :Cl_StateTransition ;
    rdfs:range xsd:string .

:hasGuard a owl:DatatypeProperty ;
    rdfs:label "hasGuard" ;
    rdfs:comment "The guard condition for a state transition. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain :Cl_StateTransition ;
    rdfs:range xsd:string .

:hasEffectiveDate a owl:DatatypeProperty ;
    rdfs:label "hasEffectiveDate" ;
    rdfs:comment "The effective date for a temporal constraint or event. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain owl:Thing ;
rdfs:range xsd:dateTime .

:withdrawnOn a owl:DatatypeProperty ;
    rdfs:label "withdrawnOn" ;
    rdfs:comment "The date on which a product feature is withdrawn. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain :Cl_ProductFeature ;
rdfs:range xsd:dateTime .

:issuedNoticeOn a owl:DatatypeProperty ;
    rdfs:label "issuedNoticeOn" ;
    rdfs:comment "The date on which a notice was issued. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain :Cl_ContractualEvent ;
rdfs:range xsd:dateTime .

:expiresOn a owl:DatatypeProperty ;
    rdfs:label "expiresOn" ;
    rdfs:comment "The date on which a period expires. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain owl:Thing ;
rdfs:range xsd:dateTime .

:mustNotSubmitOrderFor a owl:ObjectProperty ;
    rdfs:label "mustNotSubmitOrderFor" ;
    rdfs:comment "Links an RSP to the order types that must not be submitted for a product feature after a certain date. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
    rdfs:domain :RSP ;
    rdfs:range :Cl_OrderType .

:requires a owl:ObjectProperty ;
    rdfs:label "requires" ;
    rdfs:comment "Links an AVC TC-4 Product Component to the UNI type it requires as a condition of supply. [extension: nbn Ethernet Product Module, Section 4.2(c), p.17]" ;
    rdfs:domain :Cl_AVCTC4_ProductComponent ;
    rdfs:range :UNI .

:isConditionOfSupplyFor a owl:ObjectProperty ;
    rdfs:label "isConditionOfSupplyFor" ;
    rdfs:comment "Links an AVC TC-4 Product Component to the nbn Ethernet product variants for which it is a condition of supply. [extension: nbn Ethernet Product Module, Section 4.2(c), p.17]" ;
    rdfs:domain :Cl_AVCTC4_ProductComponent ;
    rdfs:range :nbnEthernetProduct .

:isAcquiredBy a owl:ObjectProperty ;
    rdfs:label "isAcquiredBy" ;
    rdfs:comment "Links an AVC TC-4 Product Component to the RSP that acquires it. [extension: nbn Ethernet Product Module, Section 4.2(c), p.17]" ;
    rdfs:domain :Cl_AVCTC4_ProductComponent ;
    rdfs:range :RSP .

:forEachPremises a owl:ObjectProperty ;
    rdfs:label "forEachPremises" ;
    rdfs:comment "Links an AVC TC-4 Product Component acquisition to the Premises at which it is supplied. [extension: nbn Ethernet Product Module, Section 4.2(c), p.17]" ;
    rdfs:domain :Cl_AVCTC4_ProductComponent ;
    rdfs:range :Premises .

:dependsOnNumberOfNTDs a owl:DatatypeProperty ;
    rdfs:label "dependsOnNumberOfNTDs" ;
    rdfs:comment "Indicates that the number of UNI-Ds available depends on the number and type of NTDs or FTTC-NCDs installed. [extension: nbn Ethernet Product Module, Section 4.2(a)(ii), p.17]" ;
    rdfs:domain :UNI_D ;
    rdfs:range xsd:boolean .

:dependsOnFootprint a owl:DatatypeProperty ;
    rdfs:label "dependsOnFootprint" ;
    rdfs:comment "Indicates that the number of UNI-Ds available depends on whether a Premises is located in the footprint of a network type. [extension: nbn Ethernet Product Module, Section 4.2(a)(i), p.17]" ;
    rdfs:domain :UNI_D ;
    rdfs:range xsd:boolean .

:dependsOnCopperPairs a owl:DatatypeProperty ;
    rdfs:label "dependsOnCopperPairs" ;
    rdfs:comment "Indicates that the number of UNI-DSLs available depends on the number of distinct nbn Copper Pairs installed. [extension: nbn Ethernet Product Module, Section 4.4(a)(i), p.17]" ;
    rdfs:domain :UNI_DSL ;
    rdfs:range xsd:boolean .

:dependsOnXDSLPortAllocation a owl:DatatypeProperty ;
    rdfs:label "dependsOnXDSLPortAllocation" ;
    rdfs:comment "Indicates that the number of UNI-DSLs available depends on the allocation and installation of a single xDSL port to each distinct nbn Copper Pair. [extension: nbn Ethernet Product Module, Section 4.4(a)(ii), p.17]" ;
    rdfs:domain :UNI_DSL ;
    rdfs:range xsd:boolean .

:dependsOnNTDVersion a owl:DatatypeProperty ;
    rdfs:label "dependsOnNTDVersion" ;
    rdfs:comment "Indicates that the number of UNI-Vs available depends on the number and version of NTDs installed. [extension: nbn Ethernet Product Module, Section 4.3(a), p.17]" ;
    rdfs:domain :UNI_V ;
    rdfs:range xsd:boolean .

# --- Individuals / Facts ---

# Section 4.2(a) - UNI-D availability depends on footprint and NTDs
:UNI_D_Availability_Rule a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-D Availability Rule" ;
    :hasCondition "a Premises is served by the Fibre Network, FTTC Network, HFC Network, Wireless Network or Satellite Network" ;
    :hasConsequence "the number of UNI-Ds available depends on: (i) whether the Premises is located in the footprint of those networks; and (ii) the number and type of NTDs or FTTC-NCDs installed at that Premises" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.2(a), p.17" .

# Section 4.2(b) - UNI-D has electrical interface
:InterfaceType_Electrical a :Cl_InterfaceType, owl:NamedIndividual ;
    rdfs:label "Electrical Interface" ;
    rdfs:comment "An electrical interface type for UNI-D. [extension: nbn Ethernet Product Module, Section 4.2(b), p.17]" .

:UNI_D_InterfaceType_Relation a owl:NamedIndividual ;
    rdfs:label "UNI-D has electrical interface" ;
    rdfs:comment "Reified relationship: UNI-D has an electrical interface and will not be made available with an optical interface. [extension: nbn Ethernet Product Module, Section 4.2(b), p.17]" ;
    :hasInterfaceType :InterfaceType_Electrical .

:Rule_UNID_ElectricalInterface a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-D Electrical Interface Rule" ;
    :hasCondition "UNI-D is made available" ;
    :hasConsequence "the UNI-D has an electrical interface and will not be made available with an optical interface" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.2(b), p.17" .

# Section 4.2(c) - AVC TC-4 requires UNI-D for Fibre, FTTC, HFC, Wireless, Satellite
:AVCTC4_ProductComponent_FibreUNID a :Cl_AVCTC4_ProductComponent, owl:NamedIndividual ;
    rdfs:label "AVC TC-4 Product Component requiring UNI-D" ;
    :requires :UNI_D ;
    :isConditionOfSupplyFor :nbnEthernet_Fibre, :nbnEthernet_FTTC, :nbnEthernet_HFC, :nbnEthernet_Wireless, :nbnEthernet_Satellite ;
    :sourceClause "nbn Ethernet Product Module, Section 4.2(c), p.17" .

:Rule_AVCTC4_Requires_UNID a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "AVC TC-4 Requires UNI-D Rule" ;
    :hasCondition "an AVC TC-4 Product Component of nbn Ethernet (Fibre), nbn Ethernet (FTTC), nbn Ethernet (HFC), nbn Ethernet (Wireless) or nbn Ethernet (Satellite) is supplied" ;
    :hasConsequence "RSP also acquires a UNI-D in conjunction with that AVC TC-4 for each Premises at which nbn Ethernet will be supplied" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.2(c), p.17" .

# Section 4.3(a) - UNI-V availability depends on NTDs
:UNI_V_Availability_Rule a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-V Availability Rule" ;
    :hasCondition "a Premises is served by the Fibre Network" ;
    :hasConsequence "the number of UNI-Vs available depends on the number and version of NTDs which nbn has installed at that Premises" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.3(a), p.17" .

# Section 4.3(b) - UNI-V is optional Product Feature of nbn Ethernet (Fibre), incorporates analogue telephone adaptor
:UNIV_ProductFeature a :Cl_ProductFeature, owl:NamedIndividual ;
    rdfs:label "UNI-V Product Feature" ;
    rdfs:comment "The UNI-V is an optional Product Feature of nbn Ethernet (Fibre) and incorporates an analogue telephone adaptor for the supply of telephony services to a Premises. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" ;
    :isOptionalProductFeatureOf :nbnEthernet_Fibre ;
    :incorporates :AnalogueTelephoneAdaptor_Instance .

:AnalogueTelephoneAdaptor_Instance a :Cl_AnalogueTelephoneAdaptor, owl:NamedIndividual ;
    rdfs:label "Analogue Telephone Adaptor" ;
    rdfs:comment "An analogue telephone adaptor incorporated in the UNI-V for the supply of telephony services to a Premises. [extension: nbn Ethernet Product Module, Section 4.3(b), p.17]" .

# Section 4.3 Notes - UNI-V withdrawal lifecycle
:Event_UNIV_NoticeIssued a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "UNI-V Notice Issued" ;
    :eventType "nbn issued a notice in relation to the withdrawal of the UNI-V Product Feature" ;
    :hasAgent :nbn ;
:issuedNoticeOn "2023-05-26T00:00:00"^^xsd:dateTime ;
    :sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

:UNIV_ContinuedOrderingPeriod a owl:NamedIndividual ;
    rdfs:label "UNI-V Continued Ordering Period" ;
    rdfs:comment "The Continued Ordering Period for the UNI-V Product Feature, expiring on 26 May 2024. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
:expiresOn "2024-05-26T00:00:00"^^xsd:dateTime .
:UNIV_WithdrawalDate a owl:NamedIndividual ;
    rdfs:label "UNI-V Withdrawal Date" ;
    rdfs:comment "The date on which the UNI-V Product Feature will be withdrawn: 31 January 2031. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" ;
:withdrawnOn "2031-01-31T00:00:00"^^xsd:dateTime .

# UNI-V Lifecycle States
:ProductFeatureState_Orderable a :Cl_ProductFeatureState, owl:NamedIndividual ;
    rdfs:label "Orderable" ;
    rdfs:comment "State in which the UNI-V Product Feature is orderable. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:ProductFeatureState_TransitionOutOnly a :Cl_ProductFeatureState, owl:NamedIndividual ;
    rdfs:label "Transition-out Only" ;
    rdfs:comment "State in which the UNI-V Product Feature can only be ordered via Transition-out Modify Order or Disconnect Order. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:ProductFeatureState_Withdrawn a :Cl_ProductFeatureState, owl:NamedIndividual ;
    rdfs:label "Withdrawn" ;
    rdfs:comment "State in which the UNI-V Product Feature is withdrawn. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

# UNI-V State Transitions
:UNIV_StateTransition_OrderableToTransitionOut a :Cl_StateTransition, owl:NamedIndividual ;
    rdfs:label "UNI-V: Orderable to Transition-out Only" ;
    :hasTrigger "expiry of Continued Ordering Period on 26 May 2024" ;
    :hasGuard "after 26 May 2024" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

:UNIV_StateTransition_TransitionOutToWithdrawn a :Cl_StateTransition, owl:NamedIndividual ;
    rdfs:label "UNI-V: Transition-out Only to Withdrawn" ;
    :hasTrigger "withdrawal date of 31 January 2031" ;
    :hasGuard "on 31 January 2031, unless disconnected earlier" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

# Order Types
:OrderType_Standard a :Cl_OrderType, owl:NamedIndividual ;
    rdfs:label "Standard Order" ;
    rdfs:comment "A standard order type. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:OrderType_TransitionOutModify a :Cl_OrderType, owl:NamedIndividual ;
    rdfs:label "Transition-out Modify Order" ;
    rdfs:comment "A Transition-out Modify Order type. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

:OrderType_Disconnect a :Cl_OrderType, owl:NamedIndividual ;
    rdfs:label "Disconnect Order" ;
    rdfs:comment "A Disconnect Order type. [extension: nbn Ethernet Product Module, Section 4.3 Notes, p.17]" .

# Business Rule: RSP must not submit Standard Order for UNI-V after Continued Ordering Period expiry
:Rule_UNIV_NoStandardOrder_AfterExpiry a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-V No Standard Order After Expiry Rule" ;
    :hasCondition "after the expiry of the Continued Ordering Period for the UNI-V Product Feature on 26 May 2024" ;
    :hasConsequence "RSP must not submit an order for a UNI-V Product Feature unless that order is a Transition-out Modify Order or Disconnect Order" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

:Rule_UNIV_ContinuedSupply_UntilWithdrawal a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-V Continued Supply Until Withdrawal Rule" ;
    :hasCondition "existing orders for UNI-V Product Features are in place" ;
    :hasConsequence "nbn will continue supplying UNI-V Product Features in respect of existing orders until the UNI-V Product Feature is withdrawn on 31 January 2031, unless disconnected earlier" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.3 Notes, p.17" .

# Section 4.4(a) - UNI-DSL availability depends on Copper Pairs and xDSL port allocation
:UNI_DSL_Availability_Rule a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-DSL Availability Rule" ;
    :hasCondition "a Premises is served by the FTTB Network or FTTN Network" ;
    :hasConsequence "the number of UNI-DSLs available depends on: (i) the number of distinct nbn Copper Pairs installed at the Premises which terminate at an accessible xDSL port; and (ii) the allocation and installation by nbn of a single xDSL port to each distinct nbn Copper Pair" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.4(a), p.17" .

# Section 4.4(b) - AVC TC-4 requires UNI-DSL for FTTB and FTTN
:AVCTC4_ProductComponent_FTTBFTTN_UNIDSL a :Cl_AVCTC4_ProductComponent, owl:NamedIndividual ;
    rdfs:label "AVC TC-4 Product Component requiring UNI-DSL" ;
    :requires :UNI_DSL ;
    :isConditionOfSupplyFor :nbnEthernet_FTTB, :nbnEthernet_FTTN ;
    :sourceClause "nbn Ethernet Product Module, Section 4.4(b), p.17" .

:Rule_AVCTC4_Requires_UNIDSL a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "AVC TC-4 Requires UNI-DSL Rule" ;
    :hasCondition "an AVC TC-4 Product Component of nbn Ethernet (FTTB) or nbn Ethernet (FTTN) is supplied" ;
    :hasConsequence "RSP also acquires a UNI-DSL in conjunction with that AVC TC-4 for each Premises at which nbn Ethernet will be supplied" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.4(b), p.17" .

# Section 7 (Page 18) - No NTD or FTTC-NCD for FTTB/FTTN
:Rule_NoNTD_FTTB_FTTN a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "No NTD or FTTC-NCD for FTTB/FTTN Rule" ;
    :hasCondition "nbn Ethernet (FTTB) or nbn Ethernet (FTTN) is supplied" ;
    :hasConsequence "there is no NTD or FTTC-NCD used in connection with the supply of nbn Ethernet (FTTB) or nbn Ethernet (FTTN)" ;
    :sourceClause "nbn Ethernet Product Module, Section 7, p.18" .

# UNI-DSL Instance
:UNI_DSL_Instance a :UNI_DSL, owl:NamedIndividual ;
    rdfs:label "UNI-DSL Instance" ;
    rdfs:comment "An instance of a UNI-DSL. [extension: nbn Ethernet Product Module, Section 4.4, p.17]" .
# ===== EXTENSIONS FOR SECTION 4.6 (Page 18-19) - FTTC Network - UNI-D and nbn Downstream Network Boundary =====
# --- New Classes ---

:Cl_FTTCNetworkBoundary a owl:Class ;
    rdfs:label "Cl_FTTCNetworkBoundary" ;
    rdfs:comment "The nbn Downstream Network Boundary for the FTTC Network, determined by premises type (MDU vs non-MDU). [extension: nbn Ethernet Product Module, Section 4.6(b), p.19]" .

:Cl_FTTCCircuitTermination a owl:Class ;
    rdfs:label "Cl_FTTCCircuitTermination" ;
    rdfs:comment "A reified relationship representing the physical and electromagnetic termination of an AVC provided by the UNI-D at a premises served by the FTTC Network. [extension: nbn Ethernet Product Module, Section 4.6(a)(ii), p.19]" .

:Cl_FTTCNCD a owl:Class ;
    rdfs:label "Cl_FTTCNCD" ;
    rdfs:comment "The Fibre-to-the-Curb Network Connection Device at a premises served by the FTTC Network that hosts the UNI-D and is explicitly not a Network Termination Device. [extension: nbn Ethernet Product Module, Section 4.6(a)(i), p.19]" ;
    owl:disjointWith :NTD .

:Cl_CustomerSideMDF a owl:Class ;
    rdfs:label "Cl_CustomerSideMDF" ;
    rdfs:comment "The Customer Side MDF at an MDU site, which is the nbn Downstream Network Boundary for FTTC when the premises is at an MDU Site. [extension: nbn Ethernet Product Module, Section 4.6(b)(i), p.19]" .

:Cl_TelecommunicationsOutlet a owl:Class ;
    rdfs:label "Cl_TelecommunicationsOutlet" ;
    rdfs:comment "The first Telecommunications Outlet at a non-MDU premises, which is the nbn Downstream Network Boundary for FTTC when the premises is not at an MDU Site (or the Passive NTD if present). [extension: nbn Ethernet Product Module, Section 4.6(b)(ii), p.19]" .

:Cl_PassiveNTD a owl:Class ;
    rdfs:label "Cl_PassiveNTD" ;
    rdfs:comment "The Passive Network Termination Device at a non-MDU premises, which is the nbn Downstream Network Boundary for FTTC when present. [extension: nbn Ethernet Product Module, Section 4.6(b)(ii), p.19]" .

:Cl_MDUSite a owl:Class ;
    rdfs:label "Cl_MDUSite" ;
    rdfs:comment "A premises that is an MDU (Multi-Dwelling Unit) Site. [extension: nbn Ethernet Product Module, Section 4.6(b)(i), p.19]" ;
    rdfs:subClassOf :Premises .

# --- New Object Properties ---

:isDownstreamNetworkBoundaryFor a owl:ObjectProperty ;
    rdfs:label "isDownstreamNetworkBoundaryFor" ;
    rdfs:comment "Links the FTTC Network Boundary to the Premises for which it is the boundary. [extension: nbn Ethernet Product Module, Section 4.6(b), p.19]" ;
    rdfs:domain :Cl_FTTCNetworkBoundary ;
    rdfs:range :Premises .

:isRealizedBy a owl:ObjectProperty ;
    rdfs:label "isRealizedBy" ;
    rdfs:comment "Links the FTTC Network Boundary to the physical entity that realizes it (Customer Side MDF, Telecommunications Outlet, or Passive NTD). [extension: nbn Ethernet Product Module, Section 4.6(b), p.19]" ;
    rdfs:domain :Cl_FTTCNetworkBoundary ;
    rdfs:range owl:Thing .

:hosts a owl:ObjectProperty ;
    rdfs:label "hosts" ;
    rdfs:comment "Links an FTTC-NCD to the UNI-D it hosts. [extension: nbn Ethernet Product Module, Section 4.6(a)(i), p.19]" ;
    rdfs:domain :Cl_FTTCNCD ;
    rdfs:range :UNI_D .

:providesTerminationOf a owl:ObjectProperty ;
    rdfs:label "providesTerminationOf" ;
    rdfs:comment "Links a UNI-D to the AVC it provides termination of. [extension: nbn Ethernet Product Module, Section 4.6(a)(ii), p.19]" ;
    rdfs:domain :UNI_D ;
    rdfs:range :AVC .

:isLocatedOn a owl:ObjectProperty ;
    rdfs:label "isLocatedOn" ;
    rdfs:comment "Links a UNI-D to the FTTC-NCD on which it is located. [extension: nbn Ethernet Product Module, Section 4.6(a)(i), p.19]" ;
    rdfs:domain :UNI_D ;
    rdfs:range :Cl_FTTCNCD .

:isAtMDUSite a owl:DatatypeProperty ;
    rdfs:label "isAtMDUSite" ;
    rdfs:comment "Indicates if a Premises is at an MDU Site. [extension: nbn Ethernet Product Module, Section 4.6(b), p.19]" ;
    rdfs:domain :Premises ;
    rdfs:range xsd:boolean .

:hasTerminationType a owl:DatatypeProperty ;
    rdfs:label "hasTerminationType" ;
    rdfs:comment "The type of termination provided by a UNI-D (e.g. physical and electromagnetic). [extension: nbn Ethernet Product Module, Section 4.6(a)(ii), p.19]" ;
    rdfs:domain :Cl_FTTCCircuitTermination ;
    rdfs:range xsd:string .

# --- Individuals / Facts ---

# Section 4.6(a)(i) - UNI-D is located on the FTTC-NCD
:FTTCNCD_Instance a :Cl_FTTCNCD, owl:NamedIndividual ;
    rdfs:label "FTTC-NCD Instance" ;
    rdfs:comment "An FTTC Network Connection Device at a premises served by the FTTC Network. [extension: nbn Ethernet Product Module, Section 4.6(a)(i), p.19]" .

:UNI_D_FTTC_Instance a :UNI_D, owl:NamedIndividual ;
    rdfs:label "UNI-D at FTTC Premises" ;
    rdfs:comment "A UNI-D at a Premises served by the FTTC Network. [extension: nbn Ethernet Product Module, Section 4.6(a), p.19]" ;
    :isLocatedOn :FTTCNCD_Instance .

# Section 4.6(a)(ii) - UNI-D provides physical and electromagnetic termination of the AVC
:FttcCircuitTermination_Instance a :Cl_FTTCCircuitTermination, owl:NamedIndividual ;
    rdfs:label "FTTC Circuit Termination Instance" ;
    rdfs:comment "The physical and electromagnetic termination of an AVC provided by the UNI-D at an FTTC premises. [extension: nbn Ethernet Product Module, Section 4.6(a)(ii), p.19]" ;
    :hasTerminationType "physical and electromagnetic" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.6(a)(ii), p.19" .

:UNI_D_FTTC_Instance :providesTerminationOf :AVC_ObjectRole .

# Section 4.6(a) - UNI-D is not the nbn Downstream Network Boundary for FTTC
:Rule_UNID_Not_FTTCBoundary a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-D is not FTTC Network Boundary Rule" ;
    rdfs:comment "The UNI-D at a Premises served by the FTTC Network is not the nbn Downstream Network Boundary for the FTTC Network. [extension: nbn Ethernet Product Module, Section 4.6(a), p.19]" ;
    :hasCondition "a UNI-D is at a Premises served by the FTTC Network" ;
    :hasConsequence "the UNI-D is not the nbn Downstream Network Boundary for the FTTC Network" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.6(a), p.19" .

# Section 4.6(b)(i) - FTTC Network Boundary for MDU Site is the Customer Side MDF
:FTTCNetworkBoundary_MDU a :Cl_FTTCNetworkBoundary, owl:NamedIndividual ;
    rdfs:label "FTTC Network Boundary - MDU Site" ;
    rdfs:comment "The nbn Downstream Network Boundary for a Premises served by the FTTC Network that is at an MDU Site. [extension: nbn Ethernet Product Module, Section 4.6(b)(i), p.19]" ;
    :isRealizedBy :CustomerSideMDF_Instance .

:CustomerSideMDF_Instance a :Cl_CustomerSideMDF, owl:NamedIndividual ;
    rdfs:label "Customer Side MDF Instance" ;
    rdfs:comment "The Customer Side MDF at an MDU site. [extension: nbn Ethernet Product Module, Section 4.6(b)(i), p.19]" .

:Premises_MDUSite_Instance a :Cl_MDUSite, owl:NamedIndividual ;
    rdfs:label "Premises at MDU Site" ;
    rdfs:comment "A Premises served by the FTTC Network that is at an MDU Site. [extension: nbn Ethernet Product Module, Section 4.6(b)(i), p.19]" ;
    :isAtMDUSite true .

:FTTCNetworkBoundary_MDU :isDownstreamNetworkBoundaryFor :Premises_MDUSite_Instance .

# Section 4.6(b)(ii) - FTTC Network Boundary for non-MDU Site is the first Telecommunications Outlet or Passive NTD
:FTTCNetworkBoundary_NonMDU a :Cl_FTTCNetworkBoundary, owl:NamedIndividual ;
    rdfs:label "FTTC Network Boundary - Non-MDU Site" ;
    rdfs:comment "The nbn Downstream Network Boundary for a Premises served by the FTTC Network that is not at an MDU Site. [extension: nbn Ethernet Product Module, Section 4.6(b)(ii), p.19]" .

:TelecommunicationsOutlet_Instance a :Cl_TelecommunicationsOutlet, owl:NamedIndividual ;
    rdfs:label "First Telecommunications Outlet Instance" ;
    rdfs:comment "The first Telecommunications Outlet at a non-MDU premises. [extension: nbn Ethernet Product Module, Section 4.6(b)(ii), p.19]" .

:PassiveNTD_Instance a :Cl_PassiveNTD, owl:NamedIndividual ;
    rdfs:label "Passive NTD Instance" ;
    rdfs:comment "A Passive Network Termination Device at a non-MDU premises. [extension: nbn Ethernet Product Module, Section 4.6(b)(ii), p.19]" .

:Premises_NonMDUSite_Instance a :Premises, owl:NamedIndividual ;
    rdfs:label "Premises not at MDU Site" ;
    rdfs:comment "A Premises served by the FTTC Network that is not at an MDU Site. [extension: nbn Ethernet Product Module, Section 4.6(b)(ii), p.19]" ;
    :isAtMDUSite false .

:FTTCNetworkBoundary_NonMDU :isDownstreamNetworkBoundaryFor :Premises_NonMDUSite_Instance .

# Rule: For non-MDU, boundary is first Telecommunications Outlet or Passive NTD
:Rule_FTTCBoundary_NonMDU a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "FTTC Network Boundary for Non-MDU Rule" ;
    rdfs:comment "For a Premises served by the FTTC Network that is not at an MDU Site, the nbn Downstream Network Boundary is the first Telecommunications Outlet or, if present, Passive NTD. [extension: nbn Ethernet Product Module, Section 4.6(b)(ii), p.19]" ;
    :hasCondition "a Premises served by the FTTC Network is not at an MDU Site" ;
    :hasConsequence "the nbn Downstream Network Boundary is the first Telecommunications Outlet or, if present, Passive NTD" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.6(b)(ii), p.19" .

# Rule: For MDU, boundary is Customer Side MDF
:Rule_FTTCBoundary_MDU a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "FTTC Network Boundary for MDU Rule" ;
    rdfs:comment "For a Premises served by the FTTC Network that is at an MDU Site, the nbn Downstream Network Boundary is the Customer Side MDF. [extension: nbn Ethernet Product Module, Section 4.6(b)(i), p.19]" ;
    :hasCondition "a Premises served by the FTTC Network is at an MDU Site" ;
    :hasConsequence "the nbn Downstream Network Boundary is the Customer Side MDF" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.6(b)(i), p.19" .

# Section 4.6(c) - FTTC-NCD is not a Network Termination Device
:Rule_FTTCNCD_Not_NTD a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "FTTC-NCD is not a Network Termination Device Rule" ;
    rdfs:comment "The FTTC-NCD is not a Network Termination Device. [extension: nbn Ethernet Product Module, Section 4.6(c), p.19]" ;
    :hasCondition "an FTTC-NCD is used" ;
    :hasConsequence "the FTTC-NCD is not a Network Termination Device" ;
    :sourceClause "nbn Ethernet Product Module, Section 4.6(c), p.19" .

# Table from Page 19 - FTTC AVC/UNI mapping
:AVCTC4_FTTC_Instance a :AVC_TC_4, owl:NamedIndividual ;
    rdfs:label "AVC TC-4 for FTTC" ;
    rdfs:comment "An AVC TC-4 mapped to a UNI-D for the FTTC Network. [extension: nbn Ethernet Product Module, Section 4.6 Table, p.19]" ;
    :isConfiguredInTrafficClass :TC_4 ;
    :mappedToUNI :UNI_D_FTTC_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 4.6 Table, p.19" .

:AVCTC1_FTTC_Instance a :AVC_TC_1, owl:NamedIndividual ;
    rdfs:label "AVC TC-1 for FTTC (default)" ;
    rdfs:comment "An AVC TC-1 mapped to a UNI-D for the FTTC Network (default mapping). [extension: nbn Ethernet Product Module, Section 4.6 Table, p.19]" ;
    :isConfiguredInTrafficClass :TC_1 ;
    :mappedToUNI :UNI_D_FTTC_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 4.6 Table, p.19" .

:AVCTC2_FTTC_Instance a :AVC_TC_2, owl:NamedIndividual ;
    rdfs:label "AVC TC-2 for FTTC" ;
    rdfs:comment "An AVC TC-2 mapped to a UNI-D for the FTTC Network. [extension: nbn Ethernet Product Module, Section 4.6 Table, p.19]" ;
    :isConfiguredInTrafficClass :TC_2 ;
    :mappedToUNI :UNI_D_FTTC_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 4.6 Table, p.19" .
# ===== EXTENSIONS FOR PART C - OPTIONAL PRODUCT FEATURES (Page 20-21) =====
# --- New Classes ---

:Cl_ServiceBundle a owl:Class ;
    rdfs:label "Cl_ServiceBundle" ;
    rdfs:comment "A composite offering that groups multiple product components and features into a single purchasable unit. [extension: nbn Ethernet Product Module, Part C, p.20]" .

:Cl_ServiceLimit a owl:Class ;
    rdfs:label "Cl_ServiceLimit" ;
    rdfs:comment "A quantitative or qualitative restriction on the supply or use of a service. [extension: nbn Ethernet Product Module, Part C, p.20]" .

:Cl_AreaType a owl:Class ;
    rdfs:label "Cl_AreaType" ;
    rdfs:comment "An enumeration of area types that may affect service availability (e.g. Isolated Area, Limited Access Area). [extension: nbn Ethernet Product Module, Section 5(f), p.20]" .

:EnhancedFaultRectificationService a owl:Class ;
    rdfs:label "EnhancedFaultRectificationService" ;
    rdfs:comment "An optional product feature that provides enhanced fault rectification for nbn Ethernet (Fibre). [extension: nbn Ethernet Product Module, Section 5, p.20]" ;
    rdfs:subClassOf :Cl_ProductFeature .

:Enhanced90DayVariant a owl:Class ;
    rdfs:label "Enhanced90DayVariant" ;
    rdfs:comment "The Enhanced (90 Day) - 12 (24/7) variant of the Enhanced Fault Rectification Service, which is automatically removed after 90 days unless reordered. [extension: nbn Ethernet Product Module, Section 5(e), p.20]" ;
    rdfs:subClassOf :EnhancedFaultRectificationService .

:SatelliteTestService a owl:Class ;
    rdfs:label "SatelliteTestService" ;
    rdfs:comment "An nbn Ethernet (Satellite) Ordered Product which allows RSP to conduct testing of applications, RSP Products, the RSP Network and the RSP Platform in connection with the Satellite Network. [extension: nbn Ethernet Product Module, Section 7(a), p.20]" ;
    rdfs:subClassOf :Cl_ServiceBundle .

:Cl_InstallationOfConnectingEquipment a owl:Class ;
    rdfs:label "Cl_InstallationOfConnectingEquipment" ;
    rdfs:comment "The installation of connecting equipment as a component of a service bundle. [extension: nbn Ethernet Product Module, Section 7(b)(iii), p.20]" .

# --- New Object Properties ---

:comprises a owl:ObjectProperty ;
    rdfs:label "comprises" ;
    rdfs:comment "Links a service bundle to its constituent components. [extension: nbn Ethernet Product Module, Section 7(b), p.20]" ;
    rdfs:domain :Cl_ServiceBundle ;
    rdfs:range owl:Thing .

:isAvailableFor a owl:ObjectProperty ;
    rdfs:label "isAvailableFor" ;
    rdfs:comment "Links a service bundle or product feature to the nbn Ethernet product it is available for. [extension: nbn Ethernet Product Module, Section 6, p.20]" ;
    rdfs:domain owl:Thing ;
    rdfs:range :nbnEthernetProduct .

:hasLimitValue a owl:DatatypeProperty ;
    rdfs:label "hasLimitValue" ;
    rdfs:comment "The numeric value of a service limit. [extension: nbn Ethernet Product Module, Section 7(c), p.20]" ;
    rdfs:domain :Cl_ServiceLimit ;
    rdfs:range xsd:integer .

:hasLimitCondition a owl:DatatypeProperty ;
    rdfs:label "hasLimitCondition" ;
    rdfs:comment "The condition under which a service limit applies (e.g. per Beam, in total). [extension: nbn Ethernet Product Module, Section 7(c), p.20]" ;
    rdfs:domain :Cl_ServiceLimit ;
    rdfs:range xsd:string .

:appliesTo a owl:ObjectProperty ;
    rdfs:label "appliesTo" ;
    rdfs:comment "Links a service limit to the service it governs. [extension: nbn Ethernet Product Module, Section 7(c), p.20]" ;
    rdfs:domain :Cl_ServiceLimit ;
    rdfs:range owl:Thing .

:isAutomaticallyRemovedAfter a owl:DatatypeProperty ;
    rdfs:label "isAutomaticallyRemovedAfter" ;
    rdfs:comment "The duration after which a service is automatically removed unless reordered. [extension: nbn Ethernet Product Module, Section 5(e), p.20]" ;
    rdfs:domain :Cl_ProductFeature ;
    rdfs:range xsd:string .

:hasValidityDuration a owl:DatatypeProperty ;
    rdfs:label "hasValidityDuration" ;
    rdfs:comment "The duration of validity for a service or feature. [extension: nbn Ethernet Product Module, Section 5(e), p.20]" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

:isMappedTo a owl:ObjectProperty ;
    rdfs:label "isMappedTo" ;
    rdfs:comment "Links an AVC TC-1 to the UNI-V it is mapped to. [extension: nbn Ethernet Product Module, Section 6(b), p.20]" ;
    rdfs:domain :AVC_TC_1 ;
    rdfs:range :UNI_V .

:isRequiredWith a owl:ObjectProperty ;
    rdfs:label "isRequiredWith" ;
    rdfs:comment "Links a product or feature to another product or feature that must be acquired in conjunction with it. [extension: nbn Ethernet Product Module, Section 6(b), p.20]" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

:allowsTestingOf a owl:DatatypeProperty ;
    rdfs:label "allowsTestingOf" ;
    rdfs:comment "Describes what the Satellite Test Service allows RSP to test. [extension: nbn Ethernet Product Module, Section 7(a), p.20]" ;
    rdfs:domain :SatelliteTestService ;
    rdfs:range xsd:string .

:isNotAvailableIn a owl:ObjectProperty ;
    rdfs:label "isNotAvailableIn" ;
    rdfs:comment "Links a product feature to an area type where it is not available. [extension: nbn Ethernet Product Module, Section 5(f), p.20]" ;
    rdfs:domain :Cl_ProductFeature ;
    rdfs:range :Cl_AreaType .

:isAssociatedWith a owl:ObjectProperty ;
    rdfs:label "isAssociatedWith" ;
    rdfs:comment "Links a Satellite Test Service component to the UNI it is associated with. [extension: nbn Ethernet Product Module, Section 7(b), p.20]" ;
    rdfs:domain owl:Thing ;
    rdfs:range :UNI .

:isOptionalComponentOf a owl:ObjectProperty ;
    rdfs:label "isOptionalComponentOf" ;
    rdfs:comment "Links an optional component to the service bundle it is part of. [extension: nbn Ethernet Product Module, Section 7(b)(ii), p.20]" ;
    rdfs:domain owl:Thing ;
    rdfs:range :Cl_ServiceBundle .

:isAcquiredInConjunctionWith a owl:ObjectProperty ;
    rdfs:label "isAcquiredInConjunctionWith" ;
    rdfs:comment "Links a bundle to another bundle that must also be acquired. [extension: nbn Ethernet Product Module, Section 6, p.20]" ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

:isAtDiscretionOf a owl:ObjectProperty ;
    rdfs:label "isAtDiscretionOf" ;
    rdfs:comment "Links a service or action to the party at whose discretion it is supplied or performed. [extension: nbn Ethernet Product Module, Section 7, p.20]" ;
    rdfs:domain owl:Thing ;
    rdfs:range :Cl_Agent .

:hasOnboardingStatus a owl:DatatypeProperty ;
    rdfs:label "hasOnboardingStatus" ;
    rdfs:comment "The onboarding status of RSP for a particular nbn Ethernet product. [extension: nbn Ethernet Product Module, Section 7(d)(i), p.20]" ;
    rdfs:domain :RSP ;
    rdfs:range xsd:string .

:determinesActingReasonably a owl:DatatypeProperty ;
    rdfs:label "determinesActingReasonably" ;
    rdfs:comment "The determination made by nbn, acting reasonably, regarding RSP's requirement for a service. [extension: nbn Ethernet Product Module, Section 7(d)(ii), p.20]" ;
    rdfs:domain :nbn ;
    rdfs:range xsd:string .

# --- Individuals / Facts ---

# Section 5 - Enhanced Fault Rectification Service
:EnhancedFaultRectificationService_Instance a :EnhancedFaultRectificationService, owl:NamedIndividual ;
    rdfs:label "Enhanced Fault Rectification Service" ;
    rdfs:comment "An optional product feature providing enhanced fault rectification for nbn Ethernet (Fibre). [extension: nbn Ethernet Product Module, Section 5, p.20]" ;
    :isOptionalProductFeatureOf :nbnEthernet_Fibre ;
    :sourceClause "nbn Ethernet Product Module, Section 5, p.20" .

:Enhanced90DayVariant_Instance a :Enhanced90DayVariant, owl:NamedIndividual ;
    rdfs:label "Enhanced (90 Day) - 12 (24/7)" ;
    rdfs:comment "The Enhanced (90 Day) - 12 (24/7) variant of the Enhanced Fault Rectification Service. [extension: nbn Ethernet Product Module, Section 5(e), p.20]" ;
    :isAutomaticallyRemovedAfter "90 days" ;
    :hasValidityDuration "90 days" ;
    :sourceClause "nbn Ethernet Product Module, Section 5(e), p.20" .

# Section 5(e) - Automatic removal event
:Event_Enhanced90Day_AutomaticRemoval a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "Enhanced (90 Day) Automatic Removal Event" ;
    :eventType "automatic removal of Enhanced (90 Day) - 12 (24/7) service at the end of the 90 day period unless RSP orders it again" ;
    :hasObject :Enhanced90DayVariant_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 5(e), p.20" .

# Section 5(e) - Reorder event
:Event_Enhanced90Day_Reorder a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "Enhanced (90 Day) Reorder Event" ;
    :eventType "RSP orders Enhanced (90 Day) - 12 (24/7) again from the expiry of the relevant 90 day period" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :Enhanced90DayVariant_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 5(e), p.20" .

# Section 5(f) - Not available in Isolated Area or Limited Access Area
:AreaType_IsolatedArea a :Cl_AreaType, owl:NamedIndividual ;
    rdfs:label "Isolated Area" ;
    rdfs:comment "An Isolated Area where the Enhanced Fault Rectification Service is not available. [extension: nbn Ethernet Product Module, Section 5(f), p.20]" .

:AreaType_LimitedAccessArea a :Cl_AreaType, owl:NamedIndividual ;
    rdfs:label "Limited Access Area" ;
    rdfs:comment "A Limited Access Area where the Enhanced Fault Rectification Service is not available. [extension: nbn Ethernet Product Module, Section 5(f), p.20]" .

:EnhancedFaultRectificationService_Instance :isNotAvailableIn :AreaType_IsolatedArea, :AreaType_LimitedAccessArea .

:Rule_EnhancedFaultRectification_NotAvailable_IsolatedLimited a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Enhanced Fault Rectification Not Available in Isolated/Limited Access Area Rule" ;
    :hasCondition "a Premises is in an Isolated Area or Limited Access Area" ;
    :hasConsequence "the Enhanced Fault Rectification Service is not available in respect of that Premises" ;
    :sourceClause "nbn Ethernet Product Module, Section 5(f), p.20" .

# Section 6 - UNI-V and AVC TC-1 bundle
:UNIV_AVCTC1_Bundle a :Cl_ServiceBundle, owl:NamedIndividual ;
    rdfs:label "UNI-V and AVC TC-1 Bundle" ;
    rdfs:comment "The UNI-V and AVC TC-1 bundle which is a feature of nbn Ethernet designed for voice services over nbn Ethernet. [extension: nbn Ethernet Product Module, Section 6, p.20]" ;
    :isAvailableFor :nbnEthernet_Fibre ;
    :isAcquiredInConjunctionWith :AVCTC4_UNID_Bundle_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 6, p.20" .

:AVCTC4_UNID_Bundle_Instance a :Cl_ServiceBundle, owl:NamedIndividual ;
    rdfs:label "AVC TC-4 and UNI-D Bundle" ;
    rdfs:comment "The AVC TC-4 and UNI-D bundle that RSP must also acquire to be eligible for the UNI-V and AVC TC-1 bundle. [extension: nbn Ethernet Product Module, Section 6, p.20]" ;
    :sourceClause "nbn Ethernet Product Module, Section 6, p.20" .

:Rule_UNIV_AVCTC1_Bundle_Availability a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-V and AVC TC-1 Bundle Availability Rule" ;
    :hasCondition "RSP wants to acquire the UNI-V and AVC TC-1 bundle" ;
    :hasConsequence "the bundle is only available for nbn Ethernet (Fibre) and where RSP has also acquired an AVC TC-4 and UNI-D bundle" ;
    :sourceClause "nbn Ethernet Product Module, Section 6, p.20" .

# Section 6(a) - UNI-V is optional Product Feature of nbn Ethernet (Fibre)
:UNIV_ProductFeature_Instance a :Cl_ProductFeature, owl:NamedIndividual ;
    rdfs:label "UNI-V Product Feature" ;
    rdfs:comment "The UNI-V is an optional Product Feature of nbn Ethernet (Fibre) which provides RSP with access to an analogue telephony interface on the NTD (where available) for the purpose of migrating legacy telephone services. [extension: nbn Ethernet Product Module, Section 6(a), p.20]" ;
    :isOptionalProductFeatureOf :nbnEthernet_Fibre ;
    :sourceClause "nbn Ethernet Product Module, Section 6(a), p.20" .

# Section 6(b) - RSP may elect to order 0.15 Mbps AVC TC-1 mapped to UNI-V
:AVCTC1_0_15_UNIV_Instance a :AVC_TC_1, owl:NamedIndividual ;
    rdfs:label "AVC TC-1 0.15 Mbps mapped to UNI-V" ;
    rdfs:comment "A 0.15 Mbps AVC TC-1 which is mapped to the UNI-V (where available) in the case of nbn Ethernet (Fibre). [extension: nbn Ethernet Product Module, Section 6(b), p.20]" ;
    :isConfiguredInTrafficClass :TC_1 ;
    :isMappedTo :UNI_V_Instance ;
    :hasDataTransferRate :DataTransferRate_AVCTC1_0_15 ;
    :sourceClause "nbn Ethernet Product Module, Section 6(b), p.20" .

:Rule_AVCTC1_UNIV_RequiresUNIV a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "AVC TC-1 mapped to UNI-V requires UNI-V Rule" ;
    :hasCondition "RSP elects to order a 0.15 Mbps AVC TC-1 which is mapped to the UNI-V" ;
    :hasConsequence "RSP must acquire a UNI-V in conjunction with that AVC TC-1" ;
    :sourceClause "nbn Ethernet Product Module, Section 6(b), p.20" .

# Section 6(c) - AVC TC-1 mapped to UNI-V supplied through separate AVC
:Rule_AVCTC1_UNIV_SeparateAVC a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "AVC TC-1 mapped to UNI-V supplied through separate AVC Rule" ;
    :hasCondition "the AVC TC-1 is mapped to the UNI-V" ;
    :hasConsequence "the 0.15 Mbps AVC TC-1 will be supplied through a separate AVC and not included in the overall AVC TC-4 Data Transfer Rate" ;
    :sourceClause "nbn Ethernet Product Module, Section 6(c), p.20" .

# Section 6(d) - Permitted use of UNI-V
:Rule_UNIV_PermittedUse a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "UNI-V Permitted Use Rule" ;
    :hasCondition "RSP uses the UNI-V" ;
    :hasConsequence "RSP may only use the UNI-V to transmit voice and data traffic in the voice band" ;
    :sourceClause "nbn Ethernet Product Module, Section 6(d), p.20" .

# Section 7 - Satellite Test Service
:SatelliteTestService_Instance a :SatelliteTestService, owl:NamedIndividual ;
    rdfs:label "Satellite Test Service" ;
    rdfs:comment "An nbn Ethernet (Satellite) Ordered Product which allows RSP to conduct testing of applications, RSP Products, the RSP Network and the RSP Platform in connection with the Satellite Network. [extension: nbn Ethernet Product Module, Section 7(a), p.20]" ;
    :isAvailableFor :nbnEthernet_Satellite ;
    :allowsTestingOf "applications, RSP Products, the RSP Network and the RSP Platform in connection with the Satellite Network" ;
    :isAtDiscretionOf :nbn ;
    :sourceClause "nbn Ethernet Product Module, Section 7(a), p.20" .

# Section 7(b) - Components of Satellite Test Service
:SatelliteTestService_Instance :comprises :AVCTC4_SatelliteTest_Instance, :UNI_SatelliteTest_Instance, :AVCTC1_SatelliteTest_Optional_Instance, :InstallationOfConnectingEquipment_SatelliteTest_Instance .

:AVCTC4_SatelliteTest_Instance a :AVC_TC_4, owl:NamedIndividual ;
    rdfs:label "AVC TC-4 for Satellite Test Service" ;
    rdfs:comment "An AVC TC-4 supplied as part of the Satellite Test Service. [extension: nbn Ethernet Product Module, Section 7(b)(i), p.20]" ;
    :isConfiguredInTrafficClass :TC_4 ;
    :sourceClause "nbn Ethernet Product Module, Section 7(b)(i), p.20" .

:UNI_SatelliteTest_Instance a :UNI, owl:NamedIndividual ;
    rdfs:label "UNI associated with Satellite Test Service" ;
    rdfs:comment "A UNI associated with the AVC TC-4 supplied as part of the Satellite Test Service. [extension: nbn Ethernet Product Module, Section 7(b)(i), p.20]" ;
    :sourceClause "nbn Ethernet Product Module, Section 7(b)(i), p.20" .

:AVCTC4_SatelliteTest_Instance :mappedToUNI :UNI_SatelliteTest_Instance .

:AVCTC1_SatelliteTest_Optional_Instance a :AVC_TC_1, owl:NamedIndividual ;
    rdfs:label "Optional AVC TC-1 for Satellite Test Service" ;
    rdfs:comment "An optional AVC TC-1 associated with the same UNI as the AVC TC-4 in the Satellite Test Service. [extension: nbn Ethernet Product Module, Section 7(b)(ii), p.20]" ;
    :isConfiguredInTrafficClass :TC_1 ;
    :isOptionalComponentOf :SatelliteTestService_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 7(b)(ii), p.20" .

:AVCTC1_SatelliteTest_Optional_Instance :isAssociatedWith :UNI_SatelliteTest_Instance .

:InstallationOfConnectingEquipment_SatelliteTest_Instance a :Cl_InstallationOfConnectingEquipment, owl:NamedIndividual ;
    rdfs:label "Installation of Connecting Equipment for Satellite Test Service" ;
    rdfs:comment "The Installation of Connecting Equipment supplied as part of the Satellite Test Service. [extension: nbn Ethernet Product Module, Section 7(b)(iii), p.20]" ;
    :sourceClause "nbn Ethernet Product Module, Section 7(b)(iii), p.20" .

# Section 7(c) - Limits on Satellite Test Service
:SatelliteTestService_Limit_Total a :Cl_ServiceLimit, owl:NamedIndividual ;
    rdfs:label "Satellite Test Service Total Limit" ;
    rdfs:comment "Maximum of five Satellite Test Services in total. [extension: nbn Ethernet Product Module, Section 7(c)(i), p.20]" ;
    :appliesTo :SatelliteTestService_Instance ;
    :hasLimitValue 5 ;
    :hasLimitCondition "in total" ;
    :sourceClause "nbn Ethernet Product Module, Section 7(c)(i), p.20" .

:SatelliteTestService_Limit_PerBeam a :Cl_ServiceLimit, owl:NamedIndividual ;
    rdfs:label "Satellite Test Service Per Beam Limit" ;
    rdfs:comment "Maximum of one Satellite Test Service per Beam. [extension: nbn Ethernet Product Module, Section 7(c)(ii), p.20]" ;
    :appliesTo :SatelliteTestService_Instance ;
    :hasLimitValue 1 ;
    :hasLimitCondition "per Beam" ;
    :sourceClause "nbn Ethernet Product Module, Section 7(c)(ii), p.20" .

# Section 7(d) - Conditions for supply of Satellite Test Service
:Rule_SatelliteTestService_OnboardingCondition a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Satellite Test Service Onboarding Condition Rule" ;
    :hasCondition "RSP requests a Satellite Test Service" ;
    :hasConsequence "nbn will only supply the Satellite Test Service if RSP has successfully On-boarded, or is in the process of On-boarding, for nbn Ethernet (Satellite)" ;
    :sourceClause "nbn Ethernet Product Module, Section 7(d)(i), p.20" .

:Rule_SatelliteTestService_RequirementDetermination a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Satellite Test Service Requirement Determination Rule" ;
    :hasCondition "RSP requests a Satellite Test Service" ;
    :hasConsequence "nbn will only supply the Satellite Test Service if nbn determines, acting reasonably, that RSP requires the Satellite Test Service to successfully supply RSP Products to which nbn Ethernet (Satellite) is an input" ;
    :sourceClause "nbn Ethernet Product Module, Section 7(d)(ii), p.20" .

# Section 7(e) - nbn may at its discretion
:Event_SatelliteTestService_Discretion a :Cl_ContractualEvent, owl:NamedIndividual ;
    rdfs:label "Satellite Test Service at nbn's Discretion" ;
    :eventType "nbn may, at its discretion, supply the Satellite Test Service" ;
    :hasAgent :nbn ;
    :hasObject :SatelliteTestService_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 7(e), p.20" .
# ===== EXTENSIONS FOR SECTION 12 (Page 25-26) - nbn Network Architecture and nbn Ethernet Boundaries =====
# --- New Classes ---

:Cl_ConnectivityServingArea a owl:Class ;
    rdfs:label "Cl_ConnectivityServingArea" ;
    rdfs:comment "A geographic area that contains FSAs (fixed-line), WSAs (wireless), or Beams (satellite) and is served by exactly one POI. [extension: nbn Ethernet Product Module, Section 12.1, p.26]" ;
    rdfs:subClassOf :PlanningResource .

:Cl_AccessDistributionArea a owl:Class ;
    rdfs:label "Cl_AccessDistributionArea" ;
    rdfs:comment "The smallest geographic unit in fixed-line networks (Fibre, FTTB, FTTN, FTTC, HFC) that contains Premises where nbn Ethernet is available. [extension: nbn Ethernet Product Module, Section 12.1(a)(i), p.26]" ;
    rdfs:subClassOf :PlanningResource .

:Cl_ServingAreaModule a owl:Class ;
    rdfs:label "Cl_ServingAreaModule" ;
    rdfs:comment "A geographic area in fixed-line networks that contains ADAs and is located within an FSA. [extension: nbn Ethernet Product Module, Section 12.1(a)(ii), p.26]" ;
    rdfs:subClassOf :PlanningResource .

:Cl_FixedLineServingArea a owl:Class ;
    rdfs:label "Cl_FixedLineServingArea" ;
    rdfs:comment "A Fixed-Line Serving Area (or FSA) that contains SAMs and is located within a CSA. [extension: nbn Ethernet Product Module, Section 12.1(a)(iii)-(iv), p.26]" ;
    rdfs:subClassOf :PlanningResource .

:Cl_WirelessServingArea a owl:Class ;
    rdfs:label "Cl_WirelessServingArea" ;
    rdfs:comment "A Wireless Serving Area (or WSA) that contains Premises and is located within a CSA. [extension: nbn Ethernet Product Module, Section 12.1(b), p.26]" ;
    rdfs:subClassOf :PlanningResource .

:Cl_PowerOutage a owl:Class ;
    rdfs:label "Cl_PowerOutage" ;
    rdfs:comment "An event in FTTB/FTTN networks where nbn may not be able to supply nbn Ethernet Ordered Products. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" ;
    rdfs:subClassOf :Cl_ContractualEvent .

:Cl_SupplyRestriction a owl:Class ;
    rdfs:label "Cl_SupplyRestriction" ;
    rdfs:comment "A reified relationship representing the conditional restriction on supply of an nbn Ethernet Ordered Product due to a Power Outage. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" .

:Cl_nbnEthernetBoundary a owl:Class ;
    rdfs:label "Cl_nbnEthernetBoundary" ;
    rdfs:comment "A reified relationship representing the two endpoints (UNI and NNI) between which nbn Ethernet carries traffic for a Premises. [extension: nbn Ethernet Product Module, Section 12.2, p.26]" .

# --- New Object Properties ---

:containsFSA a owl:ObjectProperty ;
    rdfs:label "containsFSA" ;
    rdfs:comment "Links a CSA to the FSAs it contains. [extension: nbn Ethernet Product Module, Section 12.1(a)(iv), p.26]" ;
    rdfs:domain :Cl_ConnectivityServingArea ;
    rdfs:range :Cl_FixedLineServingArea .

:containsWSA a owl:ObjectProperty ;
    rdfs:label "containsWSA" ;
    rdfs:comment "Links a CSA to the WSAs it contains. [extension: nbn Ethernet Product Module, Section 12.1(b)(ii), p.26]" ;
    rdfs:domain :Cl_ConnectivityServingArea ;
    rdfs:range :Cl_WirelessServingArea .

:containsBeam a owl:ObjectProperty ;
    rdfs:label "containsBeam" ;
    rdfs:comment "Links a CSA to the Beams it contains. [extension: nbn Ethernet Product Module, Section 12.1(c)(ii), p.26]" ;
    rdfs:domain :Cl_ConnectivityServingArea ;
    rdfs:range :Cl_Beam .

:locatedWithinSAM a owl:ObjectProperty ;
    rdfs:label "locatedWithinSAM" ;
    rdfs:comment "Links an ADA to the SAM it is located within. [extension: nbn Ethernet Product Module, Section 12.1(a)(ii), p.26]" ;
    rdfs:domain :Cl_AccessDistributionArea ;
    rdfs:range :Cl_ServingAreaModule .

:locatedWithinFSA a owl:ObjectProperty ;
    rdfs:label "locatedWithinFSA" ;
    rdfs:comment "Links a SAM to the FSA it is located within. [extension: nbn Ethernet Product Module, Section 12.1(a)(iii), p.26]" ;
    rdfs:domain :Cl_ServingAreaModule ;
    rdfs:range :Cl_FixedLineServingArea .

:locatedWithinCSA a owl:ObjectProperty ;
    rdfs:label "locatedWithinCSA" ;
    rdfs:comment "Links an FSA, WSA or Beam to the CSA it is located within. [extension: nbn Ethernet Product Module, Section 12.1(a)(iv), p.26]" ;
    rdfs:domain owl:Thing ;
    rdfs:range :Cl_ConnectivityServingArea .

:servedByPOI a owl:ObjectProperty ;
    rdfs:label "servedByPOI" ;
    rdfs:comment "Links a CSA to the POI that serves it. Each CSA is served by exactly one POI. [extension: nbn Ethernet Product Module, Section 12.1(d)(i), p.26]" ;
    rdfs:domain :Cl_ConnectivityServingArea ;
    rdfs:range :POI .

:servesCSA a owl:ObjectProperty ;
    rdfs:label "servesCSA" ;
    rdfs:comment "Links a POI to the CSAs it serves. A POI may serve one or more CSAs. [extension: nbn Ethernet Product Module, Section 12.1(d)(ii), p.26]" ;
    rdfs:domain :POI ;
    rdfs:range :Cl_ConnectivityServingArea .

:isLocatedInADA a owl:ObjectProperty ;
    rdfs:label "isLocatedInADA" ;
    rdfs:comment "Links a Premises to the ADA it is located within. [extension: nbn Ethernet Product Module, Section 12.1(a)(i), p.26]" ;
    rdfs:domain :Premises ;
    rdfs:range :Cl_AccessDistributionArea .

:isLocatedInWSA a owl:ObjectProperty ;
    rdfs:label "isLocatedInWSA" ;
    rdfs:comment "Links a Premises to the WSA it is located within. [extension: nbn Ethernet Product Module, Section 12.1(b)(i), p.26]" ;
    rdfs:domain :Premises ;
    rdfs:range :Cl_WirelessServingArea .

:isLocatedInBeam a owl:ObjectProperty ;
    rdfs:label "isLocatedInBeam" ;
    rdfs:comment "Links a Premises to the Beam it is located within. [extension: nbn Ethernet Product Module, Section 12.1(c)(i), p.26]" ;
    rdfs:domain :Premises ;
    rdfs:range :Cl_Beam .

:hasUNIBoundary a owl:ObjectProperty ;
    rdfs:label "hasUNIBoundary" ;
    rdfs:comment "Links an nbn Ethernet Boundary to the UNI that serves the Premises. [extension: nbn Ethernet Product Module, Section 12.2(a), p.26]" ;
    rdfs:domain :Cl_nbnEthernetBoundary ;
    rdfs:range :UNI .

:hasNNIBoundary a owl:ObjectProperty ;
    rdfs:label "hasNNIBoundary" ;
    rdfs:comment "Links an nbn Ethernet Boundary to the NNI that serves the Premises. [extension: nbn Ethernet Product Module, Section 12.2(b), p.26]" ;
    rdfs:domain :Cl_nbnEthernetBoundary ;
    rdfs:range :NNI .

:forPremises a owl:ObjectProperty ;
    rdfs:label "forPremises" ;
    rdfs:comment "Links an nbn Ethernet Boundary to the Premises for which it carries traffic. [extension: nbn Ethernet Product Module, Section 12.2, p.26]" ;
    rdfs:domain :Cl_nbnEthernetBoundary ;
    rdfs:range :Premises .

:hasBoundary a owl:ObjectProperty ;
    rdfs:label "hasBoundary" ;
    rdfs:comment "Links an nbn Ethernet Product to the nbn Ethernet Boundary it uses. [extension: nbn Ethernet Product Module, Section 12.2, p.26]" ;
    rdfs:domain :nbnEthernetProduct ;
    rdfs:range :Cl_nbnEthernetBoundary .

:isBoundaryOf a owl:ObjectProperty ;
    rdfs:label "isBoundaryOf" ;
    rdfs:comment "Links a UNI or NNI to the nbn Ethernet Boundary it is part of. [extension: nbn Ethernet Product Module, Section 12.2, p.26]" ;
    rdfs:domain owl:Thing ;
    rdfs:range :Cl_nbnEthernetBoundary .

:preventsSupplyOf a owl:ObjectProperty ;
    rdfs:label "preventsSupplyOf" ;
    rdfs:comment "Links a Power Outage to the Supply Restriction it causes. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" ;
    rdfs:domain :Cl_PowerOutage ;
    rdfs:range :Cl_SupplyRestriction .

:restrictsProduct a owl:ObjectProperty ;
    rdfs:label "restrictsProduct" ;
    rdfs:comment "Links a Supply Restriction to the Ordered Product that may not be supplied. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" ;
    rdfs:domain :Cl_SupplyRestriction ;
    rdfs:range :Cl_OrderedProduct .

:occursInNetwork a owl:ObjectProperty ;
    rdfs:label "occursInNetwork" ;
    rdfs:comment "Links a Power Outage to the network type in which it occurs. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" ;
    rdfs:domain :Cl_PowerOutage ;
    rdfs:range :AccessTechnology .

:containsPremises a owl:ObjectProperty ;
    rdfs:label "containsPremises" ;
    rdfs:comment "Links an ADA to the Premises it contains. [extension: nbn Ethernet Product Module, Section 12.1(a)(i), p.26]" ;
    rdfs:domain :Cl_AccessDistributionArea ;
    rdfs:range :Premises .

:geographicallyOverlapsWith a owl:ObjectProperty ;
    rdfs:label "geographicallyOverlapsWith" ;
    rdfs:comment "Links a CSA to another CSA that it geographically overlaps with. [extension: nbn Ethernet Product Module, Section 12.1(c)(iii), p.26]" ;
    rdfs:domain :Cl_ConnectivityServingArea ;
    rdfs:range :Cl_ConnectivityServingArea .

# --- Business Rules ---

:Rule_FixedLineHierarchy a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Fixed-Line Network Hierarchy Rule" ;
    rdfs:comment "In the Fibre Network, FTTB Network, FTTN Network, FTTC Network and HFC Network, each Premises is located within an ADA, each ADA is located within a SAM, each SAM is located within an FSA, and each FSA is located within a CSA. [extension: nbn Ethernet Product Module, Section 12.1(a), p.26]" ;
    :hasCondition "a Premises at which nbn Ethernet is available is in the Fibre Network, FTTB Network, FTTN Network, FTTC Network or HFC Network" ;
    :hasConsequence "the Premises is located within an ADA, the ADA is located within a SAM, the SAM is located within an FSA, and the FSA is located within a CSA" ;
    :sourceClause "nbn Ethernet Product Module, Section 12.1(a), p.26" .

:Rule_WirelessHierarchy a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Wireless Network Hierarchy Rule" ;
    rdfs:comment "In the Wireless Network, each Premises is located within a WSA, and each WSA is located within a CSA. [extension: nbn Ethernet Product Module, Section 12.1(b), p.26]" ;
    :hasCondition "a Premises at which nbn Ethernet is available is in the Wireless Network" ;
    :hasConsequence "the Premises is located within a WSA, and the WSA is located within a CSA" ;
    :sourceClause "nbn Ethernet Product Module, Section 12.1(b), p.26" .

:Rule_SatelliteHierarchy a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Satellite Network Hierarchy Rule" ;
    rdfs:comment "In the Satellite Network, each Premises is located within a Beam, and all Premises and Beams are located within a single CSA that geographically overlaps with other CSAs. [extension: nbn Ethernet Product Module, Section 12.1(c), p.26]" ;
    :hasCondition "a Premises at which nbn Ethernet is available is in the Satellite Network" ;
    :hasConsequence "the Premises is located within a Beam, all Premises and Beams are located within a single CSA, and that single CSA geographically overlaps with other CSAs that contain Premises served by other access technologies" ;
    :sourceClause "nbn Ethernet Product Module, Section 12.1(c), p.26" .

:Rule_CSAServedByOnePOI a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "CSA Served by One POI Rule" ;
    rdfs:comment "Each CSA is served by one POI. [extension: nbn Ethernet Product Module, Section 12.1(d)(i), p.26]" ;
    :hasCondition "a CSA exists in the nbn Network" ;
    :hasConsequence "that CSA is served by exactly one POI" ;
    :sourceClause "nbn Ethernet Product Module, Section 12.1(d)(i), p.26" .

:Rule_POIMayServeMultipleCSAs a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "POI May Serve Multiple CSAs Rule" ;
    rdfs:comment "A POI may serve one or more CSAs. [extension: nbn Ethernet Product Module, Section 12.1(d)(ii), p.26]" ;
    :hasCondition "a POI exists in the nbn Network" ;
    :hasConsequence "that POI may serve one or more CSAs" ;
    :sourceClause "nbn Ethernet Product Module, Section 12.1(d)(ii), p.26" .

:Rule_PowerOutageSupplyRestriction a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Power Outage Supply Restriction Rule" ;
    rdfs:comment "nbn may not be able to supply an nbn Ethernet (FTTB) Ordered Product or nbn Ethernet (FTTN) Ordered Product in the event of a Power Outage. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" ;
    :hasCondition "a Power Outage occurs in the FTTB Network or FTTN Network" ;
    :hasConsequence "nbn may not be able to supply an nbn Ethernet (FTTB) Ordered Product or nbn Ethernet (FTTN) Ordered Product" ;
    :sourceClause "nbn Ethernet Product Module, Section 12.3(a), p.26" .

:Rule_DetailsAvailableOnRequest a :Cl_BusinessRule, owl:NamedIndividual ;
    rdfs:label "Details of FSA/WSA, CSA and POI Available on Request Rule" ;
    rdfs:comment "Details of the FSA or WSA, CSA and POI serving a Premises are available to RSP on request. [extension: nbn Ethernet Product Module, Section 12.1(e), p.26]" ;
    :hasCondition "RSP requests details of the serving area or POI for a Premises" ;
    :hasConsequence "details of the FSA or WSA, CSA and POI serving that Premises are available to RSP" ;
    :sourceClause "nbn Ethernet Product Module, Section 12.1(e), p.26" .

# --- Individuals / Facts ---

# Section 12.2 - nbn Ethernet boundaries
:nbnEthernetBoundary_Instance a :Cl_nbnEthernetBoundary, owl:NamedIndividual ;
    rdfs:label "nbn Ethernet Boundary Instance" ;
    rdfs:comment "The boundary between the UNI used to serve a Premises and the NNI that serves the Premises, over which nbn Ethernet carries traffic. [extension: nbn Ethernet Product Module, Section 12.2, p.26]" ;
    :hasUNIBoundary :UNI_ObjectRole ;
    :hasNNIBoundary :NNI_ObjectRole ;
    :forPremises :Premises_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 12.2, p.26" .

:NNI_ObjectRole a :NNI, owl:NamedIndividual ;
    rdfs:label "NNI (object role)" ;
    rdfs:comment "An NNI that serves a Premises and is a boundary of nbn Ethernet. [extension: nbn Ethernet Product Module, Section 12.2(b), p.26]" .

# Section 12.3 - Power Outage event and supply restriction
:PowerOutage_FTTB_Instance a :Cl_PowerOutage, owl:NamedIndividual ;
    rdfs:label "Power Outage - FTTB Network" ;
    rdfs:comment "A Power Outage event in the FTTB Network that may prevent nbn from supplying nbn Ethernet (FTTB) Ordered Products. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" ;
    :eventType "Power Outage in the FTTB Network" ;
    :occursInNetwork :AccessTechnology_FTTB ;
    :sourceClause "nbn Ethernet Product Module, Section 12.3(a), p.26" .

:PowerOutage_FTTN_Instance a :Cl_PowerOutage, owl:NamedIndividual ;
    rdfs:label "Power Outage - FTTN Network" ;
    rdfs:comment "A Power Outage event in the FTTN Network that may prevent nbn from supplying nbn Ethernet (FTTN) Ordered Products. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" ;
    :eventType "Power Outage in the FTTN Network" ;
    :occursInNetwork :AccessTechnology_FTTN ;
    :sourceClause "nbn Ethernet Product Module, Section 12.3(a), p.26" .

:SupplyRestriction_FTTB_Instance a :Cl_SupplyRestriction, owl:NamedIndividual ;
    rdfs:label "Supply Restriction - nbn Ethernet (FTTB) due to Power Outage" ;
    rdfs:comment "The restriction on supply of nbn Ethernet (FTTB) Ordered Products due to a Power Outage. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" ;
    :restrictsProduct :OrderedProduct_FTTB_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 12.3(a), p.26" .

:SupplyRestriction_FTTN_Instance a :Cl_SupplyRestriction, owl:NamedIndividual ;
    rdfs:label "Supply Restriction - nbn Ethernet (FTTN) due to Power Outage" ;
    rdfs:comment "The restriction on supply of nbn Ethernet (FTTN) Ordered Products due to a Power Outage. [extension: nbn Ethernet Product Module, Section 12.3(a), p.26]" ;
    :restrictsProduct :OrderedProduct_FTTN_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 12.3(a), p.26" .

:PowerOutage_FTTB_Instance :preventsSupplyOf :SupplyRestriction_FTTB_Instance .
:PowerOutage_FTTN_Instance :preventsSupplyOf :SupplyRestriction_FTTN_Instance .

# Section 12.1(c)(iii) - Satellite CSA geographic overlap
:SatelliteCSA_Instance a :Cl_ConnectivityServingArea, owl:NamedIndividual ;
    rdfs:label "Satellite CSA" ;
    rdfs:comment "The single CSA that contains all Premises and Beams in the Satellite Network, which geographically overlaps with other CSAs. [extension: nbn Ethernet Product Module, Section 12.1(c)(ii)-(iii), p.26]" ;
    :geographicallyOverlapsWith :CSA_ObjectRole ;
    :sourceClause "nbn Ethernet Product Module, Section 12.1(c)(ii)-(iii), p.26" .
