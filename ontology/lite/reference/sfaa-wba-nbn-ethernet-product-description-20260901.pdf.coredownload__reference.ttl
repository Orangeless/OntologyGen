    rdfs:label "RSP" ;
    rdfs:comment "Retail Service Provider that orders and connects to the nbn Network via NNI. [extension: nbn Ethernet Product Module, Section 1, p.6]" ;
    rdfs:subClassOf :Cl_Agent .

:RedundancyMode_DIVERSE_CHASSIS a :RedundancyMode,
        owl:NamedIndividual ;
    rdfs:label "DIVERSE_CHASSIS" ;
    rdfs:comment "Diverse chassis redundancy mode: each NNI Bearer in the NNI Group will be connected across a pair of chassis. [extension: nbn Ethernet Product Module, Section 1.3(e), p.7]" .

:RedundancyMode_SINGLE a :RedundancyMode,
        owl:NamedIndividual ;
    rdfs:label "SINGLE" ;
    rdfs:comment "Used by Region-Central-1 but not a WBA redundancy mode." .

