:Rule_NetworkActivityDesignated_NotServiceFault a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Network Activity Designated - Not Service Fault Rule" ;
    :hasCondition "nbn designates that a Network Activity or Interference Mitigation is required" ;
    :hasConsequence "until that Network Activity or Interference Mitigation is completed, the downstream CIR and upstream CIR at the nbn Downstream Network Boundary in respect of that Premises will not be considered a Service Fault or Performance Incident" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.4(c)(ii), p.13" .

:Rule_RSPMayAcquireBothUNIDandUNIV a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "RSP May Acquire Both UNI-D and UNI-V AVC TC-1 Rule" ;
    :hasCondition "nbn Ethernet (Fibre) is supplied under section 6 and is available" ;
    :hasConsequence "RSP may acquire both an AVC TC-1 mapped to the UNI-D and an additional AVC TC-1 mapped to the UNI-V" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.3(c), p.13" .

