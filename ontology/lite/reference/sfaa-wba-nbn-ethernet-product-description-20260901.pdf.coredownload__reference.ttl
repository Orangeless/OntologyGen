    :governedBy :Rule_RSPMustOrderAVCTC4 ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVC_ObjectRole ;
    :hasTrafficClass :TC_4 ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(d), p.10" .

:Event_RSPOrdersCVCForAVCTC a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "RSP Orders CVC for AVC Traffic Class" ;
    :eventType "order a CVC in the same traffic class in respect of that CSA" ;
