:Profile_10GBaseLR a :NNIBearerProfile,
        owl:NamedIndividual ;
    rdfs:label "10GBaseLR" ;
    :hasInterfaceRate 10.0 ;
    :sourceClause "nbn Ethernet Product Module, Section 1.2, p.6" ;
