:Rule_AVCTC1_HFC_CM820B_Limit a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "AVC TC-1 HFC CM820B Limit Rule" ;
    :hasCondition "AVC TC-1 bandwidth profile above 2 Mbps is ordered on nbn Ethernet (HFC) using the CM820B variant of the HFC-NTD" ;
    :hasConsequence "the AVC TC-1 bandwidth profile above 2 Mbps is not available" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.3(a) Note, p.13" .

:Rule_AssociateLikeNNI a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Associate Like NNI Rule" ;
    :hasCondition "RSP associates CVCs and AVC/UNIs with a V-NNI" ;
    :hasConsequence "RSP must do so in the same way as an NNI" ;
    :sourceClause "nbn Ethernet Product Module, Section 1.4(c), p.7" .

:Rule_CVCNotCrossTech_NonSat a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC Non-Satellite Not Cross-Available Rule" ;
    :hasCondition "a CVC is supplied in respect of nbn Ethernet supplied by means of any access technology other than the Satellite Network" ;
    :hasConsequence "it will not be made available in respect of nbn Ethernet (Satellite)" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.1(d)(ii), p.7" .

:Rule_CVCNotCrossTech_Sat a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC Satellite Not Cross-Available Rule" ;
    :hasCondition "a CVC is supplied in respect of nbn Ethernet (Satellite)" ;
    :hasConsequence "it will not be made available in respect of nbn Ethernet supplied by means of any other access technology" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.1(d)(i), p.7" .

:Rule_CVCSizeDiscretion a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC Size at RSP Discretion Rule" ;
    :hasCondition "RSP orders a CVC for a CSA where nbn supplies nbn Ethernet to RSP" ;
    :hasConsequence "the size of the CVC that RSP requires is at the discretion of RSP (subject to section 2 and the nbn Ethernet Fair Use Policy)" ;
    :sourceClause "nbn Ethernet Product Module, Section 2, p.7" .

:Rule_CVCTC1_Available a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC TC-1 Availability Rule" ;
    :hasCondition "RSP orders a CVC TC-1" ;
    :hasConsequence "CVC TC-1 is available in respect of nbn Ethernet (Fibre), nbn Ethernet (FTTB), nbn Ethernet (FTTN), nbn Ethernet (FTTC), nbn Ethernet (HFC), nbn Ethernet (Wireless) and nbn Ethernet (Satellite)" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.3(a), p.8" .

:Rule_CVCTC4_Available a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC TC-4 Availability Rule" ;
    :hasCondition "RSP orders a CVC TC-4" ;
    :hasConsequence "CVC TC-4 is available in respect of nbn Ethernet (Fibre), nbn Ethernet (FTTB), nbn Ethernet (FTTN), nbn Ethernet (FTTC), nbn Ethernet (HFC), nbn Ethernet (Wireless) and nbn Ethernet (Satellite)" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(a), p.7" .

:Rule_CVCTC4_BWProfiles_Fibre a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC TC-4 Bandwidth Profiles for Fibre etc." ;
    :hasCondition "RSP orders a CVC TC-4 in respect of nbn Ethernet (Fibre), nbn Ethernet (FTTB), nbn Ethernet (FTTN), nbn Ethernet (FTTC), nbn Ethernet (HFC) or nbn Ethernet (Wireless)" ;
    :hasConsequence "the CVC TC-4 bandwidth profiles available are as set out in the relevant sections" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(c)(i), p.7" .

:Rule_CVCTC4_BWProfiles_Sat a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC TC-4 Bandwidth Profiles for Satellite" ;
    :hasCondition "RSP orders a CVC TC-4 in respect of nbn Ethernet (Satellite)" ;
    :hasConsequence "the CVC TC-4 bandwidth profiles available are as set out in the relevant sections" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(c)(ii), p.7" .

:Rule_DiverseChassis a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Diverse Chassis Rule" ;
    :hasCondition "RSP selects diverse chassis as the redundancy mode for an NNI Group" ;
    :hasConsequence "each NNI Bearer in that NNI Group will be connected across a pair of chassis" ;
    :sourceClause "nbn Ethernet Product Module, Section 1.3(e), p.7" .

:Rule_MaxAVCTC1_HomeProfiles a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Maximum AVC TC-1 Capacity for Home Fast etc. Rule" ;
    :hasCondition "RSP orders an AVC TC-1 in respect of any Home Fast, Home Superfast, Home Ultrafast, Home Hyperfast or 2000/500 Mbps (PIR) AVC TC-4 bandwidth profile" ;
    :hasConsequence "the maximum AVC TC-1 capacity is 0.15 symmetrical Mbps" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.3(e), p.13" .

:Rule_MaxAVCTC1_Wireless a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Maximum AVC TC-1 Capacity for Wireless Rule" ;
    :hasCondition "RSP orders an AVC TC-1 in respect of each NTD used by nbn to supply nbn Ethernet (Wireless)" ;
    :hasConsequence "the maximum AVC TC-1 capacity is 0.6 symmetrical Mbps" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.3(d), p.13" .

:Rule_Min1600AvcsBeforeMoreCvc a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Minimum 1,600 AVCs Before Further CVC TC-4 Rule" ;
    :hasCondition "RSP orders any further CVC TC-4 in the same CVC Class" ;
    :hasConsequence "RSP must have associated at least 1,600 AVCs with each CVC TC-4" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(e)(ii), p.8" .

:Rule_MinAvcsAtAllTimes a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Minimum AVCs at All Times Rule" ;
    :hasCondition "RSP has a CVC TC-4 in respect of nbn Ethernet (Satellite)" ;
    :hasConsequence "RSP must at all times associate at least the minimum number of AVCs with each CVC TC-4 as specified in the table per CVC Class and bandwidth profile tier" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(e)(iii), p.8" .

:Rule_MultipleCvcSameClass a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Multiple CVCs in Same Class Rule" ;
    :hasCondition "RSP orders more than one CVC in a CVC Class" ;
    :hasConsequence "each limitation in section 2.2(e) applies to each such CVC" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(e) Note, p.8" .

:Rule_MustSelectBandwidthProfile a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Must Select Bandwidth Profile Rule" ;
    :hasCondition "RSP orders a CVC TC-4" ;
    :hasConsequence "RSP must select a bandwidth profile for the CVC TC-4" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(b), p.7" .

:Rule_MustSelectBwProfile_TC1 a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Must Select Bandwidth Profile for CVC TC-1 Rule" ;
    :hasCondition "RSP orders a CVC TC-1" ;
    :hasConsequence "RSP must select a bandwidth profile for the CVC TC-1" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.3(b), p.8" .

:Rule_RSPMustOrderCVC a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "RSP Must Order CVC Rule" ;
    :hasCondition "nbn supplies nbn Ethernet to RSP in a CSA" ;
    :hasConsequence "RSP must order a CVC for that CSA" ;
    :sourceClause "nbn Ethernet Product Module, Section 2, p.7" .

:Rule_RSPMustSpecifyCvcClass a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "RSP Must Specify CVC Class Rule" ;
    :hasCondition "RSP orders a CVC TC-4 in respect of nbn Ethernet (Satellite)" ;
    :hasConsequence "RSP must specify a CVC Class for each CVC TC-4" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(e)(i), p.8" .

:Rule_UpstreamNNILinkParams a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Upstream NNI Link Parameters Rule" ;
    :hasCondition "a V-NNI is configured with an Upstream NNI Link" ;
    :hasConsequence "the Upstream NNI Link Parameters will be applied to the V-NNI" ;
    :sourceClause "nbn Ethernet Product Module, Section 1.4(b), p.7" .

