# ===== REFERENCE SEED: reference ontology schema (reuse these terms; do not delete) =====
:AVCTC1_AdditionalInstance a :AVC_TC_1,
        owl:NamedIndividual ;
    rdfs:label "AVC TC-1 Additional Instance (UNI-V)" ;
    :isConfiguredInTrafficClass :TC_1 ;
    :mappedToUNI :UNI_V_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.3(c), p.13" ;
    rdfs:comment "An additional AVC TC-1 instance mapped to UNI-V. [extension: nbn Ethernet Product Module, Section 3.3(c), p.13]" .

