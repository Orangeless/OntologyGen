:Event_AssociateCVCsWithVNNI a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "Associate CVCs and AVC/UNIs with V-NNI" ;
    :eventType "associate CVCs and AVC/UNIs with a V-NNI" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :VNNI_ObjectRole ;
    :sourceClause "nbn Ethernet Product Module, Section 1.4(c), p.7" .

:Event_CIRNotAchievingObjective a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "CIR Not Achieving Objective Event" ;
    :eventType "CIR at the nbn Downstream Network Boundary in respect of a Premises is not capable of achieving an applicable CIR Objective" ;
    :governedBy :Rule_CIRNotAchieving_ServiceFault ;
    :hasObject :CIR_Objective_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.4(c)(i), p.13" .

:Event_ConfigureVNNI a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "Configure V-NNI with Upstream NNI Link" ;
    :eventType "configured with an Upstream NNI Link" ;
    :hasObject :VNNI_ObjectRole ;
    :sourceClause "nbn Ethernet Product Module, Section 1.4(a), p.7" .

:Event_InterferenceMitigationCompleted a :InterferenceMitigation,
        owl:NamedIndividual ;
    rdfs:label "Interference Mitigation Completed" ;
    :eventType "Interference Mitigation is completed" ;
    :hasAgent :nbn ;
    :isCompleted true ;
    :sourceClause "nbn Ethernet Product Module, Section 3.4(c)(ii), p.13" .

:Event_MakeCVCAvailable a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "Make CVC Available in Traffic Classes" ;
    :eventType "make the CVC available in traffic class 1 (CVC TC-1), traffic class 2 (CVC TC-2) and traffic class 4 (CVC TC-4)" ;
    :hasAgent :nbn ;
    :hasObject :CVC_ObjectRole ;
    :hasTrafficClass :TC_1,
        :TC_2,
        :TC_4 ;
    :sourceClause "nbn Ethernet Product Module, Section 2.1(b), p.7" .

:Event_NNIGroupActivated a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "NNI Group Activated" ;
    :eventType "NNI Group is activated" ;
    :hasObject :NNIGroup_ObjectRole_1 ;
    :sourceClause "nbn Ethernet Product Module, Section 1.3(f), p.7" .

:Event_NbnConfiguresAVCTC4 a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "nbn Configures AVC in TC-4" ;
    :eventType "configure the AVC to carry data in traffic class 4 (AVC TC-4)" ;
    :governedBy :Rule_NbnConfiguresAVCTC4 ;
    :hasAgent :nbn ;
    :hasObject :AVC_ObjectRole ;
    :hasTrafficClass :TC_4 ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(c), p.10" .

:Event_NbnDesignatesInterferenceMitigation a :InterferenceMitigation,
        owl:NamedIndividual ;
    rdfs:label "nbn Designates Interference Mitigation" ;
    :eventType "nbn designates that an Interference Mitigation is required in accordance with the WBA Operations Manual" ;
    :governedBy :Rule_NetworkActivityDesignated_NotServiceFault ;
    :hasAgent :nbn ;
    :isCompleted false ;
    :sourceClause "nbn Ethernet Product Module, Section 3.4(c)(ii), p.13" .

:Event_NbnDesignatesNetworkActivity a :NetworkActivity,
        owl:NamedIndividual ;
    rdfs:label "nbn Designates Network Activity" ;
    :eventType "nbn designates that a Network Activity is required in accordance with the WBA Operations Manual" ;
    :governedBy :Rule_NetworkActivityDesignated_NotServiceFault ;
    :hasAgent :nbn ;
    :isCompleted false ;
    :sourceClause "nbn Ethernet Product Module, Section 3.4(c)(ii), p.13" .

:Event_NbnMapsOneAVCTC4ToUNI a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "nbn Maps One AVC TC-4 to UNI" ;
    :eventType "map one AVC TC-4 to any UNI used to serve the relevant Premises" ;
    :governedBy :Rule_NbnMapsOneAVCTC4ToUNI ;
    :hasAgent :nbn ;
    :hasObject :UNI_ObjectRole ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(f), p.10" .

:Event_NbnModifyBwProfile a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "nbn Modifies Bandwidth Profile" ;
    :eventType "modify the bandwidth profile of that CVC TC-4 by following the process set out in the WBA Operations Manual" ;
    :governedBy :Rule_NbnModifyBwOnNonCompliance ;
    :hasAgent :nbn ;
    :hasObject :CVC_ObjectRole ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(f), p.8" .

:Event_NetworkActivityCompleted a :NetworkActivity,
        owl:NamedIndividual ;
    rdfs:label "Network Activity Completed" ;
    :eventType "Network Activity is completed" ;
    :hasAgent :nbn ;
    :isCompleted true ;
    :sourceClause "nbn Ethernet Product Module, Section 3.4(c)(ii), p.13" .

:Event_OrderCVCForCSA a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "Order CVC for CSA" ;
    :eventType "order a CVC for each CSA" ;
    :hasAgent :RSP_AgentRole ;
    :hasCSA :CSA_ObjectRole ;
    :hasObject :CVC_ObjectRole ;
    :sourceClause "nbn Ethernet Product Module, Section 2, p.7" .

:Event_OrderCVCTrafficClass a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "Order CVC by Traffic Class" ;
    :eventType "order a CVC TC-4, CVC TC-1 or CVC TC-2, or any combination of the three" ;
    :governedBy :Rule_CVCBandwidthNotZero ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :CVC_ObjectRole ;
    :sourceClause "nbn Ethernet Product Module, Section 2.1(c), p.7" .

:Event_RSPAcquiresAVCTC1_UNID a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "RSP Acquires AVC TC-1 mapped to UNI-D" ;
    :eventType "acquire an AVC TC-1 mapped to the UNI-D" ;
    :governedBy :Rule_RSPMayAcquireBothUNIDandUNIV ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVCTC1_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.3(c), p.13" .

:Event_RSPAcquiresAVCTC1_UNIV a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "RSP Acquires Additional AVC TC-1 mapped to UNI-V" ;
    :eventType "acquire an additional AVC TC-1 mapped to the UNI-V" ;
    :governedBy :Rule_RSPMayAcquireBothUNIDandUNIV ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVCTC1_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.3(c), p.13" .

:Event_RSPElectsPartitionTC1 a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "RSP Elects to Partition AVC to TC-1" ;
    :eventType "elect to partition the AVC to additionally carry data in traffic class 1 (AVC TC-1)" ;
    :governedBy :Rule_RSPMayPartitionAVC ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVC_ObjectRole ;
    :hasTrafficClass :TC_1 ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(c), p.10" .

:Event_RSPElectsPartitionTC2 a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "RSP Elects to Partition AVC to TC-2" ;
    :eventType "elect to partition the AVC to additionally carry data in traffic class 2 (AVC TC-2)" ;
    :governedBy :Rule_RSPMayPartitionAVC ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVC_ObjectRole ;
    :hasTrafficClass :TC_2 ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(c), p.10" .

:Event_RSPOrdersAVC a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "RSP Orders AVC for Premises" ;
    :eventType "order an AVC for each Premises to which nbn Ethernet will be supplied" ;
    :governedBy :Rule_RSPMustOrderAVC ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVC_ObjectRole ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(b), p.10" .

:Event_RSPOrdersAVCTC1 a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "RSP Orders AVC TC-1" ;
    :eventType "elect to order one AVC TC-1" ;
    :governedBy :Rule_RSPMustOrderAVCTC4 ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVC_ObjectRole ;
    :hasTrafficClass :TC_1 ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(d), p.10" .

:Event_RSPOrdersAVCTC2 a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "RSP Orders AVC TC-2" ;
    :eventType "elect to order one AVC TC-2" ;
    :governedBy :Rule_RSPMustOrderAVCTC4 ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :AVC_ObjectRole ;
    :hasTrafficClass :TC_2 ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(d), p.10" .

:Event_RSPOrdersAVCTC4 a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "RSP Orders AVC TC-4" ;
