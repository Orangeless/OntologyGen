        owl:NamedIndividual ;
    rdfs:label "High" .

:RiskRating_Low a :RiskRating,
        owl:NamedIndividual ;
    rdfs:label "Low" .

:RiskRating_Medium a :RiskRating,
        owl:NamedIndividual ;
    rdfs:label "Medium" .

:Rule_CIRNotAchieving_ServiceFault a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CIR Not Achieving - Service Fault Rule" ;
    :hasCondition "the CIR at the nbn Downstream Network Boundary in respect of a Premises is not capable of achieving an applicable CIR Objective" ;
    :hasConsequence "sections 3.2(b) to 3.2(d) and 3.5 will not prevent that failure from being a Service Fault or Performance Incident until nbn designates that a Network Activity or Interference Mitigation is required in accordance with the WBA Operations Manual" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.4(c)(i), p.13" .

:Rule_CVCBandwidthNotZero a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "CVC Bandwidth Not Zero Rule" ;
    :hasCondition "RSP orders a combination of CVC TC-4, CVC TC-1 or CVC TC-2" ;
    :hasConsequence "the total combination of CVC bandwidth profiles is not zero" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.1(c), p.7" .

:Rule_NbnConfiguresAVCTC4 a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "nbn Configures AVC in TC-4 Rule" ;
    :hasCondition "RSP orders an AVC" ;
    :hasConsequence "nbn will configure the AVC to carry data in traffic class 4 (AVC TC-4)" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(c), p.10" .

:Rule_NbnMapsOneAVCTC4ToUNI a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "nbn Maps One AVC TC-4 to UNI Rule" ;
    :hasCondition "a UNI is used to serve a Premises" ;
    :hasConsequence "nbn will map one AVC TC-4 to that UNI and will not map more than one AVC TC-4 to the same UNI" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(f), p.10" .

:Rule_NbnModifyBwOnNonCompliance a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "nbn May Modify Bandwidth Profile on Non-Compliance Rule" ;
    :hasCondition "RSP fails to comply with section 2.2(e)(iii) in connection with a CVC TC-4" ;
    :hasConsequence "nbn may modify the bandwidth profile of that CVC TC-4 by following the process set out in the WBA Operations Manual" ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(f), p.8" .

:Rule_RSPMustOrderAVC a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "RSP Must Order AVC Rule" ;
    :hasCondition "nbn supplies nbn Ethernet to RSP" ;
    :hasConsequence "RSP must order an AVC for each Premises to which nbn Ethernet will be supplied" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(b), p.10" .

:Rule_RSPMustOrderCVCForAVCTC a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "RSP Must Order CVC for AVC Traffic Class Rule" ;
    :hasCondition "RSP orders an AVC traffic class in respect of a Premises in a CSA" ;
    :hasConsequence "RSP must order a CVC in the same traffic class in respect of that CSA" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.1(e), p.10" .

:Rule_ReconfigureRedundancy a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Reconfigure Redundancy Mode Rule" ;
    :hasCondition "the redundancy mode of an NNI Group is reconfigured after activation" ;
    :hasConsequence "it satisfies the criteria for an NNI Diversity Upgrade in the WBA Operations Manual (including that the NNI Group is located at an Upgraded POI)" ;
    :sourceClause "nbn Ethernet Product Module, Section 1.3(f), p.7" .

:Rule_SingleChassis a :Cl_BusinessRule,
        owl:NamedIndividual ;
    rdfs:label "Single Chassis Rule" ;
    :hasCondition "RSP selects single chassis as the redundancy mode for an NNI Group" ;
    :hasConsequence "each NNI Bearer in that NNI Group will be connected to the same chassis; and the NNI will operate as a single, unprotected interface" ;
    :sourceClause "nbn Ethernet Product Module, Section 1.3(d)(i)-(ii), p.7" .

