:Event_SpecifyCvcClass a :Cl_ContractualEvent,
        owl:NamedIndividual ;
    rdfs:label "Specify CVC Class for CVC TC-4" ;
    :eventType "specify a CVC Class for each CVC TC-4" ;
    :hasAgent :RSP_AgentRole ;
    :hasObject :CVC_ObjectRole ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(e)(i), p.8" .

:Inclusion_AVCTC1_in_AVCTC4 a :InclusionCondition,
        owl:NamedIndividual ;
    rdfs:label "Inclusion of AVC TC-1 Data Transfer Rate in AVC TC-4" ;
    :hasConditionQualifier "except where the AVC TC-1 is mapped to the UNI-V in the case of nbn Ethernet (Fibre) under section 6" ;
    :includedIn :AVCTC4_Instance ;
    :includesRateOf :AVCTC1_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.3(b), p.13" .

:Inclusion_AVCTC2_in_AVCTC4 a :InclusionCondition,
        owl:NamedIndividual ;
    rdfs:label "Inclusion of AVC TC-2 Data Transfer Rate in AVC TC-4" ;
    :includedIn :AVCTC4_Instance ;
    :includesRateOf :AVCTC2_Instance ;
    :sourceClause "nbn Ethernet Product Module, Section 3.4(b), p.13" .

:NTD_Wireless_Instance a :NTD,
        owl:NamedIndividual ;
    rdfs:label "NTD for Wireless" ;
    :sourceClause "nbn Ethernet Product Module, Section 3.3(d), p.13" ;
    :usedByNbnToSupply :nbnEthernet_Wireless ;
    rdfs:comment "An NTD used by nbn to supply nbn Ethernet (Wireless). [extension: nbn Ethernet Product Module, Section 3.3(d), p.13]" .

:PerformanceIncident a owl:Class ;
