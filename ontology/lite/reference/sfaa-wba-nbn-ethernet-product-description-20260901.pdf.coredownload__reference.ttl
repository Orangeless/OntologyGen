:BandwidthProfile_CVCTC4_CIR_Satellite a :Cl_BandwidthProfile,
        owl:NamedIndividual ;
    rdfs:label "CVC TC-4 symmetrical Mbps (CIR) - Satellite" ;
    :hasCirIncrementRule :CirIncrement_Class0,
        :CirIncrement_Class1,
        :CirIncrement_Class2 ;
    :hasCirRangeRule :CirRange_Class0,
        :CirRange_Class1,
        :CirRange_Class2 ;
    :hasTrafficClass :TC_4 ;
    :isCvcMax false ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(c)(ii), p.8" .

:BandwidthProfile_CVCTC4_CVCMax a :Cl_BandwidthProfile,
        owl:NamedIndividual ;
    rdfs:label "CVC TC-4 CVC Max" ;
    :hasTrafficClass :TC_4 ;
    :isCvcMax true ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(d), p.8" ;
    rdfs:comment "A CVC TC-4 with the CVC Max bandwidth profile has a symmetrical PIR that is automatically configured to equal the bandwidth of the associated NNI as modified from time to time. [extension: nbn Ethernet Product Module, Section 2.2(d), p.8]" .

:BandwidthProfile_CVCTC4_PIR_Satellite a :Cl_BandwidthProfile,
        owl:NamedIndividual ;
    rdfs:label "CVC TC-4 symmetrical Mbps (PIR) - Satellite" ;
    :hasPirIncrementRule :PirIncrement_Range0,
        :PirIncrement_Range100_300,
        :PirIncrement_Range300_10000 ;
    :hasTrafficClass :TC_4 ;
    :isCvcMax false ;
    :sourceClause "nbn Ethernet Product Module, Section 2.2(c)(ii), p.8" .

