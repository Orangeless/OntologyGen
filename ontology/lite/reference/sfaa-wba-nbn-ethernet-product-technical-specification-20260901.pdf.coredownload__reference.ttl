:TC_1_Description a owl:NamedIndividual ;
    rdfs:label "TC-1 Description" ;
    :hasDescription "The TC-1 traffic class is targeted towards real-time, interactive multimedia applications, with low bit-rate, low Frame Delay, Frame Delay Variation, Frame Loss."^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9" .

:TC_2_Description a owl:NamedIndividual ;
    rdfs:label "TC-2 Description" ;
    :hasDescription "The TC-2 traffic class is targeted towards real-time, interactive multimedia applications."^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9" .

:TC_4_Description a owl:NamedIndividual ;
    rdfs:label "TC-4 Description" ;
    :hasDescription "Traffic class 4 is designed for applications that can benefit from a peak capacity and can tolerate variable throughput"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33" .

:TPEP_Web_Enables_TCP a owl:NamedIndividual ;
    rdfs:label "TPEP Web Optimisation enables TPEP TCP Optimisation" ;
    :enables :TPEP_TCP_Opt_Satellite ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, footnote 23, page 37" .

:ThroughputCharacteristic_Variable a owl:NamedIndividual ;
    rdfs:label "Variable Throughput Tolerance" ;
    :hasDescription "Applications that can tolerate variable throughput"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33" .

:UNIConfigurationAttributes a owl:Class ;
    rdfs:label "UNIConfigurationAttributes" ;
    rdfs:comment "UNI configuration attributes. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 8.1.1.1]" ;
    rdfs:subClassOf :ConfigurationAttributes .

:Unicast_1_1_AVC_BWProfile_Avail_Note a owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC Bandwidth Profile Availability Note" ;
    :hasDescription "Availability by access technology for each Unicast 1:1 AVC bandwidth profile combination is also set out in sections B.1 and B.2 to Appendix B"^^xsd:string ;
    :setOutIn :DocumentSection_AppendixB ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

:Unicast_1_1_AVC_BandwidthProfile a :Unicast_1_1_AVC,
        owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC Bandwidth Profile" ;
    :describedIn :nbnEthernetProductDescription_Doc ;
    :describedInSection :DocumentSection_4_1_3_1 ;
    :hasBandwidthProfile :Unicast_1_1_AVC_BWProfile_Instance ;
    :hasDescription "A Unicast 1:1 AVC comprises a combination of mandatory (TC-4) and optional (TC-1 and/or TC-2) traffic classes as described in section 3.1 of the nbn Ethernet Product Description"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

