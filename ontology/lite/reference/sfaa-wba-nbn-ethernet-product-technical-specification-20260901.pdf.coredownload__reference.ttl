:Cl_ServiceAddressingMode a owl:Class ;
    rdfs:label "Service Addressing Mode" ;
    rdfs:comment "The service addressing mode at the NNI. [extension: nbn Ethernet Product Module, page 38]" .

:Cl_ValidationCondition a owl:Class ;
