    rdfs:comment "A variant of AVC required for unicast data applications using the UNI-V. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:subClassOf :AVC .

:AVCID_ConfiguredIn a owl:Class ;
    rdfs:label "AVC ID Configured In" ;
    rdfs:comment "Reified relationship representing that an AVC ID is configured in the Circuit ID field of a protocol. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" .

:CVC_ContentionManagement a owl:Class ;
    rdfs:label "CVC Contention Management" ;
