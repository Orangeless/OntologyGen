    rdfs:domain :CVC_BandwidthProfile ;
    rdfs:range xsd:string .

:hasTrafficClass a owl:ObjectProperty ;
    rdfs:label "hasTrafficClass" ;
    rdfs:comment "Links a BandwidthProfileSpec to the traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain :Cl_BandwidthProfileSpec ;
    rdfs:range :TrafficClass .

:hasTrafficClassModel a owl:DatatypeProperty ;
    rdfs:label "hasTrafficClassModel" ;
