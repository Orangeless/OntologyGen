        owl:NamedIndividual ;
    rdfs:label "V-NNI Example 2" ;
    :doesNotSupportUseOf :NNIGroup_100G_Diverse ;
    :hasDescription "A second V-NNI created from a Diverse Chassis NNI Group"^^xsd:string ;
    :hasVisibilityOf :NNILink_OperationalStatus_Example2 ;
    :inheritsFrom :NNIGroup_100G_Diverse ;
    :obtainsFrom :NNILink_Example2 ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.4, page 30" ;
    :supportsAssociationOf :NNILink_Example2 .

