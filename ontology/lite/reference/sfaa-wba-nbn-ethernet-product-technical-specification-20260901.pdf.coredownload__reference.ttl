# --- Table 28 Notes (Limitations on Availability) ---

# TC-1 capacity greater than 1 Mbps limitation
:TC1_Availability_Limit_Note a owl:NamedIndividual ;
    rdfs:label "TC-1 Capacity Availability Limit" ;
    :hasDescription "nbn may limit the availability of bandwidth profiles with TC-1 capacities greater than 1 Mbps in CSAs where nbn does not, or considers it is likely to not, have sufficient capacity to provide all requested TC-1 capacity. RSP must conduct a Site Qualification Enquiry which will indicate the availability of bandwidth profiles for TC-1 capacities greater than 1 Mbps in relation to each Premises." ;
    :hasThreshold 1.0 ;
    :hasThresholdUnit "Mbps" ;
    :appliesToTrafficClass :TC_1 ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes" .

# TC-2 capacity greater than 10 Mbps limitation
:TC2_Availability_Limit_Note a owl:NamedIndividual ;
    rdfs:label "TC-2 Capacity Availability Limit" ;
    :hasDescription "nbn may limit the availability of bandwidth profiles with TC-2 capacities greater than 10 Mbps in CSAs where nbn does not, or considers it is likely to not, have sufficient capacity to provide all requested TC-2 capacity. RSP must conduct a Site Qualification Enquiry which will indicate the availability of bandwidth profiles for TC-2 in relation to each Premises." ;
    :hasThreshold 10.0 ;
    :hasThresholdUnit "Mbps" ;
    :appliesToTrafficClass :TC_2 ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes" .

# TC-4 capacity greater than 100 Mbps limitation
:TC4_Availability_Limit_Note a owl:NamedIndividual ;
    rdfs:label "TC-4 Capacity Availability Limit" ;
    :hasDescription "nbn may limit the availability of bandwidth profiles with TC-4 capacities greater than 100 Mbps in CSAs where nbn does not, or considers it is likely to not, have sufficient capacity to provide all requested TC-4 capacity. RSP must conduct a Site Qualification Enquiry which will indicate the availability of bandwidth profiles for TC-4 capacities greater than 100 Mbps in relation to each Premises." ;
    :hasThreshold 100.0 ;
    :hasThresholdUnit "Mbps" ;
    :appliesToTrafficClass :TC_4 ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes" .

# Subset of bandwidth profiles available per access technology
:Subset_Availability_Note a owl:NamedIndividual ;
    rdfs:label "Subset of Bandwidth Profiles Available" ;
    :hasDescription "Only a subset of bandwidth profiles is available in relation to each of nbn Ethernet (Fibre), nbn Ethernet (Wireless), nbn Ethernet (HFC) and nbn Ethernet (Satellite). Additional restrictions may apply to the supply of certain of those bandwidth profiles." ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes" .

# Table 28 to be read subject to sections
:Table28_ReadSubjectTo_Note a owl:NamedIndividual ;
    rdfs:label "Table 28 Read Subject To" ;
    :hasDescription "To be read subject to section 2.2.2 of this nbn Ethernet Product Technical Specification and section 13 of the nbn Ethernet Product Description." ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes" .

# --- Data properties for thresholds ---

:hasThreshold a owl:DatatypeProperty ;
    rdfs:label "hasThreshold" ;
    rdfs:comment "The capacity threshold above which nbn may limit the availability of bandwidth profiles for a traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes]" ;
    rdfs:range xsd:decimal .

:hasThresholdUnit a owl:DatatypeProperty ;
    rdfs:label "hasThresholdUnit" ;
    rdfs:comment "The unit of measurement for a capacity threshold (Mbps). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes]" ;
    rdfs:range xsd:string .

:appliesToTrafficClass a owl:ObjectProperty ;
    rdfs:label "appliesToTrafficClass" ;
    rdfs:comment "Links an availability limit note to the traffic class it applies to. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63, Notes]" ;
    rdfs:range :TrafficClass .
# ===== Satellite unicast CVC TC-4 Bandwidth Profile Capacities and Minimum AVC Thresholds (Table 35) Extensions =====

# --- Classes ---

:Cl_SatelliteCvcMinAvcThresholdFact a owl:Class ;
    rdfs:label "Satellite CVC Minimum AVC Threshold Fact" ;
    rdfs:comment "A reified fact node representing a specific (bandwidth, CVC Class) to minimum AVC threshold row in Table 35 of the nbn Ethernet Product Technical Specification. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 35, page 79]" ;
    rdfs:subClassOf :Cl_SatelliteCvcMinAvcThreshold .

:Cl_SatelliteCvcTable a owl:Class ;
    rdfs:label "Satellite CVC Table" ;
    rdfs:comment "A contractual table that defines the relationship between CVC TC-4 bandwidth, CVC Class, and minimum AVC thresholds for Satellite unicast services. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 35, page 79]" .

:Cl_ConfigurationType a owl:Class ;
    rdfs:label "Configuration Type" ;
    rdfs:comment "A configuration type (e.g., 1:1) for which a Satellite unicast CVC service is available. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 35, page 79]" .

# --- Object Properties ---

:hasCvcClass a owl:ObjectProperty ;
    rdfs:label "hasCvcClass" ;
    rdfs:comment "Links a Satellite CVC minimum AVC threshold fact node to the CVC Class (Class-0, Class-1, Class-2) that determines the threshold. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 35, page 79]" ;
    rdfs:domain :Cl_SatelliteCvcMinAvcThresholdFact ;
    rdfs:range :Cl_CVCClass .

:availableForConfiguration a owl:ObjectProperty ;
    rdfs:label "availableForConfiguration" ;
    rdfs:comment "Links a Satellite CVC table to the configuration type (e.g., 1:1) for which it is available. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 35, page 79]" ;
    rdfs:domain :Cl_SatelliteCvcTable ;
    rdfs:range :Cl_ConfigurationType .

:subjectToDocumentSection a owl:ObjectProperty ;
    rdfs:label "subjectToDocumentSection" ;
    rdfs:comment "Links a Satellite CVC table to the document section it is subject to. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 35, page 79]" ;
    rdfs:domain :Cl_SatelliteCvcTable ;
rdfs:range :DocumentSection .

:hasBandwidthMbps a owl:DatatypeProperty ;
    rdfs:label "hasBandwidthMbps" ;
    rdfs:comment "The CVC TC-4 bandwidth value in Mbps for a Satellite CVC minimum AVC threshold fact node. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 35, page 79]" ;
    rdfs:domain :Cl_SatelliteCvcMinAvcThresholdFact ;
    rdfs:range xsd:integer .

:hasMinAvcCountValue a owl:DatatypeProperty ;
    rdfs:label "hasMinAvcCountValue" ;
    rdfs:comment "The minimum number of AVCs that must be associated with a Satellite CVC TC-4 for a given bandwidth and CVC Class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 35, page 79]" ;
    rdfs:domain :Cl_SatelliteCvcMinAvcThresholdFact ;
    rdfs:range xsd:integer .

