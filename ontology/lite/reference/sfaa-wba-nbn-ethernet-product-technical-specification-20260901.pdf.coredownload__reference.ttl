    rdfs:domain :NNILink ;
    rdfs:range :NNIGroup .

:isCurrentlyAssigned a owl:DatatypeProperty ;
    rdfs:label "isCurrentlyAssigned" ;
    rdfs:comment "Indicates whether an S-TAG pool is currently assigned to an existing NNI Link or CVC, which is validated to ensure it is not. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" ;
    rdfs:domain :S-TAGPool ;
    rdfs:range xsd:boolean .

:isDefault a owl:DatatypeProperty ;
    rdfs:label "isDefault" ;
    rdfs:comment "Indicates whether a CVC Class value is the default. [extension: nbn Ethernet Product Module, Table 8, page 38]" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:boolean .

:isInternallyGenerated a owl:DatatypeProperty ;
    rdfs:label "isInternallyGenerated" ;
    rdfs:comment "Indicates that an S/C-VID is internally generated by nbn. [extension: nbn Ethernet Product Module, page 38]" ;
    rdfs:domain :S_C_VID ;
    rdfs:range xsd:boolean .

:isLinkedToDownstreamV-NNI a owl:DatatypeProperty ;
    rdfs:label "isLinkedToDownstreamV-NNI" ;
    rdfs:comment "Indicates whether an NNI Link is linked to a Downstream V-NNI, which restricts updating the V-NNI RSP. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" ;
    rdfs:domain :NNILink ;
