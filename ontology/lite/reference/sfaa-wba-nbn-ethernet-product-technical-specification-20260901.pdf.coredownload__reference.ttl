    rdfs:domain :Cl_BandwidthProfileSpec ;
    rdfs:range xsd:string .

:hasRedundancyMode a owl:ObjectProperty ;
    rdfs:label "hasRedundancyMode" ;
    rdfs:comment "Links NNI Group to its redundancy mode attribute. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 8.3.1.3]",
        "Links a Bearer Limit Condition to the redundancy mode. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.6.1, page 30]",
        "Links an NNI Group to its redundancy mode (Single Chassis or Diverse Chassis). [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:domain :BearerLimitCondition,
        :Cl_NNIGroup,
        :NNIGroup ;
    rdfs:range :Cl_NNIGroupRedundancyMode,
        :RedundancyMode .

:hasRedundancyModeName a owl:DatatypeProperty ;
    rdfs:label "hasRedundancyModeName" ;
    rdfs:comment "The name of a redundancy mode (Single Chassis or Diverse Chassis). [extension: nbn Ethernet Product Module, section 8.3.1.2, page 40]" ;
    rdfs:domain :Cl_NNIGroupRedundancyMode ;
    rdfs:range xsd:string .

:hasRedundancyModeSelection a owl:ObjectProperty ;
    rdfs:label "hasRedundancyModeSelection" ;
    rdfs:comment "Links an NNI Group to the redundancy mode selected at the time the NNI Group is created. [extension: nbn Ethernet Product Module, section 8.3.1.2, page 40]" ;
    rdfs:domain :NNIGroup ;
    rdfs:range :Cl_NNIGroupRedundancyMode .

:hasRelocationRequirement a owl:DatatypeProperty ;
    rdfs:label "hasRelocationRequirement" ;
    rdfs:comment "A textual description of the requirements to change the location of an NNI Group. [extension: nbn Ethernet Product Module, section 8.3.1.1, page 40]" ;
    rdfs:domain :Cl_NNIGroupRelocation ;
    rdfs:range xsd:string .

:hasS-TAGPool a owl:ObjectProperty ;
    rdfs:label "hasS-TAGPool" ;
