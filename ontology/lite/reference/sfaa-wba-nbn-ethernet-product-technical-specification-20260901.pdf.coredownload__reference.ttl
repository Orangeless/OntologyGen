    rdfs:comment "Links an event to the state it transitions from. [extension: nbn Ethernet Product Module, section 8.3.1.1, page 40]" ;
    rdfs:domain :Cl_Event ;
    rdfs:range :Cl_State .

:hasTransitionTo a owl:ObjectProperty ;
