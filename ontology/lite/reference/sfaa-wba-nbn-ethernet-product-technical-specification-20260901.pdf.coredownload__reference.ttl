# --- Provisioning Event Facts (Footnote 38) ---

:UNI_V_TC1_ProvisioningEvent a :Cl_ProvisioningEvent, owl:NamedIndividual ;
    rdfs:label "UNI-V TC-1 Automatic Provisioning Event" ;
    :triggeredBy :RSP_Generic ;
    :performedBy :nbn_Entity ;
    :provisionsOn :UNI_V_Instance ;
    :hasDescription "Upon order of the UNI-V by RSP, the UNI-V is automatically provisioned by nbn with TC-1 capacity"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52, footnote 38" .

:TC4_0Mbps_Order_Condition a owl:NamedIndividual ;
    rdfs:label "TC-4 0 Mbps Order Condition" ;
    :hasDescription "A TC-4 bandwidth profile of 0 Mbps can only be ordered when a UNI-V is provisioned with associated TC-1 capacity"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52, footnote 38" .

:TC4_0Mbps_Order_Condition :hasCondition "A TC-4 bandwidth profile of 0 Mbps can only be ordered when a UNI-V is provisioned with associated TC-1 capacity"^^xsd:string ;
    :forBandwidthProfile :BWProfile_TC4_0Mbps ;
    :provisionsOn :UNI_V_Instance .
# ===== Unicast 1:1 AVC Bandwidth Profiles - Table 28 (page 63) Extensions =====

# --- Classes ---

:Cl_AVC_TC4_BandwidthProfile a owl:Class ;
    rdfs:label "AVC TC-4 Bandwidth Profile (Table 28)" ;
    rdfs:comment "A Unicast 1:1 AVC bandwidth profile as set out in Table 28, specifying downstream/upstream AVC_TC-4 capacities, AVC_TC-2 and AVC_TC-1 capacities, UNI interface, availability by access technology, and default-mapped traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:subClassOf :Cl_BandwidthProfile .

:Cl_AVC_TC4_ProfileAvailability a owl:Class ;
    rdfs:label "AVC TC-4 Profile Availability" ;
    rdfs:comment "A reified state indicating the availability of a Unicast 1:1 AVC bandwidth profile by access technology (F=Fibre, H=HFC, W=Wireless, S=Satellite). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" .

# --- Object Properties ---

:hasProfileNumber a owl:DatatypeProperty ;
    rdfs:label "hasProfileNumber" ;
    rdfs:comment "The profile number of a Unicast 1:1 AVC bandwidth profile in Table 28. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain :Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range xsd:integer .

:hasDownstreamCapacity a owl:DatatypeProperty ;
    rdfs:label "hasDownstreamCapacity" ;
    rdfs:comment "The downstream AVC_TC-4 capacity in Mbps for a Unicast 1:1 AVC bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain :Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range xsd:decimal .

:hasUpstreamCapacity a owl:DatatypeProperty ;
    rdfs:label "hasUpstreamCapacity" ;
    rdfs:comment "The upstream AVC_TC-4 capacity in Mbps for a Unicast 1:1 AVC bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain :Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range xsd:decimal .

:hasTC2Capacity a owl:DatatypeProperty ;
    rdfs:label "hasTC2Capacity" ;
    rdfs:comment "The AVC_TC-2 upstream/downstream capacity in Mbps for a Unicast 1:1 AVC bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain :Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range xsd:decimal .

:hasTC1Capacity a owl:DatatypeProperty ;
    rdfs:label "hasTC1Capacity" ;
    rdfs:comment "The AVC_TC-1 upstream/downstream capacity in Mbps for a Unicast 1:1 AVC bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain :Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range xsd:decimal .

:hasUNIInterface a owl:ObjectProperty ;
    rdfs:label "hasUNIInterface" ;
    rdfs:comment "Links a Unicast 1:1 AVC bandwidth profile to its UNI Interface (UNI-D). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain :Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range :AVC .

:hasDefaultMappedTrafficClass a owl:DatatypeProperty ;
    rdfs:label "hasDefaultMappedTrafficClass" ;
    rdfs:comment "The Default-Mapped Traffic Class for a Unicast 1:1 AVC bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain :Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range xsd:integer .

:hasProductName a owl:DatatypeProperty ;
    rdfs:label "hasProductName" ;
    rdfs:comment "The name of the product associated with a Unicast 1:1 AVC bandwidth profile (e.g., Wireless Plus, Home Hyperfast). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain :Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range xsd:string .

:hasCapacityUnit a owl:DatatypeProperty ;
    rdfs:label "hasCapacityUnit" ;
    rdfs:comment "The unit of measurement for the downstream/upstream capacities of a Unicast 1:1 AVC bandwidth profile (Mbps). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain :Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range xsd:string .

:availableByAccessTechnology a owl:ObjectProperty ;
    rdfs:label "availableByAccessTechnology" ;
    rdfs:comment "Links a Cl_AVC_TC4_ProfileAvailability node to the access technology (F=Fibre, H=HFC, W=Wireless, S=Satellite) on which the profile is available. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain :Cl_AVC_TC4_ProfileAvailability ;
    rdfs:range :AccessTechnology .

:forProfile a owl:ObjectProperty ;
    rdfs:label "forProfile" ;
    rdfs:comment "Links a Cl_AVC_TC4_ProfileAvailability node to the Unicast 1:1 AVC bandwidth profile whose availability is being described. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain :Cl_AVC_TC4_ProfileAvailability ;
    rdfs:range :Cl_AVC_TC4_BandwidthProfile .

:hasUNIDSupportedInterfaceMode a owl:DatatypeProperty ;
    rdfs:label "hasUNIDSupportedInterfaceMode" ;
    rdfs:comment "Indicates whether the UNI-D Supported Interface Mode is supported (Y) for a Unicast 1:1 AVC bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 28, page 63]" ;
    rdfs:domain :Cl_AVC_TC4_BandwidthProfile ;
    rdfs:range xsd:string .

