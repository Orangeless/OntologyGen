# ===== AVC Feature Availability - Traffic Class by nbn Network (Table 23) Extensions =====

# --- Classes ---

:AVCFeatureAvailability a owl:Class ;
    rdfs:label "AVC Feature Availability" ;
    rdfs:comment "Reified relationship representing the availability of a traffic class or bandwidth profile on a specific UNI type for a given access technology. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50]" .

:HFC-NTD_Variant a owl:Class ;
    rdfs:label "HFC-NTD Variant" ;
    rdfs:comment "A specific hardware variant of the HFC Network Termination Device, such as the CM820B, which has limitations on supported features. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50, footnotes 35-36]" .

# --- Object Properties ---

:hasTrafficClass a owl:ObjectProperty ;
    rdfs:label "hasTrafficClass" ;
    rdfs:comment "Links an AVCFeatureAvailability node to the traffic class whose availability is being described. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50]" ;
    rdfs:domain :AVCFeatureAvailability ;
    rdfs:range :TrafficClass .

:availableOnUNI a owl:ObjectProperty ;
    rdfs:label "availableOnUNI" ;
    rdfs:comment "Links an AVCFeatureAvailability node to the UNI type (UNI-D, UNI-V, UNI-DSL) on which the traffic class or bandwidth profile is available. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50]" ;
    rdfs:domain :AVCFeatureAvailability ;
    rdfs:range :AVC .

:hasAvailabilityState a owl:DatatypeProperty ;
    rdfs:label "hasAvailabilityState" ;
    rdfs:comment "Indicates whether a traffic class or bandwidth profile is Available or Not Available on a given UNI type for a given access technology. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50]" ;
    rdfs:domain :AVCFeatureAvailability ;
    rdfs:range xsd:string .

:hasBandwidthValue a owl:DatatypeProperty ;
    rdfs:label "hasBandwidthValue" ;
    rdfs:comment "The numeric value of a bandwidth profile in Mbps. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 24, page 50]" ;
    rdfs:domain :BandwidthProfile ;
    rdfs:range xsd:decimal .

:hasBandwidthUnit a owl:DatatypeProperty ;
    rdfs:label "hasBandwidthUnit" ;
    rdfs:comment "The unit of measurement for a bandwidth profile value (Mbps). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 24, page 50]" ;
    rdfs:domain :BandwidthProfile ;
    rdfs:range xsd:string .

:doesNotSupport a owl:ObjectProperty ;
    rdfs:label "doesNotSupport" ;
    rdfs:comment "Links an HFC-NTD variant to the traffic class or bandwidth profile it does not support. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50, footnotes 35-36]" ;
    rdfs:domain :HFC-NTD_Variant ;
    rdfs:range owl:Thing .

:hasBandwidthProfile a owl:ObjectProperty ;
    rdfs:label "hasBandwidthProfile" ;
    rdfs:comment "Links an AVCFeatureAvailability node to the bandwidth profile whose availability is being described. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 24, page 50]" ;
    rdfs:domain :AVCFeatureAvailability ;
    rdfs:range :BandwidthProfile .

