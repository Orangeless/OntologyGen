# --- HFC-NTD Variant Facts ---

:CM820B a :HFC-NTD_Variant, owl:NamedIndividual ;
    rdfs:label "CM820B" ;
    :hasDescription "The CM820B variant of the HFC-NTD"^^xsd:string ;
    :doesNotSupport :TC_2 ;
    :doesNotSupport :BWProfile_5Mbps ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 23, page 50, footnotes 35-36" .
# ===== Unicast 1:1 AVC TC-4 Bandwidth Profile Availability (Section A.6.7, Table 26) Extensions =====

# --- Classes ---

:Cl_BandwidthProfile a owl:Class ;
    rdfs:label "Bandwidth Profile" ;
    rdfs:comment "A named or numeric specification of downstream/upstream bit rates (e.g., 0 Mbps, 12/1 Mbps, Home Fast) for a specific traffic class (TC-4) on a Unicast 1:1 AVC. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52]" ;
    rdfs:subClassOf :Cl_ServiceAttribute .

:Cl_Availability a owl:Class ;
    rdfs:label "Availability" ;
    rdfs:comment "A reified state indicating whether a specific bandwidth profile is available on a given access technology and UNI type, often subject to a condition. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52]" .

:Cl_ProvisioningEvent a owl:Class ;
    rdfs:label "Provisioning Event" ;
    rdfs:comment "The automatic activation of TC-1 capacity on a UNI-V upon order by an RSP. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52, footnote 38]" ;
    rdfs:subClassOf :Cl_Event .

:Cl_UNI_V a owl:Class ;
    rdfs:label "UNI-V" ;
    rdfs:comment "The UNI-V entity on which TC-1 capacity is automatically provisioned by nbn upon order by an RSP. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52, footnote 38]" ;
    rdfs:subClassOf :UNI_V .

:Cl_UNI_D a owl:Class ;
    rdfs:label "UNI-D" ;
    rdfs:comment "The UNI-D entity on which Unicast 1:1 AVC TC-4 bandwidth profiles are available. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52]" ;
    rdfs:subClassOf :UNI_D .

:Cl_UNI_DSL a owl:Class ;
    rdfs:label "UNI-DSL" ;
    rdfs:comment "The UNI-DSL entity on which Unicast 1:1 AVC TC-4 bandwidth profiles are available for FTTB/FTTN. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52]" ;
    rdfs:subClassOf :UNI_DSL .

# --- Object Properties ---

:hasBandwidthProfile a owl:ObjectProperty ;
    rdfs:label "hasBandwidthProfile" ;
    rdfs:comment "Links a Unicast 1:1 AVC to its TC-4 bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52]" ;
    rdfs:domain :Unicast_1_1_AVC ;
    rdfs:range :Cl_BandwidthProfile .

:isAvailableOn a owl:ObjectProperty ;
    rdfs:label "isAvailableOn" ;
    rdfs:comment "Links a Cl_Availability node to the access technology on which the bandwidth profile is available. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52]" ;
    rdfs:domain :Cl_Availability ;
    rdfs:range :AccessTechnology .

:isAvailableOnUNI a owl:ObjectProperty ;
    rdfs:label "isAvailableOnUNI" ;
    rdfs:comment "Links a Cl_Availability node to the UNI type (UNI-D or UNI-DSL) on which the bandwidth profile is available. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52]" ;
    rdfs:domain :Cl_Availability ;
    rdfs:range :AVC .

:forBandwidthProfile a owl:ObjectProperty ;
    rdfs:label "forBandwidthProfile" ;
    rdfs:comment "Links a Cl_Availability node to the bandwidth profile whose availability is being described. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52]" ;
    rdfs:domain :Cl_Availability ;
    rdfs:range :Cl_BandwidthProfile .

:forTrafficClass a owl:ObjectProperty ;
    rdfs:label "forTrafficClass" ;
    rdfs:comment "Links a Cl_BandwidthProfile to the traffic class (TC-4) it applies to. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52]" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range :TrafficClass .

:triggeredBy a owl:ObjectProperty ;
    rdfs:label "triggeredBy" ;
    rdfs:comment "Links a Cl_ProvisioningEvent to the RSP order that triggers it. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52, footnote 38]" ;
    rdfs:domain :Cl_ProvisioningEvent ;
    rdfs:range owl:Thing .

:performedBy a owl:ObjectProperty ;
    rdfs:label "performedBy" ;
    rdfs:comment "Links a Cl_ProvisioningEvent to the agent (nbn) that performs the provisioning. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52, footnote 38]" ;
    rdfs:domain :Cl_ProvisioningEvent ;
    rdfs:range owl:Thing .

:resultsIn a owl:ObjectProperty ;
    rdfs:label "resultsIn" ;
    rdfs:comment "Links a Cl_ProvisioningEvent to the resulting state (TC-1 capacity provisioned on UNI-V). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52, footnote 38]" ;
    rdfs:domain :Cl_ProvisioningEvent ;
    rdfs:range owl:Thing .

:provisionsOn a owl:ObjectProperty ;
    rdfs:label "provisionsOn" ;
    rdfs:comment "Links a Cl_ProvisioningEvent to the UNI-V on which TC-1 capacity is provisioned. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52, footnote 38]" ;
    rdfs:domain :Cl_ProvisioningEvent ;
    rdfs:range :Cl_UNI_V .

:hasCondition a owl:DatatypeProperty ;
    rdfs:label "hasCondition" ;
    rdfs:comment "A textual description of the condition under which a bandwidth profile is available. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52]" ;
    rdfs:domain :Cl_Availability ;
    rdfs:range xsd:string .

:hasBandwidthProfileValue a owl:DatatypeProperty ;
    rdfs:label "hasBandwidthProfileValue" ;
    rdfs:comment "The value of a bandwidth profile (e.g., 0 Mbps, 12/1 Mbps, Home Fast). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section A.6.7, page 52]" ;
    rdfs:domain :Cl_BandwidthProfile ;
    rdfs:range xsd:string .

