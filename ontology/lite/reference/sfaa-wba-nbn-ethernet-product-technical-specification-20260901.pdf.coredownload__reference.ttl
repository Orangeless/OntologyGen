    :hasDescription "nbn will change this to an up state in co-ordination with RSP"^^xsd:string ;
    :hasObjectParticipant :NNIBearer_Completed_Order ;
    :hasTransitionFrom :State_AdminDown ;
    :hasTransitionTo :State_Up ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 42" .

:TC4_Performance_Variation a owl:NamedIndividual ;
    rdfs:label "TC-4 Performance Variation" ;
    :hasDescription "The performance of RSP Products that use AVC TC-4s as an input will vary depending on factors both within and outside of the nbn Network"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33" .

