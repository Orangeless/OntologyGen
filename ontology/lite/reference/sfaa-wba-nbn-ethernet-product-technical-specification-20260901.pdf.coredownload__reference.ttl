    rdfs:range :Cl_State .

:hasTrigger a owl:ObjectProperty ;
    rdfs:label "hasTrigger" ;
    rdfs:comment "Links a traffic discard event to the event that triggers the discard (e.g. failure of one or more NNI Bearers). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.7, page 31]" ;
    rdfs:domain :Cl_TrafficDiscardEvent ;
    rdfs:range owl:Thing .

:hasUnit a owl:DatatypeProperty ;
