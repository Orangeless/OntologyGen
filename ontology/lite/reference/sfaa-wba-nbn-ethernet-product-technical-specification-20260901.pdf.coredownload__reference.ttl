:AVCConfigurationAttributes a owl:Class ;
    rdfs:label "AVCConfigurationAttributes" ;
    rdfs:comment "AVC configuration attributes. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 8.1.1.2]" ;
    rdfs:subClassOf :ConfigurationAttributes .

:AVC_Dimensioned_Note a owl:NamedIndividual ;
    rdfs:label "AVC Individually Dimensioned Note" ;
    :hasDescription "AVCs are designed to be individually dimensioned by RSP from a set of selectable parameters according to the service needs of each End User"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24" .

:AVC_Implements_CVLAN a owl:NamedIndividual ;
    rdfs:label "AVC Implements C-VLAN" ;
    :hasDescription "The AVC implements the C-VLAN component of an IEEE802.1ad Provider Bridge, as further described in the Network Interface Specification - AVC"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24" .

:AVC_MultiApp_Note a owl:NamedIndividual ;
    rdfs:label "AVC Multiple Applications Note" ;
    :hasDescription "RSP may deliver multiple End User applications (such as voice and video) using a single AVC (and CoS to manage the capacity between applications)"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24" .

:AccessComponentAttributes a owl:Class ;
    rdfs:label "AccessComponentAttributes" ;
    rdfs:comment "Access component attributes. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 8.1.2.1]" ;
    rdfs:subClassOf :ServiceAttributes .

:AccessTechnologyImpact_TC4 a :Cl_AccessTechnologyImpact,
        owl:NamedIndividual ;
    rdfs:label "Access Technology Impact on TC-4" ;
    :hasImpactDescription "The particular access technology used to deliver nbn Ethernet will also have an impact on TC-4 performance"^^xsd:string ;
    :hasImpactOn :TC_4 ;
    :impactOfAccessTechnology :AccessTechnology_Generic ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33" .

:AppCharacteristic_PeakCapacity a owl:NamedIndividual ;
    rdfs:label "Peak Capacity Benefit" ;
    :hasDescription "Applications that can benefit from a peak capacity"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33" .

:App_BestEffort a :Cl_Application,
        owl:NamedIndividual ;
    rdfs:label "BestEffortData" ;
    :hasDescription "Best-effort data applications"^^xsd:string .

:App_Streaming a :Cl_Application,
        owl:NamedIndividual ;
    rdfs:label "Streaming" ;
    :hasDescription "Streaming standard and high definition video and real-time collaboration applications"^^xsd:string .

:App_Voice a :Cl_Application,
        owl:NamedIndividual ;
    rdfs:label "Voice" ;
    :hasDescription "Voice applications"^^xsd:string .

:Bandwidth_Validation a owl:NamedIndividual ;
    rdfs:label "Bandwidth Validation" ;
    :hasDescription "The bandwidth of the NNI Link will be validated to confirm it is unused and within the NNI Group capacity before the NNI Link order is accepted."^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43" .

:BearerLimit_Definition_Note a owl:NamedIndividual ;
    rdfs:label "Bearer Limit Definition" ;
    :hasDescription "The Bearer Limit includes the total number of Unicast 1:1 AVCs, OVCs, and Unicast N:1 CVCs associated with an NNI Group. The Bearer Limit operates in addition to the limitation set out in section 6.5"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.6, page 30" .

:Burst_TC1_Limited a :Cl_BurstCapability,
        owl:NamedIndividual ;
    rdfs:label "TC-1 Limited Burst" ;
    :hasDescription "Limited ability to burst above its CIR"^^xsd:string .

:CVCClass_For_Satellite a owl:NamedIndividual ;
    rdfs:label "CVC Class for nbn Ethernet (Satellite)" ;
    :hasServiceAttribute :CVCClass_Attribute ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 8, page 38" .

:CVC_1_1_Avail_FTTB a owl:NamedIndividual ;
    rdfs:label "1:1 CVC Available on FTTB" ;
    :hasDescription "1:1 CVC is available in FTTB/FTTN Network"^^xsd:string ;
