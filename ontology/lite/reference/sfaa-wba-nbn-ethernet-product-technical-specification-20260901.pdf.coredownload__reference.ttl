:Cl_AccessTechnologyImpact a owl:Class ;
    rdfs:label "AccessTechnologyImpact" ;
    rdfs:comment "A reified relationship representing that the particular access technology used to deliver nbn Ethernet has an impact on TC-4 performance. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33]" .

:Cl_Application a owl:Class ;
    rdfs:label "Application" ;
    rdfs:comment "An example application targeted by a traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_AvailabilityConstraint a owl:Class ;
    rdfs:label "AvailabilityConstraint" ;
    rdfs:comment "Reified relationship representing that a Unicast N:1 AVC is available only to support a specific bundle (UNI-V + AVC TC-1). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" .

:Cl_Bundle a owl:Class ;
    rdfs:label "Bundle" ;
    rdfs:comment "A bundle comprising the UNI-V interface and the AVC TC-1 traffic class that the Unicast N:1 AVC is available only to support. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" .

:Cl_CapacitySharing a owl:Class ;
    rdfs:label "CapacitySharing" ;
    rdfs:comment "Capacity-sharing characteristic of a traffic class in a given network context. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_ChassisRole a owl:Class ;
    rdfs:label "Chassis Role",
        "ChassisRole" ;
    rdfs:comment "The role (working or protect) of a chassis on which NNI Bearers are provisioned in Diverse Chassis mode. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2.2, page 28]",
        "The role (working or protect) of a chassis on which NNI Bearers are provisioned in Diverse Chassis mode. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :Cl_ChassisRole .

:Cl_FailureResponse a owl:Class ;
    rdfs:label "FailureResponse" ;
    rdfs:comment "A reified description of the behaviour of an NNI Group when an NNI Bearer fails, dependent on the redundancy mode. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2, page 28]" .

:Cl_FlowControlMechanism a owl:Class ;
    rdfs:label "FlowControlMechanism" ;
    rdfs:comment "A reified recommendation for RSP to use suitable higher-layer intelligent flow control mechanisms to achieve optimum results for RSP Products that use AVC TC-4s as an input. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33]" .

:Cl_NNIBearerType a owl:Class ;
