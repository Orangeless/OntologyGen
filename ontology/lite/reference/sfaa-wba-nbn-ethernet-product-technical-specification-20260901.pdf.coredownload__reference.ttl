:isNotUsedByDownstreamV-NNI a owl:DatatypeProperty ;
    rdfs:label "isNotUsedByDownstreamV-NNI" ;
    rdfs:comment "Indicates whether an NNI Link is not used by a Downstream V-NNI, which is the condition for cancellation to be permitted. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43]" ;
    rdfs:domain :NNILink ;
    rdfs:range xsd:boolean .

:isOptional a owl:DatatypeProperty ;
    rdfs:label "isOptional" ;
    rdfs:comment "Indicates that an action or attribute is optional. [extension: nbn Ethernet Product Module, page 38]" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:boolean .

:isPremium a owl:DatatypeProperty ;
