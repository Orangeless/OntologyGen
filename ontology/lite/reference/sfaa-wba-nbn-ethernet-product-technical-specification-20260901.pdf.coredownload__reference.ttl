    rdfs:comment "Links an NNI Group to its protection mode (N:1 or 1:1). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2, page 28]" ;
    rdfs:domain :NNIGroup ;
    rdfs:range :Cl_ProtectionMode .

:hasRSPName a owl:DatatypeProperty ;
    rdfs:label "hasRSPName" ;
    rdfs:comment "The RSP name belonging to the V-NNI RSP. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 13, page 43]" ;
    rdfs:domain :V-NNIRSP ;
    rdfs:range xsd:string .

:hasRange a owl:DatatypeProperty ;
    rdfs:label "hasRange" ;
    rdfs:comment "The range of values for a service attribute. [extension: nbn Ethernet Product Module, page 38]" ;
    rdfs:domain :Cl_ServiceAttribute ;
    rdfs:range xsd:string .

:hasRate a owl:DatatypeProperty ;
    rdfs:label "hasRate" ;
    rdfs:comment "The interface rate (Gbps) of a bearer limit condition. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.1, page 28]" ;
    rdfs:domain :Cl_BearerLimitCondition ;
    rdfs:range xsd:decimal .

:hasRateType a owl:ObjectProperty ;
    rdfs:label "hasRateType" ;
    rdfs:comment "Links a BandwidthProfileSpec to the rate type (CIR or PIR). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" ;
    rdfs:domain :Cl_BandwidthProfileSpec ;
    rdfs:range :Cl_SpecificationType .

:hasRateValue a owl:DatatypeProperty ;
    rdfs:label "hasRateValue" ;
