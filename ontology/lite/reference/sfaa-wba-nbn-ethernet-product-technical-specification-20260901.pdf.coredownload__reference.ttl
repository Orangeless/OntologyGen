:V_NNI_Example a :V_NNI,
        owl:NamedIndividual ;
    rdfs:label "V-NNI Example" ;
    :doesNotSupportUseOf :NNIGroup_100G_Single ;
    :hasDescription "A V-NNI that supports the association of a single NNI Link, obtains its S-TAG pool and bandwidth profile from the associated NNI Link, and inherits the redundancy mode of the NNI Group from which the NNI Link was created"^^xsd:string ;
    :hasVisibilityOf :NNILink_OperationalStatus_Example ;
    :inheritsFrom :NNIGroup_100G_Single ;
    :obtainsFrom :NNILink_Example ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.4, page 30" ;
    :supportsAssociationOf :NNILink_Example .

