:Bandwidth a owl:Class ;
    rdfs:label "Bandwidth" ;
    rdfs:comment "The NNI Link Bandwidth attribute. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 13, page 43]" .

