    :comprises :TC_1 ;
    :hasDescription "TC-1 is an optional traffic class in a Unicast 1:1 AVC"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.1, page 25" .

:Unicast_1_1_AVC_Comprises_TC2 a owl:NamedIndividual ;
