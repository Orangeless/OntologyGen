            owl:oneOf ( :RedundancyMode_DIVERSE_CHASSIS :RedundancyMode_SINGLE :RedundancyMode_SINGLE_CHASSIS ) ] .

:AVCBandwidthProfile a owl:Class ;
    rdfs:label "AVCBandwidthProfile" ;
    rdfs:comment "A combination of available upstream/downstream bandwidth profiles for each traffic class in a Unicast 1:1 AVC. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3, page 25]" .

:AVC_RequiredFor a owl:Class ;
    rdfs:label "AVC Required For" ;
    rdfs:comment "Reified relationship representing that an AVC variant is required for unicast data applications. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

:BandwidthProfile a owl:Class ;
    rdfs:label "BandwidthProfile" ;
    rdfs:comment "A bandwidth profile reserved from an NNI Group that can be assigned to a V-NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.3, page 30]",
        "A bandwidth profile through which an AVC is designed to be scaled in capacity. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

:Cl_BandwidthProfileSpec a owl:Class ;
    rdfs:label "BandwidthProfileSpec" ;
    rdfs:comment "Reified relationship representing a traffic class specification (traffic class, rate type, rate value, unit) within a bandwidth profile. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26]" .

:Cl_BearerLimit a owl:Class ;
    rdfs:label "BearerLimit" ;
    rdfs:comment "A reified conditional maximum number of NNI Bearers an NNI Group can support, dependent on interface rate and redundancy mode. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.1, page 28]" .

:Cl_CVCClass a owl:Class ;
    rdfs:label "CVC Class" ;
    rdfs:comment "The CVC Class attribute chosen by an RSP at the time of ordering a CVC for nbn Ethernet (Satellite), with values CVC Class-0 (Default), CVC Class-1 (Premium), and CVC Class-2 (Premium). [extension: nbn Ethernet Product Module, Table 8, page 38]" ;
    rdfs:subClassOf :Cl_ServiceAttribute .

:Cl_NNIGroupRedundancyMode a owl:Class ;
    rdfs:label "NNI Group Redundancy Mode" ;
    rdfs:comment "The redundancy mode of an NNI Group, either Single Chassis or Diverse Chassis, set through the selection of the first NNI Bearer or pair of NNI Bearers at the time the NNI Group is created. [extension: nbn Ethernet Product Module, section 8.3.1.2, page 40]" ;
    rdfs:subClassOf :ServiceAttributes .

:Cl_NNIGroupRelocation a :Cl_Event,
        owl:Class ;
    rdfs:label "NNI Group Relocation" ;
    rdfs:comment "The process of changing the location of an NNI Group, which requires purchasing a new NNI Group in the intended location and transitioning existing AVCs and CVCs from the previous NNI Group. [extension: nbn Ethernet Product Module, section 8.3.1.1, page 40]" ;
    rdfs:subClassOf :Cl_Event .

:Cl_SpecificationType a owl:Class ;
    rdfs:label "SpecificationType" ;
    rdfs:comment "The type of capacity specification (CIR or PIR) applied to a traffic class. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:Cl_TrafficDiscardEvent a owl:Class ;
    rdfs:label "TrafficDiscardEvent" ;
    rdfs:comment "A reified event describing the circumstances under which traffic may be discarded for an NNI Group, including the cause and the priority basis for discard. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.7, page 31]" .

:NNIGroup_Location_Attribute a :Cl_NNIGroupLocation,
        owl:NamedIndividual ;
    rdfs:label "NNI Group Location Attribute" ;
    :hasAttributeDescription "The location of the NNI Group must be specified at time of NNI Group creation"^^xsd:string ;
    :hasLocationName "Location"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.1.1, page 40" .

:TC_4 a :TrafficClass,
        owl:NamedIndividual ;
    rdfs:label "TC-4" ;
    :name "Best effort / bulk" ;
    :planningThresholdPct 80.0 .

:AccessNetwork a owl:Class ;
    rdfs:label "AccessNetwork" ;
    rdfs:comment "An access network type that determines AVC type availability. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

:BearerLimit a owl:Class ;
    rdfs:label "BearerLimit" ;
    rdfs:comment "The maximum number of Product Components, in aggregate, supported in an NNI Group. The Bearer Limit includes the total number of Unicast 1:1 AVCs, OVCs, and Unicast N:1 CVCs associated with an NNI Group. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.6, page 30]" .

:BearerLimitCondition a owl:Class ;
    rdfs:label "BearerLimitCondition" ;
    rdfs:comment "A reified condition (bearer count, interface rate, redundancy mode) under which a Bearer Limit applies. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.6.1, page 30]" .

:CSA_Example a :CSA,
        owl:NamedIndividual ;
    rdfs:label "CSA Example" ;
    :hasDescription "Connectivity Serving Area to which a CVC provides connectivity"^^xsd:string ;
    :servedAt :POI_Example ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26" .

:Cl_Bearer a owl:Class ;
    rdfs:label "NNI Bearer" ;
    rdfs:comment "A physical interface of an NNI Group, landed on a line-card/port in a failure domain. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :Bearer .

:Cl_NetworkContext a owl:Class ;
    rdfs:label "NetworkContext" ;
    rdfs:comment "A network element or variant that determines applicable specification type and capacity-sharing behavior. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 9]" .

:RedundancyMode_DIVERSE_CHASSIS a :RedundancyMode,
        owl:NamedIndividual ;
    rdfs:label "DIVERSE_CHASSIS" .

:RedundancyMode_SINGLE_CHASSIS a :RedundancyMode,
        owl:NamedIndividual ;
    rdfs:label "SINGLE_CHASSIS" .

:UNI_D_Instance a :UNI_D,
        owl:NamedIndividual ;
    rdfs:label "UNI-D Instance" ;
    :hasDescription "User Network Interface - Data"^^xsd:string .

:V_NNI a owl:Class ;
    rdfs:label "V-NNI" ;
    rdfs:comment "A virtual NNI that supports the association of a single NNI Link and inherits characteristics from the NNI Group from which the NNI Link was created. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.4, page 30]" .

:CVC_BandwidthProfile a owl:Class ;
    rdfs:label "CVC Bandwidth Profile" ;
    rdfs:comment "A bandwidth profile for a CVC, e.g. CVC Max CVC TC-4. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26]" .

:CVC_Example a :CVC,
        owl:NamedIndividual ;
    rdfs:label "CVC Example" ;
    :carries :CSA_Example ;
    :coExistsOnNNI :CVC_CoExistence_Example ;
    :consumes :TC_4 ;
    :deliversAVC :CVC_DeliversAVC_Example ;
    :describedInSection :DocumentSection_5 ;
    :dimensionedWithBandwidth "specific configured amount of bandwidth capacity"^^xsd:string ;
    :hasDescription "Connectivity Virtual Circuit - an Ethernet virtual circuit that provides connectivity from an NNI to a CSA"^^xsd:string ;
    :hasScalability :CVC_Scalability_Example ;
    :hasVariant :CVC_1_1_VLAN_Example,
        :CVC_N_1_VLAN_Example ;
    :isolatedVia :CVC_Isolation_Example ;
    :mapsTo :NNIGroup_Example ;
    :providesConnectivity :CVC_Connectivity_Example ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.1, page 26" .

:Cl_BandwidthProfile a owl:Class ;
    rdfs:label "Bandwidth Profile" ;
    rdfs:comment "A set of attributes (CVC_TC-1_CIR, CVC_TC-2_CIR, CVC_TC-4_PIR, CVC_TC-4_CIR) that define the bandwidth characteristics of a CVC, with applicability varying by access technology. [extension: nbn Ethernet Product Module, Table 9, page 39]" ;
    rdfs:subClassOf :Cl_ServiceAttribute .

:nbnEthernetProduct a owl:Class ;
    rdfs:label "nbnEthernetProduct" ;
    rdfs:comment "A specific nbn Ethernet Ordered Product variant (FTTB, FTTN, FTTC). [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 33]" .

:AccessTechnology a owl:Class ;
    rdfs:label "AccessTechnology" ;
    rdfs:comment "Access technology of a CSA (csas.tech; a CSA may have several, separated by '|')." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :AccessTechnology_FIBRE :AccessTechnology_FTTC :AccessTechnology_HFC :AccessTechnology_FTTB :AccessTechnology_FTTN :AccessTechnology_Wireless :AccessTechnology_Satellite ) ] .

:AccessTechnology_FIBRE a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FIBRE" .

:AccessTechnology_FTTB a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTB" ;
    :hasDescription "Fibre to the Building access technology"^^xsd:string .

:AccessTechnology_FTTC a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTC" .

:AccessTechnology_FTTN a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTN" ;
    :hasDescription "Fibre to the Node access technology"^^xsd:string .

:AccessTechnology_HFC a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "HFC" .

:AccessTechnology_Satellite a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "Satellite" ;
    :hasDescription "Satellite access technology"^^xsd:string .

:AccessTechnology_Wireless a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "Wireless" ;
    :hasDescription "Wireless access technology"^^xsd:string .

:Cl_FrameBurstEvent a owl:Class ;
    rdfs:label "FrameBurstEvent" ;
    rdfs:comment "A reified event describing an AVC peak burst in excess of a maximum number of consecutive Ethernet frames that may cause increased Frame Loss in the downstream. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.3, page 33]" .

:NNI a owl:Class ;
    rdfs:label "NNI" ;
    rdfs:comment "A single NNI within an NNI Group, realised on one Bearer." .

:Cl_PerformanceExclusion a owl:Class ;
    rdfs:label "PerformanceExclusion" ;
    rdfs:comment "A reified relationship representing that the performance of traffic class operations does not apply to a service or product under a specific condition. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 7.2, page 33]" .

:RSP_Generic a :RSP,
        owl:NamedIndividual ;
    rdfs:label "RSP" ;
    :hasContentionManagement :CVC_ContentionManagement_Example ;
    :hasDescription "Retail Service Provider"^^xsd:string .

:Cl_NNIGroupInterfaceRate a owl:Class ;
    rdfs:label "NNI Group Interface Rate" ;
    rdfs:comment "The group interface rate that determines the interface rate of each NNI Bearer within the NNI Group. Available rates: 1Gbps, 10Gbps, 100Gbps (100Gbps not available for nbn Ethernet (Satellite)). [extension: nbn Ethernet Product Module, section 8.3.1.2, page 40]" ;
    rdfs:subClassOf :ServiceAttributes .

:Unicast_N_1_AVC_Instance a :Unicast_N_1_AVC,
        owl:NamedIndividual ;
    rdfs:label "Unicast N:1 AVC Instance" ;
    :availableOn :Avail_N_1_UNI_V_Fibre ;
    :availableOnlyToSupport :AvailabilityConstraint_UnicastN1 ;
    :describedInSection :DocumentSection_4_1,
        :DocumentSection_4_1_3_2 ;
    :hasBandwidthProfile :BWProfile_Unicast_N_1 ;
    :hasDescription "Unicast N:1 AVC - available only to support the UNI-V and AVC TC-1 bundle"^^xsd:string,
        "Unicast N:1 AVC - required for unicast data applications using the UNI-V"^^xsd:string ;
    :requiredFor :ReqFor_N_1_AVC_UNI_V ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24",
        "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.3.2, page 26" .

:ActionType a owl:Class ;
    rdfs:label "ActionType" ;
    rdfs:comment "Planning action types (legacy fixture action generation)." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :ActionType_INCREASE_CVC_BW :ActionType_ADD_PORT :ActionType_MOVE_CSA_LOAD :ActionType_REBALANCE_AVCS :ActionType_SPLIT_CAPACITY_POOL :ActionType_CREATE_NEW_NNI :ActionType_CREATE_NEW_CVC :ActionType_UPGRADE_PORT :ActionType_ADD_BACKHAUL :ActionType_ADD_AGGREGATION :ActionType_CREATE_RESILIENCE_PATH :ActionType_CREATE_NEW_BEARER ) ] .

:NNILink a owl:Class ;
    rdfs:label "NNILink" ;
    rdfs:comment "WBA NNI Link / V-NNI / S-TAG concepts. Not modelled." ;
    skos:altLabel "NNI Link",
        "S-TAG",
        "V-NNI",
        "over-book" .

:AVC_AvailableOn a owl:Class ;
    rdfs:label "AVC Available On" ;
    rdfs:comment "Reified relationship representing that an AVC type is available on a specific UNI type qualified by access network. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

:Bearer a owl:Class ;
    rdfs:label "Bearer" ;
    rdfs:comment "NNI Bearer: one physical interface of an NNI Group, landed on a line-card/port in a failure domain." ;
    skos:altLabel "Diverse Chassis",
        "NNI Bearer",
        "Redundancy Mode",
        "Single Chassis",
        "interface rate" .

:ControlProtocol_DHCPv4 a :ControlProtocol,
        owl:NamedIndividual ;
    rdfs:label "DHCPv4" ;
    :hasDescription "Dynamic Host Configuration Protocol version 4"^^xsd:string .

:ControlProtocol_DHCPv6 a :ControlProtocol,
        owl:NamedIndividual ;
    rdfs:label "DHCPv6" ;
    :hasDescription "Dynamic Host Configuration Protocol version 6"^^xsd:string .

:ControlProtocol_PPPoE a :ControlProtocol,
        owl:NamedIndividual ;
    rdfs:label "PPPoE" ;
    :hasDescription "Point-to-Point Protocol over Ethernet"^^xsd:string .

:S_C_VID a owl:Class ;
    rdfs:label "S/C-VID" ;
    rdfs:comment "Distinct Service and Customer VLAN Identifiers used to logically isolate AVCs from each other. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" .

:RSP a owl:Class ;
    rdfs:label "RSP" ;
    rdfs:comment "Retail Service Provider who may order optional features for AVCs. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 24]" .

:ServiceAttributes a owl:Class ;
    rdfs:label "ServiceAttributes" ;
    rdfs:comment "Service attributes of access components. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, section 8.1.2]" .

:CSA a owl:Class ;
    rdfs:label "CSA" ;
    rdfs:comment "Connectivity Serving Area: a served area with services, premises and demand growth." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "CSA",
        "Connectivity Serving Area" .

:AccessLoopCharacterisationAvailability a owl:Class ;
    rdfs:label "AccessLoopCharacterisationAvailability" ;
    rdfs:comment "Reified relationship for the availability of Access Loop Characterisation on an access technology qualified by control protocol. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 25]" .

:AccessLoopCharacterisation_Feature a :AccessLoopCharacterisation,
        owl:NamedIndividual ;
    rdfs:label "Access Loop Characterisation" ;
    :dependsOn :AccessLoopIdentification_Feature ;
    :hasDescription "Access Loop Characterisation - identifying actual data rate Upstream and actual data rate Downstream"^^xsd:string ;
    :identifies :ActualDataRate_Downstream,
        :ActualDataRate_Upstream ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 25" ;
    :specifiedIn :NetworkInterfaceSpecification_AVC_Doc .

:AccessLoopIdentificationAvailability a owl:Class ;
    rdfs:label "AccessLoopIdentificationAvailability" ;
    rdfs:comment "Reified relationship for the availability of Access Loop Identification on an access technology qualified by control protocol. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 25]" .

:CandidateAction a owl:Class ;
    rdfs:label "CandidateAction" ;
    rdfs:comment "Candidate planning action with lead time, cost, feasibility, blocking reasons and scores." ;
    skos:altLabel "Modify",
        "NNI Diversity Upgrade",
        "NNI Upsize Migration",
        "charge",
        "lead time",
        "order",
        "price" .

:AccessLoopIdentification_Feature a :AccessLoopIdentification,
        owl:NamedIndividual ;
    rdfs:label "Access Loop Identification" ;
    :hasDescription "Access Loop Identification - identifying the access loop by inserting identification into upstream Layer 3 control packets"^^xsd:string ;
    :identifies :AccessLoop_Identified ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.2, page 25" ;
    :specifiedIn :NetworkInterfaceSpecification_AVC_Doc .

:Cl_NNIGroup a owl:Class ;
    rdfs:label "NNI Group" ;
    rdfs:comment "A group of NNI Bearers at a POI sharing a redundancy mode, interface rate, and protected capacity. [extension: nbn Ethernet Product Module, page 42]" ;
    rdfs:subClassOf :NNIGroup .

:Cl_State a owl:Class ;
    rdfs:label "State" ;
    rdfs:comment "A state or condition of a product component. [extension: nbn Ethernet Product Module, page 38]" .

:TrafficClass a owl:Class ;
    rdfs:label "TrafficClass" ;
    rdfs:comment "Traffic class (TC-1, TC-2, TC-4) with a planning utilisation threshold." ;
    skos:altLabel "TC-1",
        "TC-2",
        "TC-4",
        "bandwidth profile",
        "traffic class" .

:Unicast_1_1_AVC_Instance a :Unicast_1_1_AVC,
        owl:NamedIndividual ;
    rdfs:label "Unicast 1:1 AVC Instance" ;
    :availableOn :Avail_1_1_UNI_DSL_FTTB,
        :Avail_1_1_UNI_DSL_FTTN,
        :Avail_1_1_UNI_D_FTTB,
        :Avail_1_1_UNI_D_FTTC,
        :Avail_1_1_UNI_D_FTTN,
        :Avail_1_1_UNI_D_Fibre,
        :Avail_1_1_UNI_D_HFC,
        :Avail_1_1_UNI_D_Satellite,
        :Avail_1_1_UNI_D_Wireless ;
    :describedInSection :DocumentSection_4_1 ;
    :hasDescription "Unicast 1:1 AVC - required for unicast data applications using the UNI-D or UNI-DSL"^^xsd:string ;
    :logicallyIsolatedBy :LogicalIsolation_Example ;
    :mayCauseIncreasedFrameLoss :FrameBurstEvent_TC4 ;
    :requiredFor :ReqFor_1_1_AVC_UNI_D,
        :ReqFor_1_1_AVC_UNI_DSL ;
    :scaledThrough :ScaledThrough_Example ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24" .

:Cl_Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "An event that changes a product state or causes a consequence. [extension: nbn Ethernet Product Module, page 38]" .

:AVC a owl:Class ;
    rdfs:label "AVC" ;
    rdfs:comment "Access Virtual Circuit: per-service circuit that uses a CVC." ;
    skos:altLabel "AVC",
        "Access Virtual Circuit",
        "OVC",
        "Unicast 1:1 AVC" .

:CVC a owl:Class ;
    rdfs:label "CVC" ;
    rdfs:comment "Connectivity Virtual Circuit: carries a CSA's traffic over an NNI Group, with a traffic-class mix." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "CVC",
        "CVC TC-1",
        "CVC TC-2",
        "CVC TC-4",
        "Connectivity Virtual Circuit",
        "Unicast N:1 CVC" .

:NNIGroup a owl:Class ;
    rdfs:label "NNIGroup" ;
    rdfs:comment "Group of NNI Bearers/NNIs at a POI sharing a redundancy mode, interface rate and protected capacity." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "NNI",
        "NNI Group",
        "NNI Product Component",
        "Network-Network Interface" .

:DocumentSection a owl:Class ;
    rdfs:label "DocumentSection" ;
    rdfs:comment "A section or subsection of the Wholesale Broadband Agreement document. [extension: Wholesale Broadband Agreement – Product Technical Specification – nbn® Ethernet Product Module, page 4]" .


# ===== EXTENSIONS FROM DOCUMENTS: append new classes / properties / facts BELOW this line =====
# ===== V-NNI Ordering (Section 8.3.4) Extensions =====

# --- Classes ---

:UpstreamNNILink a owl:Class ;
    rdfs:label "Upstream NNI Link" ;
    rdfs:comment "The NNI Link that a V-NNI is associated with; its attributes (S-TAG pool and bandwidth) are displayed during the V-NNI ordering process. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:subClassOf :NNILink .

:CreateVNNIEvent a owl:Class ;
    rdfs:label "Create a new V-NNI" ;
    rdfs:comment "An event performed by an RSP to create a new V-NNI by selecting from a list of possible NNI Links. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:subClassOf :Cl_Event .

:CancelVNNIEvent a owl:Class ;
    rdfs:label "Cancel an existing V-NNI" ;
    rdfs:comment "An event performed by an RSP to cancel an existing V-NNI, permitted after associated CVCs have been cancelled. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:subClassOf :Cl_Event .

:Condition a owl:Class ;
    rdfs:label "Condition" ;
    rdfs:comment "A reified condition that must be met before an event can occur. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" .

:CVCsCancelledCondition a owl:Class ;
    rdfs:label "CVCs Cancelled Condition" ;
    rdfs:comment "A precondition that all associated CVCs have been cancelled before cancelling an existing V-NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:subClassOf :Condition .

:S-TAGPool a owl:Class ;
    rdfs:label "S-TAG Pool" ;
    rdfs:comment "The range of S-TAG values associated with an NNI Link, displayed during the V-NNI ordering process. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:subClassOf :S_TAG_Pool .

:Bandwidth a owl:Class ;
    rdfs:label "Bandwidth" ;
    rdfs:comment "The bandwidth attribute of an Upstream NNI Link, displayed during the V-NNI ordering process. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" .

# --- Object Properties ---

:associatedWithUpstreamNNILink a owl:ObjectProperty ;
    rdfs:label "associatedWithUpstreamNNILink" ;
    rdfs:comment "Links a V-NNI to the single Upstream NNI Link it is associated with. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:domain :V_NNI ;
    rdfs:range :UpstreamNNILink .

:isAssociatedWithVNNI a owl:ObjectProperty ;
    rdfs:label "isAssociatedWithVNNI" ;
    rdfs:comment "Inverse of associatedWithUpstreamNNILink; links an Upstream NNI Link to the V-NNI it is associated with. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:domain :UpstreamNNILink ;
    rdfs:range :V_NNI .

:hasS-TAGPool a owl:ObjectProperty ;
    rdfs:label "hasS-TAGPool" ;
    rdfs:comment "Links an Upstream NNI Link to its S-TAG pool attribute. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:domain :UpstreamNNILink ;
    rdfs:range :S-TAGPool .

:hasBandwidth a owl:ObjectProperty ;
    rdfs:label "hasBandwidth" ;
    rdfs:comment "Links an Upstream NNI Link to its bandwidth attribute. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:domain :UpstreamNNILink ;
    rdfs:range :Bandwidth .

:hasNNILinkID a owl:DatatypeProperty ;
    rdfs:label "hasNNILinkID" ;
    rdfs:comment "The NNI Link ID that identifies the NNI Link which will be associated to the V-NNI. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 14, page 44]" ;
    rdfs:domain :V_NNI ;
    rdfs:range xsd:string .

:hasPrecondition a owl:ObjectProperty ;
    rdfs:label "hasPrecondition" ;
    rdfs:comment "Links an event to the condition that must be met before it can occur. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:domain :Cl_Event ;
    rdfs:range :Condition .

:performs a owl:ObjectProperty ;
    rdfs:label "performs" ;
    rdfs:comment "Links an RSP to the V-NNI ordering events it performs. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:domain :RSP ;
    rdfs:range :Cl_Event .

:isCreatedBy a owl:ObjectProperty ;
    rdfs:label "isCreatedBy" ;
    rdfs:comment "Links a V-NNI to the CreateVNNIEvent that created it. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:domain :V_NNI ;
    rdfs:range :CreateVNNIEvent .

:isCancelledBy a owl:ObjectProperty ;
    rdfs:label "isCancelledBy" ;
    rdfs:comment "Links a V-NNI to the CancelVNNIEvent that cancelled it. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:domain :V_NNI ;
    rdfs:range :CancelVNNIEvent .

:hasAssociatedCVC a owl:ObjectProperty ;
    rdfs:label "hasAssociatedCVC" ;
    rdfs:comment "Links a V-NNI to the CVCs associated with it, which must be cancelled before the V-NNI can be cancelled. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44]" ;
    rdfs:domain :V_NNI ;
    rdfs:range :CVC .

# --- Facts / Individuals ---

:VNNI_Ordering_Activities a owl:NamedIndividual ;
    rdfs:label "V-NNI Ordering Activities" ;
    :hasDescription "The following activities may be performed by RSP for a V-NNI: Create a new V-NNI by selecting from a list of possible NNI Links; Cancel an existing V-NNI."^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44" .

:VNNI_Association_Note a owl:NamedIndividual ;
    rdfs:label "V-NNI Association with Upstream NNI Link" ;
    :hasDescription "A V-NNI can be associated with one Upstream NNI Link. The Upstream NNI Link attributes (S-TAG pool and bandwidth) will be displayed during the V-NNI ordering process."^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44" .

:VNNI_Cancellation_Precondition a :CVCsCancelledCondition, owl:NamedIndividual ;
    rdfs:label "V-NNI Cancellation Precondition" ;
    :hasDescription "Cancelling of an existing V-NNI is permitted after associated CVCs have been cancelled."^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.1, page 44" .

:VNNI_Identification_Assignment a owl:NamedIndividual ;
    rdfs:label "V-NNI Identification Number Assignment" ;
    :hasDescription "Each successful V-NNI order will be assigned an nbn-designated V-NNI identification number."^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.2, page 44" .

:VNNI_Identification_Example a :V_NNI, owl:NamedIndividual ;
    rdfs:label "nbn-designated V-NNI identification number" ;
    :hasIdentificationNumber "nbn-designated V-NNI identification number"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.4.2, page 44" .

:VNNI_Orderable_Attributes a owl:NamedIndividual ;
    rdfs:label "V-NNI Orderable Attributes" ;
    :hasDescription "A summary of attributes that must be specified for each V-NNI order: NNI Link ID."^^xsd:string ;
    :hasServiceAttribute :NNILinkID_Attribute ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 14, page 44" .

:NNILinkID_Attribute a :Cl_ServiceAttribute, owl:NamedIndividual ;
    rdfs:label "NNI Link ID Attribute" ;
    :hasAttributeDescription "The NNI Link which will be associated to the V-NNI"^^xsd:string ;
    :hasOptions "NNI Link ID"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 14, page 44" .

