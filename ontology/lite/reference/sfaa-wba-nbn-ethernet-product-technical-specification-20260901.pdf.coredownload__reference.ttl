:RSP_Purchase_CVC_Example a owl:NamedIndividual ;
    rdfs:label "RSP May Purchase CVC in Relation to CSA" ;
    :hasDescription "Subject to section 2.1(d) of the nbn Ethernet Product Description, the number of CVCs that RSP may purchase in relation to a given CSA is limited only by the NNI resources that RSP has purchased for that CSA"^^xsd:string ;
    :inRelationToCSA :CSA_Example ;
    :limitedByNNIResources :NNIGroup_Example ;
    :mayPurchase :CVC_1_1_VLAN_Scalability_Example ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28" ;
    :subjectToClause :DocumentSection_2_1_d .

:RSP_RequiresAccess_Example a owl:NamedIndividual ;
    rdfs:label "RSP Requires Access to More Than 4,000 AVCs" ;
    :hasDescription "Where RSP requires access to more than 4,000 AVCs in a given CSA, it is necessary to utilise more than one CVC"^^xsd:string ;
    :inRelationToCSA :CSA_Example ;
    :requiresAccessTo :Unicast_1_1_AVC_Addressed_Example ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 5.1.2.1, page 28" ;
    :utilisesMoreThanOneCVC :CVC_1_1_VLAN_Scalability_Example .

:RedundancyMode_DIVERSE_CHASSIS_Desc a owl:NamedIndividual ;
    rdfs:label "Diverse Chassis Mode Description" ;
    :hasDescription "Diverse Chassis redundancy mode, where NNI Bearers are connected across a pair of chassis"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2, page 28" .

:RedundancyMode_SINGLE_CHASSIS_Desc a owl:NamedIndividual ;
    rdfs:label "Single Chassis Mode Description" ;
    :hasDescription "Single Chassis redundancy mode, where all NNI Bearers are connected to the same chassis"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2, page 28" .

:S-TAGPool_Validation a owl:NamedIndividual ;
    rdfs:label "S-TAG Pool Validation" ;
    :hasDescription "The pool of S-TAGs will be validated to ensure that it is not currently assigned to an existing NNI Link or CVC."^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 8.3.3.1, page 43" .

:SCVID_Allocated_Value_Unique a owl:NamedIndividual ;
    rdfs:label "S/C-VID Unique to RSP Service" ;
    :avoidsMismatch :SCVID_Mismatch_Potential ;
    :isUniqueToRspService true ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 38" .

:SCVID_Allocation_Event a :Cl_SCVIDAllocationEvent,
        owl:NamedIndividual ;
    rdfs:label "S/C-VID Allocation Event" ;
    :hasAgent :nbn_Entity ;
    :hasObjectParticipant :CVC_Example,
        :Unicast_1_1_AVC_Instance ;
    :resultsIn :SCVID_Allocated_Value ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, page 38" ;
    :triggeredBy :RSP_Generic .

:SatelliteCvcMinAvcThreshold_For_Satellite a owl:NamedIndividual ;
    rdfs:label "Satellite CVC Minimum AVC Threshold for nbn Ethernet (Satellite)" ;
    :hasServiceAttribute :SatelliteCvcMinAvcThreshold_Attribute ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, Table 8, page 38" .

:Satellite_CSA_Note a owl:NamedIndividual ;
    rdfs:label "Satellite CSA Note" ;
    :hasDescription "nbn Ethernet (Satellite) is supplied in a separate single national CSA which geographically overlaps with the other CSAs that contain Premises served by other nbn Network technologies"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, footnote 11, page 28" .

:ServiceLevel a owl:Class ;
    rdfs:label "ServiceLevel" ;
    rdfs:comment "WBA availability and service levels (Network Availability, frame delay, frame loss). Not modelled." ;
    skos:altLabel "Network Availability",
        "Service Level",
        "frame delay",
        "frame loss" .

:Service_Support_Note a owl:NamedIndividual ;
    rdfs:label "Service Support Note" ;
    :hasDescription "RSP must not exceed the maximum number of Product Components, in aggregate, supported in an NNI Group set out in section 6.6 (the Bearer Limit)"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.6, page 30" .

:SingleChassis_Provisioning_Note a owl:NamedIndividual ;
    rdfs:label "Single Chassis Provisioning" ;
    :hasDescription "In Single Chassis mode, all NNI Bearers of the NNI Group will be provisioned on the same chassis"^^xsd:string ;
    :sourceClause "Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 6.2.1, page 28" .

:State_Transition_DownToUp a :Cl_Event,
        owl:NamedIndividual ;
    rdfs:label "State Transition: Down to Up" ;
