    rdfs:domain :Unicast_N_1_AVC ;
    rdfs:range :Cl_AvailabilityConstraint .

:avcType a owl:ObjectProperty ;
    rdfs:label "avcType" ;
    rdfs:comment "Links an AVC_AvailableOn node to the AVC type. [extension: Wholesale Broadband Agreement - Product Technical Specification - nbn Ethernet Product Module, section 4.1.1, page 24]" ;
    rdfs:domain :AVC_AvailableOn ;
    rdfs:range :AVC .

:avcs a owl:DatatypeProperty ;
    rdfs:label "avcs" ;
    rdfs:domain :CVC ;
    rdfs:range xsd:integer .

