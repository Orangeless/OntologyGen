:CVCClassAdjustment_Instance a :Cl_CVCClassAdjustment,
        owl:NamedIndividual ;
    rdfs:label "CVC Class Adjustment for nbn Ethernet (Satellite)" ;
    :hasChargeTier :UsageTierCharge_CVC0_Tier1,
        :UsageTierCharge_CVC0_Tier2,
        :UsageTierCharge_CVC0_Tier3,
        :UsageTierCharge_CVC1_Tier1,
        :UsageTierCharge_CVC1_Tier2,
        :UsageTierCharge_CVC2_Tier1 ;
    :isAdditionalTo :Section_1_2,
        :Section_2_3,
        :Section_6 ;
    :triggeredBy :ExceedanceEvent_BothLimitations,
        :ExceedanceEvent_MultipleOccasions,
        :ExcessUsageEvent_Instance ;
    rdfs:comment "Any Charges applicable under section 6 are in addition to Charges that apply under sections 1.2 and 2.3. [extension: nbn Ethernet Price List, Section 6, Note, p.17]",
        "Any Charges applicable under this section 6 are in addition to Charges that apply under sections 1.2 and 2.3. [extension: nbn Ethernet Price List, Section 6, Note, p.17]",
        "CVC Class Adjustment triggered by exceedance events under section 6. [extension: nbn Ethernet Price List, Section 6, p.18]" .

