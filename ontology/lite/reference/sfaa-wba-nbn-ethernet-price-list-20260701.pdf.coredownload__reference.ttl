:actionType a owl:ObjectProperty ;
    rdfs:label "action_type" ;
    rdfs:domain :CandidateAction ;
    rdfs:range :ActionType .

:addressesConstraintIds a owl:DatatypeProperty ;
    rdfs:label "addresses_constraint_ids" ;
    rdfs:comment "'|'-separated constraint ids covered, scoped to a resource." ;
    rdfs:domain :CandidateAction ;
    rdfs:range xsd:string .

:addressesRule a owl:ObjectProperty ;
    rdfs:domain :CandidateAction ;
    rdfs:range :PlanningRule .

:amountEquals a owl:ObjectProperty ;
    rdfs:label "amountEquals" ;
    rdfs:comment "Links a Rebate or Credit to the Recurring Charge whose amount it equals. [extension: nbn Ethernet Price List, Section 1.4, p.6]" ;
    rdfs:domain :RebateOrCredit ;
    rdfs:range :RecurringCharge .

:appliesTo a owl:ObjectProperty ;
    rdfs:label "appliesTo" ;
    rdfs:comment "Links a FlatRateAVCCharge to the AVC TC-4 Product Component or CVC TC-4 capacity it applies to. [extension: nbn Ethernet Price List, Section 1.1]",
        "Links a Rebate or Credit to the Product Component it applies to. [extension: nbn Ethernet Price List, Section 1.4, p.6]" ;
    rdfs:domain :FlatRateAVCCharge,
        :RebateOrCredit ;
    rdfs:range :AVC_TC4_ProductComponent,
        :ProductComponent .

:appliesToBandwidth a owl:ObjectProperty ;
    rdfs:label "appliesToBandwidth" ;
    rdfs:comment "Links an OrderedBandwidth or IncludedBandwidth to the CVC TC-2 Product Component it applies to. [extension: nbn Ethernet Price List, Section 1.5(c), p.8]" ;
    rdfs:domain :OrderedBandwidth ;
    rdfs:range :CVC_TC2_ProductComponent .

:appliesToNetworkType a owl:ObjectProperty ;
    rdfs:label "appliesToNetworkType" ;
    rdfs:comment "Links a Product Feature or Charge to the network type it applies to. [extension: nbn Ethernet Price List, Section 2.4, p.10]" ;
    rdfs:domain :ProductFeatures ;
    rdfs:range :AccessTechnology .

:appliesToOrderedProduct a owl:ObjectProperty ;
    rdfs:label "applies to ordered product" ;
    rdfs:comment "Links a section 7 charge to the ordered product it applies to. [extension: nbn Ethernet Price List, Section 7(a), p.18]" ;
    rdfs:domain :Cl_EarlyDisconnectionModificationCharge ;
    rdfs:range :OrderedProduct .

:assessedAs a owl:ObjectProperty ;
    rdfs:domain :CandidateAction ;
    rdfs:range :ActionAssessment .

:associatedWith a owl:ObjectProperty ;
    rdfs:label "associatedWith" ;
    rdfs:comment "Links an AVC TC-2 Product Component to the CVC TC-2 Product Component it is associated with. [extension: nbn Ethernet Price List, Section 1.5(c), p.8]" ;
    rdfs:domain :AVC_TC2_ProductComponent ;
    rdfs:range :CVC_TC2_ProductComponent .

:availableGbps a owl:DatatypeProperty ;
    rdfs:label "available_gbps" ;
    rdfs:comment "= protected - current load" ;
    rdfs:domain :NNIGroup ;
    rdfs:range xsd:double .

:avcs a owl:DatatypeProperty ;
    rdfs:label "avcs" ;
    rdfs:domain :CVC ;
    rdfs:range xsd:integer .

:averageUtilisationThresholdMbps a owl:DatatypeProperty ;
    rdfs:label "averageUtilisationThresholdMbps" ;
    rdfs:comment "The average utilisation threshold in Mbps for a usage condition. [extension: nbn Ethernet Price List, Note 4, p.5]" ;
    rdfs:domain :UsageCondition ;
    rdfs:range xsd:decimal .

:bandwidthTierMbps a owl:DatatypeProperty ;
    rdfs:label "bandwidth_tier_mbps" ;
    rdfs:domain :AVC ;
    rdfs:range xsd:integer .

