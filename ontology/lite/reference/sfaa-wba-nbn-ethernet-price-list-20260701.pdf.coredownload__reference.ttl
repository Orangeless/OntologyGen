:Cl_ExemptionCondition a owl:Class ;
    rdfs:label "Exemption Condition" ;
    rdfs:comment "A condition under which the Charge under section 7 does not apply, such as unsuccessful Network Activity or Service Transfer Order with qualifying CIR Objective. [extension: nbn Ethernet Price List, Section 7(d), p.19]" .

:Cl_Incidentals a owl:Class ;
