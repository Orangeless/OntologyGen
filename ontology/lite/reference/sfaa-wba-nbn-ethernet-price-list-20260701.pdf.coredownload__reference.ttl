    rdfs:comment "A party to the Agreement (e.g. nbn, RSP). [extension: nbn Ethernet Price List, Section 7, p.18]" .

:ProRataRule a owl:Class ;
    rdfs:label "ProRataRule" ;
    rdfs:comment "A rule that calculates charges on a pro-rata basis when conditions are met for some days of a Billing Period but not others. [extension: nbn Ethernet Price List, Note 4, p.5]" .

:ProductFeatures a owl:Class ;
    rdfs:label "ProductFeatures" ;
    rdfs:comment "The set of features selected by an RSP for a Product Component (e.g. bandwidth profile, access technology). [extension: nbn Ethernet Price List, Section 1]" .

:RebateOrCredit a owl:Class ;
    rdfs:label "RebateOrCredit" ;
    rdfs:comment "A rebate or credit equal to the recurring charge of one symmetrical AVC TC-1 of 0.15Mbps, applied when an RSP orders any symmetrical AVC TC-1 of 0.15Mbps or above. [extension: nbn Ethernet Price List, Section 1.4, p.6]" .

:TimeInterval a owl:Class ;
