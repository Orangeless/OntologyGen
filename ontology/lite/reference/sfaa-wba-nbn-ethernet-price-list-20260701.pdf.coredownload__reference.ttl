:BasicOfferCondition_12_1 a :BasicOfferCondition,
        owl:NamedIndividual ;
    rdfs:label "Basic Offer Condition for 12/1 AVC TC-4" ;
    :appliesTo :AVC_TC4_ProdComp_12_1_Basic ;
    :conditionDescription "Basic Offer applies if RSP uses the AVC TC-4 as input into a broadband service with voice component, and the AVC does not utilise more than 0.1 Mbps average during any 60-minute period on that day." ;
    :hasConditionTrigger :UsageCondition_LowUtilisation,
        :UsageCondition_VoiceBroadband ;
    :hasDayDefinition :Day_Sydney ;
    :hasProRataRule :ProRataRule_12_1 ;
    :sourceClause "nbn Ethernet Price List, Note 4, p.5" .

