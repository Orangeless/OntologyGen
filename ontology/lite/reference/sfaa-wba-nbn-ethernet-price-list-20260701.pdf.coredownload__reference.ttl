    rdfs:label "TrafficClass" ;
    rdfs:comment "Traffic class (TC-1, TC-2, TC-4) with a planning utilisation threshold." ;
    skos:altLabel "TC-1",
        "TC-2",
        "TC-4",
        "bandwidth profile",
        "traffic class" .

:UsageCondition a owl:Class ;
    rdfs:label "UsageCondition" ;
    rdfs:comment "A condition related to the usage or capacity utilisation of an AVC. [extension: nbn Ethernet Price List, Note 4, p.5]" .

:CVC_TC2_ProductComponent a owl:Class ;
    rdfs:label "CVC_TC2_ProductComponent" ;
    rdfs:comment "A Connectivity Virtual Circuit Product Component for Traffic Class 2, with a recurring charge per provisioned symmetrical Mbps (CIR). [extension: nbn Ethernet Price List, Section 1.5, p.8]" ;
    rdfs:subClassOf :CVC,
        :ProductComponent .

:Cl_EarlyDisconnectionModificationCharge a owl:Class ;
    rdfs:label "Early Disconnection or Modification Charge" ;
    rdfs:comment "A monetary charge triggered when an AVC TC-2 Product Component is cancelled, disconnected, or modified within 12 months of order completion. [extension: nbn Ethernet Price List, Section 7, p.18]" ;
    rdfs:subClassOf :MonetaryAmount .

:Cl_ExceedanceEvent a owl:Class ;
    rdfs:label "Exceedance Event" ;
    rdfs:comment "An event where an RSP exceeds the average download and/or upload limitation set out in section 4.5(a) of the nbn Ethernet Fair Use Policy. [extension: nbn Ethernet Price List, Section 6(d)-(e), p.18]" ;
    rdfs:subClassOf :Event .

:Cl_UsageRange a owl:Class ;
    rdfs:label "Usage Range" ;
    rdfs:comment "A threshold or range of CVC TC-4 usage that defines a charge tier. [extension: nbn Ethernet Price List, Section 6(a), p.17]" .

:ESLAChangeEvent a owl:Class ;
    rdfs:label "ESLAChangeEvent" ;
    rdfs:comment "An event where an Enhanced Fault Rectification Service is disconnected or modified to change the selected Enhanced Fault Rectification Service option, triggering special charge rules under section 2.2. [extension: nbn Ethernet Price List, Section 2.2(e), p.10]" .

:NNIBearerProfile a owl:Class ;
    rdfs:label "NNIBearerProfile" ;
    rdfs:comment "An enumeration of NNI Bearer profile types (e.g. 1000BaseLX, 10GBaseLR). [extension: nbn Ethernet Price List, Section 1.6, p.8]" .

:AVC a owl:Class ;
    rdfs:label "AVC" ;
    rdfs:comment "Access Virtual Circuit: per-service circuit that uses a CVC." ;
    skos:altLabel "AVC",
        "Access Virtual Circuit",
        "OVC",
        "Unicast 1:1 AVC" .

:BandwidthTier a owl:Class ;
    rdfs:label "BandwidthTier" ;
    rdfs:comment "A symmetrical bandwidth tier in Mbps (CIR) for an AVC TC-1 Product Component. [extension: nbn Ethernet Price List, Section 1.4, p.6]" .

:Bearer a owl:Class ;
    rdfs:label "Bearer" ;
    rdfs:comment "NNI Bearer: one physical interface of an NNI Group, landed on a line-card/port in a failure domain." ;
    skos:altLabel "Diverse Chassis",
        "NNI Bearer",
        "Redundancy Mode",
        "Single Chassis",
        "interface rate" .

:Cl_AreaType a owl:Class ;
    rdfs:label "Area Type" ;
    rdfs:comment "A classification of geographic area that determines the charge for certain service management activities. [extension: nbn Ethernet Price List, Section (c), p.17]" .

:Cl_ChargeFormula a owl:Class ;
    rdfs:label "Charge Formula" ;
    rdfs:comment "A reified representation of the formula: Charge = (Pre Disconnection Modification Charges - Post Disconnection Modification Charges) x Shortfall Period. [extension: nbn Ethernet Price List, Section 7(c), p.19]" .

:Cl_ServiceManagementActivity a owl:Class ;
    rdfs:label "Service Management Activity" ;
    rdfs:comment "An event (fault report, cancellation, missed visit) related to nbn Ethernet (Satellite) that incurs a one-off charge per activity. [extension: nbn Ethernet Price List, Section (c), p.17]" .

:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "An event that occurs at a point in time or over a duration. [extension: nbn Ethernet Price List, Section 6, p.18]" .

:ProductComponentName a owl:Class ;
    rdfs:label "ProductComponentName" ;
    rdfs:comment "A named variant of a Product Component (e.g. 'Wireless Plus', 'Home Fast'). [extension: nbn Ethernet Price List, Section 1.1]" .

:AVC_TC1_ProductComponent a owl:Class ;
    rdfs:label "AVC_TC1_ProductComponent" ;
    rdfs:comment "An Access Virtual Circuit with Traffic Class 1, charged per Billing Period based on symmetrical Mbps (CIR) and network type. [extension: nbn Ethernet Price List, Section 1.4, p.6]" ;
    rdfs:subClassOf :AVC,
        :ProductComponent .

:AVC_TC2_ProductComponent a owl:Class ;
    rdfs:label "AVC_TC2_ProductComponent" ;
    rdfs:comment "An Access Virtual Circuit with Traffic Class 2, associated with a CVC TC-2 Product Component. [extension: nbn Ethernet Price List, Section 1.5(c), p.8]" ;
    rdfs:subClassOf :AVC,
        :ProductComponent .

:ServiceOption a owl:Class ;
    rdfs:label "ServiceOption" ;
    rdfs:comment "An enumeration of Enhanced Fault Rectification Service options. [extension: nbn Ethernet Price List, Section 2.2, p.9]" .

:BasicOfferCondition a owl:Class ;
    rdfs:label "BasicOfferCondition" ;
    rdfs:comment "A condition that, when satisfied, triggers the Basic Offer charge for a 12/1 Mbps AVC TC-4 on a given day. [extension: nbn Ethernet Price List, Note 4, p.5]" .

:OrderedProduct a owl:Class ;
    rdfs:label "OrderedProduct" ;
    rdfs:comment "A product ordered by an RSP. [extension: nbn Ethernet Price List, Section 1.4, p.6]" .

:AccessTechnology a owl:Class ;
    rdfs:label "AccessTechnology" ;
    rdfs:comment "Access technology of a CSA (csas.tech; a CSA may have several, separated by '|')." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :AccessTechnology_FIBRE :AccessTechnology_FTTC :AccessTechnology_HFC :AccessTechnology_FTTB :AccessTechnology_FTTN :AccessTechnology_Wireless ) ] .

:Cl_UsageTierCharge a owl:Class ;
    rdfs:label "Usage Tier Charge" ;
    rdfs:comment "A reified relationship linking an Ordered CVC Class, a usage range, and a charge per each associated AVC TC-4. [extension: nbn Ethernet Price List, Section 6(a), p.17]" .

:ProductComponent a owl:Class ;
    rdfs:label "ProductComponent" ;
    rdfs:comment "WBA Product Component; counts toward an NNI Group's Bearer Limit. Not modelled in the simulator." ;
    skos:altLabel "Bearer Limit",
        "Product Component" .

:ActionType a owl:Class ;
    rdfs:label "ActionType" ;
    rdfs:comment "Planning action types (legacy fixture action generation)." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :ActionType_INCREASE_CVC_BW :ActionType_ADD_PORT :ActionType_MOVE_CSA_LOAD :ActionType_REBALANCE_AVCS :ActionType_SPLIT_CAPACITY_POOL :ActionType_CREATE_NEW_NNI :ActionType_CREATE_NEW_CVC :ActionType_UPGRADE_PORT :ActionType_ADD_BACKHAUL :ActionType_ADD_AGGREGATION :ActionType_CREATE_RESILIENCE_PATH :ActionType_CREATE_NEW_BEARER ) ] .

:CSA a owl:Class ;
    rdfs:label "CSA" ;
    rdfs:comment "Connectivity Serving Area: a served area with services, premises and demand growth." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "CSA",
        "Connectivity Serving Area" .

:NNIBearerProductComponent a owl:Class ;
    rdfs:label "NNIBearerProductComponent" ;
    rdfs:comment "A physical interface of an NNI Group, with a profile and a recurring charge per Billing Period. [extension: nbn Ethernet Price List, Section 1.6, p.8]" ;
    rdfs:subClassOf :ProductComponent .

:EnhancedFaultRectificationService a owl:Class ;
    rdfs:label "EnhancedFaultRectificationService" ;
    rdfs:comment "An optional service with multiple options (Enhanced-12, Enhanced-8, etc.) that has a recurring charge per Billing Period, dependent on the option and nbn Network type. [extension: nbn Ethernet Price List, Section 2.2, p.9]" ;
    rdfs:subClassOf :ProductComponent .

:AccessTechnology_Wireless a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "Wireless" ;
    rdfs:comment "Fixed Wireless access technology. [extension: nbn Ethernet Price List, Section 1.1]" .

:Cl_ActivityCharge a owl:Class ;
    rdfs:label "Activity Charge" ;
    rdfs:comment "A reified relationship linking a service management activity, area type, monetary amount, and optional incidentals. [extension: nbn Ethernet Price List, Section (c), p.17]" .

:CVC a owl:Class ;
    rdfs:label "CVC" ;
    rdfs:comment "Connectivity Virtual Circuit: carries a CSA's traffic over an NNI Group, with a traffic-class mix." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "CVC",
        "CVC TC-1",
        "CVC TC-2",
        "CVC TC-4",
        "Connectivity Virtual Circuit",
        "Unicast N:1 CVC" .

:DownstreamPIR a owl:Class ;
    rdfs:label "DownstreamPIR" ;
    rdfs:comment "The downstream Peak Information Rate (Mbps) for an AVC TC-4 Product Component. [extension: nbn Ethernet Price List, Section 1.1]" .

:NNIGroup a owl:Class ;
    rdfs:label "NNIGroup" ;
    rdfs:comment "Group of NNI Bearers/NNIs at a POI sharing a redundancy mode, interface rate and protected capacity." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "NNI",
        "NNI Group",
        "NNI Product Component",
        "Network-Network Interface" .

:UpstreamPIR a owl:Class ;
    rdfs:label "UpstreamPIR" ;
    rdfs:comment "The upstream Peak Information Rate (Mbps) for an AVC TC-4 Product Component. [extension: nbn Ethernet Price List, Section 1.1]" .

:CandidateAction a owl:Class ;
    rdfs:label "CandidateAction" ;
    rdfs:comment "Candidate planning action with lead time, cost, feasibility, blocking reasons and scores." ;
    skos:altLabel "Modify",
        "NNI Diversity Upgrade",
        "NNI Upsize Migration",
        "charge",
        "lead time",
        "order",
        "price" .

:FlatRateAVCCharge a owl:Class ;
    rdfs:label "FlatRateAVCCharge" ;
    :conditionDescription "No additional recurring CVC TC-4 charges apply in connection with any Flat Rate AVC TC-4 Product Components." ;
    :sourceClause "nbn Ethernet Price List, Note 1, p.5" ;
    rdfs:comment "A specific type of Recurring Charge that applies per Billing Period for AVC TC-4 Product Components and associated CVC TC-4 capacity. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:subClassOf :RecurringCharge .

:AccessTechnology_FTTB a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTB" ;
    rdfs:comment "Fibre to the Building access technology. [extension: nbn Ethernet Price List, Section 1.1]" .

:AccessTechnology_FTTC a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTC" .

:AccessTechnology_FTTN a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FTTN" ;
    rdfs:comment "Fibre to the Node access technology. [extension: nbn Ethernet Price List, Section 1.1]" .

:AccessTechnology_HFC a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "HFC" .

:AVC_TC4_ProductComponent a owl:Class ;
    rdfs:label "AVC_TC4_ProductComponent" ;
    rdfs:comment "A specific type of Product Component that is an AVC with Traffic Class 4, which can be ordered and charged separately. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:subClassOf :AVC,
        :ProductComponent .

:AccessTechnology_FIBRE a :AccessTechnology,
        owl:NamedIndividual ;
    rdfs:label "FIBRE" .

:RecurringCharge a owl:Class ;
    rdfs:label "RecurringCharge" ;
    rdfs:comment "A monetary amount that recurs per Billing Period for a Product Component. [extension: nbn Ethernet Price List, Section 1.1]" ;
    rdfs:subClassOf :CostItem .

:BillingPeriod_P1M a :BillingPeriod,
        owl:NamedIndividual ;
    rdfs:label "BillingPeriod_P1M" ;
    :duration "P1M"^^xsd:string ;
    rdfs:comment "Monthly billing period (1 month). [extension: nbn Ethernet Price List, Section 1.1]" .

:MonetaryAmount a owl:Class ;
    rdfs:label "MonetaryAmount" ;
    rdfs:comment "A monetary value with a currency and numeric amount. [extension: nbn Ethernet Price List, Section 1.1]" .


