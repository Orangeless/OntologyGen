        owl:NamedIndividual ;
    rdfs:label "eSLA Change Event (example)" ;
    :hasExemptionCondition :ExemptionCondition_AVCTC2 ;
    :isCausedByDisconnection :EnhancedFaultRectification_Enhanced4_24_7 ;
    :isCausedByModification :EnhancedFaultRectification_Enhanced4_24_7 ;
    :occursWithin :FirstMonth_Instance ;
    :triggersChargeRule :RecurringCharge_Enhanced4_24_7_25_00 ;
    rdfs:comment "An eSLA Change Event occurs when an Enhanced Fault Rectification Service is disconnected or modified to change the selected option. [extension: nbn Ethernet Price List, Section 2.2(e), p.10]" .

:EarlyDisconnectionModificationCharge_Rule a :Cl_ChargeRule,
        owl:NamedIndividual ;
    rdfs:label "Early Disconnection or Modification Charge Rule" ;
    rdfs:comment "Rule: If an AVC TC-2 Product Component is cancelled, or within 12 months after order completion is disconnected or modified, RSP must pay the Charge calculated under section 7(c). [extension: nbn Ethernet Price List, Section 7(b), p.18]" .

:ExcessUsageEvent_Instance a :Cl_ExcessUsageEvent,
        owl:NamedIndividual ;
    rdfs:label "Excess CVC TC-4 Usage Event" ;
    rdfs:comment "Event triggered when RSP uses CVC TC-4 capacity in excess of either the average download limitation or the average upload limitation set out in section 4.5(a) of the nbn Ethernet Fair Use Policy. [extension: nbn Ethernet Price List, Section 6(a), p.17]" .

:ExemptionCondition_AVCTC2 a :BasicOfferCondition,
        owl:NamedIndividual ;
    rdfs:label "Exemption Condition: Enhanced Fault Rectification with AVC TC-2" ;
    :appliesTo :EnhancedFaultRectification_Enhanced4_24_7 ;
    :conditionDescription "Section 2.2(b) will not apply in respect of any Enhanced Fault Rectification Service which is supplied as part of an Ordered Product that also includes an AVC TC-2 Product Component at the time that the eSLA Change Event occurs." .

:ExemptionCondition_ServiceTransferOrder a :Cl_ExemptionCondition,
        owl:NamedIndividual ;
    rdfs:label "Exemption: Service Transfer Order with Qualifying CIR Objective" ;
    :appliesTo :ServiceTransferOrder_Instance ;
    :conditionDescription "The Other Gaining RSP has ordered an AVC TC-2 Product Component with a bandwidth profile with a CIR Objective that is the same as, or higher than, the CIR Objective applicable to the Losing RSP's AVC TC-2 Product Component." ;
    :sourceClause "nbn Ethernet Price List, Section 7(d)(ii), p.19" ;
    rdfs:comment "The Charge under section 7 will not apply if the nbn Ethernet Ordered Product is disconnected following acceptance by nbn of a Service Transfer Order and the Other Gaining RSP has ordered an AVC TC-2 Product Component with a bandwidth profile with a CIR Objective that is the same as, or higher than, the CIR Objective applicable to the Losing RSP's AVC TC-2 Product Component. [extension: nbn Ethernet Price List, Section 7(d)(ii), p.19]" .

