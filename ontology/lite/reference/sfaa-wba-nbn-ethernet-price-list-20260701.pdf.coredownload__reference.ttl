:Cl_ShortfallPeriod a owl:Class ;
    rdfs:label "Shortfall Period" ;
    rdfs:comment "A time interval used in the Charge calculation: 12 months for cancellation, or 12 months less the period Pre Disconnection Modification Charges applied for disconnection or modification, calculated on a pro rata daily basis. [extension: nbn Ethernet Price List, Section 7(c)(iii), p.19]" ;
    rdfs:subClassOf :TimeInterval .

:Day a owl:Class ;
    rdfs:label "Day" ;
    rdfs:comment "A calendar day defined as the period from 12:00am to 11:59pm based on local time in Sydney. [extension: nbn Ethernet Price List, Note 4, p.5]" .

