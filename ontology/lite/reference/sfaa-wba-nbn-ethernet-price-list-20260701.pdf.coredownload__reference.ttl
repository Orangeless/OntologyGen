:ChargeCalculationRule_FirstMonth_PostEvent a :ProRataRule,
        owl:NamedIndividual ;
    rdfs:label "Charge Calculation Rule: First Month portion after eSLA Change Event" ;
    :conditionDescription "For the portion of the first month after the day on which the eSLA Change Event occurs, the Charge is calculated in accordance with the applicable Charge in section 2.2(a), without the application of any Discount, Credit, Rebate or Waiver." .

:ChargeCalculationRule_FirstMonth_PreEvent a :ProRataRule,
        owl:NamedIndividual ;
    rdfs:label "Charge Calculation Rule: First Month portion on or before eSLA Change Event" ;
    :conditionDescription "For the portion of the first month on or before the day on which the eSLA Change Event occurs, the Charge is calculated in accordance with the applicable Charge in this nbn Ethernet Price List and any applicable Discounts, Credits, Rebates or Waivers." .

:DefaultNotice_Instance a :Cl_DefaultNotice,
        owl:NamedIndividual ;
    rdfs:label "Default Notice" ;
    :hasDefault :Default_Instance ;
    :hasNoticeName "Default Notice" ;
    :hasNotifyingParty :nbn ;
    rdfs:comment "A Default Notice given by one party to another when a party fails to comply with the Agreement. [extension: nbn Ethernet Price List, Section 7, p.18]" .

:EarlyDisconnectionModificationCharge_Instance a :Cl_Charge,
        :Cl_EarlyDisconnectionModificationCharge,
        owl:NamedIndividual ;
    rdfs:label "Early Disconnection or Modification Charge",
        "Early Disconnection or Modification Charge under Section 7" ;
    :appliesToOrderedProduct :OrderedProduct_DisconnectedViaSTO,
        :OrderedProduct_WithAVCTC2 ;
    :currency "AUD" ;
    :hasChargeFormula :ChargeFormula_Section7,
        :ChargeFormula_Section7_Cancellation,
        :ChargeFormula_Section7_DisconnectionModification,
        :ChargeFormula_Section7_Modification ;
    :hasChargeRule :EarlyDisconnectionModificationCharge_Rule ;
    :hasDurationInMonths 12 ;
    :hasExemptionCondition :ExemptionCondition_ServiceTransferOrder,
        :ExemptionCondition_UnsuccessfulNetworkActivity ;
    :hasTriggerEvent :TriggerEvent_Cancellation,
        :TriggerEvent_Disconnection,
        :TriggerEvent_Modification ;
    :sourceClause "nbn Ethernet Price List, Section 7, p.19" ;
    rdfs:comment "Charge triggered when an AVC TC-2 Product Component is cancelled, disconnected, or modified within 12 months of order completion, calculated as (Pre - Post) x Shortfall Period. [extension: nbn Ethernet Price List, Section 7, p.19]",
        "Charge triggered when an AVC TC-2 Product Component is cancelled, disconnected, or modified within 12 months of order completion. [extension: nbn Ethernet Price List, Section 7, p.18]" .

