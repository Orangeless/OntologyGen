@prefix : <http://www.example.org/test#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== REFERENCE SEED: reference ontology schema (reuse these terms; do not delete) =====
:Cl_BusinessDay a owl:Class ;
    rdfs:label "Business Day" ;
    rdfs:comment "A standard business day used for measuring performance objective durations. [extension: WBA Ethernet Service Levels Schedule, s5.2, p.14]" .

:Cl_EstimatedNetworkActivityDate a owl:Class ;
    rdfs:label "Estimated Network Activity Date" ;
    rdfs:comment "An estimated completion date provided by nbn within 30 Business Days after the Network Activity Designation Date. [extension: WBA Ethernet Service Levels Schedule, s5.2, p.14]" .

:Cl_InitialNetworkActivityUpdate a owl:Class ;
    rdfs:label "Initial Network Activity Update" ;
    rdfs:comment "An update provided by nbn within 20 Business Days after the Network Activity Designation Date. [extension: WBA Ethernet Service Levels Schedule, s5.2, p.14]" .

:CoordinatedAppointmentEvent a :Cl_CoOrdinatedAppointment,
        owl:NamedIndividual ;
    rdfs:label "Co-ordinated Appointment Event" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s2.5(a), p.13" ;
    :triggersRebate :CoordinatedAppointmentRebate .

:CoordinatedAppointmentServiceLevel a :ServiceLevel,
        owl:NamedIndividual ;
    rdfs:label "Co-ordinated Appointment Service Level" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s2.5(a), p.13" .

:CvcActivationPerformanceObjective a :Cl_PerformanceObjective,
        owl:NamedIndividual ;
    rdfs:label "CVC Activation Performance Objective" ;
    :appliesToActivation :Cl_CvcActivation ;
    :hasTargetPercentage 95 ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.2, p.13" .

:CvcActivationServiceLevel a :ServiceLevel,
        owl:NamedIndividual ;
    rdfs:label "CVC Activation Service Level" ;
    :appliesToActivation :Cl_CvcActivation ;
    :hasDuration 3 ;
    :hasUnit "Business Days" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.1, p.13" ;
    :startsAt :OrderAcknowledgementEvent .

:EstimatedNetworkActivityDatePerformanceObjective a :Cl_PerformanceObjective,
        owl:NamedIndividual ;
    rdfs:label "Estimated Network Activity Date Performance Objective" ;
    :hasMeasurementBasis "total number of Estimated Network Activity Dates provided by nbn for all RSPs each month" ;
    :hasTargetPercentage 90 ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s5.2, p.14" .

:EstimatedNetworkActivityDateServiceLevel a :ServiceLevel,
        owl:NamedIndividual ;
    rdfs:label "Estimated Network Activity Date Service Level" ;
    :hasDuration 30 ;
    :hasUnit "Business Days" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s5.2, p.14" ;
    :startsAt :NetworkActivityDesignationDateEvent .

:InitialNetworkActivityUpdatePerformanceObjective a :Cl_PerformanceObjective,
        owl:NamedIndividual ;
    rdfs:label "Initial Network Activity Update Performance Objective" ;
    :hasMeasurementBasis "total number of Initial Network Activity Updates provided by nbn for all RSPs each month" ;
    :hasTargetPercentage 90 ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s5.2, p.14" .

:InitialNetworkActivityUpdateServiceLevel a :ServiceLevel,
        owl:NamedIndividual ;
    rdfs:label "Initial Network Activity Update Service Level" ;
    :hasDuration 20 ;
    :hasUnit "Business Days" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s5.2, p.14" ;
    :startsAt :NetworkActivityDesignationDateEvent .

:NNILink a owl:Class ;
    rdfs:label "NNILink" ;
    rdfs:comment "WBA NNI Link / V-NNI / S-TAG concepts. Not modelled." ;
    skos:altLabel "NNI Link",
        "S-TAG",
        "V-NNI",
        "over-book" .

:NetworkActivityCompletionEvent a :Cl_NetworkActivityCompletion,
        owl:NamedIndividual ;
    rdfs:label "Network Activity Completion Event" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s5.3, p.15" .

:NetworkActivityPerformanceObjective a :Cl_PerformanceObjective,
        owl:NamedIndividual ;
    rdfs:label "Network Activity Performance Objective" ;
    :hasMeasurementBasis "total number of relevant Network Activities completed by nbn for all RSPs each month" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s5.1, p.14" .

:NniGroupActivationPerformanceObjective a :Cl_PerformanceObjective,
        owl:NamedIndividual ;
    rdfs:label "NNI Group Activation Performance Objective" ;
    :appliesToActivation :Cl_NniGroupActivation ;
    :hasTargetPercentage 95 ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.2, p.13" .

:NniGroupActivationServiceLevel a :ServiceLevel,
        owl:NamedIndividual ;
    rdfs:label "NNI Group Activation Service Level" ;
    :appliesToActivation :Cl_NniGroupActivation ;
    :hasDuration 15 ;
    :hasUnit "Business Days" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.1, p.13" ;
    :startsAt :OrderAcknowledgementEvent .

:NniLinkActivationPerformanceObjective a :Cl_PerformanceObjective,
        owl:NamedIndividual ;
    rdfs:label "NNI Link Activation Performance Objective" ;
    :appliesToActivation :Cl_NniLinkActivation ;
    :hasTargetPercentage 95 ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.2, p.13" .

:NniLinkActivationServiceLevel a :ServiceLevel,
        owl:NamedIndividual ;
    rdfs:label "NNI Link Activation Service Level" ;
    :appliesToActivation :Cl_NniLinkActivation ;
    :hasDuration 15 ;
    :hasUnit "Business Days" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.1, p.13" ;
    :startsAt :OrderAcknowledgementEvent .

:ProductComponent a owl:Class ;
    rdfs:label "ProductComponent" ;
    rdfs:comment "WBA Product Component; counts toward an NNI Group's Bearer Limit. Not modelled in the simulator." ;
    skos:altLabel "Bearer Limit",
        "Product Component" .

:StartDateEvent a :Cl_StartDate,
        owl:NamedIndividual ;
    rdfs:label "Start Date Event" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s5.3, p.15" .

:TC_1 a :TrafficClass,
        owl:NamedIndividual ;
    rdfs:label "TC-1" ;
    :name "Priority / realtime" ;
    :planningThresholdPct 70.0 .

:TC_2 a :TrafficClass,
        owl:NamedIndividual ;
    rdfs:label "TC-2" ;
    :name "Interactive" ;
    :planningThresholdPct 75.0 .

:TroubleTicketAcknowledgmentEvent a :Cl_TroubleTicket,
        owl:NamedIndividual ;
    rdfs:label "Trouble Ticket Acknowledgment Event" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s5.3, p.15" .

:VNniActivationPerformanceObjective a :Cl_PerformanceObjective,
        owl:NamedIndividual ;
    rdfs:label "V-NNI Activation Performance Objective" ;
    :appliesToActivation :Cl_VNniActivation ;
    :hasTargetPercentage 95 ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.2, p.13" .

:VNniActivationServiceLevel a :ServiceLevel,
        owl:NamedIndividual ;
    rdfs:label "V-NNI Activation Service Level" ;
    :appliesToActivation :Cl_VNniActivation ;
    :hasDuration 15 ;
    :hasUnit "Business Days" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.1, p.13" ;
    :startsAt :OrderAcknowledgementEvent .

:actionType a owl:ObjectProperty ;
    rdfs:label "action_type" ;
    rdfs:domain :CandidateAction ;
    rdfs:range :ActionType .

:addressesConstraintIds a owl:DatatypeProperty ;
    rdfs:label "addresses_constraint_ids" ;
    rdfs:comment "'|'-separated constraint ids covered, scoped to a resource." ;
    rdfs:domain :CandidateAction ;
    rdfs:range xsd:string .

:addressesRule a owl:ObjectProperty ;
    rdfs:domain :CandidateAction ;
    rdfs:range :PlanningRule .

:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:comment "Links a PIR Objective Rebate or PIR Affected Billing Period to the AVC TC-4 Ordered Product Component it applies to. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Cl_PirObjectiveRebate :Cl_PirAffectedBillingPeriod ) ] ;
    rdfs:range :Cl_AvcTc4OrderedProductComponent .
:appliesToActivation a owl:ObjectProperty ;
    rdfs:label "applies to activation" ;
    rdfs:comment "Links a Service Level or Performance Objective to the Activation type it applies to. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:assessedAs a owl:ObjectProperty ;
    rdfs:domain :CandidateAction ;
    rdfs:range :ActionAssessment .

:availableGbps a owl:DatatypeProperty ;
    rdfs:label "available_gbps" ;
    rdfs:comment "= protected - current load" ;
    rdfs:domain :NNIGroup ;
    rdfs:range xsd:double .

:avcs a owl:DatatypeProperty ;
    rdfs:label "avcs" ;
    rdfs:domain :CVC ;
    rdfs:range xsd:integer .

:bandwidthTierMbps a owl:DatatypeProperty ;
    rdfs:label "bandwidth_tier_mbps" ;
    rdfs:domain :AVC ;
    rdfs:range xsd:integer .

:bearerRateGbps a owl:DatatypeProperty ;
    rdfs:label "bearer_rate_gbps" ;
    rdfs:comment "Interface rate of every bearer in the group." ;
    rdfs:domain :NNIGroup ;
    rdfs:range xsd:double .

:bearers a owl:DatatypeProperty ;
    rdfs:label "bearers" ;
    rdfs:comment "Number of bearers. Config product_rules: max_bearers_per_nni=8, by rate (Gbps) {'1': 2, '10': 4, '100': 8}." ;
    rdfs:domain :NNIGroup ;
    rdfs:range xsd:integer .

:belongsToSegment a owl:ObjectProperty ;
    rdfs:domain :AVC ;
    rdfs:range :CustomerSegment .

:blockedBy a owl:DatatypeProperty ;
    rdfs:label "blocked_by" ;
    rdfs:comment "Blocking rule ids; BEARER_CEILING when the per-rate bearer limit blocks it.",
        "Rule id blocking use, e.g. EP-02." ;
    rdfs:domain :CandidateAction ;
    rdfs:range xsd:string .

:blockedByRule a owl:ObjectProperty ;
    rdfs:domain :CandidateAction ;
    rdfs:range :PlanningRule .

:busyHourFactor a owl:DatatypeProperty ;
    rdfs:label "busy_hour_factor" ;
    rdfs:domain :CSA ;
    rdfs:range xsd:double .

:capacityGbps a owl:DatatypeProperty ;
    rdfs:label "capacity_gbps" ;
    rdfs:comment "= protected_gbps" ;
    rdfs:domain :NNIGroup ;
    rdfs:range xsd:double .

:carries a owl:ObjectProperty ;
    rdfs:domain :CVC ;
    rdfs:range :CSA .

:commitmentPct a owl:DatatypeProperty ;
    rdfs:label "commitment_pct" ;
    rdfs:domain :NNIGroup ;
    rdfs:range xsd:double .

:completedOn a owl:ObjectProperty ;
    rdfs:label "completed on" ;
    rdfs:comment "Links a Network Activity to its Completion event. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.15]" ;
    rdfs:domain :Cl_NetworkActivity ;
    rdfs:range :Cl_NetworkActivityCompletion .

:consumes a owl:ObjectProperty ;
    rdfs:domain :CVC ;
    rdfs:range :TrafficClass .

:contractualGbps a owl:DatatypeProperty ;
    rdfs:label "contractual_gbps" ;
    rdfs:domain :NNIGroup ;
    rdfs:range xsd:double .

:currentBandwidthGbps a owl:DatatypeProperty ;
    rdfs:label "current_bandwidth_gbps" ;
    rdfs:domain :CVC ;
    rdfs:range xsd:double .

:currentLoadGbps a owl:DatatypeProperty ;
    rdfs:label "current_load_gbps" ;
    rdfs:domain :NNIGroup ;
    rdfs:range xsd:double .

:designatedOn a owl:ObjectProperty ;
    rdfs:label "designated on" ;
    rdfs:comment "Links a Network Activity to its Designation Date. [extension: WBA Ethernet Service Levels Schedule, s5.2, p.14]" ;
    rdfs:domain :Cl_NetworkActivity ;
    rdfs:range :Cl_NetworkActivityDesignationDate .

:designatesForNetworkActivity a owl:ObjectProperty ;
    rdfs:label "designates for network activity" ;
    rdfs:comment "Links an AVC TC-4 Ordered Product Component to the Network Activity it is designated for. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" ;
    rdfs:domain :Cl_AvcTc4OrderedProductComponent ;
    rdfs:range :Cl_NetworkActivity .

:endsAt a owl:ObjectProperty ;
    rdfs:label "ends at" ;
    rdfs:comment "Links a PIR Affected Billing Period to the Network Activity Completion event that ends it. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.15]" ;
    rdfs:domain :Cl_PirAffectedBillingPeriod ;
    rdfs:range :Cl_NetworkActivityCompletion .

:evidence a owl:DatatypeProperty ;
    rdfs:label "evidence" ;
    rdfs:domain :CandidateAction ;
    rdfs:range xsd:string .

:failureDomain a owl:DatatypeProperty ;
    rdfs:label "failure_domain" ;
    rdfs:comment "Cluster A/B the bearer lands in." ;
    rdfs:domain :Bearer ;
    rdfs:range xsd:string .

:feasible a owl:DatatypeProperty ;
    rdfs:label "feasible" ;
    rdfs:domain :CandidateAction ;
    rdfs:range xsd:boolean .

:forBillingPeriod a owl:ObjectProperty ;
    rdfs:label "for billing period" ;
    rdfs:comment "Links a PIR Objective Rebate to the PIR Affected Billing Period it applies to. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.15]" ;
    rdfs:domain :Cl_PirObjectiveRebate ;
    rdfs:range :Cl_PirAffectedBillingPeriod .

:forScenario a owl:ObjectProperty ;
    rdfs:domain :CandidateAction ;
    rdfs:range :Scenario .

:forecastGrowthPct a owl:DatatypeProperty ;
    rdfs:label "forecast_growth_pct" ;
    rdfs:domain :CSA ;
    rdfs:range xsd:double .

:hasAccessTechnology a owl:ObjectProperty ;
    rdfs:label "has access technology" ;
    rdfs:domain :Cl_AvcTc4OrderedProductComponent ;
    rdfs:range :AccessTechnology .

:hasAmount a owl:ObjectProperty ;
    rdfs:label "has amount" ;
    rdfs:comment "Links a rebate to the Charge that determines its amount. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:hasBandwidthProfileDownstreamMbps a owl:DatatypeProperty ;
    rdfs:label "has bandwidth profile downstream Mbps" ;
    rdfs:comment "The downstream PIR bandwidth profile in Mbps for an AVC TC-4 Ordered Product Component. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" ;
    rdfs:domain :Cl_AvcTc4OrderedProductComponent ;
    rdfs:range xsd:integer .

:hasBandwidthProfileUpstreamMbps a owl:DatatypeProperty ;
    rdfs:label "has bandwidth profile upstream Mbps" ;
    rdfs:comment "The upstream PIR bandwidth profile in Mbps for an AVC TC-4 Ordered Product Component. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" ;
    rdfs:domain :Cl_AvcTc4OrderedProductComponent ;
    rdfs:range xsd:integer .

:hasBearer a owl:ObjectProperty ;
    rdfs:domain :NNIGroup ;
    rdfs:range :Bearer .

:hasCapacityPool a owl:ObjectProperty ;
    rdfs:domain :NNIGroup ;
    rdfs:range :CapacityPool .

:hasCost a owl:ObjectProperty ;
    rdfs:domain :CandidateAction ;
    rdfs:range :CostItem .

:hasCurrency a owl:DatatypeProperty ;
    rdfs:label "has currency" ;
    rdfs:comment "The currency of a monetary amount. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.15]" ;
    rdfs:range xsd:string .

:hasDuration a owl:DatatypeProperty ;
    rdfs:label "has duration" ;
    rdfs:comment "The numeric duration of a Service Level in Business Days. [extension: WBA Ethernet Service Levels Schedule, p.13]" ;
    rdfs:range xsd:integer .

:hasDurationIso a owl:DatatypeProperty ;
    rdfs:label "has duration ISO" ;
    rdfs:comment "The duration of a PIR Affected Billing Period in ISO-8601 format. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.15]" ;
    rdfs:range xsd:string .

:hasLineRateDownstreamMbps a owl:DatatypeProperty ;
    rdfs:label "has line rate downstream Mbps" ;
    rdfs:comment "The line rate at the nbn Downstream Network Boundary in Mbps. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" ;
    rdfs:domain :Cl_AvcTc4OrderedProductComponent ;
    rdfs:range xsd:integer .

:hasLineRateUpstreamMbps a owl:DatatypeProperty ;
    rdfs:label "has line rate upstream Mbps" ;
    rdfs:comment "The line rate at the nbn Upstream Network Boundary in Mbps. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" ;
    rdfs:domain :Cl_AvcTc4OrderedProductComponent ;
    rdfs:range xsd:integer .

:hasMaxConsecutiveBillingPeriods a owl:DatatypeProperty ;
    rdfs:label "has max consecutive billing periods" ;
    rdfs:comment "The maximum number of consecutive PIR Affected Billing Periods for which the rebate applies. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.15]" ;
    rdfs:domain :Cl_PirObjectiveRebate ;
    rdfs:range xsd:integer .

:hasMeasurementBasis a owl:DatatypeProperty ;
    rdfs:label "has measurement basis" ;
    rdfs:comment "The basis on which a Performance Objective is measured. [extension: WBA Ethernet Service Levels Schedule, s5.1-5.2, p.14]" ;
    rdfs:domain :Cl_PerformanceObjective ;
    rdfs:range xsd:string .

:hasNni a owl:ObjectProperty ;
    rdfs:domain :NNIGroup ;
    rdfs:range :NNI .

:hasPerformanceObjective a owl:ObjectProperty ;
    rdfs:label "has performance objective" ;
    rdfs:comment "Links an Activation to its Performance Objective. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:hasPirObjective a owl:ObjectProperty ;
    rdfs:label "has PIR objective" ;
    rdfs:comment "Links an AVC TC-4 Ordered Product Component to its PIR Objective. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" ;
    rdfs:domain :Cl_AvcTc4OrderedProductComponent ;
    rdfs:range :Cl_PirObjective .

:hasRebateAmount a owl:DatatypeProperty ;
    rdfs:label "has rebate amount" ;
    rdfs:comment "The monetary amount of a rebate. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.15]" ;
    rdfs:range xsd:decimal .

:hasSegmentMix a owl:ObjectProperty ;
    rdfs:domain :CSA ;
    rdfs:range :CustomerSegment .

:hasServiceLevel a owl:ObjectProperty ;
    rdfs:label "has service level" ;
    rdfs:comment "Links an Activation to its Service Level. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:hasTargetPercentage a owl:DatatypeProperty ;
    rdfs:label "has target percentage" ;
    rdfs:comment "The target percentage of a Performance Objective. [extension: WBA Ethernet Service Levels Schedule, p.13]" ;
    rdfs:domain :Cl_PerformanceObjective ;
    rdfs:range xsd:integer .

:hasTrafficClass a owl:ObjectProperty ;
    rdfs:label "has traffic class" ;
    rdfs:comment "Links an AVC TC-4 Ordered Product Component to its traffic class (TC-4). [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" ;
    rdfs:domain :Cl_AvcTc4OrderedProductComponent ;
    rdfs:range :TrafficClass .

:hasUnit a owl:DatatypeProperty ;
    rdfs:label "has unit" ;
    rdfs:comment "The unit of a Service Level duration (e.g. 'Business Days'). [extension: WBA Ethernet Service Levels Schedule, p.13]" ;
    rdfs:range xsd:string .

:inRegion a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Bearer :CSA :CVC :NNIGroup :POI ) ] ;
    rdfs:range :PlanningRegion .

:isFollowedBy a owl:ObjectProperty ;
    rdfs:label "is followed by" ;
    rdfs:comment "Links consecutive PIR Affected Billing Periods. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.15]" ;
    rdfs:domain :Cl_PirAffectedBillingPeriod ;
    rdfs:range :Cl_PirAffectedBillingPeriod .

:isNotCapableOfAchievingPirObjective a owl:ObjectProperty ;
    rdfs:label "is not capable of achieving PIR objective" ;
    rdfs:comment "Links an AVC TC-4 Ordered Product Component to the PIR Objective it cannot achieve. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" ;
    rdfs:domain :Cl_AvcTc4OrderedProductComponent ;
    rdfs:range :Cl_PirObjective .

:isPaidBy a owl:ObjectProperty ;
    rdfs:label "is paid by" ;
    rdfs:comment "Links a rebate to the agent that pays it (nbn). [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:isPaidByApplyingToInvoice a owl:ObjectProperty ;
    rdfs:label "is paid by applying to invoice" ;
    rdfs:comment "Links a rebate to the Invoice it is applied to. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:isPaidTo a owl:ObjectProperty ;
    rdfs:label "is paid to" ;
    rdfs:comment "Links a rebate to the agent that receives it (RSP). [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:knownRequiredConstraintsCovered a owl:DatatypeProperty ;
    rdfs:label "known_required_constraints_covered" ;
    rdfs:domain :CandidateAction ;
    rdfs:range xsd:boolean .

:label a owl:DatatypeProperty ;
    rdfs:label "label" ;
    rdfs:domain :CandidateAction ;
    rdfs:range xsd:string .

:landedOn a owl:ObjectProperty ;
    rdfs:domain :Bearer ;
    rdfs:range :Device .

:leadTimeDays a owl:DatatypeProperty ;
    rdfs:label "lead_time_days" ;
    rdfs:domain :CandidateAction ;
    rdfs:range xsd:integer .

:mapsTo a owl:ObjectProperty ;
    rdfs:domain :CVC ;
    rdfs:range :NNIGroup .

:materialisationCoverage a owl:ObjectProperty ;
    rdfs:label "materialisation_coverage" ;
    rdfs:domain :CVC ;
    rdfs:range :MaterialisationCoverage .

:materialisedAvcCount a owl:DatatypeProperty ;
    rdfs:label "materialised_avc_count" ;
    rdfs:domain :CVC ;
    rdfs:range xsd:integer .

:maxSupportedCvc a owl:DatatypeProperty ;
    rdfs:label "max_supported_cvc" ;
    rdfs:domain :NNIGroup ;
    rdfs:range xsd:integer .

:measuredOver a owl:DatatypeProperty ;
    rdfs:label "measured over" ;
    rdfs:comment "The time interval over which a Performance Objective is measured (e.g. 'P1M' for monthly). [extension: WBA Ethernet Service Levels Schedule, p.13]" ;
    rdfs:domain :Cl_PerformanceObjective ;
    rdfs:range xsd:string .

:mode a owl:ObjectProperty ;
    rdfs:label "mode" ;
    rdfs:domain :NNIGroup ;
    rdfs:range :RedundancyMode .

:monthlyCost a owl:DatatypeProperty ;
    rdfs:label "monthly_cost" ;
    rdfs:domain :NNIGroup ;
    rdfs:range xsd:double .

:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain :TrafficClass ;
    rdfs:range xsd:string .

:orderedBy a owl:ObjectProperty ;
    rdfs:label "ordered by" ;
    rdfs:comment "Links an AVC TC-4 Ordered Product Component to the RSP that ordered it. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" ;
    rdfs:domain :Cl_AvcTc4OrderedProductComponent ;
    rdfs:range :Cl_RSP .

:peakBandwidthGbps a owl:DatatypeProperty ;
    rdfs:label "peak_bandwidth_gbps" ;
    rdfs:domain :CVC ;
    rdfs:range xsd:double .

:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by" ;
    rdfs:comment "Links a Network Activity to the nbn agent that performs it. [extension: WBA Ethernet Service Levels Schedule, s5.1, p.14]" ;
    rdfs:domain :Cl_NetworkActivity ;
    rdfs:range :Cl_nbn .

:performs a owl:ObjectProperty ;
    rdfs:label "performs" ;
    rdfs:comment "Links an nbn agent to the Network Activity it performs. [extension: WBA Ethernet Service Levels Schedule, s5.1, p.14]" ;
    rdfs:domain :Cl_nbn ;
    rdfs:range :Cl_NetworkActivity .

:planningThresholdPct a owl:DatatypeProperty ;
    rdfs:label "planning_threshold_pct" ;
    rdfs:domain :TrafficClass ;
    rdfs:range xsd:double .

:populationBasis a owl:DatatypeProperty ;
    rdfs:label "population_basis" ;
    rdfs:comment "CVC_AVC_COUNT_PROXY: the aggregate avcs count is authoritative over materialised AVC records." ;
    rdfs:domain :CVC ;
    rdfs:range xsd:string .

:premises a owl:DatatypeProperty ;
    rdfs:label "premises" ;
    rdfs:domain :CSA ;
    rdfs:range xsd:integer .

:projectedToGrow a owl:ObjectProperty ;
    rdfs:domain :CSA ;
    rdfs:range :DemandForecast .

:protectedGbps a owl:DatatypeProperty ;
    rdfs:label "protected_gbps" ;
    rdfs:domain :NNIGroup ;
    rdfs:range xsd:double .

:rateGbps a owl:DatatypeProperty ;
    rdfs:label "rate_gbps" ;
    rdfs:domain :Bearer ;
    rdfs:range xsd:double .

:resilienceScore a owl:DatatypeProperty ;
    rdfs:label "resilience_score" ;
    rdfs:domain :CandidateAction ;
    rdfs:range xsd:double .

:riskRating a owl:ObjectProperty ;
    rdfs:label "risk_rating" ;
    rdfs:domain :CSA ;
    rdfs:range :RiskRating .

:riskScore a owl:DatatypeProperty ;
    rdfs:label "risk_score" ;
    rdfs:domain :CandidateAction ;
    rdfs:range xsd:double .

