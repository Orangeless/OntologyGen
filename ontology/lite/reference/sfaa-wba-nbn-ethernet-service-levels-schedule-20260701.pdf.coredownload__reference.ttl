        owl:NamedIndividual ;
    rdfs:label "nbn" ;
    :performs :NetworkActivityDesignationDateEvent ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.13" .

:PlanningRule a owl:Class ;
    rdfs:label "PlanningRule" ;
    rdfs:comment "Named planning/engineering/governance rule with a limit, unit and compliance level (PR-01 ... GV-03)." .

:Cl_NetworkActivityCompletion a owl:Class ;
    rdfs:label "Network Activity Completion" ;
    rdfs:comment "The event marking the completion of a designated Network Activity, ending the PIR Affected Billing Period. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.15]" .

:Cl_PirObjective a owl:Class ;
    rdfs:label "PIR Objective" ;
    rdfs:comment "Peak Information Rate objective for an AVC TC-4 Ordered Product Component. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" .

:Cl_nbn a owl:Class ;
    rdfs:label "nbn" ;
    rdfs:comment "The agent nbn, who pays the Co-ordinated Appointment Rebate. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:NetworkActivityDesignationDateEvent a :Cl_NetworkActivityDesignationDate,
        owl:NamedIndividual ;
    rdfs:label "Network Activity Designation Date Event" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s5.2, p.14" ;
    :triggersRebate :PirObjectiveRebate .

:RspAgent a :Cl_RSP,
        owl:NamedIndividual ;
    rdfs:label "RSP" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.13" .

:AVC a owl:Class ;
    rdfs:label "AVC" ;
    rdfs:comment "Access Virtual Circuit: per-service circuit that uses a CVC." ;
    skos:altLabel "AVC",
        "Access Virtual Circuit",
        "OVC",
        "Unicast 1:1 AVC" .

:Cl_Activation a owl:Class ;
    rdfs:label "Activation" ;
    rdfs:comment "The completion of a CVC, NNI Group, NNI Link, or V-NNI activation. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:Cl_PirObjectiveRebate a owl:Class ;
    rdfs:label "PIR Objective Rebate" ;
    rdfs:comment "A rebate of $10.61 AUD provided by nbn to an RSP for each PIR Affected Billing Period when an AVC TC-4 Ordered Product Component cannot achieve its PIR Objective and is designated for a Network Activity. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14-15]" .

:InterfaceTechnology a owl:Class ;
    rdfs:label "InterfaceTechnology" ;
    rdfs:comment "NNI interface technology (nni_groups.technology)." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :InterfaceTechnology_100GE :InterfaceTechnology_10GE :InterfaceTechnology_1GE ) ] .

:MaterialisationCoverage a owl:Class ;
    rdfs:label "MaterialisationCoverage" ;
    rdfs:comment "How many of a CVC's AVCs exist as explicit records." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :MaterialisationCoverage_COMPLETE :MaterialisationCoverage_PARTIAL :MaterialisationCoverage_NONE ) ] .

:OrderAcknowledgementEvent a :Cl_OrderAcknowledgement,
        owl:NamedIndividual ;
    rdfs:label "Order Acknowledgement Event" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, s3.1, p.13" .

:POI a owl:Class ;
    rdfs:label "POI" ;
    rdfs:comment "Point of Interconnect: where CSAs and NNI Groups meet the wholesale network. One per region, hosted on aggregation devices." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "Local POI",
        "POI",
        "Point of Interconnect",
        "State Aggregation POI" .

:RedundancyMode a owl:Class ;
    rdfs:label "RedundancyMode" ;
    rdfs:comment "NNI Group redundancy mode (nni_groups.mode)." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :RedundancyMode_DIVERSE_CHASSIS :RedundancyMode_SINGLE :RedundancyMode_SINGLE_CHASSIS ) ] .

:RiskRating a owl:Class ;
    rdfs:label "RiskRating" ;
    rdfs:comment "CSA risk rating (csas.risk_rating)." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :RiskRating_High :RiskRating_Low :RiskRating_Medium ) ] .

:Cl_NetworkActivity a owl:Class ;
    rdfs:label "Network Activity" ;
    rdfs:comment "An activity performed by nbn on the network, designated by a Network Activity Designation Date, and subject to performance objectives for update timeliness. [extension: WBA Ethernet Service Levels Schedule, s5.1-5.2, p.14]" .

:Cl_PirAffectedBillingPeriod a owl:Class ;
    rdfs:label "PIR Affected Billing Period" ;
    rdfs:comment "A monthly billing period during which an AVC TC-4 Ordered Product Component is designated for a Network Activity because it cannot achieve its PIR Objective, starting from the Start Date (Prior WBA) or Trouble Ticket acknowledgment (this Agreement), and ending when the Network Activity is completed. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.15]" .

:PlanningResource a owl:Class ;
    rdfs:label "PlanningResource" ;
    rdfs:comment "Run-scoped planning inventory object (not a new physical asset). Superclass of POI, CSA, NNIGroup, CVC, PlanningLineCard, PlanningPort." .

:AccessTechnology a owl:Class ;
    rdfs:label "AccessTechnology" ;
    rdfs:comment "Access technology of a CSA (csas.tech; a CSA may have several, separated by '|')." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :AccessTechnology_FIBRE :AccessTechnology_FTTC :AccessTechnology_HFC ) ],
        [ a owl:Class ;
            owl:oneOf ( :AccessTechnology_FIBRE :AccessTechnology_FTTC :AccessTechnology_FTTB :AccessTechnology_FTTN ) ] .

:ServiceLevel a owl:Class ;
    rdfs:label "ServiceLevel" ;
    rdfs:comment "WBA availability and service levels (Network Availability, frame delay, frame loss). Not modelled." ;
    skos:altLabel "Network Availability",
        "Service Level",
        "frame delay",
        "frame loss" .

:TrafficClass a owl:Class ;
    rdfs:label "TrafficClass" ;
    rdfs:comment "Traffic class (TC-1, TC-2, TC-4) with a planning utilisation threshold." ;
    skos:altLabel "TC-1",
        "TC-2",
        "TC-4",
        "bandwidth profile",
        "traffic class" .

:Bearer a owl:Class ;
    rdfs:label "Bearer" ;
    rdfs:comment "NNI Bearer: one physical interface of an NNI Group, landed on a line-card/port in a failure domain." ;
    skos:altLabel "Diverse Chassis",
        "NNI Bearer",
        "Redundancy Mode",
        "Single Chassis",
        "interface rate" .

:Cl_PerformanceObjective a owl:Class ;
    rdfs:label "Performance Objective" ;
    rdfs:comment "A target percentage of activations completed within the relevant Service Level, measured monthly. [extension: WBA Ethernet Service Levels Schedule, p.13]" .

:Cl_AvcTc4OrderedProductComponent a owl:Class ;
    rdfs:label "AVC TC-4 Ordered Product Component" ;
    rdfs:comment "An AVC product component with TC-4 traffic class that has been ordered by an RSP, subject to PIR Objective rebate provisions. Includes nbn Ethernet (FTTB), nbn Ethernet (FTTN) or nbn Ethernet (FTTC) AVC TC-4 Ordered Product Components. [extension: WBA Ethernet Service Levels Schedule, s5.3, p.14]" .

:ActionType a owl:Class ;
    rdfs:label "ActionType" ;
    rdfs:comment "Planning action types (legacy fixture action generation)." ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :ActionType_INCREASE_CVC_BW :ActionType_ADD_PORT :ActionType_MOVE_CSA_LOAD :ActionType_REBALANCE_AVCS :ActionType_SPLIT_CAPACITY_POOL :ActionType_CREATE_NEW_NNI :ActionType_CREATE_NEW_CVC :ActionType_UPGRADE_PORT :ActionType_ADD_BACKHAUL :ActionType_ADD_AGGREGATION :ActionType_CREATE_RESILIENCE_PATH :ActionType_CREATE_NEW_BEARER ) ] .

:CSA a owl:Class ;
    rdfs:label "CSA" ;
    rdfs:comment "Connectivity Serving Area: a served area with services, premises and demand growth." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "CSA",
        "Connectivity Serving Area" .

:CVC a owl:Class ;
    rdfs:label "CVC" ;
    rdfs:comment "Connectivity Virtual Circuit: carries a CSA's traffic over an NNI Group, with a traffic-class mix." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "CVC",
        "CVC TC-1",
        "CVC TC-2",
        "CVC TC-4",
        "Connectivity Virtual Circuit",
        "Unicast N:1 CVC" .

:NNIGroup a owl:Class ;
    rdfs:label "NNIGroup" ;
    rdfs:comment "Group of NNI Bearers/NNIs at a POI sharing a redundancy mode, interface rate and protected capacity." ;
    rdfs:subClassOf :PlanningResource ;
    skos:altLabel "NNI",
        "NNI Group",
        "NNI Product Component",
        "Network-Network Interface" .

:CandidateAction a owl:Class ;
    rdfs:label "CandidateAction" ;
    rdfs:comment "Candidate planning action with lead time, cost, feasibility, blocking reasons and scores." ;
    skos:altLabel "Modify",
        "NNI Diversity Upgrade",
        "NNI Upsize Migration",
        "charge",
        "lead time",
        "order",
        "price" .


# ===== EXTENSIONS FROM DOCUMENTS: append new classes / properties / facts BELOW this line =====
# ===== EXTENSIONS FROM PAGE 32: Network Availability, Shared Network Resources, Throughput Dimensioning, Exclusion Events =====
# ===== EXTENSIONS FROM PAGE 32: Network Availability, Shared Network Resources, Throughput Dimensioning, Exclusion Events =====

# --- New Classes ---

:Cl_NetworkAvailability a owl:Class ;
    rdfs:label "Network Availability" ;
    rdfs:comment "The state of the nbn network being available as measured against a performance objective, with specific exclusions defined by contract. [extension: WBA Ethernet Service Levels Schedule, p.32-33]" ;
    rdfs:subClassOf :ServiceLevel .

:Cl_NetworkAvailabilityPerformanceObjective a owl:Class ;
    rdfs:label "Network Availability Performance Objective" ;
    rdfs:comment "The Performance Objective for Network Availability, based on modelling using a set of assumptions regarding future network performance and may be modified by nbn following analysis of empirical Network Availability performance data gathered over time. [extension: WBA Ethernet Service Levels Schedule, p.33]" ;
    rdfs:subClassOf :Cl_PerformanceObjective .

:Cl_SharedNetworkResource a owl:Class ;
    rdfs:label "Shared Network Resource" ;
    rdfs:comment "nbn's transit backhaul network between the POI and a specified network endpoint, defined differently per access technology. [extension: WBA Ethernet Service Levels Schedule, p.33]" .

:Cl_AvcTc4 a owl:Class ;
    rdfs:label "AVC TC-4" ;
    rdfs:comment "An AVC with TC-4 traffic class, used in throughput dimensioning obligations. [extension: WBA Ethernet Service Levels Schedule, p.33]" ;
    rdfs:subClassOf :AVC .

:Cl_ThroughputDimensioning a owl:Class ;
    rdfs:label "Throughput Dimensioning" ;
    rdfs:comment "The contractual obligation for nbn to dimension average busy hour throughput of Shared Network Resources at specified minimums per AVC TC-4. [extension: WBA Ethernet Service Levels Schedule, p.33]" .

:Cl_ExclusionEvent a owl:Class ;
    rdfs:label "Exclusion Event" ;
    rdfs:comment "An event that is excluded from Network Availability measurement. [extension: WBA Ethernet Service Levels Schedule, p.32-33]" .

:Cl_PowerOutage a owl:Class ;
    rdfs:label "Power Outage" ;
    rdfs:comment "A power outage event excluded from Network Availability measurement. [extension: WBA Ethernet Service Levels Schedule, p.32-33]" ;
    rdfs:subClassOf :Cl_ExclusionEvent .

:Cl_BoundaryExclusion a owl:Class ;
    rdfs:label "Boundary Exclusion" ;
    rdfs:comment "A matter, thing, event or circumstance that occurs outside the nbn Network Boundaries, excluded from Network Availability measurement. [extension: WBA Ethernet Service Levels Schedule, p.32-33]" ;
    rdfs:subClassOf :Cl_ExclusionEvent .

:Cl_FairUsePolicyBreach a owl:Class ;
    rdfs:label "Fair Use Policy Breach" ;
    rdfs:comment "A breach of the nbn Ethernet Fair Use Policy under this Agreement or under any Other Wholesale Broadband Agreement, excluded from Network Availability measurement. [extension: WBA Ethernet Service Levels Schedule, p.33]" ;
    rdfs:subClassOf :Cl_ExclusionEvent .

:Cl_BandwidthProfile a owl:Class ;
    rdfs:label "Bandwidth Profile" ;
    rdfs:comment "A bandwidth profile definition for AVC TC-4, specifying downstream/upstream PIR values. [extension: WBA Ethernet Service Levels Schedule, p.33]" .

# --- New Data Properties ---

:hasMinimumThroughputKbps a owl:DatatypeProperty ;
    rdfs:label "has minimum throughput kbps" ;
    rdfs:comment "The minimum average busy hour throughput per AVC TC-4 in kbps. [extension: WBA Ethernet Service Levels Schedule, p.33]" ;
    rdfs:range xsd:integer .

:hasMinimumThroughputMbps a owl:DatatypeProperty ;
    rdfs:label "has minimum throughput Mbps" ;
    rdfs:comment "The minimum average busy hour throughput per AVC TC-4 in Mbps. [extension: WBA Ethernet Service Levels Schedule, p.33]" ;
    rdfs:range xsd:integer .

:affectsEquipmentType a owl:DatatypeProperty ;
    rdfs:label "affects equipment type" ;
    rdfs:comment "The type of network equipment affected by a Power Outage exclusion event. [extension: WBA Ethernet Service Levels Schedule, p.32-33]" ;
    rdfs:range xsd:string .

:occursAtSiteType a owl:DatatypeProperty ;
    rdfs:label "occurs at site type" ;
    rdfs:comment "The type of site where a Power Outage exclusion event occurs. [extension: WBA Ethernet Service Levels Schedule, p.32-33]" ;
    rdfs:range xsd:string .

:isNotLocatedIn a owl:DatatypeProperty ;
    rdfs:label "is not located in" ;
    rdfs:comment "The facility type that the affected equipment is not located within. [extension: WBA Ethernet Service Levels Schedule, p.32-33]" ;
    rdfs:range xsd:string .

# --- New Object Properties ---

:isExcludedFrom a owl:ObjectProperty ;
    rdfs:label "is excluded from" ;
    rdfs:comment "Links an Exclusion Event to the Network Availability measurement it is excluded from. [extension: WBA Ethernet Service Levels Schedule, p.32-33]" ;
    rdfs:domain :Cl_ExclusionEvent ;
    rdfs:range :Cl_NetworkAvailability .

:isDimensionedOn a owl:ObjectProperty ;
    rdfs:label "is dimensioned on" ;
    rdfs:comment "Links Throughput Dimensioning to the Shared Network Resource it applies to. [extension: WBA Ethernet Service Levels Schedule, p.33]" ;
    rdfs:domain :Cl_ThroughputDimensioning ;
    rdfs:range :Cl_SharedNetworkResource .

:appliesToNetwork a owl:ObjectProperty ;
    rdfs:label "applies to network" ;
    rdfs:comment "Links a Throughput Dimensioning or Shared Network Resource definition to the Access Technology it applies to. [extension: WBA Ethernet Service Levels Schedule, p.33]" ;
    rdfs:range :AccessTechnology .

:hasBandwidthProfile a owl:ObjectProperty ;
    rdfs:label "has bandwidth profile" ;
    rdfs:comment "Links Throughput Dimensioning to the Bandwidth Profile it applies to. [extension: WBA Ethernet Service Levels Schedule, p.33]" ;
    rdfs:domain :Cl_ThroughputDimensioning ;
    rdfs:range :Cl_BandwidthProfile .

:hasAvcTc4 a owl:ObjectProperty ;
    rdfs:label "has AVC TC-4" ;
    rdfs:comment "Links Throughput Dimensioning to the AVC TC-4 it applies to. [extension: WBA Ethernet Service Levels Schedule, p.33]" ;
    rdfs:domain :Cl_ThroughputDimensioning ;
    rdfs:range :Cl_AvcTc4 .

# --- Individuals / Facts ---

# Network Availability Performance Objective
:NetworkAvailabilityPerformanceObjective a :Cl_NetworkAvailabilityPerformanceObjective, owl:NamedIndividual ;
    rdfs:label "Network Availability Performance Objective" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.33" .

# Network Availability
:NetworkAvailability a :Cl_NetworkAvailability, owl:NamedIndividual ;
    rdfs:label "Network Availability" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.32-33" .

# Exclusion Events
:BoundaryExclusionEvent a :Cl_BoundaryExclusion, owl:NamedIndividual ;
    rdfs:label "Boundary Exclusion Event" ;
    rdfs:comment "A matter, thing, event or circumstance that occurs outside the nbn Network Boundaries." ;
    :isExcludedFrom :NetworkAvailability ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.32-33" .

:PowerOutageMduSite a :Cl_PowerOutage, owl:NamedIndividual ;
    rdfs:label "Power Outage at MDU Site" ;
    rdfs:comment "Any Power Outage at an MDU Site or affecting any nbn Equipment located at that MDU Site." ;
    :isExcludedFrom :NetworkAvailability ;
    :occursAtSiteType "MDU Site" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.32-33" .

:PowerOutageFttbFttnNode a :Cl_PowerOutage, owl:NamedIndividual ;
    rdfs:label "Power Outage affecting FTTB/FTTN Node" ;
    rdfs:comment "Power Outage affecting an nbn Node or any other active equipment that forms part of the FTTB Network or the FTTN Network and is not located within a Type 1 Facility or a Type 2 Facility." ;
    :isExcludedFrom :NetworkAvailability ;
    :affectsEquipmentType "nbn Node, active equipment forming part of FTTB Network or FTTN Network" ;
    :isNotLocatedIn "Type 1 Facility, Type 2 Facility" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.32-33" .

:PowerOutageHfcOpticalNode a :Cl_PowerOutage, owl:NamedIndividual ;
    rdfs:label "Power Outage affecting HFC Optical Node" ;
    rdfs:comment "Power Outage affecting an HFC Optical Node or any other active equipment that forms part of the HFC Network and is not located within a Type 1 Facility or a Type 2 Facility." ;
    :isExcludedFrom :NetworkAvailability ;
    :affectsEquipmentType "HFC Optical Node, active equipment forming part of HFC Network" ;
    :isNotLocatedIn "Type 1 Facility, Type 2 Facility" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.32-33" .

:PowerOutageFttcDpu a :Cl_PowerOutage, owl:NamedIndividual ;
    rdfs:label "Power Outage affecting FTTC DPU" ;
    rdfs:comment "Power Outage affecting an nbn DPU, FTTC-NCD or any other active equipment that forms part of the FTTC Network and is not located within a Type 1 Facility or a Type 2 Facility." ;
    :isExcludedFrom :NetworkAvailability ;
    :affectsEquipmentType "nbn DPU, FTTC-NCD, active equipment forming part of FTTC Network" ;
    :isNotLocatedIn "Type 1 Facility, Type 2 Facility" ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.32-33" .

:FairUsePolicyBreachEvent a :Cl_FairUsePolicyBreach, owl:NamedIndividual ;
    rdfs:label "Fair Use Policy Breach Event" ;
    rdfs:comment "Breach of the nbn Ethernet Fair Use Policy under this Agreement or under any Other Wholesale Broadband Agreement." ;
    :isExcludedFrom :NetworkAvailability ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.33" .

# Shared Network Resources by network type
:SharedNetworkResourceFibreFttc a :Cl_SharedNetworkResource, owl:NamedIndividual ;
    rdfs:label "Shared Network Resource - Fibre and FTTC" ;
    rdfs:comment "nbn's transit backhaul network between the POI and the OLT for the Fibre Network and FTTC Network." ;
    :appliesToNetwork :AccessTechnology_FIBRE ;
    :appliesToNetwork :AccessTechnology_FTTC ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.33" .

:SharedNetworkResourceFttbFttn a :Cl_SharedNetworkResource, owl:NamedIndividual ;
    rdfs:label "Shared Network Resource - FTTB and FTTN" ;
    rdfs:comment "nbn's transit backhaul network between the POI and the access aggregation switch for the FTTB Network and the FTTN Network." ;
    :appliesToNetwork :AccessTechnology_FTTB ;
    :appliesToNetwork :AccessTechnology_FTTN ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.33" .

:SharedNetworkResourceHfc a :Cl_SharedNetworkResource, owl:NamedIndividual ;
    rdfs:label "Shared Network Resource - HFC" ;
    rdfs:comment "nbn's transit backhaul network between the POI and the cable modem termination system for the HFC Network." ;
    :appliesToNetwork :AccessTechnology_HFC ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.33" .

:SharedNetworkResourceWireless a :Cl_SharedNetworkResource, owl:NamedIndividual ;
    rdfs:label "Shared Network Resource - Wireless" ;
    rdfs:comment "nbn's transit backhaul network between the POI and the combined packet gateway for the Wireless Network." ;
    :sourceClause "WBA Ethernet Service Levels Schedule, p.33" .

